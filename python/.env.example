# NPLogic Backend 환경 변수 설정
# 이 파일을 .env로 복사한 후 실제 값을 입력하세요

# ===================
# Supabase 설정 (추천 시스템용)
# ===================
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your-supabase-anon-key

# ===================
# Clova OCR 설정
# ===================
# 네이버 클라우드 플랫폼 > AI Services > CLOVA OCR에서 발급
CLOVA_SECRET_KEY=your-clova-secret-key
CLOVA_INVOKE_URL=https://your-clova-invoke-url
