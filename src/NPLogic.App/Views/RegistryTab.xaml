<UserControl x:Class="NPLogic.Views.RegistryTab"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:vm="clr-namespace:NPLogic.ViewModels"
             xmlns:controls="clr-namespace:NPLogic.Controls;assembly=NPLogic.UI"
             mc:Ignorable="d" 
             d:DesignHeight="900" d:DesignWidth="1400"
             Loaded="RegistryTab_Loaded">
    
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <Grid Margin="24">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            
            <!-- ========== 메시지 영역 ========== -->
            <StackPanel Grid.Row="0" Margin="0,0,0,16">
                <!-- 에러 메시지 -->
                <Border Background="{StaticResource ErrorBrush}"
                        CornerRadius="4"
                        Padding="12"
                        Margin="0,0,0,8"
                        Visibility="{Binding RegistryViewModel.ErrorMessage, Converter={StaticResource NullToVisibilityConverter}}">
                    <TextBlock Text="{Binding RegistryViewModel.ErrorMessage}" 
                              Foreground="White"
                              TextWrapping="Wrap"/>
                </Border>

                <!-- 성공 메시지 -->
                <Border Background="{StaticResource SuccessBrush}"
                        CornerRadius="4"
                        Padding="12"
                        Visibility="{Binding RegistryViewModel.SuccessMessage, Converter={StaticResource NullToVisibilityConverter}}">
                    <TextBlock Text="{Binding RegistryViewModel.SuccessMessage}" 
                              Foreground="White"
                              TextWrapping="Wrap"/>
                </Border>
            </StackPanel>
            
            <!-- ========== OCR 업로드 섹션 ========== -->
            <Border Grid.Row="1" 
                    Background="{StaticResource BackgroundBrush}"
                    CornerRadius="8"
                    Padding="20"
                    Margin="0,0,0,16">
                <Border.Effect>
                    <DropShadowEffect Color="Black" Opacity="0.1" BlurRadius="10" ShadowDepth="2"/>
                </Border.Effect>
                
                <controls:NPExpandableSection Header="📄 등기부등본 OCR 업로드" IsExpanded="True">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        
                        <!-- 서버 상태 & 파일 선택 -->
                        <Grid Grid.Row="0" Margin="0,0,0,16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            
                            <!-- 서버 상태 -->
                            <Border Grid.Column="0"
                                    CornerRadius="4"
                                    Padding="10,6"
                                    Margin="0,0,12,0">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Background" Value="{StaticResource BlueGray200Brush}"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding RegistryViewModel.IsOcrServerReady}" Value="True">
                                                <Setter Property="Background" Value="{StaticResource SuccessBrush}"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <TextBlock Text="{Binding RegistryViewModel.OcrServerStatus}" FontSize="{StaticResource FontSizeBody}">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding RegistryViewModel.IsOcrServerReady}" Value="True">
                                                    <Setter Property="Foreground" Value="White"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </Border>
                            
                            <!-- 파일 선택 버튼 -->
                            <StackPanel Grid.Column="2" Orientation="Horizontal">
                                <Button Content="📂 PDF 선택"
                                        Command="{Binding RegistryViewModel.SelectOcrPdfFilesCommand}"
                                        Style="{StaticResource PrimaryButton}"
                                        Padding="16,8"
                                        FontSize="{StaticResource FontSizeBody}"
                                        IsEnabled="{Binding RegistryViewModel.IsOcrServerReady}"/>
                            </StackPanel>
                        </Grid>
                        
                        <!-- 선택된 파일 목록 -->
                        <Border Grid.Row="1"
                                Background="{StaticResource BlueGray50Brush}"
                                CornerRadius="6"
                                Padding="12"
                                Margin="0,0,0,12"
                                MinHeight="80"
                                MaxHeight="200"
                                Visibility="{Binding RegistryViewModel.HasOcrPdfFiles, Converter={StaticResource BoolToVisibilityConverter}}">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>
                                
                                <Grid Grid.Row="0" Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="선택된 파일" FontWeight="SemiBold" FontSize="{StaticResource FontSizeBody}"/>
                                    <Button Grid.Column="1"
                                            Content="✕ 전체 취소"
                                            Command="{Binding RegistryViewModel.CancelAllOcrPdfFilesCommand}"
                                            Background="Transparent"
                                            BorderThickness="0"
                                            Foreground="{StaticResource TextSecondaryBrush}"
                                            FontSize="{StaticResource FontSizeSmall}"
                                            Padding="4,2"
                                            Cursor="Hand"/>
                                </Grid>
                                
                                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" MaxHeight="150">
                                    <ItemsControl ItemsSource="{Binding RegistryViewModel.OcrPdfFiles}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Background="White"
                                                        CornerRadius="4"
                                                        Padding="10,8"
                                                        Margin="0,0,0,6">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="Auto"/>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                        </Grid.ColumnDefinitions>
                                                        
                                                        <TextBlock Text="📄" FontSize="{StaticResource FontSizeH3}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                                        
                                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                            <TextBlock Text="{Binding FileName}" 
                                                                       FontSize="{StaticResource FontSizeBody}"
                                                                       TextTrimming="CharacterEllipsis"/>
                                                            <TextBlock Text="{Binding FileSizeFormatted}" 
                                                                       FontSize="{StaticResource FontSizeTiny}"
                                                                       Opacity="0.6"/>
                                                        </StackPanel>
                                                        
                                                        <Border Grid.Column="2"
                                                                CornerRadius="4"
                                                                Padding="8,3"
                                                                Margin="8,0"
                                                                VerticalAlignment="Center">
                                                            <Border.Style>
                                                                <Style TargetType="Border">
                                                                    <Setter Property="Background" Value="{StaticResource BlueGray200Brush}"/>
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding Status}" Value="완료">
                                                                            <Setter Property="Background" Value="{StaticResource SuccessBrush}"/>
                                                                        </DataTrigger>
                                                                        <DataTrigger Binding="{Binding Status}" Value="처리 중">
                                                                            <Setter Property="Background" Value="{StaticResource InfoBrush}"/>
                                                                        </DataTrigger>
                                                                        <DataTrigger Binding="{Binding Status}" Value="실패">
                                                                            <Setter Property="Background" Value="{StaticResource ErrorBrush}"/>
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </Border.Style>
                                                            <TextBlock Text="{Binding Status}" FontSize="{StaticResource FontSizeTiny}">
                                                                <TextBlock.Style>
                                                                    <Style TargetType="TextBlock">
                                                                        <Style.Triggers>
                                                                            <DataTrigger Binding="{Binding Status}" Value="완료">
                                                                                <Setter Property="Foreground" Value="White"/>
                                                                            </DataTrigger>
                                                                            <DataTrigger Binding="{Binding Status}" Value="처리 중">
                                                                                <Setter Property="Foreground" Value="White"/>
                                                                            </DataTrigger>
                                                                            <DataTrigger Binding="{Binding Status}" Value="실패">
                                                                                <Setter Property="Foreground" Value="White"/>
                                                                            </DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </TextBlock.Style>
                                                            </TextBlock>
                                                        </Border>
                                                        
                                                        <Button Grid.Column="3"
                                                                Content="✕"
                                                                Command="{Binding DataContext.RegistryViewModel.RemoveOcrPdfFileCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                CommandParameter="{Binding}"
                                                                Background="Transparent"
                                                                BorderThickness="0"
                                                                Foreground="{StaticResource TextSecondaryBrush}"
                                                                Padding="6,2"
                                                                FontSize="{StaticResource FontSizeBody}"
                                                                Cursor="Hand"/>
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>
                            </Grid>
                        </Border>
                        
                        <!-- 빈 상태 메시지 -->
                        <Border Grid.Row="1"
                                Background="{StaticResource BlueGray50Brush}"
                                CornerRadius="6"
                                Padding="24"
                                Visibility="{Binding RegistryViewModel.HasOcrPdfFiles, Converter={StaticResource InverseBooleanToVisibilityConverter}}">
                            <StackPanel HorizontalAlignment="Center">
                                <TextBlock Text="📄" FontSize="{StaticResource FontSizeXXLarge}" HorizontalAlignment="Center" Margin="0,0,0,8"/>
                                <TextBlock Text="등기부등본 PDF 파일을 선택하세요" 
                                           Style="{StaticResource CaptionTextStyle}"
                                           HorizontalAlignment="Center"
                                           Opacity="0.7"/>
                                <TextBlock Text="Clova OCR을 통해 소유자, 갑구, 을구 정보를 자동 추출합니다" 
                                           Style="{StaticResource CaptionTextStyle}"
                                           HorizontalAlignment="Center"
                                           Opacity="0.5"
                                           FontSize="{StaticResource FontSizeSmall}"/>
                            </StackPanel>
                        </Border>
                        
                        <!-- 진행률 & 버튼 -->
                        <Grid Grid.Row="2" Margin="0,12,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            
                            <!-- 진행률 -->
                            <StackPanel Grid.Column="0" VerticalAlignment="Center"
                                        Visibility="{Binding RegistryViewModel.IsOcrProcessing, Converter={StaticResource BoolToVisibilityConverter}}">
                                <ProgressBar Value="{Binding RegistryViewModel.OcrProgressPercent}" 
                                             Maximum="100"
                                             Height="6"
                                             Foreground="{StaticResource PrimaryBrush}"
                                             Margin="0,0,16,4"/>
                                <TextBlock Text="{Binding RegistryViewModel.OcrStatusMessage}" 
                                           Style="{StaticResource CaptionTextStyle}"
                                           Opacity="0.7"
                                           Margin="0,0,16,0"/>
                            </StackPanel>
                            
                            <!-- 버튼 -->
                            <StackPanel Grid.Column="1" Orientation="Horizontal">
                                <!-- 취소 버튼 -->
                                <Button Content="취소"
                                        Command="{Binding RegistryViewModel.CancelOcrProcessingCommand}"
                                        Style="{StaticResource SecondaryButton}"
                                        Padding="16,8"
                                        FontSize="{StaticResource FontSizeBody}"
                                        Margin="0,0,8,0"
                                        Visibility="{Binding RegistryViewModel.IsOcrProcessing, Converter={StaticResource BoolToVisibilityConverter}}"/>
                                
                                <!-- OCR 시작 버튼 -->
                                <Button Content="🔍 OCR 처리 시작"
                                        Command="{Binding RegistryViewModel.StartOcrProcessingCommand}"
                                        Style="{StaticResource PrimaryButton}"
                                        Padding="20,8"
                                        FontSize="{StaticResource FontSizeBody}"
                                        Visibility="{Binding RegistryViewModel.IsOcrProcessing, Converter={StaticResource InverseBooleanToVisibilityConverter}}"
                                        IsEnabled="{Binding RegistryViewModel.HasOcrPdfFiles}"/>
                            </StackPanel>
                        </Grid>
                        
                        <!-- 등기부등본 요약 이미지 표시 (여러 페이지 지원) -->
                        <Border Grid.Row="3"
                                Background="White"
                                BorderBrush="{StaticResource PrimaryBrush}"
                                BorderThickness="1"
                                CornerRadius="6"
                                Padding="16"
                                Margin="0,16,0,0"
                                Visibility="{Binding RegistryViewModel.HasSummaryImage, Converter={StaticResource BoolToVisibilityConverter}}">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                                    <TextBlock Text="📄 주요 등기사항 요약"
                                               FontWeight="SemiBold"
                                               FontSize="{StaticResource FontSizeH4}"/>
                                    <Border Background="{StaticResource PrimaryBrush}"
                                            CornerRadius="10"
                                            Padding="8,2"
                                            Margin="8,0,0,0"
                                            VerticalAlignment="Center">
                                        <TextBlock Foreground="White" FontSize="{StaticResource FontSizeSmall}">
                                            <Run Text="{Binding RegistryViewModel.SummaryImageCount, Mode=OneWay}"/>
                                            <Run Text="페이지"/>
                                        </TextBlock>
                                    </Border>
                                </StackPanel>

                                <!-- 여러 이미지 표시 영역 (스크롤 가능) -->
                                <ScrollViewer HorizontalScrollBarVisibility="Auto"
                                              VerticalScrollBarVisibility="Auto"
                                              MaxHeight="800">
                                    <ItemsControl ItemsSource="{Binding RegistryViewModel.SummaryImages}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Background="{StaticResource BlueGray50Brush}"
                                                        CornerRadius="4"
                                                        Padding="8"
                                                        Margin="0,0,0,12">
                                                    <StackPanel>
                                                        <Image Source="{Binding}"
                                                               Stretch="Uniform"
                                                               MaxWidth="800"
                                                               RenderOptions.BitmapScalingMode="HighQuality"/>
                                                    </StackPanel>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>
                            </StackPanel>
                        </Border>

                        <!-- OCR 결과 미리보기 -->
                        <Border Grid.Row="4"
                                Background="{StaticResource InfoBgBrush}"
                                BorderBrush="{StaticResource InfoBrush}"
                                BorderThickness="1"
                                CornerRadius="6"
                                Padding="16"
                                Margin="0,16,0,0"
                                Visibility="{Binding RegistryViewModel.HasOcrResults, Converter={StaticResource BoolToVisibilityConverter}}">
                            <StackPanel>
                                <Grid Margin="0,0,0,12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <StackPanel>
                                        <TextBlock Text="📋 OCR 추출 결과" FontWeight="SemiBold" FontSize="{StaticResource FontSizeH4}"/>
                                        <TextBlock Text="{Binding RegistryViewModel.OcrExtractedAddress}"
                                                   Style="{StaticResource CaptionTextStyle}"
                                                   Opacity="0.8"
                                                   Margin="0,4,0,0"
                                                   Visibility="{Binding RegistryViewModel.OcrExtractedAddress, Converter={StaticResource NullToVisibilityConverter}}"/>
                                    </StackPanel>

                                    <Button Grid.Column="1"
                                            Content="💾 결과 저장"
                                            Command="{Binding RegistryViewModel.SaveOcrResultsCommand}"
                                            Style="{StaticResource PrimaryButton}"
                                            Padding="16,8"
                                            FontSize="{StaticResource FontSizeBody}"/>
                                </Grid>

                                <!-- 요약 정보 -->
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                    <Border Background="{StaticResource BlueGray200Brush}" CornerRadius="4" Padding="8,4" Margin="0,0,8,0">
                                        <TextBlock FontSize="{StaticResource FontSizeSmall}">
                                            <Run Text="소유자"/>
                                            <Run Text="{Binding RegistryViewModel.OcrPreviewOwners.Count, Mode=OneWay}" FontWeight="Bold"/>
                                            <Run Text="건"/>
                                        </TextBlock>
                                    </Border>
                                    <Border Background="{StaticResource BlueGray200Brush}" CornerRadius="4" Padding="8,4" Margin="0,0,8,0">
                                        <TextBlock FontSize="{StaticResource FontSizeSmall}">
                                            <Run Text="갑구"/>
                                            <Run Text="{Binding RegistryViewModel.OcrPreviewGapgu.Count, Mode=OneWay}" FontWeight="Bold"/>
                                            <Run Text="건"/>
                                        </TextBlock>
                                    </Border>
                                    <Border Background="{StaticResource BlueGray200Brush}" CornerRadius="4" Padding="8,4">
                                        <TextBlock FontSize="{StaticResource FontSizeSmall}">
                                            <Run Text="을구"/>
                                            <Run Text="{Binding RegistryViewModel.OcrPreviewEulgu.Count, Mode=OneWay}" FontWeight="Bold"/>
                                            <Run Text="건"/>
                                        </TextBlock>
                                    </Border>
                                </StackPanel>

                                <TextBlock Text="※ '결과 저장' 버튼을 클릭하면 담보물건 탭에서 확인하실 수 있습니다."
                                           Style="{StaticResource CaptionTextStyle}"
                                           Opacity="0.6"
                                           FontSize="{StaticResource FontSizeSmall}"/>
                            </StackPanel>
                        </Border>
                    </Grid>
                </controls:NPExpandableSection>
            </Border>
            
            <!-- 안내 문구 -->
            <Border Grid.Row="2" 
                    Background="{StaticResource InfoBgBrush}"
                    BorderBrush="{StaticResource InfoBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="16"
                    Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Text="ℹ️ 안내" FontWeight="SemiBold" FontSize="{StaticResource FontSizeBody}" Margin="0,0,0,8"/>
                    <TextBlock Text="• 등기부등본 탭에서는 PDF 업로드만 진행하시면 됩니다." 
                               Style="{StaticResource BodyTextStyle}"
                               Margin="0,0,0,4"/>
                    <TextBlock Text="• 각 물건별 세부 정보 (소유자, 갑구, 을구)는 담보물건 탭에서 확인하실 수 있습니다." 
                               Style="{StaticResource BodyTextStyle}"/>
                </StackPanel>
            </Border>
            
            <!-- 로딩 오버레이 -->
            <Border Grid.Row="0" Grid.RowSpan="3"
                    Background="#80FFFFFF"
                    Visibility="{Binding RegistryViewModel.IsLoading, Converter={StaticResource BoolToVisibilityConverter}}">
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                    <ProgressBar IsIndeterminate="True" Width="200" Height="4"/>
                    <TextBlock Text="로딩 중..."
                               Margin="0,12,0,0"
                               Style="{StaticResource BodyTextStyle}"
                               HorizontalAlignment="Center"/>
                </StackPanel>
            </Border>

            <!-- OCR 처리 중 오버레이 (더 눈에 띄는 표시) -->
            <Border Grid.Row="0" Grid.RowSpan="3"
                    Background="#CC000000"
                    Visibility="{Binding RegistryViewModel.IsOcrProcessing, Converter={StaticResource BoolToVisibilityConverter}}">
                <Border Background="White"
                        CornerRadius="12"
                        Padding="32,24"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        MinWidth="400">
                    <Border.Effect>
                        <DropShadowEffect Color="Black" Opacity="0.3" BlurRadius="20" ShadowDepth="5"/>
                    </Border.Effect>
                    <StackPanel>
                        <!-- 제목 -->
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,16">
                            <TextBlock Text="🔍" FontSize="24" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <TextBlock Text="OCR 처리 중..."
                                       FontSize="{StaticResource FontSizeH3}"
                                       FontWeight="SemiBold"
                                       VerticalAlignment="Center"/>
                        </StackPanel>

                        <!-- 현재 처리 파일명 -->
                        <TextBlock Text="{Binding RegistryViewModel.OcrStatusMessage}"
                                   FontSize="{StaticResource FontSizeBody}"
                                   Foreground="{StaticResource TextSecondaryBrush}"
                                   HorizontalAlignment="Center"
                                   TextWrapping="Wrap"
                                   MaxWidth="350"
                                   Margin="0,0,0,16"/>

                        <!-- 진행률 바 -->
                        <Grid Margin="0,0,0,8">
                            <ProgressBar Value="{Binding RegistryViewModel.OcrProgressPercent}"
                                         Maximum="100"
                                         Height="12"
                                         Foreground="{StaticResource PrimaryBrush}"
                                         Background="{StaticResource BlueGray100Brush}"/>
                        </Grid>

                        <!-- 진행률 텍스트 -->
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,16">
                            <TextBlock FontSize="{StaticResource FontSizeBody}">
                                <Run Text="{Binding RegistryViewModel.OcrCompletedCount, Mode=OneWay}"/>
                                <Run Text="/"/>
                                <Run Text="{Binding RegistryViewModel.OcrTotalCount, Mode=OneWay}"/>
                                <Run Text="파일 완료"/>
                            </TextBlock>
                            <TextBlock Text=" (" Foreground="{StaticResource TextSecondaryBrush}"/>
                            <TextBlock Text="{Binding RegistryViewModel.OcrProgressPercent}" FontWeight="Bold" Foreground="{StaticResource PrimaryBrush}"/>
                            <TextBlock Text="%)" Foreground="{StaticResource TextSecondaryBrush}"/>
                        </StackPanel>

                        <!-- 취소 버튼 -->
                        <Button Content="취소"
                                Command="{Binding RegistryViewModel.CancelOcrProcessingCommand}"
                                Style="{StaticResource SecondaryButton}"
                                HorizontalAlignment="Center"
                                Padding="24,8"
                                FontSize="{StaticResource FontSizeBody}"/>

                        <!-- 안내 문구 -->
                        <TextBlock Text="Clova OCR로 등기부등본 정보를 추출하고 있습니다."
                                   FontSize="{StaticResource FontSizeSmall}"
                                   Foreground="{StaticResource TextSecondaryBrush}"
                                   HorizontalAlignment="Center"
                                   Margin="0,16,0,0"/>
                    </StackPanel>
                </Border>
            </Border>
        </Grid>
    </ScrollViewer>
</UserControl>

