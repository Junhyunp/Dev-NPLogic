<UserControl x:Class="NPLogic.Views.BasicDataTab"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:controls="clr-namespace:NPLogic.Controls;assembly=NPLogic.UI"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             mc:Ignorable="d"
             d:DesignHeight="900" d:DesignWidth="1400"
             Loaded="BasicDataTab_Loaded">
    
    <!-- 
    ============================================================
    프로그램(Pool) 수준 기초데이터 화면
    - 프로그램정보관리, Data Disk 정보관리, 기초정보관리
    - QA, 고유정보관리, 사용인 설정, Assign
    ============================================================
    -->
    
    <Grid Background="{StaticResource BackgroundBrush}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>

        <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <Grid Margin="24">
                <!-- 2열 그리드 레이아웃: 좌측 넓은 영역 + 우측 사이드 영역 -->
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2*"/>
                    <ColumnDefinition Width="24"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                
                <!-- ========== 좌측 영역 ========== -->
                <StackPanel Grid.Column="0">
                    
                    <!-- ========== 섹션 1: 프로그램정보관리 ========== -->
                    <Border Background="{StaticResource BackgroundBrush}"
                            CornerRadius="8"
                            Padding="20"
                            Margin="0,0,0,16">
                        <Border.Effect>
                            <DropShadowEffect Color="Black" Opacity="0.08" BlurRadius="8" ShadowDepth="2"/>
                        </Border.Effect>
                        
                        <StackPanel>
                            <!-- 섹션 헤더 -->
                            <Grid Margin="0,0,0,16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                
                                <StackPanel Grid.Column="0" Orientation="Horizontal">
                                    <TextBlock Text="📋 프로그램정보관리" 
                                               Style="{StaticResource H4TextStyle}"
                                               FontWeight="Bold"/>
                                </StackPanel>
                                
                                <!-- 업데이트 정보 -->
                                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding ProgramInfoUpdatedAt, StringFormat='업데이트: {0:yyyy-MM-dd}', FallbackValue='-'}" 
                                               Style="{StaticResource CaptionTextStyle}"
                                               Foreground="{StaticResource TextMutedBrush}"
                                               Margin="0,0,8,0"/>
                                    <TextBlock Text="{Binding ProgramInfoUpdatedBy, FallbackValue=''}" 
                                               Style="{StaticResource CaptionTextStyle}"
                                               Foreground="{StaticResource TextMutedBrush}"/>
                                </StackPanel>
                            </Grid>
                            
                            <!-- 프로그램 정보 필드들 -->
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="16"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="16"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="16"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="16"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                
                                <!-- Row 0 -->
                                <StackPanel Grid.Row="0" Grid.Column="0">
                                    <TextBlock Text="프로그램명" Style="{StaticResource CaptionTextStyle}" FontWeight="SemiBold" Margin="0,0,0,4"/>
                                    <TextBox Text="{Binding Program.ProgramName, UpdateSourceTrigger=PropertyChanged}" 
                                             Padding="8,6" IsReadOnly="True" Background="{StaticResource BlueGray50Brush}"/>
                                </StackPanel>
                                
                                <StackPanel Grid.Row="0" Grid.Column="2">
                                    <TextBlock Text="은행명" Style="{StaticResource CaptionTextStyle}" FontWeight="SemiBold" Margin="0,0,0,4"/>
                                    <TextBox Text="{Binding Program.BankName, UpdateSourceTrigger=PropertyChanged}" 
                                             Padding="8,6" IsReadOnly="True" Background="{StaticResource BlueGray50Brush}"/>
                                </StackPanel>
                                
                                <StackPanel Grid.Row="0" Grid.Column="4">
                                    <TextBlock Text="Pool" Style="{StaticResource CaptionTextStyle}" FontWeight="SemiBold" Margin="0,0,0,4"/>
                                    <TextBox Text="{Binding Program.Pool, UpdateSourceTrigger=PropertyChanged}" 
                                             Padding="8,6" IsReadOnly="True" Background="{StaticResource BlueGray50Brush}"/>
                                </StackPanel>
                                
                                <StackPanel Grid.Row="0" Grid.Column="6">
                                    <TextBlock Text="Cut-off Date (cdate)" Style="{StaticResource CaptionTextStyle}" FontWeight="SemiBold" Margin="0,0,0,4"/>
                                    <TextBox Text="{Binding Program.CutOffDate, StringFormat=yyyy-MM-dd, UpdateSourceTrigger=PropertyChanged}" 
                                             Padding="8,6" IsReadOnly="True" Background="{StaticResource BlueGray50Brush}"/>
                                </StackPanel>
                                
                                <!-- Row 2 -->
                                <StackPanel Grid.Row="2" Grid.Column="0">
                                    <TextBlock Text="적용환율 (1 USD)" Style="{StaticResource CaptionTextStyle}" FontWeight="SemiBold" Margin="0,0,0,4"/>
                                    <TextBox Text="{Binding Program.ExchangeRateUsd, StringFormat=N2, UpdateSourceTrigger=PropertyChanged}" 
                                             Padding="8,6" IsReadOnly="True" Background="{StaticResource BlueGray50Brush}"/>
                                </StackPanel>
                                
                                <StackPanel Grid.Row="2" Grid.Column="2">
                                    <TextBlock Text="적용환율 (1 JPY)" Style="{StaticResource CaptionTextStyle}" FontWeight="SemiBold" Margin="0,0,0,4"/>
                                    <TextBox Text="{Binding Program.ExchangeRateJpy, StringFormat=N4, UpdateSourceTrigger=PropertyChanged}" 
                                             Padding="8,6" IsReadOnly="True" Background="{StaticResource BlueGray50Brush}"/>
                                </StackPanel>
                                
                                <StackPanel Grid.Row="2" Grid.Column="4">
                                    <TextBlock Text="Action Date (adate)" Style="{StaticResource CaptionTextStyle}" FontWeight="SemiBold" Margin="0,0,0,4"/>
                                    <TextBox Text="{Binding Program.ActionDate, StringFormat=yyyy-MM-dd, UpdateSourceTrigger=PropertyChanged}" 
                                             Padding="8,6" IsReadOnly="True" Background="{StaticResource BlueGray50Brush}"/>
                                </StackPanel>
                                
                                <StackPanel Grid.Row="2" Grid.Column="6">
                                    <TextBlock Text="입찰일" Style="{StaticResource CaptionTextStyle}" FontWeight="SemiBold" Margin="0,0,0,4"/>
                                    <TextBox Text="{Binding Program.BidDate, StringFormat=yyyy-MM-dd, UpdateSourceTrigger=PropertyChanged}" 
                                             Padding="8,6" IsReadOnly="True" Background="{StaticResource BlueGray50Brush}"/>
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </Border>
                    
                    <!-- ========== 섹션 2: Data Disk 정보관리 ========== -->
                    <Border Background="{StaticResource BackgroundBrush}"
                            CornerRadius="8"
                            Padding="20"
                            Margin="0,0,0,16">
                        <Border.Effect>
                            <DropShadowEffect Color="Black" Opacity="0.08" BlurRadius="8" ShadowDepth="2"/>
                        </Border.Effect>
                        
                        <StackPanel>
                            <!-- 섹션 헤더 -->
                            <Grid Margin="0,0,0,16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                
                                <StackPanel Grid.Column="0" Orientation="Horizontal">
                                    <TextBlock Text="📁 Data Disk 정보관리" 
                                               Style="{StaticResource H4TextStyle}"
                                               FontWeight="Bold"/>
                                </StackPanel>
                                
                                <!-- 업데이트 정보 -->
                                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding DataDiskUpdatedAt, StringFormat='업데이트: {0:yyyy-MM-dd}', FallbackValue='-'}" 
                                               Style="{StaticResource CaptionTextStyle}"
                                               Foreground="{StaticResource TextMutedBrush}"
                                               Margin="0,0,8,0"/>
                                    <TextBlock Text="{Binding DataDiskUpdatedBy, FallbackValue=''}" 
                                               Style="{StaticResource CaptionTextStyle}"
                                               Foreground="{StaticResource TextMutedBrush}"/>
                                </StackPanel>
                            </Grid>
                            
                            <!-- 시트 목록 -->
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="16"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                
                                <!-- 좌측 시트들 -->
                                <StackPanel Grid.Column="0">
                                    <!-- Sheet A -->
                                    <Border Background="{StaticResource BlueGray50Brush}" CornerRadius="4" Padding="12,8" Margin="0,0,0,8">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0">
                                                <TextBlock Text="Sheet A (차주일반정보)" FontWeight="SemiBold" FontSize="{StaticResource FontSizeBody}"/>
                                                <TextBlock Text="{Binding SheetAUploadedAt, StringFormat='업로드: {0:yyyy-MM-dd}', FallbackValue='미등록'}" 
                                                           FontSize="{StaticResource FontSizeTiny}" Foreground="{StaticResource TextMutedBrush}"/>
                                            </StackPanel>
                                            <TextBlock Grid.Column="1" Text="{Binding SheetARowCount, StringFormat={}{0}행, FallbackValue=''}" 
                                                       FontSize="{StaticResource FontSizeTiny}" Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center" Margin="8,0"/>
                                            <Button Grid.Column="2" Content="업로드" Style="{StaticResource SecondaryButton}" Padding="8,4" FontSize="{StaticResource FontSizeTiny}"/>
                                        </Grid>
                                    </Border>
                                    
                                    <!-- Sheet A-1 -->
                                    <Border Background="{StaticResource BlueGray50Brush}" CornerRadius="4" Padding="12,8" Margin="0,0,0,8">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0">
                                                <TextBlock Text="Sheet A-1 (회생차주정보)" FontWeight="SemiBold" FontSize="{StaticResource FontSizeBody}"/>
                                                <TextBlock Text="{Binding SheetA1UploadedAt, StringFormat='업로드: {0:yyyy-MM-dd}', FallbackValue='미등록'}" 
                                                           FontSize="{StaticResource FontSizeTiny}" Foreground="{StaticResource TextMutedBrush}"/>
                                            </StackPanel>
                                            <TextBlock Grid.Column="1" Text="{Binding SheetA1RowCount, StringFormat={}{0}행, FallbackValue=''}" 
                                                       FontSize="{StaticResource FontSizeTiny}" Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center" Margin="8,0"/>
                                            <Button Grid.Column="2" Content="업로드" Style="{StaticResource SecondaryButton}" Padding="8,4" FontSize="{StaticResource FontSizeTiny}"/>
                                        </Grid>
                                    </Border>
                                    
                                    <!-- Sheet B -->
                                    <Border Background="{StaticResource BlueGray50Brush}" CornerRadius="4" Padding="12,8" Margin="0,0,0,8">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0">
                                                <TextBlock Text="Sheet B (채권일반정보)" FontWeight="SemiBold" FontSize="{StaticResource FontSizeBody}"/>
                                                <TextBlock Text="{Binding SheetBUploadedAt, StringFormat='업로드: {0:yyyy-MM-dd}', FallbackValue='미등록'}" 
                                                           FontSize="{StaticResource FontSizeTiny}" Foreground="{StaticResource TextMutedBrush}"/>
                                            </StackPanel>
                                            <TextBlock Grid.Column="1" Text="{Binding SheetBRowCount, StringFormat={}{0}행, FallbackValue=''}" 
                                                       FontSize="{StaticResource FontSizeTiny}" Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center" Margin="8,0"/>
                                            <Button Grid.Column="2" Content="업로드" Style="{StaticResource SecondaryButton}" Padding="8,4" FontSize="{StaticResource FontSizeTiny}"/>
                                        </Grid>
                                    </Border>
                                    
                                    <!-- Sheet C-1 -->
                                    <Border Background="{StaticResource BlueGray50Brush}" CornerRadius="4" Padding="12,8" Margin="0,0,0,8">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0">
                                                <TextBlock Text="Sheet C-1 (물건정보)" FontWeight="SemiBold" FontSize="{StaticResource FontSizeBody}"/>
                                                <TextBlock Text="{Binding SheetC1UploadedAt, StringFormat='업로드: {0:yyyy-MM-dd}', FallbackValue='미등록'}" 
                                                           FontSize="{StaticResource FontSizeTiny}" Foreground="{StaticResource TextMutedBrush}"/>
                                            </StackPanel>
                                            <TextBlock Grid.Column="1" Text="{Binding SheetC1RowCount, StringFormat={}{0}행, FallbackValue=''}" 
                                                       FontSize="{StaticResource FontSizeTiny}" Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center" Margin="8,0"/>
                                            <Button Grid.Column="2" Content="업로드" Style="{StaticResource SecondaryButton}" Padding="8,4" FontSize="{StaticResource FontSizeTiny}"/>
                                        </Grid>
                                    </Border>
                                    
                                    <!-- Sheet C-2 -->
                                    <Border Background="{StaticResource BlueGray50Brush}" CornerRadius="4" Padding="12,8" Margin="0,0,0,8">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0">
                                                <TextBlock Text="Sheet C-2 (등기부등본정보)" FontWeight="SemiBold" FontSize="{StaticResource FontSizeBody}"/>
                                                <TextBlock Text="{Binding SheetC2UploadedAt, StringFormat='업로드: {0:yyyy-MM-dd}', FallbackValue='미등록'}" 
                                                           FontSize="{StaticResource FontSizeTiny}" Foreground="{StaticResource TextMutedBrush}"/>
                                            </StackPanel>
                                            <TextBlock Grid.Column="1" Text="{Binding SheetC2RowCount, StringFormat={}{0}행, FallbackValue=''}" 
                                                       FontSize="{StaticResource FontSizeTiny}" Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center" Margin="8,0"/>
                                            <Button Grid.Column="2" Content="업로드" Style="{StaticResource SecondaryButton}" Padding="8,4" FontSize="{StaticResource FontSizeTiny}"/>
                                        </Grid>
                                    </Border>
                                </StackPanel>
                                
                                <!-- 우측 시트들 -->
                                <StackPanel Grid.Column="2">
                                    <!-- Sheet C-3 -->
                                    <Border Background="{StaticResource BlueGray50Brush}" CornerRadius="4" Padding="12,8" Margin="0,0,0,8">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0">
                                                <TextBlock Text="Sheet C-3 (설정순위)" FontWeight="SemiBold" FontSize="{StaticResource FontSizeBody}"/>
                                                <TextBlock Text="{Binding SheetC3UploadedAt, StringFormat='업로드: {0:yyyy-MM-dd}', FallbackValue='미등록'}" 
                                                           FontSize="{StaticResource FontSizeTiny}" Foreground="{StaticResource TextMutedBrush}"/>
                                            </StackPanel>
                                            <TextBlock Grid.Column="1" Text="{Binding SheetC3RowCount, StringFormat={}{0}행, FallbackValue=''}" 
                                                       FontSize="{StaticResource FontSizeTiny}" Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center" Margin="8,0"/>
                                            <Button Grid.Column="2" Content="업로드" Style="{StaticResource SecondaryButton}" Padding="8,4" FontSize="{StaticResource FontSizeTiny}"/>
                                        </Grid>
                                    </Border>
                                    
                                    <!-- Sheet D -->
                                    <Border Background="{StaticResource BlueGray50Brush}" CornerRadius="4" Padding="12,8" Margin="0,0,0,8">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0">
                                                <TextBlock Text="Sheet D (신용보증서)" FontWeight="SemiBold" FontSize="{StaticResource FontSizeBody}"/>
                                                <TextBlock Text="{Binding SheetDUploadedAt, StringFormat='업로드: {0:yyyy-MM-dd}', FallbackValue='미등록'}" 
                                                           FontSize="{StaticResource FontSizeTiny}" Foreground="{StaticResource TextMutedBrush}"/>
                                            </StackPanel>
                                            <TextBlock Grid.Column="1" Text="{Binding SheetDRowCount, StringFormat={}{0}행, FallbackValue=''}" 
                                                       FontSize="{StaticResource FontSizeTiny}" Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center" Margin="8,0"/>
                                            <Button Grid.Column="2" Content="업로드" Style="{StaticResource SecondaryButton}" Padding="8,4" FontSize="{StaticResource FontSizeTiny}"/>
                                        </Grid>
                                    </Border>
                                    
                                    <!-- Sheet E -->
                                    <Border Background="{StaticResource BlueGray50Brush}" CornerRadius="4" Padding="12,8" Margin="0,0,0,8">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0">
                                                <TextBlock Text="Sheet E (가압류)" FontWeight="SemiBold" FontSize="{StaticResource FontSizeBody}"/>
                                                <TextBlock Text="{Binding SheetEUploadedAt, StringFormat='업로드: {0:yyyy-MM-dd}', FallbackValue='미등록'}" 
                                                           FontSize="{StaticResource FontSizeTiny}" Foreground="{StaticResource TextMutedBrush}"/>
                                            </StackPanel>
                                            <TextBlock Grid.Column="1" Text="{Binding SheetERowCount, StringFormat={}{0}행, FallbackValue=''}" 
                                                       FontSize="{StaticResource FontSizeTiny}" Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center" Margin="8,0"/>
                                            <Button Grid.Column="2" Content="업로드" Style="{StaticResource SecondaryButton}" Padding="8,4" FontSize="{StaticResource FontSizeTiny}"/>
                                        </Grid>
                                    </Border>
                                    
                                    <!-- Interim 입력 -->
                                    <Border Background="{StaticResource InfoBrush}" CornerRadius="4" Padding="12,8" Margin="0,0,0,8">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0">
                                                <TextBlock Text="Interim 입력" FontWeight="SemiBold" FontSize="{StaticResource FontSizeBody}" Foreground="White"/>
                                                <TextBlock Text="{Binding InterimUploadedAt, StringFormat='업로드: {0:yyyy-MM-dd}', FallbackValue='미등록'}" 
                                                           FontSize="{StaticResource FontSizeTiny}" Foreground="#B0FFFFFF"/>
                                            </StackPanel>
                                            <Button Grid.Column="2" Content="업로드" Style="{StaticResource PrimaryButton}" 
                                                    Background="White" Foreground="{StaticResource InfoBrush}"
                                                    Padding="8,4" FontSize="{StaticResource FontSizeTiny}"/>
                                        </Grid>
                                    </Border>
                                    
                                    <!-- 안내 문구 -->
                                    <TextBlock Text="*1. 엑셀을 업로드하는 방식" 
                                               Style="{StaticResource CaptionTextStyle}"
                                               Foreground="{StaticResource TextMutedBrush}"
                                               Margin="0,8,0,0"/>
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </Border>
                    
                    <!-- ========== 섹션 3: 기초정보관리 ========== -->
                    <Border Background="{StaticResource BackgroundBrush}"
                            CornerRadius="8"
                            Padding="20"
                            Margin="0,0,0,16">
                        <Border.Effect>
                            <DropShadowEffect Color="Black" Opacity="0.08" BlurRadius="8" ShadowDepth="2"/>
                        </Border.Effect>
                        
                        <StackPanel>
                            <!-- 섹션 헤더 -->
                            <Grid Margin="0,0,0,16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                
                                <TextBlock Grid.Column="0" Text="⚙️ 기초정보관리" 
                                           Style="{StaticResource H4TextStyle}"
                                           FontWeight="Bold"/>
                                
                                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,16,0">
                                    <TextBlock Text="{Binding BasicInfoUpdatedAt, StringFormat='업데이트: {0:yyyy-MM-dd}', FallbackValue='-'}" 
                                               Style="{StaticResource CaptionTextStyle}"
                                               Foreground="{StaticResource TextMutedBrush}"
                                               Margin="0,0,8,0"/>
                                    <TextBlock Text="{Binding BasicInfoUpdatedBy, FallbackValue=''}" 
                                               Style="{StaticResource CaptionTextStyle}"
                                               Foreground="{StaticResource TextMutedBrush}"/>
                                </StackPanel>
                                
                                <StackPanel Grid.Column="2" Orientation="Horizontal">
                                    <Button Content="💾 저장"
                                            Command="{Binding SaveBasicInfoCommand}"
                                            Style="{StaticResource PrimaryButton}"
                                            Padding="16,8"/>
                                    <Button Command="{Binding ToggleNotePanelCommand}"
                                            Style="{StaticResource MaterialDesignIconButton}"
                                            ToolTip="비고 패널 열기/닫기"
                                            Width="32" Height="32" Padding="0" Margin="8,0,0,0">
                                        <materialDesign:PackIcon Kind="NoteEdit" Width="18" Height="18"/>
                                    </Button>
                                </StackPanel>
                            </Grid>
                            
                            <!-- 기초정보 필드들 -->
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="16"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="16"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="16"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="16"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                
                                <!-- Row 0 -->
                                <StackPanel Grid.Row="0" Grid.Column="0">
                                    <TextBlock Text="IRR" Style="{StaticResource CaptionTextStyle}" FontWeight="SemiBold" Margin="0,0,0,4"/>
                                    <TextBox Text="{Binding Irr, StringFormat=P2, UpdateSourceTrigger=PropertyChanged}" Padding="8,6"/>
                                </StackPanel>
                                
                                <StackPanel Grid.Row="0" Grid.Column="2">
                                    <TextBlock Text="신용보증서 회수율" Style="{StaticResource CaptionTextStyle}" FontWeight="SemiBold" Margin="0,0,0,4"/>
                                    <TextBox Text="{Binding CreditGuaranteeRecoveryRate, StringFormat=P2, UpdateSourceTrigger=PropertyChanged}" Padding="8,6"/>
                                </StackPanel>
                                
                                <StackPanel Grid.Row="0" Grid.Column="4">
                                    <TextBlock Text="Interim 회수율" Style="{StaticResource CaptionTextStyle}" FontWeight="SemiBold" Margin="0,0,0,4"/>
                                    <TextBox Text="{Binding InterimRecoveryRate, StringFormat=P2, UpdateSourceTrigger=PropertyChanged}" Padding="8,6"/>
                                </StackPanel>
                                
                                <!-- Row 2 -->
                                <StackPanel Grid.Row="2" Grid.Column="0">
                                    <TextBlock Text="경매개시후 1회차 Lead time (개월)" Style="{StaticResource CaptionTextStyle}" FontWeight="SemiBold" Margin="0,0,0,4"/>
                                    <TextBox Text="{Binding AuctionFirstLeadTimeMonths, UpdateSourceTrigger=PropertyChanged}" Padding="8,6"/>
                                </StackPanel>
                                
                                <StackPanel Grid.Row="2" Grid.Column="2">
                                    <TextBlock Text="회차별 Lead time" Style="{StaticResource CaptionTextStyle}" FontWeight="SemiBold" Margin="0,0,0,4"/>
                                    <TextBox Text="{Binding RoundLeadTime, UpdateSourceTrigger=PropertyChanged}" Padding="8,6"/>
                                </StackPanel>
                                
                                <StackPanel Grid.Row="2" Grid.Column="4">
                                    <TextBlock Text="배당시 Lead time" Style="{StaticResource CaptionTextStyle}" FontWeight="SemiBold" Margin="0,0,0,4"/>
                                    <TextBox Text="{Binding DistributionLeadTime, UpdateSourceTrigger=PropertyChanged}" Padding="8,6"/>
                                </StackPanel>
                                
                                <!-- Row 4 -->
                                <StackPanel Grid.Row="4" Grid.Column="0">
                                    <TextBlock Text="개회 경매개시일까지 Lead time" Style="{StaticResource CaptionTextStyle}" FontWeight="SemiBold" Margin="0,0,0,4"/>
                                    <TextBox Text="{Binding OpeningToAuctionLeadTime, UpdateSourceTrigger=PropertyChanged}" Padding="8,6"/>
                                </StackPanel>
                                
                                <StackPanel Grid.Row="4" Grid.Column="2">
                                    <TextBlock Text="대위등기 필요시 경매개시일까지 Lead time" Style="{StaticResource CaptionTextStyle}" FontWeight="SemiBold" Margin="0,0,0,4"/>
                                    <TextBox Text="{Binding SubrogationToAuctionLeadTime, UpdateSourceTrigger=PropertyChanged}" Padding="8,6"/>
                                </StackPanel>
                                
                                <StackPanel Grid.Row="4" Grid.Column="4">
                                    <TextBlock Text="개회, 대위등기 중복시 Lead time" Style="{StaticResource CaptionTextStyle}" FontWeight="SemiBold" Margin="0,0,0,4"/>
                                    <TextBox Text="{Binding CombinedLeadTime, UpdateSourceTrigger=PropertyChanged}" Padding="8,6"/>
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </Border>
                    
                    <!-- ========== 섹션 4: QA ========== -->
                    <Border Background="{StaticResource BackgroundBrush}"
                            CornerRadius="8"
                            Padding="20"
                            Margin="0,0,0,16">
                        <Border.Effect>
                            <DropShadowEffect Color="Black" Opacity="0.08" BlurRadius="8" ShadowDepth="2"/>
                        </Border.Effect>
                        
                        <StackPanel>
                            <!-- 섹션 헤더 -->
                            <TextBlock Text="❓ QA" 
                                       Style="{StaticResource H4TextStyle}"
                                       FontWeight="Bold"
                                       Margin="0,0,0,16"/>
                            
                            <!-- QA 항목들 -->
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="16"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                
                                <!-- QA집계 -->
                                <Border Grid.Column="0" Background="{StaticResource BlueGray50Brush}" CornerRadius="4" Padding="12,8">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="QA집계" FontWeight="SemiBold" FontSize="{StaticResource FontSizeBody}"/>
                                            <TextBlock FontSize="{StaticResource FontSizeTiny}" Foreground="{StaticResource TextMutedBrush}">
                                                <Run Text="총"/>
                                                <Run Text="{Binding QaTotalCount, FallbackValue='0'}"/>
                                                <Run Text="건 /"/>
                                                <Run Text="미회신"/>
                                                <Run Text="{Binding QaUnansweredCount, FallbackValue='0'}"/>
                                                <Run Text="건"/>
                                            </TextBlock>
                                        </StackPanel>
                                        <Button Grid.Column="1" Content="상세보기" Style="{StaticResource SecondaryButton}" Padding="8,4" FontSize="{StaticResource FontSizeTiny}"/>
                                    </Grid>
                                </Border>
                                
                                <!-- QA회신 업로드 -->
                                <Border Grid.Column="2" Background="{StaticResource BlueGray50Brush}" CornerRadius="4" Padding="12,8">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="QA회신 업로드" FontWeight="SemiBold" FontSize="{StaticResource FontSizeBody}"/>
                                            <TextBlock Text="{Binding QaResponseUploadedAt, StringFormat='업로드: {0:yyyy-MM-dd}', FallbackValue='미등록'}" 
                                                       FontSize="{StaticResource FontSizeTiny}" Foreground="{StaticResource TextMutedBrush}"/>
                                        </StackPanel>
                                        <Button Grid.Column="1" Content="업로드" Style="{StaticResource PrimaryButton}" Padding="8,4" FontSize="{StaticResource FontSizeTiny}"/>
                                    </Grid>
                                </Border>
                            </Grid>
                        </StackPanel>
                    </Border>
                    
                </StackPanel>
                
                <!-- ========== 우측 영역 ========== -->
                <StackPanel Grid.Column="2">
                    
                    <!-- ========== 섹션 5: 고유정보관리 ========== -->
                    <Border Background="{StaticResource BackgroundBrush}"
                            CornerRadius="8"
                            Padding="20"
                            Margin="0,0,0,16">
                        <Border.Effect>
                            <DropShadowEffect Color="Black" Opacity="0.08" BlurRadius="8" ShadowDepth="2"/>
                        </Border.Effect>
                        
                        <StackPanel>
                            <TextBlock Text="🏛️ 고유정보관리" 
                                       Style="{StaticResource H4TextStyle}"
                                       FontWeight="Bold"
                                       Margin="0,0,0,16"/>
                            
                            <!-- 법원별 저감율 -->
                            <Border Background="{StaticResource BlueGray50Brush}" CornerRadius="4" Padding="12,8" Margin="0,0,0,8">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="법원별 저감율" FontWeight="SemiBold" FontSize="{StaticResource FontSizeBody}"/>
                                        <TextBlock Text="{Binding CourtReductionRateCount, StringFormat={}{0}개 법원 설정됨, FallbackValue='미설정'}" 
                                                   FontSize="{StaticResource FontSizeTiny}" Foreground="{StaticResource TextMutedBrush}"/>
                                    </StackPanel>
                                    <Button Grid.Column="1" Content="설정" Style="{StaticResource SecondaryButton}" Padding="8,4" FontSize="{StaticResource FontSizeTiny}"/>
                                </Grid>
                            </Border>
                            
                            <!-- 선순위 주택임대차보호법 -->
                            <Border Background="{StaticResource BlueGray50Brush}" CornerRadius="4" Padding="12,8" Margin="0,0,0,8">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="선순위 주택임대차보호법" FontWeight="SemiBold" FontSize="{StaticResource FontSizeBody}"/>
                                        <TextBlock Text="{Binding HousingLeaseProtectionStatus, FallbackValue='미설정'}" 
                                                   FontSize="{StaticResource FontSizeTiny}" Foreground="{StaticResource TextMutedBrush}"/>
                                    </StackPanel>
                                    <Button Grid.Column="1" Content="설정" Style="{StaticResource SecondaryButton}" Padding="8,4" FontSize="{StaticResource FontSizeTiny}"/>
                                </Grid>
                            </Border>
                            
                            <!-- 선순위 상가임대차보호법 -->
                            <Border Background="{StaticResource BlueGray50Brush}" CornerRadius="4" Padding="12,8" Margin="0,0,0,8">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="선순위 상가임대차보호법" FontWeight="SemiBold" FontSize="{StaticResource FontSizeBody}"/>
                                        <TextBlock Text="{Binding CommercialLeaseProtectionStatus, FallbackValue='미설정'}" 
                                                   FontSize="{StaticResource FontSizeTiny}" Foreground="{StaticResource TextMutedBrush}"/>
                                    </StackPanel>
                                    <Button Grid.Column="1" Content="설정" Style="{StaticResource SecondaryButton}" Padding="8,4" FontSize="{StaticResource FontSizeTiny}"/>
                                </Grid>
                            </Border>
                        </StackPanel>
                    </Border>
                    
                    <!-- ========== 섹션 6: 사용인 설정 ========== -->
                    <Border Background="{StaticResource BackgroundBrush}"
                            CornerRadius="8"
                            Padding="20"
                            Margin="0,0,0,16">
                        <Border.Effect>
                            <DropShadowEffect Color="Black" Opacity="0.08" BlurRadius="8" ShadowDepth="2"/>
                        </Border.Effect>
                        
                        <StackPanel>
                            <Grid Margin="0,0,0,16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                
                                <TextBlock Grid.Column="0" Text="👤 사용인 설정" 
                                           Style="{StaticResource H4TextStyle}"
                                           FontWeight="Bold"/>
                                
                                <Button Grid.Column="1" Content="💾 저장" 
                                        Command="{Binding SaveAgentSettingsCommand}"
                                        Style="{StaticResource PrimaryButton}"
                                        Padding="16,8"/>
                            </Grid>
                            
                            <!-- 사용인 정보 필드들 -->
                            <StackPanel>
                                <StackPanel Margin="0,0,0,12">
                                    <TextBlock Text="소속" Style="{StaticResource CaptionTextStyle}" FontWeight="SemiBold" Margin="0,0,0,4"/>
                                    <TextBox Text="{Binding AgentAffiliation, UpdateSourceTrigger=PropertyChanged}" Padding="8,6"/>
                                </StackPanel>
                                
                                <StackPanel Margin="0,0,0,12">
                                    <TextBlock Text="사용인" Style="{StaticResource CaptionTextStyle}" FontWeight="SemiBold" Margin="0,0,0,4"/>
                                    <TextBox Text="{Binding AgentName, UpdateSourceTrigger=PropertyChanged}" Padding="8,6"/>
                                </StackPanel>
                                
                                <StackPanel Margin="0,0,0,12">
                                    <TextBlock Text="등급" Style="{StaticResource CaptionTextStyle}" FontWeight="SemiBold" Margin="0,0,0,4"/>
                                    <ComboBox SelectedItem="{Binding AgentGrade}" Padding="8,6">
                                        <ComboBoxItem Content="A"/>
                                        <ComboBoxItem Content="B"/>
                                        <ComboBoxItem Content="C"/>
                                    </ComboBox>
                                </StackPanel>
                                
                                <StackPanel Margin="0,0,0,12">
                                    <TextBlock Text="사용인 연락처" Style="{StaticResource CaptionTextStyle}" FontWeight="SemiBold" Margin="0,0,0,4"/>
                                    <TextBox Text="{Binding AgentContact, UpdateSourceTrigger=PropertyChanged}" Padding="8,6"/>
                                </StackPanel>
                                
                                <StackPanel Margin="0,0,0,12">
                                    <TextBlock Text="카카오톡 ID" Style="{StaticResource CaptionTextStyle}" FontWeight="SemiBold" Margin="0,0,0,4"/>
                                    <TextBox Text="{Binding AgentKakaoId, UpdateSourceTrigger=PropertyChanged}" Padding="8,6"/>
                                </StackPanel>
                                
                                <Grid Margin="0,0,0,12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="8"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="굿옥션 ID" Style="{StaticResource CaptionTextStyle}" FontWeight="SemiBold" Margin="0,0,0,4"/>
                                        <TextBox Text="{Binding GoodAuctionId, UpdateSourceTrigger=PropertyChanged}" Padding="8,6"/>
                                    </StackPanel>
                                    
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="굿옥션 PW" Style="{StaticResource CaptionTextStyle}" FontWeight="SemiBold" Margin="0,0,0,4"/>
                                        <TextBox Text="{Binding GoodAuctionPw, UpdateSourceTrigger=PropertyChanged}" 
                                                 Padding="8,6"
                                                 ToolTip="비밀번호를 입력하세요"/>
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                    
                    <!-- ========== 섹션 7: Assign ========== -->
                    <Border Background="{StaticResource BackgroundBrush}"
                            CornerRadius="8"
                            Padding="20"
                            Margin="0,0,0,16">
                        <Border.Effect>
                            <DropShadowEffect Color="Black" Opacity="0.08" BlurRadius="8" ShadowDepth="2"/>
                        </Border.Effect>
                        
                        <StackPanel>
                            <TextBlock Text="📝 Assign" 
                                       Style="{StaticResource H4TextStyle}"
                                       FontWeight="Bold"
                                       Margin="0,0,0,16"/>
                            
                            <!-- Placeholder -->
                            <Border Background="{StaticResource BlueGray50Brush}" 
                                    CornerRadius="4" 
                                    Padding="24"
                                    MinHeight="100">
                                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <TextBlock Text="Assign 기능 준비 중" 
                                               Style="{StaticResource CaptionTextStyle}"
                                               Foreground="{StaticResource TextMutedBrush}"
                                               HorizontalAlignment="Center"/>
                                    <TextBlock Text="추후 구현 예정입니다" 
                                               Style="{StaticResource CaptionTextStyle}"
                                               Foreground="{StaticResource TextTertiaryBrush}"
                                               HorizontalAlignment="Center"
                                               Margin="0,4,0,0"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Border>
                    
                </StackPanel>
            </Grid>
        </ScrollViewer>

        <!-- 비고 사이드 패널 -->
        <Border x:Name="NotePanelColumn" Grid.Column="1"
                Width="250"
                Visibility="{Binding IsNotePanelVisible, Converter={StaticResource BoolToVisibilityConverter}}"
                Background="{StaticResource SurfaceColor}"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="1,0,0,0"
                Padding="12">
            <DockPanel>
                <TextBlock DockPanel.Dock="Top"
                           Text="&#x1F4DD; 비고"
                           FontWeight="SemiBold"
                           FontSize="{StaticResource FontSizeBody}"
                           Foreground="{StaticResource PrimaryBrush}"
                           Margin="0,0,0,8"/>
                <TextBox Text="{Binding NoteText, UpdateSourceTrigger=PropertyChanged}"
                         TextWrapping="Wrap"
                         AcceptsReturn="True"
                         VerticalScrollBarVisibility="Auto"
                         VerticalAlignment="Stretch"
                         FontSize="{StaticResource FontSizeBody}"
                         Padding="8"
                         BorderBrush="{StaticResource BorderBrush}"
                         BorderThickness="1"
                         Background="White"/>
            </DockPanel>
        </Border>

    </Grid>
</UserControl>
