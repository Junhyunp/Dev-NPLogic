                                        <TextBlock Text="행 추가" Margin="4,0,0,0" FontSize="{StaticResource FontSizeSmall}" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                                <Button Command="{Binding RemoveInquiryRowCommand}"
                                        CommandParameter="{Binding SelectedItem, ElementName=InquiryDataGrid}"
