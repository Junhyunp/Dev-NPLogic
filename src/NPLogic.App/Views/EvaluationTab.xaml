                                                   FontWeight="SemiBold"
                                                   FontSize="{StaticResource FontSizeH4}"/>
                                    </StackPanel>
                                    <!-- 테이블 생성 버튼 -->
                                    <Button Content="+" FontSize="16" FontWeight="Bold"
                                            HorizontalAlignment="Right" VerticalAlignment="Center"
                                            Command="{Binding CreateInquiryTableCommand}"
                                            Visibility="{Binding HasInquiryTable, Converter={StaticResource InverseBooleanToVisibilityConverter}}"
                                            Background="Transparent" Foreground="White" BorderThickness="0"
                                            Padding="8,0" MinHeight="0" Height="20" Cursor="Hand"
                                            ToolTip="탐문 내역 테이블 생성"/>
