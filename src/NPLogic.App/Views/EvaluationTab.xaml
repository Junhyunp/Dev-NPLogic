<UserControl x:Class="NPLogic.Views.EvaluationTab"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:NPLogic.Views"
             xmlns:evalViews="clr-namespace:NPLogic.Views.Evaluation"
             xmlns:vm="clr-namespace:NPLogic.ViewModels"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:lvc="clr-namespace:LiveChartsCore.SkiaSharpView.WPF;assembly=LiveChartsCore.SkiaSharpView.WPF"
             mc:Ignorable="d"
             d:DesignHeight="900" d:DesignWidth="1400"
             d:DataContext="{d:DesignInstance Type=vm:EvaluationTabViewModel}">

    <UserControl.Resources>
        <!-- 피드백 반영: 공통 스타일 참조로 통일 -->
        <!-- SectionHeader, LabelText, ValueText, AmountText, CardBorder 스타일은 Typography.xaml에서 참조 -->
        
        <!-- 로컬 별칭 (하위 호환성) -->
        <Style x:Key="SectionHeaderStyle" TargetType="TextBlock" BasedOn="{StaticResource SectionHeader}">
            <Setter Property="FontSize" Value="{StaticResource FontSizeH4}"/>
        </Style>
        <Style x:Key="LabelStyle" TargetType="TextBlock" BasedOn="{StaticResource LabelText}"/>
        <Style x:Key="ValueStyle" TargetType="TextBlock" BasedOn="{StaticResource ValueText}"/>
        <Style x:Key="AmountStyle" TargetType="TextBlock" BasedOn="{StaticResource AmountText}"/>
        <Style x:Key="CardStyle" TargetType="Border" BasedOn="{StaticResource CardBorder}">
            <Setter Property="Padding" Value="16"/>
        </Style>

        <!-- DataGrid 공통 스타일 (SeniorRightsView와 동일) -->
        <Style x:Key="SectionDataGridColumnHeaderStyle" TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="{StaticResource BlueGray100Brush}"/>
            <Setter Property="Padding" Value="8,6"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="0,0,1,1"/>
        </Style>
        <Style x:Key="SectionDataGridCellStyle" TargetType="DataGridCell">
            <Setter Property="Foreground" Value="Black"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="0,0,1,0"/>
            <Setter Property="Padding" Value="4,2"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Foreground" Value="Black"/>
                </Trigger>
                <Trigger Property="IsEditing" Value="True">
                    <Setter Property="Foreground" Value="Black"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="SectionDataGridRowStyle" TargetType="DataGridRow">
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Foreground" Value="Black"/>
        </Style>
        <Style x:Key="SectionDataGridTextBlockStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="{StaticResource FontSizeBody}"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="TextAlignment" Value="Center"/>
        </Style>
        <Style x:Key="ScenarioHeaderTextBoxStyle" TargetType="TextBox">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="TextAlignment" Value="Center"/>
            <Setter Property="VerticalAlignment" Value="Stretch"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="Padding" Value="4,4"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="materialDesign:TextFieldAssist.DecorationVisibility" Value="Collapsed"/>
            <Style.Triggers>
                <Trigger Property="IsKeyboardFocused" Value="True">
                    <Setter Property="BorderBrush" Value="{StaticResource PrimaryBrush}"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="SectionDataGridTextBoxStyle" TargetType="TextBox">
            <Setter Property="FontSize" Value="{StaticResource FontSizeBody}"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="TextAlignment" Value="Center"/>
            <Setter Property="VerticalAlignment" Value="Stretch"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Margin" Value="0"/>
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled"
                  Padding="12,8,12,12">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- 로딩 오버레이 -->
            <Border Grid.RowSpan="2" 
                    Background="{StaticResource OverlaySemiLightBrush}" 
                    Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibilityConverter}}"
                    Panel.ZIndex="100">
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                    <ProgressBar IsIndeterminate="True" Width="200" Height="4"/>
                    <TextBlock Text="로딩 중..." Margin="0,12,0,0" 
                               HorizontalAlignment="Center"
                               Style="{StaticResource BodyTextStyle}"/>
                </StackPanel>
            </Border>

            <!-- 헤더: 평가 유형 선택 -->
            <Border Grid.Row="0" Style="{StaticResource CardStyle}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Orientation="Horizontal">
                        <TextBlock Text="평가 유형 선택"
                                   Style="{StaticResource SectionHeaderStyle}"
                                   Margin="0"
                                   VerticalAlignment="Center"/>
                    </StackPanel>

                    <!-- 평가 유형 라디오 버튼 -->
                    <StackPanel Grid.Column="1" Orientation="Horizontal" 
                                Margin="32,0,0,0"
                                VerticalAlignment="Center">
                        <RadioButton Content="1. 아파트"
                                     IsChecked="{Binding IsApartmentType}"
                                     Margin="0,0,24,0"
                                     FontSize="{StaticResource FontSizeBody}"/>
                        <RadioButton Content="2. 연립다세대"
                                     IsChecked="{Binding IsMultiFamilyType}"
                                     Margin="0,0,24,0"
                                     FontSize="{StaticResource FontSizeBody}"/>
                        <RadioButton Content="3. 공장/창고"
                                     IsChecked="{Binding IsFactoryType}"
                                     Margin="0,0,24,0"
                                     FontSize="{StaticResource FontSizeBody}"/>
                        <RadioButton Content="4. 상가/아파트형공장"
                                     IsChecked="{Binding IsCommercialType}"
                                     Margin="0,0,24,0"
                                     FontSize="{StaticResource FontSizeBody}"/>
                        <RadioButton Content="5. 주택/근린시설/토지/기타"
                                     IsChecked="{Binding IsHouseLandType}"

                                     FontSize="{StaticResource FontSizeBody}"/>
                    </StackPanel>

                    <Button Grid.Column="2" Content="저장"
                            Command="{Binding SaveCommand}"
                            Style="{StaticResource MaterialDesignRaisedButton}"
                            Padding="12,6"/>
                </Grid>
            </Border>

            <!-- 메인 콘텐츠 -->
            <StackPanel Grid.Row="1">

                    <!-- 상가구분 (상가/아파트형공장 선택 시) -->
                    <Border Background="{StaticResource SurfaceColor}"
                            BorderBrush="{StaticResource BorderBrush}"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="16,10"
                            Margin="0,0,0,8"
                            Visibility="{Binding IsCommercialType, Converter={StaticResource BoolToVisibilityConverter}}">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="상가구분"
                                       FontWeight="SemiBold"
                                       FontSize="{StaticResource FontSizeBody}"
                                       Margin="0,0,24,0"
                                       VerticalAlignment="Center"/>
                            <RadioButton Content="오피스"
                                         IsChecked="{Binding IsOfficeSubType}"
                                         GroupName="CommercialSubType"
                                         Margin="0,0,16,0"
                                         FontSize="{StaticResource FontSizeBody}"/>
                            <RadioButton Content="중대형상가"
                                         IsChecked="{Binding IsMediumLargeSubType}"
                                         GroupName="CommercialSubType"
                                         Margin="0,0,16,0"
                                         FontSize="{StaticResource FontSizeBody}"/>
                            <RadioButton Content="소규모상가"
                                         IsChecked="{Binding IsSmallSubType}"
                                         GroupName="CommercialSubType"
                                         Margin="0,0,16,0"
                                         FontSize="{StaticResource FontSizeBody}"/>
                            <RadioButton Content="집합상가"
                                         IsChecked="{Binding IsCollectiveSubType}"
                                         GroupName="CommercialSubType"
                                         Margin="0,0,16,0"
                                         FontSize="{StaticResource FontSizeBody}"/>
                            <RadioButton Content="해당없음"
                                         IsChecked="{Binding IsNoSubType}"
                                         GroupName="CommercialSubType"
                                         FontSize="{StaticResource FontSizeBody}"/>
                        </StackPanel>
                    </Border>
                    
                    <!-- 사례지도 및 실거래가 통합 영역 -->
                    <Border Background="{StaticResource SurfaceColor}"
                            BorderBrush="{StaticResource BorderBrush}"
                            BorderThickness="1"
                            CornerRadius="8"
                            Margin="0,0,0,16">
                        <StackPanel>
                            <!-- 섹션 헤더 -->
                            <Border Background="{StaticResource PrimaryBrush}"
                                    CornerRadius="8,8,0,0"
                                    Padding="16,10">
                                <Grid>
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <materialDesign:PackIcon Kind="MapMarkerRadius" Width="18" Height="18"
                                                                 Margin="0,0,6,0" VerticalAlignment="Center" Foreground="White"/>
                                        <TextBlock Text="{Binding CaseMapSectionTitle}"
                                                   Foreground="White"
                                                   FontWeight="SemiBold"
                                                   FontSize="{StaticResource FontSizeH4}"/>
                                    </StackPanel>
                                    <Button Content="가져오기"
                                            Command="{Binding LoadCaseMapCommand}"
                                            Padding="12,4"
                                            FontSize="{StaticResource FontSizeBody}"
                                            HorizontalAlignment="Right"
                                            VerticalAlignment="Center"/>
                                </Grid>
                            </Border>

                            <!-- 좌: 사례지도 / 우: 실거래가 + 그래프 -->
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <!-- 좌측: 사례지도 (전체 높이) -->
                                <Border Grid.Column="0"
                                        Background="{StaticResource BlueGray50Brush}"
                                        MinHeight="560"
                                        Cursor="Hand"
                                        MouseLeftButtonUp="MapPlaceholder_MouseLeftButtonUp"
                                        ToolTip="클릭하여 확대">
                                    <TextBlock Text="소재지 기준으로 위치, 본건기준거래 자동 산정 및 표시"
                                               Style="{StaticResource BodyTextStyle}"
                                               Opacity="0.6"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"/>
                                </Border>

                                <!-- 세로 구분선 -->
                                <Border Grid.Column="1" Background="{StaticResource BorderBrush}" Width="2"
                                        Visibility="{Binding IsShowRealTransaction, Converter={StaticResource BooleanToVisibilityConverter}}"/>

                                <!-- 우측: 실거래가 DataGrid + 거래 그래프 -->
                                <DockPanel Grid.Column="2"
                                           Visibility="{Binding IsShowRealTransaction, Converter={StaticResource BooleanToVisibilityConverter}}">
                                    <!-- 실거래가 DataGrid (상단) -->
                                    <DataGrid DockPanel.Dock="Top"
                                              x:Name="RealTransactionGrid"
                                              PreviewMouseWheel="DataGrid_SmartScrollMouseWheel"
                                              ItemsSource="{Binding RealTransactions}"
                                              AutoGenerateColumns="False"
                                              CanUserAddRows="False"
                                              CanUserDeleteRows="False"
                                              CanUserSortColumns="False"
                                              HeadersVisibility="Column"
                                              GridLinesVisibility="All"
                                              BorderThickness="0"
                                              SelectionUnit="Cell"
                                              SelectionMode="Single"
                                              HorizontalGridLinesBrush="{StaticResource BorderBrush}"
                                              VerticalGridLinesBrush="{StaticResource BorderBrush}"
                                              RowHeight="32"
                                              ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                              ScrollViewer.VerticalScrollBarVisibility="Auto"
                                              MaxHeight="240"
                                              MinHeight="160">
                                        <DataGrid.ColumnHeaderStyle>
                                            <StaticResource ResourceKey="SectionDataGridColumnHeaderStyle"/>
                                        </DataGrid.ColumnHeaderStyle>
                                        <DataGrid.CellStyle>
                                            <StaticResource ResourceKey="SectionDataGridCellStyle"/>
                                        </DataGrid.CellStyle>
                                        <DataGrid.RowStyle>
                                            <StaticResource ResourceKey="SectionDataGridRowStyle"/>
                                        </DataGrid.RowStyle>
                                        <DataGrid.Columns>
                                            <DataGridTextColumn Header="거래면적(㎡)" Binding="{Binding Area, StringFormat=N2}" Width="*" IsReadOnly="True"
                                                                ElementStyle="{StaticResource SectionDataGridTextBlockStyle}"/>
                                            <DataGridTextColumn Header="거래일자" Binding="{Binding TransactionDate, StringFormat=yyyy-MM-dd}" Width="*" IsReadOnly="True"
                                                                ElementStyle="{StaticResource SectionDataGridTextBlockStyle}"/>
                                            <DataGridTemplateColumn Width="*" IsReadOnly="True">
                                                <DataGridTemplateColumn.HeaderTemplate>
                                                    <DataTemplate>
                                                        <TextBlock Text="{Binding DataContext.AmountColumnHeader, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                                   HorizontalAlignment="Center"/>
                                                    </DataTemplate>
                                                </DataGridTemplateColumn.HeaderTemplate>
                                                <DataGridTemplateColumn.CellTemplate>
                                                    <DataTemplate>
                                                        <TextBlock Text="{Binding Amount, StringFormat=N0}"
                                                                   Style="{StaticResource SectionDataGridTextBlockStyle}"/>
                                                    </DataTemplate>
                                                </DataGridTemplateColumn.CellTemplate>
                                            </DataGridTemplateColumn>
                                            <DataGridTextColumn Header="층수" Binding="{Binding Floor}" Width="80" IsReadOnly="True"
                                                                ElementStyle="{StaticResource SectionDataGridTextBlockStyle}"/>
                                            <DataGridTextColumn Header="등기여부" Binding="{Binding IsRegistered}" Width="80" IsReadOnly="True"
                                                                ElementStyle="{StaticResource SectionDataGridTextBlockStyle}"/>
                                            <DataGridTemplateColumn Header="적용" Width="60">
                                                <DataGridTemplateColumn.CellTemplate>
                                                    <DataTemplate>
                                                        <CheckBox IsChecked="{Binding IsApplied, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                                  HorizontalAlignment="Center" VerticalAlignment="Center"
                                                                  IsHitTestVisible="True"
                                                                  Focusable="True"/>
                                                    </DataTemplate>
                                                </DataGridTemplateColumn.CellTemplate>
                                            </DataGridTemplateColumn>
                                        </DataGrid.Columns>
                                    </DataGrid>

                                    <!-- 거래가격/건수 그래프 (하단, 나머지 공간 채움) -->
                                    <DockPanel>
                                        <Border DockPanel.Dock="Top"
                                                Background="{StaticResource BlueGray100Brush}"
                                                BorderBrush="{StaticResource BorderBrush}"
                                                BorderThickness="0,1,0,1"
                                                Padding="8,4">
                                            <Grid>
                                                <TextBlock Text="거래가격/건수 그래프"
                                                           Foreground="{StaticResource TextSecondaryBrush}"
                                                           FontWeight="SemiBold" FontSize="12"
                                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                <ComboBox ItemsSource="{Binding AvailableAreas}"
                                                          SelectedItem="{Binding SelectedArea}"
                                                          HorizontalAlignment="Right"
                                                          MinWidth="100" Height="24"
                                                          FontSize="11" Padding="6,2"
                                                          VerticalAlignment="Center"/>
                                            </Grid>
                                        </Border>
                                        <Border Background="White" MinHeight="280">
                                            <lvc:CartesianChart Series="{Binding TradeSeries}"
                                                                XAxes="{Binding TradeXAxes}"
                                                                YAxes="{Binding TradeYAxes}"
                                                                DrawMarginFrame="{x:Null}"
                                                                Margin="8,16,8,16"/>
                                        </Border>
                                    </DockPanel>
                                </DockPanel>
                            </Grid>

                            <!-- 상가 전용: 임대동향 + 상권지도 통합 테이블 -->
                            <Grid Visibility="{Binding IsCommercialType, Converter={StaticResource BoolToVisibilityConverter}}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <!-- 좌측: 임대동향 데이터 테이블 -->
                                <StackPanel Grid.Column="0">

                                    <!-- 지역 헤더 -->
                                    <Border Background="{StaticResource BlueGray100Brush}"
                                            BorderBrush="{StaticResource BlueGray200Brush}" BorderThickness="1,1,0,1" Padding="8,6">
                                        <TextBlock Text="서울_서울_서울" FontWeight="SemiBold" FontSize="12"
                                                   Foreground="{StaticResource TextSecondaryBrush}" HorizontalAlignment="Center"/>
                                    </Border>

                                    <!-- 임대수익률 -->
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="120"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>
                                        <Border Grid.Row="0" Grid.Column="0" Grid.RowSpan="2" Background="{StaticResource BlueGray100Brush}"
                                                BorderBrush="{StaticResource BlueGray200Brush}" BorderThickness="1,0,1,1" Padding="4,4">
                                            <TextBlock Text="임대수익률(2024)" FontWeight="SemiBold" FontSize="11"
                                                       Foreground="{StaticResource TextSecondaryBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <Border Grid.Row="0" Grid.Column="1" Background="{StaticResource BlueGray100Brush}"
                                                BorderBrush="{StaticResource BlueGray200Brush}" BorderThickness="0,0,1,1" Padding="4,4">
                                            <TextBlock Text="소득수익률" FontSize="10" Foreground="{StaticResource TextSecondaryBrush}" HorizontalAlignment="Center"/>
                                        </Border>
                                        <Border Grid.Row="0" Grid.Column="2" Background="{StaticResource BlueGray100Brush}"
                                                BorderBrush="{StaticResource BlueGray200Brush}" BorderThickness="0,0,1,1" Padding="4,4">
                                            <TextBlock Text="자본수익률" FontSize="10" Foreground="{StaticResource TextSecondaryBrush}" HorizontalAlignment="Center"/>
                                        </Border>
                                        <Border Grid.Row="0" Grid.Column="3" Background="{StaticResource BlueGray100Brush}"
                                                BorderBrush="{StaticResource BlueGray200Brush}" BorderThickness="0,0,0,1" Padding="4,4">
                                            <TextBlock Text="투자수익률" FontSize="10" Foreground="{StaticResource TextSecondaryBrush}" HorizontalAlignment="Center"/>
                                        </Border>
                                        <Border Grid.Row="1" Grid.Column="1" BorderBrush="{StaticResource BlueGray200Brush}" BorderThickness="0,0,1,1" Padding="4,4" MinHeight="26"/>
                                        <Border Grid.Row="1" Grid.Column="2" BorderBrush="{StaticResource BlueGray200Brush}" BorderThickness="0,0,1,1" Padding="4,4" MinHeight="26"/>
                                        <Border Grid.Row="1" Grid.Column="3" BorderBrush="{StaticResource BlueGray200Brush}" BorderThickness="0,0,0,1" Padding="4,4" MinHeight="26"/>
                                    </Grid>

                                    <!-- 임대가격지수 -->
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="120"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>
                                        <Border Grid.Row="0" Grid.Column="0" Grid.RowSpan="2" Background="{StaticResource BlueGray100Brush}"
                                                BorderBrush="{StaticResource BlueGray200Brush}" BorderThickness="1,0,1,1" Padding="4,4">
                                            <TextBlock Text="임대가격지수" FontWeight="SemiBold" FontSize="11"
                                                       Foreground="{StaticResource TextSecondaryBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <Border Grid.Row="0" Grid.Column="1" Background="{StaticResource BlueGray100Brush}"
                                                BorderBrush="{StaticResource BlueGray200Brush}" BorderThickness="0,0,1,1" Padding="2,4">
                                            <TextBlock Text="2024년 2분기" FontSize="9" Foreground="{StaticResource TextSecondaryBrush}" HorizontalAlignment="Center"/>
                                        </Border>
                                        <Border Grid.Row="0" Grid.Column="2" Background="{StaticResource BlueGray100Brush}"
                                                BorderBrush="{StaticResource BlueGray200Brush}" BorderThickness="0,0,1,1" Padding="2,4">
                                            <TextBlock Text="2024년 3분기" FontSize="9" Foreground="{StaticResource TextSecondaryBrush}" HorizontalAlignment="Center"/>
                                        </Border>
                                        <Border Grid.Row="0" Grid.Column="3" Background="{StaticResource BlueGray100Brush}"
                                                BorderBrush="{StaticResource BlueGray200Brush}" BorderThickness="0,0,1,1" Padding="2,4">
                                            <TextBlock Text="2024년 4분기" FontSize="9" Foreground="{StaticResource TextSecondaryBrush}" HorizontalAlignment="Center"/>
                                        </Border>
                                        <Border Grid.Row="0" Grid.Column="4" Background="{StaticResource BlueGray100Brush}"
                                                BorderBrush="{StaticResource BlueGray200Brush}" BorderThickness="0,0,1,1" Padding="2,4">
                                            <TextBlock Text="2025년 1분기" FontSize="9" Foreground="{StaticResource TextSecondaryBrush}" HorizontalAlignment="Center"/>
                                        </Border>
                                        <Border Grid.Row="0" Grid.Column="5" Background="{StaticResource BlueGray100Brush}"
                                                BorderBrush="{StaticResource BlueGray200Brush}" BorderThickness="0,0,1,1" Padding="2,4">
                                            <TextBlock Text="2025년 2분기" FontSize="9" Foreground="{StaticResource TextSecondaryBrush}" HorizontalAlignment="Center"/>
                                        </Border>
                                        <Border Grid.Row="0" Grid.Column="6" Background="{StaticResource BlueGray100Brush}"
                                                BorderBrush="{StaticResource BlueGray200Brush}" BorderThickness="0,0,0,1" Padding="2,4">
                                            <TextBlock Text="2025년 3분기" FontSize="9" Foreground="{StaticResource TextSecondaryBrush}" HorizontalAlignment="Center"/>
                                        </Border>
                                        <Border Grid.Row="1" Grid.Column="1" BorderBrush="{StaticResource BlueGray200Brush}" BorderThickness="0,0,1,1" Padding="4,4" MinHeight="26"/>
                                        <Border Grid.Row="1" Grid.Column="2" BorderBrush="{StaticResource BlueGray200Brush}" BorderThickness="0,0,1,1" Padding="4,4" MinHeight="26"/>
                                        <Border Grid.Row="1" Grid.Column="3" BorderBrush="{StaticResource BlueGray200Brush}" BorderThickness="0,0,1,1" Padding="4,4" MinHeight="26"/>
                                        <Border Grid.Row="1" Grid.Column="4" BorderBrush="{StaticResource BlueGray200Brush}" BorderThickness="0,0,1,1" Padding="4,4" MinHeight="26"/>
                                        <Border Grid.Row="1" Grid.Column="5" BorderBrush="{StaticResource BlueGray200Brush}" BorderThickness="0,0,1,1" Padding="4,4" MinHeight="26"/>
                                        <Border Grid.Row="1" Grid.Column="6" BorderBrush="{StaticResource BlueGray200Brush}" BorderThickness="0,0,0,1" Padding="4,4" MinHeight="26"/>
                                    </Grid>

                                    <!-- 공실률 -->
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="120"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>
                                        <Border Grid.Row="0" Grid.Column="0" Grid.RowSpan="2" Background="{StaticResource BlueGray100Brush}"
                                                BorderBrush="{StaticResource BlueGray200Brush}" BorderThickness="1,0,1,1" Padding="4,4">
                                            <TextBlock Text="공실률" FontWeight="SemiBold" FontSize="11"
                                                       Foreground="{StaticResource TextSecondaryBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <Border Grid.Row="0" Grid.Column="1" Background="{StaticResource BlueGray100Brush}"
                                                BorderBrush="{StaticResource BlueGray200Brush}" BorderThickness="0,0,1,1" Padding="2,4">
                                            <TextBlock Text="2024년 3분기" FontSize="9" Foreground="{StaticResource TextSecondaryBrush}" HorizontalAlignment="Center"/>
                                        </Border>
                                        <Border Grid.Row="0" Grid.Column="2" Background="{StaticResource BlueGray100Brush}"
                                                BorderBrush="{StaticResource BlueGray200Brush}" BorderThickness="0,0,1,1" Padding="2,4">
                                            <TextBlock Text="2024년 4분기" FontSize="9" Foreground="{StaticResource TextSecondaryBrush}" HorizontalAlignment="Center"/>
                                        </Border>
                                        <Border Grid.Row="0" Grid.Column="3" Background="{StaticResource BlueGray100Brush}"
                                                BorderBrush="{StaticResource BlueGray200Brush}" BorderThickness="0,0,1,1" Padding="2,4">
                                            <TextBlock Text="2025년 1분기" FontSize="9" Foreground="{StaticResource TextSecondaryBrush}" HorizontalAlignment="Center"/>
