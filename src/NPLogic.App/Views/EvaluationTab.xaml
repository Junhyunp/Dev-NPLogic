                                    <TextBox Text="{Binding FactoryScenario2EvalAmount, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource ScenarioHeaderTextBoxStyle}"/>
                                </Border>
                                <Border Grid.Column="3" Background="{StaticResource BlueGray100Brush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,1,1" Padding="8,6">
