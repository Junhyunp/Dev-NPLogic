                                </Border>
                                <Border Grid.Column="4" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,1,1" Padding="0">
                                    <TextBox Text="{Binding FactoryScenario2EvalReason, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource ScenarioHeaderTextBoxStyle}"/>
