                                        BorderBrush="{StaticResource BlueGray300Brush}"
                                        BorderThickness="0,0,2,1"
                                        Padding="8,6">
                                    <TextBlock Text="지역통계"
                                               Foreground="{StaticResource TextSecondaryBrush}"
                                               FontWeight="SemiBold" FontSize="12"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>

                                <!-- Row 0: 시/도 -->
                                <Border Grid.Row="0" Grid.Column="1" Grid.ColumnSpan="2"
                                        Background="{StaticResource BlueGray200Brush}"
                                        BorderBrush="{StaticResource BlueGray300Brush}"
                                        BorderThickness="0,0,2,2"
                                        Padding="8,6">
                                    <TextBlock Text="{Binding RegionName1}"
                                               Foreground="{StaticResource TextSecondaryBrush}"
                                               FontWeight="SemiBold" FontSize="12"
                                               HorizontalAlignment="Center"/>
                                </Border>

                                <!-- Row 0: 구/군 -->
                                <Border Grid.Row="0" Grid.Column="3" Grid.ColumnSpan="2"
                                        Background="{StaticResource BlueGray100Brush}"
                                        BorderBrush="{StaticResource BlueGray300Brush}"
                                        BorderThickness="0,0,2,2"
                                        Padding="8,6">
                                    <TextBlock Text="{Binding RegionName2}"
                                               Foreground="{StaticResource TextSecondaryBrush}"
                                               FontWeight="SemiBold" FontSize="12"
                                               HorizontalAlignment="Center"/>
                                </Border>

                                <!-- Row 0: 동 -->
                                <Border Grid.Row="0" Grid.Column="5" Grid.ColumnSpan="2"
                                        Background="{StaticResource BlueGray50Brush}"
                                        BorderBrush="{StaticResource BlueGray300Brush}"
                                        BorderThickness="0,0,2,2"
                                        Padding="8,6">
                                    <TextBlock Text="{Binding RegionName3}"
                                               Foreground="{StaticResource TextSecondaryBrush}"
                                               FontWeight="SemiBold" FontSize="12"
                                               HorizontalAlignment="Center"/>
                                </Border>

                                <!-- Row 0: 적용낙찰가율 헤더 -->
                                <Border Grid.Row="0" Grid.Column="7"
                                        Background="{StaticResource PrimaryBrush}"
                                        BorderBrush="{StaticResource BlueGray300Brush}"
                                        BorderThickness="0,0,0,1"
                                        Padding="8,6">
                                    <TextBlock Text="적용낙찰가율"
                                               Foreground="White"
                                               FontWeight="SemiBold" FontSize="12"
                                               HorizontalAlignment="Center"/>
                                </Border>

                                <!-- Row 1: 시/도 하위 헤더 -->
                                <Border Grid.Row="1" Grid.Column="1"
                                        Background="{StaticResource BlueGray200Brush}"
                                        BorderBrush="{StaticResource BlueGray300Brush}"
                                        BorderThickness="0,0,1,1" Padding="8,6">
                                    <TextBlock Text="가율" Foreground="{StaticResource TextSecondaryBrush}"
                                               FontWeight="SemiBold" FontSize="12" HorizontalAlignment="Center"/>
                                </Border>
                                <Border Grid.Row="1" Grid.Column="2"
                                        Background="{StaticResource BlueGray200Brush}"
                                        BorderBrush="{StaticResource BlueGray300Brush}"
                                        BorderThickness="0,0,2,1" Padding="8,6">
                                    <TextBlock Text="건수" Foreground="{StaticResource TextSecondaryBrush}"
                                               FontWeight="SemiBold" FontSize="12" HorizontalAlignment="Center"/>
                                </Border>

                                <!-- Row 1: 구/군 하위 헤더 -->
                                <Border Grid.Row="1" Grid.Column="3"
                                        Background="{StaticResource BlueGray100Brush}"
                                        BorderBrush="{StaticResource BlueGray300Brush}"
                                        BorderThickness="0,0,1,1" Padding="8,6">
                                    <TextBlock Text="가율" Foreground="{StaticResource TextSecondaryBrush}"
                                               FontWeight="SemiBold" FontSize="12" HorizontalAlignment="Center"/>
                                </Border>
                                <Border Grid.Row="1" Grid.Column="4"
                                        Background="{StaticResource BlueGray100Brush}"
                                        BorderBrush="{StaticResource BlueGray300Brush}"
                                        BorderThickness="0,0,2,1" Padding="8,6">
                                    <TextBlock Text="건수" Foreground="{StaticResource TextSecondaryBrush}"
                                               FontWeight="SemiBold" FontSize="12" HorizontalAlignment="Center"/>
                                </Border>

                                <!-- Row 1: 동 하위 헤더 -->
                                <Border Grid.Row="1" Grid.Column="5"
                                        Background="{StaticResource BlueGray50Brush}"
                                        BorderBrush="{StaticResource BlueGray300Brush}"
                                        BorderThickness="0,0,1,1" Padding="8,6">
                                    <TextBlock Text="가율" Foreground="{StaticResource TextSecondaryBrush}"
                                               FontWeight="SemiBold" FontSize="12" HorizontalAlignment="Center"/>
                                </Border>
                                <Border Grid.Row="1" Grid.Column="6"
                                        Background="{StaticResource BlueGray50Brush}"
                                        BorderBrush="{StaticResource BlueGray300Brush}"
                                        BorderThickness="0,0,2,1" Padding="8,6">
                                    <TextBlock Text="건수" Foreground="{StaticResource TextSecondaryBrush}"
                                               FontWeight="SemiBold" FontSize="12" HorizontalAlignment="Center"/>
                                </Border>

                                <!-- Row 1: 적용낙찰가율 설명 -->
                                <Border Grid.Row="1" Grid.Column="7"
                                        Background="#FFEEF5FF"
                                        BorderBrush="{StaticResource BlueGray300Brush}"
                                        BorderThickness="0,0,0,1" Padding="8,6">
                                    <TextBlock Text="{Binding AppliedBidRateDescription}"
                                               Foreground="{StaticResource PrimaryBrush}"
                                               FontWeight="SemiBold" FontSize="11"
                                               HorizontalAlignment="Center"
                                               TextWrapping="Wrap"/>
                                </Border>

                                <!-- Row 2: 1년간 평균 -->
                                <Border Grid.Row="2" Grid.Column="0"
                                        Background="{StaticResource BlueGray100Brush}"
                                        BorderBrush="{StaticResource BorderBrush}"
                                        BorderThickness="0,0,1,1" Padding="8,6">
                                    <TextBlock Text="1년 평균" Foreground="{StaticResource TextSecondaryBrush}"
                                               FontWeight="SemiBold" FontSize="12" HorizontalAlignment="Center"/>
                                </Border>
                                <Border Grid.Row="2" Grid.Column="1" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,1,1" Padding="8,6">
                                    <TextBlock Text="{Binding Stats1Year_Rate1, StringFormat={}{0:P1}, TargetNullValue='-'}" HorizontalAlignment="Center" FontSize="12"/>
                                </Border>
                                <Border Grid.Row="2" Grid.Column="2" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,2,1" Padding="8,6">
                                    <TextBlock Text="{Binding Stats1Year_Count1, StringFormat={}{0:N0}, TargetNullValue='-'}" HorizontalAlignment="Center" FontSize="12"/>
                                </Border>
                                <Border Grid.Row="2" Grid.Column="3" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,1,1" Padding="8,6">
                                    <TextBlock Text="{Binding Stats1Year_Rate2, StringFormat={}{0:P1}, TargetNullValue='-'}" HorizontalAlignment="Center" FontSize="12"/>
                                </Border>
                                <Border Grid.Row="2" Grid.Column="4" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,2,1" Padding="8,6">
                                    <TextBlock Text="{Binding Stats1Year_Count2, StringFormat={}{0:N0}, TargetNullValue='-'}" HorizontalAlignment="Center" FontSize="12"/>
                                </Border>
                                <Border Grid.Row="2" Grid.Column="5" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,1,1" Padding="8,6">
                                    <TextBlock Text="{Binding Stats1Year_Rate3, StringFormat={}{0:P1}, TargetNullValue='-'}" HorizontalAlignment="Center" FontSize="12"/>
                                </Border>
                                <Border Grid.Row="2" Grid.Column="6" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,2,1" Padding="8,6">
                                    <TextBlock Text="{Binding Stats1Year_Count3, StringFormat={}{0:N0}, TargetNullValue='-'}" HorizontalAlignment="Center" FontSize="12"/>
                                </Border>

                                <!-- Row 2-4, Col 7: 적용낙찰가율 값 (RowSpan=3, 편집 가능) -->
                                <Border Grid.Row="2" Grid.Column="7" Grid.RowSpan="3"
                                        Background="#FFEEF5FF"
                                        Padding="8,4">
                                    <StackPanel Orientation="Horizontal"
                                                VerticalAlignment="Center" HorizontalAlignment="Center">
                                        <TextBox Text="{Binding AppliedBidRatePercent, StringFormat={}{0:N1}, Mode=TwoWay, UpdateSourceTrigger=LostFocus, TargetNullValue=''}"
                                                 FontSize="18" FontWeight="Bold"
                                                 Foreground="{StaticResource PrimaryBrush}"
                                                 HorizontalContentAlignment="Center"
                                                 BorderThickness="0,0,0,1"
                                                 BorderBrush="{StaticResource PrimaryBrush}"
                                                 Background="Transparent"
                                                 MinWidth="60"
                                                 Padding="4,2"/>
                                        <TextBlock Text="%"
                                                   FontSize="18" FontWeight="Bold"
                                                   Foreground="{StaticResource PrimaryBrush}"
                                                   VerticalAlignment="Center"
                                                   Margin="2,0,0,0"/>
                                    </StackPanel>
                                </Border>

                                <!-- Row 3: 6개월 평균 -->
                                <Border Grid.Row="3" Grid.Column="0"
                                        Background="{StaticResource BlueGray100Brush}"
                                        BorderBrush="{StaticResource BorderBrush}"
                                        BorderThickness="0,0,1,1" Padding="8,6">
                                    <TextBlock Text="6개월 평균" Foreground="{StaticResource TextSecondaryBrush}"
                                               FontWeight="SemiBold" FontSize="12" HorizontalAlignment="Center"/>
                                </Border>
                                <Border Grid.Row="3" Grid.Column="1" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,1,1" Padding="8,6">
                                    <TextBlock Text="{Binding Stats6Month_Rate1, StringFormat={}{0:P1}, TargetNullValue='-'}" HorizontalAlignment="Center" FontSize="12"/>
                                </Border>
                                <Border Grid.Row="3" Grid.Column="2" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,2,1" Padding="8,6">
                                    <TextBlock Text="{Binding Stats6Month_Count1, StringFormat={}{0:N0}, TargetNullValue='-'}" HorizontalAlignment="Center" FontSize="12"/>
                                </Border>
                                <Border Grid.Row="3" Grid.Column="3" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,1,1" Padding="8,6">
                                    <TextBlock Text="{Binding Stats6Month_Rate2, StringFormat={}{0:P1}, TargetNullValue='-'}" HorizontalAlignment="Center" FontSize="12"/>
                                </Border>
                                <Border Grid.Row="3" Grid.Column="4" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,2,1" Padding="8,6">
                                    <TextBlock Text="{Binding Stats6Month_Count2, StringFormat={}{0:N0}, TargetNullValue='-'}" HorizontalAlignment="Center" FontSize="12"/>
                                </Border>
                                <Border Grid.Row="3" Grid.Column="5" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,1,1" Padding="8,6">
                                    <TextBlock Text="{Binding Stats6Month_Rate3, StringFormat={}{0:P1}, TargetNullValue='-'}" HorizontalAlignment="Center" FontSize="12"/>
                                </Border>
                                <Border Grid.Row="3" Grid.Column="6" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,2,1" Padding="8,6">
                                    <TextBlock Text="{Binding Stats6Month_Count3, StringFormat={}{0:N0}, TargetNullValue='-'}" HorizontalAlignment="Center" FontSize="12"/>
                                </Border>

                                <!-- Row 4: 3개월 평균 -->
                                <Border Grid.Row="4" Grid.Column="0"
                                        Background="{StaticResource BlueGray100Brush}"
                                        BorderBrush="{StaticResource BorderBrush}"
                                        BorderThickness="0,0,1,0" Padding="8,6">
                                    <TextBlock Text="3개월 평균" Foreground="{StaticResource TextSecondaryBrush}"
                                               FontWeight="SemiBold" FontSize="12" HorizontalAlignment="Center"/>
                                </Border>
                                <Border Grid.Row="4" Grid.Column="1" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,1,0" Padding="8,6">
                                    <TextBlock Text="{Binding Stats3Month_Rate1, StringFormat={}{0:P1}, TargetNullValue='-'}" HorizontalAlignment="Center" FontSize="12"/>
                                </Border>
                                <Border Grid.Row="4" Grid.Column="2" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,2,0" Padding="8,6">
                                    <TextBlock Text="{Binding Stats3Month_Count1, StringFormat={}{0:N0}, TargetNullValue='-'}" HorizontalAlignment="Center" FontSize="12"/>
                                </Border>
                                <Border Grid.Row="4" Grid.Column="3" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,1,0" Padding="8,6">
                                    <TextBlock Text="{Binding Stats3Month_Rate2, StringFormat={}{0:P1}, TargetNullValue='-'}" HorizontalAlignment="Center" FontSize="12"/>
                                </Border>
                                <Border Grid.Row="4" Grid.Column="4" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,2,0" Padding="8,6">
                                    <TextBlock Text="{Binding Stats3Month_Count2, StringFormat={}{0:N0}, TargetNullValue='-'}" HorizontalAlignment="Center" FontSize="12"/>
                                </Border>
                                <Border Grid.Row="4" Grid.Column="5" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,1,0" Padding="8,6">
                                    <TextBlock Text="{Binding Stats3Month_Rate3, StringFormat={}{0:P1}, TargetNullValue='-'}" HorizontalAlignment="Center" FontSize="12"/>
                                </Border>
                                <Border Grid.Row="4" Grid.Column="6" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,2,0" Padding="8,6">
                                    <TextBlock Text="{Binding Stats3Month_Count3, StringFormat={}{0:N0}, TargetNullValue='-'}" HorizontalAlignment="Center" FontSize="12"/>
                                </Border>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- 탐문 내역 (공장/창고 + 상가/아파트형공장) -->
                    <Border Background="{StaticResource SurfaceColor}"
                            BorderBrush="{StaticResource BorderBrush}"
                            BorderThickness="1"
                            CornerRadius="8"
                            Margin="0,0,0,16"
                            Visibility="{Binding IsFactoryOrCommercialType, Converter={StaticResource BoolToVisibilityConverter}}">
                        <StackPanel>
                            <!-- 섹션 헤더 -->
                            <Border Background="{StaticResource PrimaryBrush}"
                                    CornerRadius="8,8,0,0"
                                    Padding="16,10">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <materialDesign:PackIcon Kind="PhoneInTalk" Width="18" Height="18"
                                                             Margin="0,0,6,0" VerticalAlignment="Center" Foreground="White"/>
                                    <TextBlock Text="탐문 내역"
                                               Foreground="White"
                                               FontWeight="SemiBold"
                                               FontSize="{StaticResource FontSizeH4}"/>
                                </StackPanel>
                            </Border>

                            <!-- 탐문 내역 DataGrid -->
                            <DataGrid x:Name="FactoryInquiryDataGrid"
                                      ItemsSource="{Binding InquiryRows}"
                                      AutoGenerateColumns="False"
                                      CanUserAddRows="False" CanUserDeleteRows="False"
                                      CanUserSortColumns="False"
                                      HeadersVisibility="Column"
                                      RowHeight="32"
                                      GridLinesVisibility="All"
                                      HorizontalGridLinesBrush="{StaticResource BorderBrush}"
                                      VerticalGridLinesBrush="{StaticResource BorderBrush}"
                                      BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                                      Background="White"
                                      RowBackground="White"
                                      AlternatingRowBackground="#FAFAFA"
                                      MinHeight="60"
                                      PreviewMouseWheel="DataGrid_PreviewMouseWheel">
                                <DataGrid.ColumnHeaderStyle>
                                    <StaticResource ResourceKey="SectionDataGridColumnHeaderStyle"/>
                                </DataGrid.ColumnHeaderStyle>
                                <DataGrid.CellStyle>
                                    <StaticResource ResourceKey="SectionDataGridCellStyle"/>
                                </DataGrid.CellStyle>
                                <DataGrid.RowStyle>
                                    <StaticResource ResourceKey="SectionDataGridRowStyle"/>
                                </DataGrid.RowStyle>
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="부동산명" Binding="{Binding RealEstateName, UpdateSourceTrigger=PropertyChanged}" Width="*"
                                                        ElementStyle="{StaticResource SectionDataGridTextBlockStyle}"
                                                        EditingElementStyle="{StaticResource SectionDataGridTextBoxStyle}"/>
                                    <DataGridTextColumn Header="연락처" Binding="{Binding ContactNumber, UpdateSourceTrigger=PropertyChanged}" Width="150"
                                                        ElementStyle="{StaticResource SectionDataGridTextBlockStyle}"
                                                        EditingElementStyle="{StaticResource SectionDataGridTextBoxStyle}"/>
                                    <DataGridTextColumn Header="탐문내역" Binding="{Binding InquiryDetails, UpdateSourceTrigger=PropertyChanged}" Width="2*"
                                                        ElementStyle="{StaticResource SectionDataGridTextBlockStyle}"
                                                        EditingElementStyle="{StaticResource SectionDataGridTextBoxStyle}"/>
                                </DataGrid.Columns>
                            </DataGrid>

                            <!-- 행 추가/삭제 버튼 -->
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,8">
                                <Button Command="{Binding AddInquiryRowCommand}"
                                        Style="{StaticResource MaterialDesignFlatButton}"
                                        Padding="6,2" Height="28" ToolTip="행 추가">
                                    <StackPanel Orientation="Horizontal">
                                        <materialDesign:PackIcon Kind="Plus" Width="14" Height="14" VerticalAlignment="Center"/>
                                        <TextBlock Text="행 추가" Margin="4,0,0,0" FontSize="{StaticResource FontSizeSmall}" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                                <Button Command="{Binding RemoveInquiryRowCommand}"
                                        CommandParameter="{Binding SelectedItem, ElementName=FactoryInquiryDataGrid}"
                                        Style="{StaticResource MaterialDesignFlatButton}"
                                        Foreground="{StaticResource ErrorBrush}"
                                        Padding="6,2" Height="28" Margin="4,0,8,0" ToolTip="선택 행 삭제">
                                    <StackPanel Orientation="Horizontal">
                                        <materialDesign:PackIcon Kind="Delete" Width="14" Height="14" VerticalAlignment="Center"/>
                                        <TextBlock Text="행 삭제" Margin="4,0,0,0" FontSize="{StaticResource FontSizeSmall}" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- 탐문 결과 (공장/창고 전용) -->
                    <Border Background="{StaticResource SurfaceColor}"
                            BorderBrush="{StaticResource BorderBrush}"
                            BorderThickness="1"
                            CornerRadius="8"
                            Margin="0,0,0,16"
                            Visibility="{Binding IsFactoryType, Converter={StaticResource BoolToVisibilityConverter}}">
                        <StackPanel>
                            <!-- 섹션 헤더 -->
                            <Border Background="{StaticResource PrimaryBrush}"
                                    CornerRadius="8,8,0,0"
                                    Padding="16,10">
                                <Grid>
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <materialDesign:PackIcon Kind="ClipboardTextOutline" Width="18" Height="18"
                                                                 Margin="0,0,6,0" VerticalAlignment="Center" Foreground="White"/>
                                        <TextBlock Text="탐문 결과"
                                                   Foreground="White"
                                                   FontWeight="SemiBold"
                                                   FontSize="{StaticResource FontSizeH4}"/>
                                    </StackPanel>
                                    <!-- 테이블 생성 버튼 -->
                                    <Button Content="+" FontSize="16" FontWeight="Bold"
                                            HorizontalAlignment="Right" VerticalAlignment="Center"
                                            Command="{Binding CreateInquiryResultTableCommand}"
                                            Visibility="{Binding HasInquiryResultTable, Converter={StaticResource InverseBooleanToVisibilityConverter}}"
                                            Background="Transparent" Foreground="White" BorderThickness="0"
                                            Padding="8,0" MinHeight="0" Height="20" Cursor="Hand"
                                            ToolTip="탐문 결과 테이블 생성"/>
                                    <!-- 테이블 제거 버튼 -->
                                    <Button Content="−" FontSize="16" FontWeight="Bold"
                                            HorizontalAlignment="Right" VerticalAlignment="Center"
                                            Command="{Binding DestroyInquiryResultTableCommand}"
                                            Visibility="{Binding HasInquiryResultTable, Converter={StaticResource BoolToVisibilityConverter}}"
                                            Background="Transparent" Foreground="White" BorderThickness="0"
                                            Padding="8,0" MinHeight="0" Height="20" Cursor="Hand"
                                            ToolTip="탐문 결과 테이블 제거"/>
                                </Grid>
                            </Border>

                            <!-- 탐문 결과 DataGrid -->
                            <DataGrid x:Name="FactoryInquiryResultDataGrid"
                                      ItemsSource="{Binding InquiryResultRows}"
                                      Visibility="{Binding HasInquiryResultTable, Converter={StaticResource BoolToVisibilityConverter}}"
                                      AutoGenerateColumns="False"
                                      CanUserAddRows="False" CanUserDeleteRows="False"
                                      CanUserSortColumns="False"
                                      HeadersVisibility="Column"
                                      RowHeight="32"
                                      GridLinesVisibility="All"
                                      HorizontalGridLinesBrush="{StaticResource BorderBrush}"
                                      VerticalGridLinesBrush="{StaticResource BorderBrush}"
                                      BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                                      Background="White"
                                      RowBackground="White"
                                      AlternatingRowBackground="#FAFAFA"
                                      MinHeight="60"
                                      PreviewMouseWheel="DataGrid_PreviewMouseWheel">
                                <DataGrid.ColumnHeaderStyle>
                                    <StaticResource ResourceKey="SectionDataGridColumnHeaderStyle"/>
                                </DataGrid.ColumnHeaderStyle>
                                <DataGrid.CellStyle>
                                    <StaticResource ResourceKey="SectionDataGridCellStyle"/>
                                </DataGrid.CellStyle>
                                <DataGrid.RowStyle>
                                    <StaticResource ResourceKey="SectionDataGridRowStyle"/>
                                </DataGrid.RowStyle>
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="구분" Binding="{Binding Category}" Width="100" IsReadOnly="True"
                                                        ElementStyle="{StaticResource SectionDataGridTextBlockStyle}"/>
                                    <DataGridTextColumn Header="감정가" Binding="{Binding AppraisedValue, UpdateSourceTrigger=PropertyChanged}" Width="*"
                                                        ElementStyle="{StaticResource SectionDataGridTextBlockStyle}"
                                                        EditingElementStyle="{StaticResource SectionDataGridTextBoxStyle}"/>
                                    <DataGridTextColumn Header="면적(평)" Binding="{Binding AreaPyeong, UpdateSourceTrigger=PropertyChanged}" Width="*"
                                                        ElementStyle="{StaticResource SectionDataGridTextBlockStyle}"
                                                        EditingElementStyle="{StaticResource SectionDataGridTextBoxStyle}"/>
                                    <DataGridTextColumn Header="단가" Binding="{Binding UnitPrice, UpdateSourceTrigger=PropertyChanged}" Width="*"
                                                        ElementStyle="{StaticResource SectionDataGridTextBlockStyle}"
                                                        EditingElementStyle="{StaticResource SectionDataGridTextBoxStyle}"/>
                                    <DataGridTextColumn Header="평가액" Binding="{Binding EvaluatedValue, UpdateSourceTrigger=PropertyChanged}" Width="*"
                                                        ElementStyle="{StaticResource SectionDataGridTextBlockStyle}"
                                                        EditingElementStyle="{StaticResource SectionDataGridTextBoxStyle}"/>
                                </DataGrid.Columns>
                            </DataGrid>
                        </StackPanel>
                    </Border>

                    <!-- 탐문 수익가치 (공장/창고 전용) -->
                    <Border Background="{StaticResource SurfaceColor}"
                            BorderBrush="{StaticResource BorderBrush}"
                            BorderThickness="1"
                            CornerRadius="8"
                            Margin="0,0,0,16"
                            Visibility="{Binding IsFactoryType, Converter={StaticResource BoolToVisibilityConverter}}">
                        <StackPanel>
                            <!-- 섹션 헤더 -->
                            <Border Background="{StaticResource PrimaryBrush}"
                                    CornerRadius="8,8,0,0"
                                    Padding="16,10">
                                <Grid>
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <materialDesign:PackIcon Kind="CurrencyUsd" Width="18" Height="18"
                                                                 Margin="0,0,6,0" VerticalAlignment="Center" Foreground="White"/>
                                        <TextBlock Text="탐문 수익가치"
                                                   Foreground="White"
                                                   FontWeight="SemiBold"
                                                   FontSize="{StaticResource FontSizeH4}"/>
                                    </StackPanel>
                                    <!-- 테이블 생성 버튼 -->
                                    <Button Content="+" FontSize="16" FontWeight="Bold"
                                            HorizontalAlignment="Right" VerticalAlignment="Center"
                                            Command="{Binding CreateInquiryProfitTableCommand}"
                                            Visibility="{Binding HasInquiryProfitTable, Converter={StaticResource InverseBooleanToVisibilityConverter}}"
                                            Background="Transparent" Foreground="White" BorderThickness="0"
                                            Padding="8,0" MinHeight="0" Height="20" Cursor="Hand"
                                            ToolTip="탐문 수익가치 테이블 생성"/>
                                    <!-- 테이블 제거 버튼 -->
                                    <Button Content="−" FontSize="16" FontWeight="Bold"
                                            HorizontalAlignment="Right" VerticalAlignment="Center"
                                            Command="{Binding DestroyInquiryProfitTableCommand}"
                                            Visibility="{Binding HasInquiryProfitTable, Converter={StaticResource BoolToVisibilityConverter}}"
                                            Background="Transparent" Foreground="White" BorderThickness="0"
                                            Padding="8,0" MinHeight="0" Height="20" Cursor="Hand"
                                            ToolTip="탐문 수익가치 테이블 제거"/>
                                </Grid>
                            </Border>

                            <!-- 4x9 Grid -->
                            <Grid Visibility="{Binding HasInquiryProfitTable, Converter={StaticResource BoolToVisibilityConverter}}"
                                  Background="White">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <!-- Row 0: 왼쪽 헤더 3개 + 오른쪽 헤더/데이터 -->
                                <Border Grid.Row="0" Grid.Column="0" Background="{StaticResource BlueGray100Brush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,1,1" Padding="8,6">
                                    <TextBlock Text="건물면적" HorizontalAlignment="Center" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}"/>
                                </Border>
                                <Border Grid.Row="0" Grid.Column="1" Background="{StaticResource BlueGray100Brush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,1,1" Padding="8,6">
                                    <TextBlock Text="평당임대료" HorizontalAlignment="Center" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}"/>
                                </Border>
