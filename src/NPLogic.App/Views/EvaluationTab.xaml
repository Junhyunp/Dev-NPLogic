<UserControl x:Class="NPLogic.Views.EvaluationTab"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:NPLogic.Views"
             xmlns:evalViews="clr-namespace:NPLogic.Views.Evaluation"
             xmlns:vm="clr-namespace:NPLogic.ViewModels"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             mc:Ignorable="d"
             d:DesignHeight="900" d:DesignWidth="1400"
             d:DataContext="{d:DesignInstance Type=vm:EvaluationTabViewModel}">

    <UserControl.Resources>
        <!-- 피드백 반영: 공통 스타일 참조로 통일 -->
        <!-- SectionHeader, LabelText, ValueText, AmountText, CardBorder 스타일은 Typography.xaml에서 참조 -->
        
        <!-- 로컬 별칭 (하위 호환성) -->
        <Style x:Key="SectionHeaderStyle" TargetType="TextBlock" BasedOn="{StaticResource SectionHeader}">
            <Setter Property="FontSize" Value="{StaticResource FontSizeH4}"/>
        </Style>
        <Style x:Key="LabelStyle" TargetType="TextBlock" BasedOn="{StaticResource LabelText}"/>
        <Style x:Key="ValueStyle" TargetType="TextBlock" BasedOn="{StaticResource ValueText}"/>
        <Style x:Key="AmountStyle" TargetType="TextBlock" BasedOn="{StaticResource AmountText}"/>
        <Style x:Key="CardStyle" TargetType="Border" BasedOn="{StaticResource CardBorder}">
            <Setter Property="Padding" Value="16"/>
        </Style>

        <!-- DataGrid 공통 스타일 (SeniorRightsView와 동일) -->
        <Style x:Key="SectionDataGridColumnHeaderStyle" TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="{StaticResource BlueGray100Brush}"/>
            <Setter Property="Padding" Value="8,6"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="0,0,1,1"/>
        </Style>
        <Style x:Key="SectionDataGridCellStyle" TargetType="DataGridCell">
            <Setter Property="Foreground" Value="Black"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="0,0,1,0"/>
            <Setter Property="Padding" Value="4,2"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Foreground" Value="Black"/>
                </Trigger>
                <Trigger Property="IsEditing" Value="True">
                    <Setter Property="Foreground" Value="Black"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="SectionDataGridRowStyle" TargetType="DataGridRow">
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Foreground" Value="Black"/>
        </Style>
        <Style x:Key="SectionDataGridTextBlockStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="{StaticResource FontSizeBody}"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="TextAlignment" Value="Center"/>
        </Style>
        <Style x:Key="SectionDataGridTextBoxStyle" TargetType="TextBox">
            <Setter Property="FontSize" Value="{StaticResource FontSizeBody}"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="TextAlignment" Value="Center"/>
            <Setter Property="VerticalAlignment" Value="Stretch"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Margin" Value="0"/>
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled"
                  Padding="12,8,12,12">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- 로딩 오버레이 -->
            <Border Grid.RowSpan="2" 
                    Background="{StaticResource OverlaySemiLightBrush}" 
                    Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibilityConverter}}"
                    Panel.ZIndex="100">
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                    <ProgressBar IsIndeterminate="True" Width="200" Height="4"/>
                    <TextBlock Text="로딩 중..." Margin="0,12,0,0" 
                               HorizontalAlignment="Center"
                               Style="{StaticResource BodyTextStyle}"/>
                </StackPanel>
            </Border>

            <!-- 헤더: 평가 유형 선택 -->
            <Border Grid.Row="0" Style="{StaticResource CardStyle}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Orientation="Horizontal">
                        <TextBlock Text="평가 유형 선택" 
                                   Style="{StaticResource SectionHeaderStyle}"
                                   Margin="0"/>
                    </StackPanel>

                    <!-- 평가 유형 라디오 버튼 -->
                    <StackPanel Grid.Column="1" Orientation="Horizontal" 
                                Margin="32,0,0,0"
                                VerticalAlignment="Center">
                        <RadioButton Content="1. 아파트" 
                                     IsChecked="{Binding IsApartmentType}"
                                     GroupName="EvaluationType"
                                     Margin="0,0,24,0"
                                     FontSize="{StaticResource FontSizeBody}"/>
                        <RadioButton Content="2. 연립다세대" 
                                     IsChecked="{Binding IsMultiFamilyType}"
                                     GroupName="EvaluationType"
                                     Margin="0,0,24,0"
                                     FontSize="{StaticResource FontSizeBody}"/>
                        <RadioButton Content="3. 공장/창고" 
                                     IsChecked="{Binding IsFactoryType}"
                                     GroupName="EvaluationType"
                                     Margin="0,0,24,0"
                                     FontSize="{StaticResource FontSizeBody}"/>
                        <RadioButton Content="4. 상가/아파트형공장" 
                                     IsChecked="{Binding IsCommercialType}"
                                     GroupName="EvaluationType"
                                     Margin="0,0,24,0"
                                     FontSize="{StaticResource FontSizeBody}"/>
                        <RadioButton Content="5. 주택/근린시설/토지/기타" 
                                     IsChecked="{Binding IsHouseLandType}"
                                     GroupName="EvaluationType"
                                     FontSize="{StaticResource FontSizeBody}"/>
                    </StackPanel>

                    <Button Grid.Column="2" Content="저장"
                            Command="{Binding SaveCommand}"
                            Style="{StaticResource MaterialDesignRaisedButton}"
                            Padding="12,6"/>
                </Grid>
            </Border>

            <!-- 메인 콘텐츠 -->
            <StackPanel Grid.Row="1">
                    
                    <!-- 사례지도 및 실거래가 통합 영역 -->
                    <Border Background="{StaticResource SurfaceColor}"
                            BorderBrush="{StaticResource BorderBrush}"
                            BorderThickness="1"
                            CornerRadius="8"
                            Margin="0,0,0,16">
                        <StackPanel>
                            <!-- 섹션 헤더 -->
                            <Border Background="{StaticResource PrimaryBrush}"
                                    CornerRadius="8,8,0,0"
                                    Padding="16,10">
                                <Grid>
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <materialDesign:PackIcon Kind="MapMarkerRadius" Width="18" Height="18"
                                                                 Margin="0,0,6,0" VerticalAlignment="Center" Foreground="White"/>
                                        <TextBlock Text="사례지도 및 실거래가"
                                                   Foreground="White"
                                                   FontWeight="SemiBold"
                                                   FontSize="{StaticResource FontSizeH4}"/>
                                    </StackPanel>
                                    <Button Content="가져오기"
                                            Command="{Binding LoadCaseMapCommand}"
                                            Padding="12,4"
                                            FontSize="{StaticResource FontSizeBody}"
                                            HorizontalAlignment="Right"
                                            VerticalAlignment="Center"/>
                                </Grid>
                            </Border>

                            <!-- 좌: 사례지도 / 우: 실거래가 DataGrid -->
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="2"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <!-- 좌측: 사례지도 -->
                                <Border Grid.Column="0"
                                        Background="{StaticResource BlueGray50Brush}"
                                        MinHeight="200"
                                        Cursor="Hand"
                                        MouseLeftButtonUp="MapPlaceholder_MouseLeftButtonUp"
                                        ToolTip="클릭하여 확대">
                                    <TextBlock Text="소재지 기준으로 위치, 본건기준거래 자동 산정 및 표시"
                                               Style="{StaticResource BodyTextStyle}"
                                               Opacity="0.6"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"/>
                                </Border>

                                <!-- 굵은 세로 구분선 -->
                                <Border Grid.Column="1" Background="{StaticResource BorderBrush}" Width="2"/>

                                <!-- 우측: 실거래가 DataGrid -->
                                <DataGrid Grid.Column="2"
                                          x:Name="RealTransactionGrid"
                                          PreviewMouseWheel="DataGrid_SmartScrollMouseWheel"
                                          ItemsSource="{Binding RealTransactions}"
                                          AutoGenerateColumns="False"
                                          CanUserAddRows="False"
                                          CanUserDeleteRows="False"
                                          CanUserSortColumns="False"
                                          HeadersVisibility="Column"
                                          GridLinesVisibility="All"
                                          BorderThickness="0"
                                          SelectionUnit="Cell"
                                          SelectionMode="Single"
                                          HorizontalGridLinesBrush="{StaticResource BorderBrush}"
                                          VerticalGridLinesBrush="{StaticResource BorderBrush}"
                                          RowHeight="32"
                                          ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                          ScrollViewer.VerticalScrollBarVisibility="Auto"
                                          MaxHeight="360"
                                          MinHeight="200">
                                    <DataGrid.ColumnHeaderStyle>
                                        <StaticResource ResourceKey="SectionDataGridColumnHeaderStyle"/>
                                    </DataGrid.ColumnHeaderStyle>
                                    <DataGrid.CellStyle>
                                        <StaticResource ResourceKey="SectionDataGridCellStyle"/>
                                    </DataGrid.CellStyle>
                                    <DataGrid.RowStyle>
                                        <StaticResource ResourceKey="SectionDataGridRowStyle"/>
                                    </DataGrid.RowStyle>
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="거래면적(㎡)" Binding="{Binding Area, StringFormat=N2}" Width="*" IsReadOnly="True"
                                                            ElementStyle="{StaticResource SectionDataGridTextBlockStyle}"/>
                                        <DataGridTextColumn Header="거래일자" Binding="{Binding TransactionDate, StringFormat=yyyy-MM-dd}" Width="*" IsReadOnly="True"
                                                            ElementStyle="{StaticResource SectionDataGridTextBlockStyle}"/>
                                        <DataGridTextColumn Header="거래금액(만원)" Binding="{Binding Amount, StringFormat=N0}" Width="*" IsReadOnly="True"
                                                            ElementStyle="{StaticResource SectionDataGridTextBlockStyle}"/>
                                        <DataGridTextColumn Header="층수" Binding="{Binding Floor}" Width="80" IsReadOnly="True"
                                                            ElementStyle="{StaticResource SectionDataGridTextBlockStyle}"/>
                                        <DataGridTextColumn Header="등기여부" Binding="{Binding IsRegistered}" Width="80" IsReadOnly="True"
                                                            ElementStyle="{StaticResource SectionDataGridTextBlockStyle}"/>
                                        <DataGridTemplateColumn Header="적용" Width="60">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <CheckBox IsChecked="{Binding IsApplied, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                              HorizontalAlignment="Center" VerticalAlignment="Center"
                                                              IsHitTestVisible="True"
                                                              Focusable="True"/>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                    </DataGrid.Columns>
                                </DataGrid>
                            </Grid>

                            <!-- 거래 추이 차트 영역 -->
                            <Grid Margin="0,0,0,16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="200"/>
                                </Grid.RowDefinitions>

                                <!-- 헤더: 거래가격 추이 -->
                                <Border Grid.Row="0" Grid.Column="0"
                                        Background="{StaticResource BlueGray100Brush}"
                                        BorderBrush="{StaticResource BorderBrush}"
                                        BorderThickness="0,0,1,1"
                                        Padding="8,6">
                                    <TextBlock Text="거래가격 추이"
                                               Foreground="{StaticResource TextSecondaryBrush}"
                                               FontWeight="SemiBold" FontSize="12"
                                               HorizontalAlignment="Center"/>
                                </Border>

                                <!-- 헤더: 거래건수 추이 -->
                                <Border Grid.Row="0" Grid.Column="1"
                                        Background="{StaticResource BlueGray100Brush}"
                                        BorderBrush="{StaticResource BorderBrush}"
                                        BorderThickness="0,0,0,1"
                                        Padding="8,6">
                                    <TextBlock Text="거래건수 추이"
                                               Foreground="{StaticResource TextSecondaryBrush}"
                                               FontWeight="SemiBold" FontSize="12"
                                               HorizontalAlignment="Center"/>
                                </Border>

                                <!-- 차트 자리: 거래가격 추이 -->
                                <Border Grid.Row="1" Grid.Column="0"
                                        BorderBrush="{StaticResource BorderBrush}"
                                        BorderThickness="1,0,0.5,1"
                                        Background="{StaticResource SurfaceColor}">
                                    <TextBlock Text="차트 영역"
                                               Foreground="{StaticResource TextSecondaryBrush}"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"
                                               FontSize="12"/>
                                </Border>

                                <!-- 차트 자리: 거래건수 추이 -->
                                <Border Grid.Row="1" Grid.Column="1"
                                        BorderBrush="{StaticResource BorderBrush}"
                                        BorderThickness="0.5,0,1,1"
                                        Background="{StaticResource SurfaceColor}">
                                    <TextBlock Text="차트 영역"
                                               Foreground="{StaticResource TextSecondaryBrush}"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"
                                               FontSize="12"/>
                                </Border>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- 사례평가 영역 -->
                    <Border Background="{StaticResource SurfaceColor}"
                            BorderBrush="{StaticResource BorderBrush}"
                            BorderThickness="1"
                            CornerRadius="8"
                            Margin="0,0,0,16">
                        <StackPanel>
                            <!-- 섹션 헤더 -->
                            <Border Background="{StaticResource PrimaryBrush}"
                                    CornerRadius="8,8,0,0"
                                    Padding="16,10">
                                <Grid>
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <materialDesign:PackIcon Kind="ChartBox" Width="18" Height="18"
                                                                 Margin="0,0,6,0" VerticalAlignment="Center" Foreground="White"/>
                                        <TextBlock Text="사례평가"
                                                   Foreground="White"
                                                   FontWeight="SemiBold"
                                                   FontSize="{StaticResource FontSizeH4}"/>
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <!-- 사례평가 테이블 -->
                            <DataGrid x:Name="CaseEvaluationGrid"
                                      PreviewMouseWheel="DataGrid_PreviewMouseWheel"
                                      ItemsSource="{Binding CaseItems}"
                                      AutoGenerateColumns="False"
                                      CanUserAddRows="False"
                                      CanUserDeleteRows="False"
                                      CanUserSortColumns="False"
                                      HeadersVisibility="Column"
                                      GridLinesVisibility="All"
                                      BorderThickness="0"
                                      SelectionUnit="Cell"
                                      SelectionMode="Single"
                                      HorizontalGridLinesBrush="{StaticResource BorderBrush}"
                                      VerticalGridLinesBrush="{StaticResource BorderBrush}"
                                      RowHeight="32"
                                      ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                      MinHeight="60">
                                <DataGrid.ColumnHeaderStyle>
                                    <StaticResource ResourceKey="SectionDataGridColumnHeaderStyle"/>
                                </DataGrid.ColumnHeaderStyle>
                                <DataGrid.CellStyle>
                                    <StaticResource ResourceKey="SectionDataGridCellStyle"/>
                                </DataGrid.CellStyle>
                                <DataGrid.RowStyle>
                                    <StaticResource ResourceKey="SectionDataGridRowStyle"/>
                                </DataGrid.RowStyle>
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="구분" Binding="{Binding Label}" Width="140" IsReadOnly="True"
                                                        ElementStyle="{StaticResource SectionDataGridTextBlockStyle}"/>
                                    <DataGridTextColumn Header="본건 감정가" Binding="{Binding BaseValue}" Width="*" IsReadOnly="True"
                                                        ElementStyle="{StaticResource SectionDataGridTextBlockStyle}"/>
                                    <DataGridTextColumn Header="사례 1" Binding="{Binding Case1Value}" Width="*" IsReadOnly="True"
                                                        ElementStyle="{StaticResource SectionDataGridTextBlockStyle}"/>
                                    <DataGridTextColumn Header="사례 2" Binding="{Binding Case2Value}" Width="*" IsReadOnly="True"
                                                        ElementStyle="{StaticResource SectionDataGridTextBlockStyle}"/>
                                    <DataGridTextColumn Header="사례 3" Binding="{Binding Case3Value}" Width="*" IsReadOnly="True"
                                                        ElementStyle="{StaticResource SectionDataGridTextBlockStyle}"/>
                                    <DataGridTextColumn Header="사례 4" Binding="{Binding Case4Value}" Width="*" IsReadOnly="True"
                                                        ElementStyle="{StaticResource SectionDataGridTextBlockStyle}"/>
                                </DataGrid.Columns>
                            </DataGrid>
                        </StackPanel>
                    </Border>

                    <!-- 경매사건검색 영역 -->
                    <Border Background="{StaticResource SurfaceColor}"
                            BorderBrush="{StaticResource BorderBrush}"
                            BorderThickness="1"
                            CornerRadius="8"
                            Margin="0,0,0,16">
                        <StackPanel>
                            <!-- 섹션 헤더 -->
                            <Border Background="{StaticResource PrimaryBrush}"
                                    CornerRadius="8,8,0,0"
                                    Padding="16,10">
                                <Grid>
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <materialDesign:PackIcon Kind="Gavel" Width="18" Height="18"
                                                                 Margin="0,0,6,0" VerticalAlignment="Center" Foreground="White"/>
                                        <TextBlock Text="경매사건검색"
                                                   Foreground="White"
                                                   FontWeight="SemiBold"
                                                   FontSize="{StaticResource FontSizeH4}"/>
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <!-- 경매사건 사례 테이블 -->
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="200"/>
                                </Grid.RowDefinitions>

                                <!-- 헤더: 사례1 -->
                                <Border Grid.Row="0" Grid.Column="0"
                                        Background="{StaticResource BlueGray100Brush}"
                                        BorderBrush="{StaticResource BorderBrush}"
                                        BorderThickness="0,0,1,1"
                                        Padding="8,6">
                                    <TextBlock Text="사례1"
                                               Foreground="{StaticResource TextSecondaryBrush}"
                                               FontWeight="SemiBold" FontSize="12"
                                               HorizontalAlignment="Center"/>
                                </Border>

                                <!-- 헤더: 사례2 -->
                                <Border Grid.Row="0" Grid.Column="1"
                                        Background="{StaticResource BlueGray100Brush}"
                                        BorderBrush="{StaticResource BorderBrush}"
                                        BorderThickness="0,0,0,1"
                                        Padding="8,6">
                                    <TextBlock Text="사례2"
                                               Foreground="{StaticResource TextSecondaryBrush}"
                                               FontWeight="SemiBold" FontSize="12"
                                               HorizontalAlignment="Center"/>
                                </Border>

                                <!-- 사례1 정보 -->
                                <Border Grid.Row="1" Grid.Column="0"
                                        BorderBrush="{StaticResource BorderBrush}"
                                        BorderThickness="0,0,1,0"
                                        Background="{StaticResource SurfaceColor}">
                                    <TextBlock Text="사례 정보"
                                               Foreground="{StaticResource TextSecondaryBrush}"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"
                                               FontSize="12"/>
                                </Border>

                                <!-- 사례2 정보 -->
                                <Border Grid.Row="1" Grid.Column="1"
                                        Background="{StaticResource SurfaceColor}">
                                    <TextBlock Text="사례 정보"
                                               Foreground="{StaticResource TextSecondaryBrush}"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"
                                               FontSize="12"/>
                                </Border>
                            </Grid>
                        </StackPanel>
                    </Border>

                <!-- 낙찰통계 + 평가결과 -->

                    <!-- 낙찰통계 영역 -->
                    <Border Background="{StaticResource SurfaceColor}"
                            BorderBrush="{StaticResource BorderBrush}"
                            BorderThickness="1"
                            CornerRadius="8"
                            Margin="0,0,0,16">
                        <StackPanel>
                            <!-- 섹션 헤더 -->
                            <Border Background="{StaticResource PrimaryBrush}"
                                    CornerRadius="8,8,0,0"
                                    Padding="16,10">
                                <Grid>
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <materialDesign:PackIcon Kind="ChartBar" Width="18" Height="18"
                                                                 Margin="0,0,6,0" VerticalAlignment="Center" Foreground="White"/>
                                        <TextBlock Text="낙찰통계"
                                                   Foreground="White"
                                                   FontWeight="SemiBold"
                                                   FontSize="{StaticResource FontSizeH4}"/>
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <!-- 5x10 낙찰통계 테이블 -->
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="100"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <!-- Row 0, Col 0 + Row 1, Col 0: 지역통계 (RowSpan=2) -->
                                <Border Grid.Row="0" Grid.Column="0" Grid.RowSpan="2"
                                        Background="{StaticResource BlueGray100Brush}"
                                        BorderBrush="{StaticResource BlueGray300Brush}"
                                        BorderThickness="0,0,2,1"
                                        Padding="8,6">
                                    <TextBlock Text="지역통계"
                                               Foreground="{StaticResource TextSecondaryBrush}"
                                               FontWeight="SemiBold" FontSize="12"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>

                                <!-- Row 0, Col 1-3: 시/도 -->
                                <Border Grid.Row="0" Grid.Column="1" Grid.ColumnSpan="3"
                                        Background="{StaticResource BlueGray200Brush}"
                                        BorderBrush="{StaticResource BlueGray300Brush}"
                                        BorderThickness="0,0,2,2"
                                        Padding="8,6">
                                    <TextBlock Text="{Binding RegionName1}"
                                               Foreground="{StaticResource TextSecondaryBrush}"
                                               FontWeight="SemiBold" FontSize="12"
                                               HorizontalAlignment="Center"/>
                                </Border>

                                <!-- Row 0, Col 4-6: 구/군 -->
                                <Border Grid.Row="0" Grid.Column="4" Grid.ColumnSpan="3"
                                        Background="{StaticResource BlueGray100Brush}"
                                        BorderBrush="{StaticResource BlueGray300Brush}"
                                        BorderThickness="0,0,2,2"
                                        Padding="8,6">
                                    <TextBlock Text="{Binding RegionName2}"
                                               Foreground="{StaticResource TextSecondaryBrush}"
                                               FontWeight="SemiBold" FontSize="12"
                                               HorizontalAlignment="Center"/>
                                </Border>

                                <!-- Row 0, Col 7-9: 동 -->
                                <Border Grid.Row="0" Grid.Column="7" Grid.ColumnSpan="3"
                                        Background="{StaticResource BlueGray50Brush}"
                                        BorderBrush="{StaticResource BlueGray300Brush}"
                                        BorderThickness="0,0,0,2"
                                        Padding="8,6">
                                    <TextBlock Text="{Binding RegionName3}"
                                               Foreground="{StaticResource TextSecondaryBrush}"
                                               FontWeight="SemiBold" FontSize="12"
                                               HorizontalAlignment="Center"/>
                                </Border>

                                <!-- Row 1: 시/도 하위 헤더 -->
                                <Border Grid.Row="1" Grid.Column="1"
                                        Background="{StaticResource BlueGray200Brush}"
                                        BorderBrush="{StaticResource BlueGray300Brush}"
                                        BorderThickness="0,0,1,1" Padding="8,6">
                                    <TextBlock Text="낙찰가율" Foreground="{StaticResource TextSecondaryBrush}"
                                               FontWeight="SemiBold" FontSize="12" HorizontalAlignment="Center"/>
                                </Border>
                                <Border Grid.Row="1" Grid.Column="2"
                                        Background="{StaticResource BlueGray200Brush}"
                                        BorderBrush="{StaticResource BlueGray300Brush}"
                                        BorderThickness="0,0,1,1" Padding="8,6">
                                    <TextBlock Text="낙찰률 평균" Foreground="{StaticResource TextSecondaryBrush}"
                                               FontWeight="SemiBold" FontSize="12" HorizontalAlignment="Center"/>
                                </Border>
                                <Border Grid.Row="1" Grid.Column="3"
                                        Background="{StaticResource BlueGray200Brush}"
                                        BorderBrush="{StaticResource BlueGray300Brush}"
                                        BorderThickness="0,0,2,1" Padding="8,6">
                                    <TextBlock Text="낙찰건수" Foreground="{StaticResource TextSecondaryBrush}"
                                               FontWeight="SemiBold" FontSize="12" HorizontalAlignment="Center"/>
                                </Border>

