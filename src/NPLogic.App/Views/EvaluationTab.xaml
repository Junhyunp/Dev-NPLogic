                                    <TextBlock Text="" FontSize="12" HorizontalAlignment="Center"/>
                                </Border>
                                <Border Grid.Row="2" Grid.Column="2" BorderBrush="{StaticResource BlueGray200Brush}" BorderThickness="0,0,1,0" Padding="8,8">
                                    <TextBlock Text="" FontSize="12" HorizontalAlignment="Center"/>
                                </Border>
                                <Border Grid.Row="2" Grid.Column="3" BorderBrush="{StaticResource BlueGray200Brush}" BorderThickness="0,0,1,0" Padding="8,8">
                                    <TextBlock Text="" FontSize="12" HorizontalAlignment="Center"/>
                                </Border>
                                <Border Grid.Row="2" Grid.Column="4" BorderBrush="{StaticResource BlueGray200Brush}" BorderThickness="0,0,1,0" Padding="8,8">
                                    <TextBlock Text="" FontSize="12" HorizontalAlignment="Center"/>
                                </Border>
                                <Border Grid.Row="2" Grid.Column="5" Padding="8,8">
                                    <TextBlock Text="" FontSize="12" HorizontalAlignment="Center"/>
                                </Border>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- 회수 전략 요약 + 인터림 섹션들 (연립다세대 제외) -->
                    <StackPanel Visibility="{Binding IsMultiFamilyType, Converter={StaticResource InverseBoolToVisibilityConverter}}">

                    <!-- 회수 전략 요약 (차주별 첫 번째 물건에만 표시) -->
                    <Border Background="{StaticResource SurfaceColor}"
                            BorderBrush="{StaticResource BorderBrush}"
                            BorderThickness="1"
                            CornerRadius="8"
                            Margin="0,0,0,16"
                            Visibility="{Binding IsFirstPropertyInBorrower, Converter={StaticResource BoolToVisibilityConverter}}">
                        <StackPanel>
                            <!-- 섹션 헤더 -->
                            <Border Background="{StaticResource PrimaryBrush}"
                                    CornerRadius="8,8,0,0"
                                    Padding="16,10">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <materialDesign:PackIcon Kind="ShieldCheckOutline" Width="18" Height="18"
                                                             Margin="0,0,6,0" VerticalAlignment="Center" Foreground="White"/>
                                    <TextBlock Text="회수 전략 요약"
                                               Foreground="White"
                                               FontWeight="SemiBold"
                                               FontSize="{StaticResource FontSizeH4}"/>
                                </StackPanel>
                            </Border>

                            <!-- 시나리오 1 (좌) + 시나리오 2 (우) 병렬 테이블 -->
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <!-- ===== 시나리오 1 (좌측) ===== -->
                                <Border Grid.Column="0" BorderBrush="{StaticResource BlueGray300Brush}" BorderThickness="0,0,2,0">
                                    <StackPanel>
                                        <!-- Row 0 (시나리오 라벨 + Cap) + Row 1 (컬럼 헤더) 통합 Grid -->
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                            </Grid.RowDefinitions>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="160"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="120"/>
                                            </Grid.ColumnDefinitions>
                                            <!-- Row 0: 시나리오 라벨 + Cap 적용 여부 -->
                                            <Border Grid.Row="0" Grid.Column="0" Background="{StaticResource PrimaryBrush}" BorderBrush="{StaticResource BlueGray300Brush}" BorderThickness="0,0,1,2" Padding="8,8">
                                                <TextBlock Text="시나리오 1" FontSize="12" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center"/>
                                            </Border>
                                            <Border Grid.Row="0" Grid.Column="1" BorderBrush="{StaticResource BlueGray300Brush}" BorderThickness="0,0,1,2" Padding="8,8">
                                                <TextBlock Text="" FontSize="12" HorizontalAlignment="Center"/>
                                            </Border>
                                            <Border Grid.Row="0" Grid.Column="2" Background="{StaticResource BlueGray100Brush}" BorderBrush="{StaticResource BlueGray300Brush}" BorderThickness="0,0,1,2" Padding="8,8">
                                                <TextBlock Text="Cap 적용 여부" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}" HorizontalAlignment="Center"/>
                                            </Border>
                                            <Border Grid.Row="0" Grid.Column="3" BorderBrush="{StaticResource BlueGray300Brush}" BorderThickness="0,0,0,2" Padding="4,4">
                                                <ComboBox ItemsSource="{Binding CapTypeOptions}"
                                                          SelectedItem="{Binding Scenario1CapType}"
                                                          FontSize="12" BorderThickness="0"
                                                          HorizontalContentAlignment="Center"/>
                                            </Border>
                                            <!-- Row 1: 컬럼 헤더 -->
                                            <Border Grid.Row="1" Grid.Column="0" Background="{StaticResource BlueGray100Brush}" BorderBrush="{StaticResource BlueGray200Brush}" BorderThickness="0,0,1,1" Padding="8,6">
                                                <TextBlock Text="구분" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}" HorizontalAlignment="Center"/>
                                            </Border>
                                            <Border Grid.Row="1" Grid.Column="1" Background="{StaticResource BlueGray100Brush}" BorderBrush="{StaticResource BlueGray200Brush}" BorderThickness="0,0,1,1" Padding="8,6">
                                                <TextBlock Text="CF in date" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}" HorizontalAlignment="Center"/>
                                            </Border>
                                            <Border Grid.Row="1" Grid.Column="2" Background="{StaticResource BlueGray100Brush}" BorderBrush="{StaticResource BlueGray200Brush}" BorderThickness="0,0,1,1" Padding="8,6">
                                                <TextBlock Text="Cash in/out" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}" HorizontalAlignment="Center"/>
                                            </Border>
                                            <Border Grid.Row="1" Grid.Column="3" Background="{StaticResource BlueGray100Brush}" BorderBrush="{StaticResource BlueGray200Brush}" BorderThickness="0,0,0,1" Padding="8,6">
                                                <TextBlock Text="Ratio" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}" HorizontalAlignment="Center"/>
                                            </Border>
                                        </Grid>

                                        <!-- 동적 데이터 행 -->
                                        <ItemsControl ItemsSource="{Binding RecoveryStrategyRows}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="160"/>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="120"/>
                                                        </Grid.ColumnDefinitions>
                                                        <Border Grid.Column="0" Background="{StaticResource BlueGray100Brush}" BorderBrush="{StaticResource BlueGray200Brush}" BorderThickness="0,0,1,1" Padding="8,6">
                                                            <TextBlock Text="{Binding Label}" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}" HorizontalAlignment="Center"/>
                                                        </Border>
                                                        <Border Grid.Column="1" BorderBrush="{StaticResource BlueGray200Brush}" BorderThickness="0,0,1,1" Padding="8,6">
                                                            <TextBlock Text="{Binding S1CfDate}" FontSize="12" HorizontalAlignment="Center"/>
                                                        </Border>
                                                        <Border Grid.Column="2" BorderBrush="{StaticResource BlueGray200Brush}" BorderThickness="0,0,1,1" Padding="8,6">
                                                            <TextBlock Text="{Binding S1CashInOut}" FontSize="12" HorizontalAlignment="Center"/>
                                                        </Border>
                                                        <Border Grid.Column="3" BorderBrush="{StaticResource BlueGray200Brush}" BorderThickness="0,0,0,1" Padding="8,6">
                                                            <TextBlock Text="{Binding S1Ratio}" FontSize="12" HorizontalAlignment="Center"/>
                                                        </Border>
                                                    </Grid>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </Border>

                                <!-- ===== 시나리오 2 (우측) ===== -->
                                <Border Grid.Column="1">
                                    <StackPanel>
                                        <!-- Row 0 (시나리오 라벨 + Cap) + Row 1 (컬럼 헤더) 통합 Grid -->
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                            </Grid.RowDefinitions>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="160"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="120"/>
                                            </Grid.ColumnDefinitions>
                                            <!-- Row 0: 시나리오 라벨 + Cap 적용 여부 -->
                                            <Border Grid.Row="0" Grid.Column="0" Background="{StaticResource SecondaryBrush}" BorderBrush="{StaticResource BlueGray300Brush}" BorderThickness="0,0,1,2" Padding="8,8">
                                                <TextBlock Text="시나리오 2" FontSize="12" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center"/>
                                            </Border>
                                            <Border Grid.Row="0" Grid.Column="1" BorderBrush="{StaticResource BlueGray300Brush}" BorderThickness="0,0,1,2" Padding="8,8">
                                                <TextBlock Text="" FontSize="12" HorizontalAlignment="Center"/>
                                            </Border>
                                            <Border Grid.Row="0" Grid.Column="2" Background="{StaticResource BlueGray100Brush}" BorderBrush="{StaticResource BlueGray300Brush}" BorderThickness="0,0,1,2" Padding="8,8">
                                                <TextBlock Text="Cap 적용 여부" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}" HorizontalAlignment="Center"/>
                                            </Border>
                                            <Border Grid.Row="0" Grid.Column="3" BorderBrush="{StaticResource BlueGray300Brush}" BorderThickness="0,0,0,2" Padding="4,4">
                                                <ComboBox ItemsSource="{Binding CapTypeOptions}"
                                                          SelectedItem="{Binding Scenario2CapType}"
                                                          FontSize="12" BorderThickness="0"
                                                          HorizontalContentAlignment="Center"/>
                                            </Border>
                                            <!-- Row 1: 컬럼 헤더 -->
                                            <Border Grid.Row="1" Grid.Column="0" Background="{StaticResource BlueGray100Brush}" BorderBrush="{StaticResource BlueGray200Brush}" BorderThickness="0,0,1,1" Padding="8,6">
                                                <TextBlock Text="구분" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}" HorizontalAlignment="Center"/>
                                            </Border>
                                            <Border Grid.Row="1" Grid.Column="1" Background="{StaticResource BlueGray100Brush}" BorderBrush="{StaticResource BlueGray200Brush}" BorderThickness="0,0,1,1" Padding="8,6">
                                                <TextBlock Text="CF in date" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}" HorizontalAlignment="Center"/>
                                            </Border>
                                            <Border Grid.Row="1" Grid.Column="2" Background="{StaticResource BlueGray100Brush}" BorderBrush="{StaticResource BlueGray200Brush}" BorderThickness="0,0,1,1" Padding="8,6">
                                                <TextBlock Text="Cash in/out" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}" HorizontalAlignment="Center"/>
                                            </Border>
                                            <Border Grid.Row="1" Grid.Column="3" Background="{StaticResource BlueGray100Brush}" BorderBrush="{StaticResource BlueGray200Brush}" BorderThickness="0,0,0,1" Padding="8,6">
                                                <TextBlock Text="Ratio" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}" HorizontalAlignment="Center"/>
                                            </Border>
                                        </Grid>

                                        <!-- 동적 데이터 행 -->
                                        <ItemsControl ItemsSource="{Binding RecoveryStrategyRows}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="160"/>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="120"/>
                                                        </Grid.ColumnDefinitions>
                                                        <Border Grid.Column="0" Background="{StaticResource BlueGray100Brush}" BorderBrush="{StaticResource BlueGray200Brush}" BorderThickness="0,0,1,1" Padding="8,6">
                                                            <TextBlock Text="{Binding Label}" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}" HorizontalAlignment="Center"/>
                                                        </Border>
                                                        <Border Grid.Column="1" BorderBrush="{StaticResource BlueGray200Brush}" BorderThickness="0,0,1,1" Padding="8,6">
                                                            <TextBlock Text="{Binding S2CfDate}" FontSize="12" HorizontalAlignment="Center"/>
                                                        </Border>
                                                        <Border Grid.Column="2" BorderBrush="{StaticResource BlueGray200Brush}" BorderThickness="0,0,1,1" Padding="8,6">
                                                            <TextBlock Text="{Binding S2CashInOut}" FontSize="12" HorizontalAlignment="Center"/>
                                                        </Border>
                                                        <Border Grid.Column="3" BorderBrush="{StaticResource BlueGray200Brush}" BorderThickness="0,0,0,1" Padding="8,6">
                                                            <TextBlock Text="{Binding S2Ratio}" FontSize="12" HorizontalAlignment="Center"/>
                                                        </Border>
                                                    </Grid>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </Border>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- 인터림 상계/회수 (모든 물건 공통 표시) -->
                    <Border Background="{StaticResource SurfaceColor}"
                            BorderBrush="{StaticResource BorderBrush}"
                            BorderThickness="1"
                            CornerRadius="8"
                            Margin="0,0,0,16">
                        <StackPanel>
                            <!-- 섹션 헤더 -->
                            <Border Background="{StaticResource PrimaryBrush}"
                                    CornerRadius="8,8,0,0"
                                    Padding="16,10">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <materialDesign:PackIcon Kind="SwapHorizontal" Width="18" Height="18"
                                                             Margin="0,0,6,0" VerticalAlignment="Center" Foreground="White"/>
                                    <TextBlock Text="인터림 상계/회수"
                                               Foreground="White"
                                               FontWeight="SemiBold"
                                               FontSize="{StaticResource FontSizeH4}"/>
                                </StackPanel>
                            </Border>

                            <!-- 16열 테이블 -->
                            <DataGrid ItemsSource="{Binding InterimRecoveryRows}"
                                      PreviewMouseWheel="DataGrid_PreviewMouseWheel"
                                      AutoGenerateColumns="False"
                                      CanUserAddRows="False"
                                      CanUserDeleteRows="False"
                                      CanUserSortColumns="False"
                                      HeadersVisibility="Column"
                                      GridLinesVisibility="All"
                                      BorderThickness="0"
                                      HorizontalGridLinesBrush="{StaticResource BorderBrush}"
                                      VerticalGridLinesBrush="{StaticResource BorderBrush}"
                                      RowHeight="32"
                                      IsReadOnly="True"
                                      ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                      ScrollViewer.VerticalScrollBarVisibility="Disabled"
                                      MinHeight="60">
                                <DataGrid.ColumnHeaderStyle>
                                    <StaticResource ResourceKey="SectionDataGridColumnHeaderStyle"/>
                                </DataGrid.ColumnHeaderStyle>
                                <DataGrid.CellStyle>
                                    <StaticResource ResourceKey="SectionDataGridCellStyle"/>
                                </DataGrid.CellStyle>
                                <DataGrid.RowStyle>
                                    <StaticResource ResourceKey="SectionDataGridRowStyle"/>
                                </DataGrid.RowStyle>
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="차주일련번호" Binding="{Binding BorrowerNumber}" Width="*" IsReadOnly="True"
                                                        ElementStyle="{StaticResource SectionDataGridTextBlockStyle}"/>
                                    <DataGridTextColumn Header="차주명" Binding="{Binding BorrowerName}" Width="*" IsReadOnly="True"
                                                        ElementStyle="{StaticResource SectionDataGridTextBlockStyle}"/>
                                    <DataGridTextColumn Header="채권일련번호" Binding="{Binding LoanNumber}" Width="*" IsReadOnly="True"
                                                        ElementStyle="{StaticResource SectionDataGridTextBlockStyle}"/>
                                    <DataGridTextColumn Header="계좌번호" Binding="{Binding AccountNumber}" Width="*" IsReadOnly="True"
                                                        ElementStyle="{StaticResource SectionDataGridTextBlockStyle}"/>
                                    <DataGridTextColumn Header="회수구분" Binding="{Binding RecoveryType}" Width="*" IsReadOnly="True"
                                                        ElementStyle="{StaticResource SectionDataGridTextBlockStyle}"/>
                                    <DataGridTextColumn Header="회수일자" Binding="{Binding RecoveryDate}" Width="*" IsReadOnly="True"
                                                        ElementStyle="{StaticResource SectionDataGridTextBlockStyle}"/>
                                    <DataGridTextColumn Header="회수원금" Binding="{Binding RecoveryPrincipal}" Width="*" IsReadOnly="True"
                                                        ElementStyle="{StaticResource SectionDataGridTextBlockStyle}"/>
                                    <DataGridTextColumn Header="회수이자" Binding="{Binding RecoveryInterest}" Width="*" IsReadOnly="True"
                                                        ElementStyle="{StaticResource SectionDataGridTextBlockStyle}"/>
                                    <DataGridTextColumn Header="회수가지급금" Binding="{Binding RecoveryProvisional}" Width="*" IsReadOnly="True"
                                                        ElementStyle="{StaticResource SectionDataGridTextBlockStyle}"/>
                                    <DataGridTextColumn Header="회수총액" Binding="{Binding RecoveryTotal}" Width="*" IsReadOnly="True"
                                                        ElementStyle="{StaticResource SectionDataGridTextBlockStyle}"/>
                                    <DataGridCheckBoxColumn Header="원금회수반영" Binding="{Binding PrincipalRecoveryApplied, UpdateSourceTrigger=PropertyChanged}" Width="*"/>
                                    <DataGridCheckBoxColumn Header="원금상계반영" Binding="{Binding PrincipalOffsetApplied, UpdateSourceTrigger=PropertyChanged}" Width="*"/>
                                    <DataGridCheckBoxColumn Header="이자회수반영" Binding="{Binding InterestRecoveryApplied, UpdateSourceTrigger=PropertyChanged}" Width="*"/>
                                    <DataGridCheckBoxColumn Header="이자상계반영" Binding="{Binding InterestOffsetApplied, UpdateSourceTrigger=PropertyChanged}" Width="*"/>
                                    <DataGridCheckBoxColumn Header="대위변제반영" Binding="{Binding SubrogationApplied, UpdateSourceTrigger=PropertyChanged}" Width="*"/>
                                    <DataGridCheckBoxColumn Header="기타회수반영" Binding="{Binding OtherRecoveryApplied, UpdateSourceTrigger=PropertyChanged}" Width="*"/>
                                </DataGrid.Columns>
                            </DataGrid>
                        </StackPanel>
                    </Border>

                    <!-- 인터림 지출 (모든 물건 공통 표시) -->
                    <Border Background="{StaticResource SurfaceColor}"
                            BorderBrush="{StaticResource BorderBrush}"
                            BorderThickness="1"
                            CornerRadius="8"
                            Margin="0,0,0,16">
                        <StackPanel>
                            <!-- 섹션 헤더 -->
                            <Border Background="{StaticResource PrimaryBrush}"
                                    CornerRadius="8,8,0,0"
                                    Padding="16,10">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <materialDesign:PackIcon Kind="CashMinus" Width="18" Height="18"
                                                             Margin="0,0,6,0" VerticalAlignment="Center" Foreground="White"/>
                                    <TextBlock Text="인터림 지출"
                                               Foreground="White"
                                               FontWeight="SemiBold"
                                               FontSize="{StaticResource FontSizeH4}"/>
                                </StackPanel>
                            </Border>

                            <!-- 10열 테이블 -->
                            <DataGrid ItemsSource="{Binding InterimExpenseRows}"
                                      PreviewMouseWheel="DataGrid_PreviewMouseWheel"
                                      AutoGenerateColumns="False"
                                      CanUserAddRows="False"
                                      CanUserDeleteRows="False"
                                      CanUserSortColumns="False"
                                      HeadersVisibility="Column"
                                      GridLinesVisibility="All"
                                      BorderThickness="0"
                                      HorizontalGridLinesBrush="{StaticResource BorderBrush}"
                                      VerticalGridLinesBrush="{StaticResource BorderBrush}"
                                      RowHeight="32"
                                      IsReadOnly="True"
                                      ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                      ScrollViewer.VerticalScrollBarVisibility="Disabled"
                                      MinHeight="60">
                                <DataGrid.ColumnHeaderStyle>
                                    <StaticResource ResourceKey="SectionDataGridColumnHeaderStyle"/>
                                </DataGrid.ColumnHeaderStyle>
                                <DataGrid.CellStyle>
                                    <StaticResource ResourceKey="SectionDataGridCellStyle"/>
                                </DataGrid.CellStyle>
                                <DataGrid.RowStyle>
                                    <StaticResource ResourceKey="SectionDataGridRowStyle"/>
                                </DataGrid.RowStyle>
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="차주일련번호" Binding="{Binding BorrowerNumber}" Width="*" IsReadOnly="True"
                                                        ElementStyle="{StaticResource SectionDataGridTextBlockStyle}"/>
                                    <DataGridTextColumn Header="차주명" Binding="{Binding BorrowerName}" Width="*" IsReadOnly="True"
                                                        ElementStyle="{StaticResource SectionDataGridTextBlockStyle}"/>
                                    <DataGridTextColumn Header="채권일련번호" Binding="{Binding LoanNumber}" Width="*" IsReadOnly="True"
                                                        ElementStyle="{StaticResource SectionDataGridTextBlockStyle}"/>
                                    <DataGridTextColumn Header="계좌번호" Binding="{Binding AccountNumber}" Width="*" IsReadOnly="True"
                                                        ElementStyle="{StaticResource SectionDataGridTextBlockStyle}"/>
                                    <DataGridTextColumn Header="발생일자" Binding="{Binding OccurrenceDate}" Width="*" IsReadOnly="True"
                                                        ElementStyle="{StaticResource SectionDataGridTextBlockStyle}"/>
                                    <DataGridTextColumn Header="최초발생액" Binding="{Binding InitialAmount}" Width="*" IsReadOnly="True"
                                                        ElementStyle="{StaticResource SectionDataGridTextBlockStyle}"/>
                                    <DataGridTextColumn Header="잔액" Binding="{Binding Balance}" Width="*" IsReadOnly="True"
                                                        ElementStyle="{StaticResource SectionDataGridTextBlockStyle}"/>
                                    <DataGridTextColumn Header="비고" Binding="{Binding Remarks}" Width="*" IsReadOnly="True"
                                                        ElementStyle="{StaticResource SectionDataGridTextBlockStyle}"/>
                                    <DataGridCheckBoxColumn Header="경매비용반영" Binding="{Binding AuctionCostApplied, UpdateSourceTrigger=PropertyChanged}" Width="*"/>
                                    <DataGridCheckBoxColumn Header="기타비용반영" Binding="{Binding OtherCostApplied, UpdateSourceTrigger=PropertyChanged}" Width="*"/>
                                </DataGrid.Columns>
                            </DataGrid>
                        </StackPanel>
                    </Border>

                    </StackPanel> <!-- 연립다세대 제외 섹션 끝 -->

            </StackPanel>

            <!-- 메시지 표시 -->
            <Border Grid.Row="1" 
                    Background="{StaticResource MaterialGreenBgBrush}" 
                    CornerRadius="4" 
                    Padding="12"
                    Margin="0,16,0,0"
                    VerticalAlignment="Bottom"
                    Visibility="{Binding SuccessMessage, Converter={StaticResource NullToVisibilityConverter}}">
                <TextBlock Text="{Binding SuccessMessage}" 
                           Foreground="{StaticResource MaterialGreenDarkBrush}"
                           FontSize="{StaticResource FontSizeBody}"/>
            </Border>

            <Border Grid.Row="1" 
                    Background="{StaticResource MaterialRedBgBrush}" 
                    CornerRadius="4" 
                    Padding="12"
                    Margin="0,16,0,0"
                    VerticalAlignment="Bottom"
                    Visibility="{Binding ErrorMessage, Converter={StaticResource NullToVisibilityConverter}}">
                <TextBlock Text="{Binding ErrorMessage}" 
                           Foreground="{StaticResource MaterialRedDarkBrush}"
                           FontSize="{StaticResource FontSizeBody}"/>
            </Border>
        </Grid>
    </ScrollViewer>
</UserControl>

