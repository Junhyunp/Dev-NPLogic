                                    <Button Content="−" FontSize="16" FontWeight="Bold"
                                            HorizontalAlignment="Right" VerticalAlignment="Center"
                                            Command="{Binding DestroyInquiryTableCommand}"
                                            Visibility="{Binding HasInquiryTable, Converter={StaticResource BoolToVisibilityConverter}}"
                                            Background="Transparent" Foreground="White" BorderThickness="0"
                                            Padding="8,0" MinHeight="0" Height="20" Cursor="Hand"
                                            ToolTip="탐문 내역 테이블 제거"/>
                                </Grid>
                            </Border>

                            <!-- 탐문 내역 DataGrid -->
                            <DataGrid x:Name="InquiryDataGrid"
                                      Visibility="{Binding HasInquiryTable, Converter={StaticResource BoolToVisibilityConverter}}"
                                      ItemsSource="{Binding InquiryRows}"
                                      AutoGenerateColumns="False"
                                      CanUserAddRows="False" CanUserDeleteRows="False"
                                      CanUserSortColumns="False"
                                      HeadersVisibility="Column"
                                      RowHeight="32"
                                      GridLinesVisibility="All"
                                      HorizontalGridLinesBrush="{StaticResource BorderBrush}"
                                      VerticalGridLinesBrush="{StaticResource BorderBrush}"
                                      BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                                      Background="White"
                                      RowBackground="White"
                                      AlternatingRowBackground="#FAFAFA"
                                      MinHeight="60"
                                      PreviewMouseWheel="DataGrid_PreviewMouseWheel">
                                <DataGrid.ColumnHeaderStyle>
                                    <StaticResource ResourceKey="SectionDataGridColumnHeaderStyle"/>
                                </DataGrid.ColumnHeaderStyle>
                                <DataGrid.CellStyle>
                                    <StaticResource ResourceKey="SectionDataGridCellStyle"/>
                                </DataGrid.CellStyle>
                                <DataGrid.RowStyle>
                                    <StaticResource ResourceKey="SectionDataGridRowStyle"/>
                                </DataGrid.RowStyle>
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="부동산명" Binding="{Binding RealEstateName, UpdateSourceTrigger=PropertyChanged}" Width="*"
                                                        ElementStyle="{StaticResource SectionDataGridTextBlockStyle}"
                                                        EditingElementStyle="{StaticResource SectionDataGridTextBoxStyle}"/>
                                    <DataGridTextColumn Header="연락처" Binding="{Binding ContactNumber, UpdateSourceTrigger=PropertyChanged}" Width="150"
                                                        ElementStyle="{StaticResource SectionDataGridTextBlockStyle}"
                                                        EditingElementStyle="{StaticResource SectionDataGridTextBoxStyle}"/>
                                    <DataGridTextColumn Header="탐문내역" Binding="{Binding InquiryDetails, UpdateSourceTrigger=PropertyChanged}" Width="2*"
                                                        ElementStyle="{StaticResource SectionDataGridTextBlockStyle}"
                                                        EditingElementStyle="{StaticResource SectionDataGridTextBoxStyle}"/>
                                </DataGrid.Columns>
                            </DataGrid>

                            <!-- 행 추가/삭제 버튼 -->
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,8"
