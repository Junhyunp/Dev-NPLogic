                                </Border>
                                <Border Grid.Column="6" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,1,1" Padding="0">
                                    <TextBox Text="{Binding FactoryScenario2ReductionAmount, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource ScenarioHeaderTextBoxStyle}"/>
                                </Border>
                                <Border Grid.Column="7" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,1,1" Padding="8,6">
                                    <TextBlock Text="" HorizontalAlignment="Center" FontSize="12"/>
                                </Border>
                                <Border Grid.Column="8" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,1" Padding="8,6">
                                    <TextBlock Text="" HorizontalAlignment="Center" FontSize="12"/>
                                </Border>
                            </Grid>

                            <!-- 시나리오 2 DataGrid -->
                            <DataGrid x:Name="FactoryScenario2DataGrid"
                                      ItemsSource="{Binding FactoryScenario2Rows}"
                                      AutoGenerateColumns="False"
                                      CanUserAddRows="False" CanUserDeleteRows="False"
                                      CanUserSortColumns="False"
                                      HeadersVisibility="Column"
                                      RowHeight="32"
                                      GridLinesVisibility="All"
                                      HorizontalGridLinesBrush="{StaticResource BorderBrush}"
                                      VerticalGridLinesBrush="{StaticResource BorderBrush}"
                                      BorderBrush="{StaticResource BorderBrush}" BorderThickness="0"
                                      Background="White"
                                      RowBackground="White"
                                      AlternatingRowBackground="#FAFAFA"
                                      MinHeight="60"
                                      PreviewMouseWheel="DataGrid_PreviewMouseWheel">
                                <DataGrid.ColumnHeaderStyle>
                                    <StaticResource ResourceKey="SectionDataGridColumnHeaderStyle"/>
                                </DataGrid.ColumnHeaderStyle>
                                <DataGrid.CellStyle>
                                    <StaticResource ResourceKey="SectionDataGridCellStyle"/>
                                </DataGrid.CellStyle>
                                <DataGrid.RowStyle>
                                    <StaticResource ResourceKey="SectionDataGridRowStyle"/>
                                </DataGrid.RowStyle>
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="구분" Binding="{Binding Category}" Width="150" IsReadOnly="True"
                                                        ElementStyle="{StaticResource SectionDataGridTextBlockStyle}"/>
                                    <DataGridTextColumn Header="감정가" Binding="{Binding AppraisalValue, UpdateSourceTrigger=PropertyChanged}" Width="*"
                                                        ElementStyle="{StaticResource SectionDataGridTextBlockStyle}"
                                                        EditingElementStyle="{StaticResource SectionDataGridTextBoxStyle}"/>
                                    <DataGridTextColumn Header="면적" Binding="{Binding Area, UpdateSourceTrigger=PropertyChanged}" Width="*"
                                                        ElementStyle="{StaticResource SectionDataGridTextBlockStyle}"
                                                        EditingElementStyle="{StaticResource SectionDataGridTextBoxStyle}"/>
                                    <DataGridTextColumn Header="평당감정가" Binding="{Binding UnitAppraisal, UpdateSourceTrigger=PropertyChanged}" Width="*"
                                                        ElementStyle="{StaticResource SectionDataGridTextBlockStyle}"
                                                        EditingElementStyle="{StaticResource SectionDataGridTextBoxStyle}"/>
                                    <DataGridTextColumn Header="평당 평가액" Binding="{Binding UnitEvalPrice, UpdateSourceTrigger=PropertyChanged}" Width="*"
                                                        ElementStyle="{StaticResource SectionDataGridTextBlockStyle}"
                                                        EditingElementStyle="{StaticResource SectionDataGridTextBoxStyle}"/>
                                    <DataGridTextColumn Header="평가액" Binding="{Binding EvalAmount, UpdateSourceTrigger=PropertyChanged}" Width="*"
                                                        ElementStyle="{StaticResource SectionDataGridTextBlockStyle}"
                                                        EditingElementStyle="{StaticResource SectionDataGridTextBoxStyle}"/>
                                    <DataGridTextColumn Header="낙찰가율" Binding="{Binding BidRate, UpdateSourceTrigger=PropertyChanged}" Width="*"
                                                        ElementStyle="{StaticResource SectionDataGridTextBlockStyle}"
                                                        EditingElementStyle="{StaticResource SectionDataGridTextBoxStyle}"/>
                                    <DataGridTextColumn Header="토지평당낙찰가" Binding="{Binding LandPerPyeongBid, UpdateSourceTrigger=PropertyChanged}" Width="*"
                                                        ElementStyle="{StaticResource SectionDataGridTextBlockStyle}"
                                                        EditingElementStyle="{StaticResource SectionDataGridTextBoxStyle}"/>
                                    <DataGridTextColumn Header="건물평당 낙찰가" Binding="{Binding BuildingPerPyeongBid, UpdateSourceTrigger=PropertyChanged}" Width="*"
                                                        ElementStyle="{StaticResource SectionDataGridTextBlockStyle}"
                                                        EditingElementStyle="{StaticResource SectionDataGridTextBoxStyle}"/>
                                </DataGrid.Columns>
                            </DataGrid>
                        </StackPanel>
                    </Border>

                    <!-- 지번별 평가 (공장/창고 전용) -->
                    <Border Background="{StaticResource SurfaceColor}"
                            BorderBrush="{StaticResource BorderBrush}"
                            BorderThickness="1"
                            CornerRadius="8"
                            Margin="0,0,0,16"
                            Visibility="{Binding IsFactoryType, Converter={StaticResource BoolToVisibilityConverter}}">
                        <StackPanel>
                            <!-- 섹션 헤더 -->
                            <Border Background="{StaticResource PrimaryBrush}"
                                    CornerRadius="8,8,0,0"
                                    Padding="16,10">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <materialDesign:PackIcon Kind="MapMarkerMultipleOutline" Width="18" Height="18"
                                                             Margin="0,0,6,0" VerticalAlignment="Center" Foreground="White"/>
                                    <TextBlock Text="지번별 평가"
                                               Foreground="White"
                                               FontWeight="SemiBold"
                                               FontSize="{StaticResource FontSizeH4}"/>
                                </StackPanel>
                            </Border>

                            <!-- 2행 헤더 Grid -->
                            <Grid Background="{StaticResource BlueGray100Brush}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="2*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <!-- Row 0-1 RowSpan=2: 지번일련번호 ~ 감정가 -->
                                <Border Grid.Row="0" Grid.RowSpan="2" Grid.Column="0" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,1,1" Padding="8,6">
                                    <TextBlock Text="지번일련번호" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}"/>
                                </Border>
                                <Border Grid.Row="0" Grid.RowSpan="2" Grid.Column="1" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,1,1" Padding="8,6">
                                    <TextBlock Text="구분" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}"/>
                                </Border>
                                <Border Grid.Row="0" Grid.RowSpan="2" Grid.Column="2" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,1,1" Padding="8,6">
                                    <TextBlock Text="지번주소지" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}"/>
                                </Border>
                                <Border Grid.Row="0" Grid.RowSpan="2" Grid.Column="3" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,1,1" Padding="8,6">
                                    <TextBlock Text="면적(평)" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}"/>
                                </Border>
                                <Border Grid.Row="0" Grid.RowSpan="2" Grid.Column="4" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,1,1" Padding="8,6">
                                    <TextBlock Text="평당감정가" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}"/>
                                </Border>
                                <Border Grid.Row="0" Grid.RowSpan="2" Grid.Column="5" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,1,1" Padding="8,6">
                                    <TextBlock Text="감정가" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}"/>
                                </Border>

                                <!-- Row 0: 1안, 2안 (ColumnSpan=2) -->
                                <Border Grid.Row="0" Grid.Column="6" Grid.ColumnSpan="2" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,1,1" Padding="8,6">
                                    <TextBlock Text="1안" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}"/>
                                </Border>
                                <Border Grid.Row="0" Grid.Column="8" Grid.ColumnSpan="2" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1" Padding="8,6">
                                    <TextBlock Text="2안" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}"/>
                                </Border>

                                <!-- Row 1: 평당 평가액, 평가액 x2 -->
                                <Border Grid.Row="1" Grid.Column="6" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,1,1" Padding="8,6">
                                    <TextBlock Text="평당 평가액" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}"/>
                                </Border>
                                <Border Grid.Row="1" Grid.Column="7" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,1,1" Padding="8,6">
                                    <TextBlock Text="평가액" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}"/>
                                </Border>
                                <Border Grid.Row="1" Grid.Column="8" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,1,1" Padding="8,6">
                                    <TextBlock Text="평당 평가액" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}"/>
                                </Border>
                                <Border Grid.Row="1" Grid.Column="9" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1" Padding="8,6">
                                    <TextBlock Text="평가액" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}"/>
                                </Border>
                            </Grid>

                            <!-- 데이터 DataGrid -->
                            <DataGrid x:Name="LotEvalDataGrid"
                                      ItemsSource="{Binding LotEvalRows}"
                                      AutoGenerateColumns="False"
                                      CanUserAddRows="False" CanUserDeleteRows="False"
                                      CanUserSortColumns="False"
                                      HeadersVisibility="None"
                                      RowHeight="32"
                                      GridLinesVisibility="All"
                                      HorizontalGridLinesBrush="{StaticResource BorderBrush}"
                                      VerticalGridLinesBrush="{StaticResource BorderBrush}"
                                      BorderBrush="{StaticResource BorderBrush}" BorderThickness="0"
                                      Background="White"
                                      RowBackground="White"
                                      AlternatingRowBackground="#FAFAFA"
                                      MinHeight="32"
                                      PreviewMouseWheel="DataGrid_PreviewMouseWheel">
                                <DataGrid.CellStyle>
                                    <StaticResource ResourceKey="SectionDataGridCellStyle"/>
                                </DataGrid.CellStyle>
                                <DataGrid.RowStyle>
                                    <StaticResource ResourceKey="SectionDataGridRowStyle"/>
                                </DataGrid.RowStyle>
                                <DataGrid.Columns>
                                    <DataGridTextColumn Binding="{Binding LotSerialNumber, UpdateSourceTrigger=PropertyChanged}" Width="*"
                                                        ElementStyle="{StaticResource SectionDataGridTextBlockStyle}"
                                                        EditingElementStyle="{StaticResource SectionDataGridTextBoxStyle}"/>
                                    <DataGridTextColumn Binding="{Binding Category, UpdateSourceTrigger=PropertyChanged}" Width="*"
                                                        ElementStyle="{StaticResource SectionDataGridTextBlockStyle}"
                                                        EditingElementStyle="{StaticResource SectionDataGridTextBoxStyle}"/>
                                    <DataGridTextColumn Binding="{Binding LotAddress, UpdateSourceTrigger=PropertyChanged}" Width="2*"
                                                        ElementStyle="{StaticResource SectionDataGridTextBlockStyle}"
                                                        EditingElementStyle="{StaticResource SectionDataGridTextBoxStyle}"/>
                                    <DataGridTextColumn Binding="{Binding AreaPyeong, UpdateSourceTrigger=PropertyChanged}" Width="*"
                                                        ElementStyle="{StaticResource SectionDataGridTextBlockStyle}"
                                                        EditingElementStyle="{StaticResource SectionDataGridTextBoxStyle}"/>
                                    <DataGridTextColumn Binding="{Binding UnitAppraisal, UpdateSourceTrigger=PropertyChanged}" Width="*"
                                                        ElementStyle="{StaticResource SectionDataGridTextBlockStyle}"
                                                        EditingElementStyle="{StaticResource SectionDataGridTextBoxStyle}"/>
                                    <DataGridTextColumn Binding="{Binding AppraisalValue, UpdateSourceTrigger=PropertyChanged}" Width="*"
                                                        ElementStyle="{StaticResource SectionDataGridTextBlockStyle}"
                                                        EditingElementStyle="{StaticResource SectionDataGridTextBoxStyle}"/>
                                    <DataGridTextColumn Binding="{Binding Plan1UnitPrice, UpdateSourceTrigger=PropertyChanged}" Width="*"
                                                        ElementStyle="{StaticResource SectionDataGridTextBlockStyle}"
                                                        EditingElementStyle="{StaticResource SectionDataGridTextBoxStyle}"/>
                                    <DataGridTextColumn Binding="{Binding Plan1EvalAmount, UpdateSourceTrigger=PropertyChanged}" Width="*"
                                                        ElementStyle="{StaticResource SectionDataGridTextBlockStyle}"
                                                        EditingElementStyle="{StaticResource SectionDataGridTextBoxStyle}"/>
                                    <DataGridTextColumn Binding="{Binding Plan2UnitPrice, UpdateSourceTrigger=PropertyChanged}" Width="*"
                                                        ElementStyle="{StaticResource SectionDataGridTextBlockStyle}"
                                                        EditingElementStyle="{StaticResource SectionDataGridTextBoxStyle}"/>
                                    <DataGridTextColumn Binding="{Binding Plan2EvalAmount, UpdateSourceTrigger=PropertyChanged}" Width="*"
                                                        ElementStyle="{StaticResource SectionDataGridTextBlockStyle}"
                                                        EditingElementStyle="{StaticResource SectionDataGridTextBoxStyle}"/>
                                </DataGrid.Columns>
                            </DataGrid>

                            <!-- Total 합계 행 (읽기전용) -->
                            <Grid Background="{StaticResource BlueGray50Brush}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="2*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Border Grid.Column="0" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,1,0" Padding="8,6">
                                    <TextBlock Text="Total" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}"/>
                                </Border>
                                <Border Grid.Column="1" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,1,0" Padding="8,6">
                                    <TextBlock Text="" HorizontalAlignment="Center" FontSize="12"/>
                                </Border>
                                <Border Grid.Column="2" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,1,0" Padding="8,6">
                                    <TextBlock Text="" HorizontalAlignment="Center" FontSize="12"/>
                                </Border>
                                <Border Grid.Column="3" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,1,0" Padding="8,6">
                                    <TextBlock Text="" HorizontalAlignment="Center" FontSize="12"/>
                                </Border>
                                <Border Grid.Column="4" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,1,0" Padding="8,6">
                                    <TextBlock Text="" HorizontalAlignment="Center" FontSize="12"/>
                                </Border>
                                <Border Grid.Column="5" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,1,0" Padding="8,6">
                                    <TextBlock Text="" HorizontalAlignment="Center" FontSize="12"/>
                                </Border>
                                <Border Grid.Column="6" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,1,0" Padding="8,6">
                                    <TextBlock Text="" HorizontalAlignment="Center" FontSize="12"/>
                                </Border>
                                <Border Grid.Column="7" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,1,0" Padding="8,6">
                                    <TextBlock Text="" HorizontalAlignment="Center" FontSize="12"/>
                                </Border>
                                <Border Grid.Column="8" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,1,0" Padding="8,6">
                                    <TextBlock Text="" HorizontalAlignment="Center" FontSize="12"/>
                                </Border>
                                <Border Grid.Column="9" Padding="8,6">
                                    <TextBlock Text="" HorizontalAlignment="Center" FontSize="12"/>
                                </Border>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- 회수 전략 요약 + 인터림 섹션들 (아파트 전용) -->
                    <StackPanel Visibility="{Binding IsApartmentType, Converter={StaticResource BoolToVisibilityConverter}}">

                    <!-- 회수 전략 요약 (차주별 첫 번째 물건에만 표시) -->
                    <Border Background="{StaticResource SurfaceColor}"
                            BorderBrush="{StaticResource BorderBrush}"
                            BorderThickness="1"
                            CornerRadius="8"
                            Margin="0,0,0,16"
                            Visibility="{Binding IsFirstPropertyInBorrower, Converter={StaticResource BoolToVisibilityConverter}}">
                        <StackPanel>
                            <!-- 섹션 헤더 -->
                            <Border Background="{StaticResource PrimaryBrush}"
                                    CornerRadius="8,8,0,0"
                                    Padding="16,10">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <materialDesign:PackIcon Kind="ShieldCheckOutline" Width="18" Height="18"
                                                             Margin="0,0,6,0" VerticalAlignment="Center" Foreground="White"/>
                                    <TextBlock Text="회수 전략 요약"
                                               Foreground="White"
                                               FontWeight="SemiBold"
                                               FontSize="{StaticResource FontSizeH4}"/>
                                </StackPanel>
                            </Border>

                            <!-- 시나리오 1 (좌) + 시나리오 2 (우) 병렬 테이블 -->
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <!-- ===== 시나리오 1 (좌측) ===== -->
                                <Border Grid.Column="0" BorderBrush="{StaticResource BlueGray300Brush}" BorderThickness="0,0,2,0">
                                    <StackPanel>
                                        <!-- Row 0 (시나리오 라벨 + Cap) + Row 1 (컬럼 헤더) 통합 Grid -->
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                            </Grid.RowDefinitions>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="160"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="120"/>
                                            </Grid.ColumnDefinitions>
                                            <!-- Row 0: 시나리오 라벨 + Cap 적용 여부 -->
                                            <Border Grid.Row="0" Grid.Column="0" Background="{StaticResource PrimaryBrush}" BorderBrush="{StaticResource BlueGray300Brush}" BorderThickness="0,0,1,2" Padding="8,8">
                                                <TextBlock Text="시나리오 1" FontSize="12" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center"/>
                                            </Border>
                                            <Border Grid.Row="0" Grid.Column="1" BorderBrush="{StaticResource BlueGray300Brush}" BorderThickness="0,0,1,2" Padding="8,8">
                                                <TextBlock Text="" FontSize="12" HorizontalAlignment="Center"/>
                                            </Border>
                                            <Border Grid.Row="0" Grid.Column="2" Background="{StaticResource BlueGray100Brush}" BorderBrush="{StaticResource BlueGray300Brush}" BorderThickness="0,0,1,2" Padding="8,8">
                                                <TextBlock Text="Cap 적용 여부" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}" HorizontalAlignment="Center"/>
                                            </Border>
                                            <Border Grid.Row="0" Grid.Column="3" BorderBrush="{StaticResource BlueGray300Brush}" BorderThickness="0,0,0,2" Padding="4,4">
                                                <ComboBox ItemsSource="{Binding CapTypeOptions}"
                                                          SelectedItem="{Binding Scenario1CapType}"
                                                          FontSize="12" BorderThickness="0"
                                                          HorizontalContentAlignment="Center"/>
                                            </Border>
                                            <!-- Row 1: 컬럼 헤더 -->
                                            <Border Grid.Row="1" Grid.Column="0" Background="{StaticResource BlueGray100Brush}" BorderBrush="{StaticResource BlueGray200Brush}" BorderThickness="0,0,1,1" Padding="8,6">
                                                <TextBlock Text="구분" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}" HorizontalAlignment="Center"/>
                                            </Border>
                                            <Border Grid.Row="1" Grid.Column="1" Background="{StaticResource BlueGray100Brush}" BorderBrush="{StaticResource BlueGray200Brush}" BorderThickness="0,0,1,1" Padding="8,6">
                                                <TextBlock Text="CF in date" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}" HorizontalAlignment="Center"/>
                                            </Border>
                                            <Border Grid.Row="1" Grid.Column="2" Background="{StaticResource BlueGray100Brush}" BorderBrush="{StaticResource BlueGray200Brush}" BorderThickness="0,0,1,1" Padding="8,6">
                                                <TextBlock Text="Cash in/out" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}" HorizontalAlignment="Center"/>
                                            </Border>
                                            <Border Grid.Row="1" Grid.Column="3" Background="{StaticResource BlueGray100Brush}" BorderBrush="{StaticResource BlueGray200Brush}" BorderThickness="0,0,0,1" Padding="8,6">
                                                <TextBlock Text="Ratio" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}" HorizontalAlignment="Center"/>
                                            </Border>
                                        </Grid>

                                        <!-- 동적 데이터 행 -->
                                        <ItemsControl ItemsSource="{Binding RecoveryStrategyRows}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="160"/>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="120"/>
                                                        </Grid.ColumnDefinitions>
                                                        <Border Grid.Column="0" Background="{StaticResource BlueGray100Brush}" BorderBrush="{StaticResource BlueGray200Brush}" BorderThickness="0,0,1,1" Padding="8,6">
                                                            <TextBlock Text="{Binding Label}" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}" HorizontalAlignment="Center"/>
                                                        </Border>
                                                        <Border Grid.Column="1" BorderBrush="{StaticResource BlueGray200Brush}" BorderThickness="0,0,1,1" Padding="8,6">
                                                            <TextBlock Text="{Binding S1CfDate}" FontSize="12" HorizontalAlignment="Center"/>
                                                        </Border>
                                                        <Border Grid.Column="2" BorderBrush="{StaticResource BlueGray200Brush}" BorderThickness="0,0,1,1" Padding="8,6">
                                                            <TextBlock Text="{Binding S1CashInOut}" FontSize="12" HorizontalAlignment="Center"/>
                                                        </Border>
                                                        <Border Grid.Column="3" BorderBrush="{StaticResource BlueGray200Brush}" BorderThickness="0,0,0,1" Padding="8,6">
                                                            <TextBlock Text="{Binding S1Ratio}" FontSize="12" HorizontalAlignment="Center"/>
                                                        </Border>
                                                    </Grid>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </Border>

                                <!-- ===== 시나리오 2 (우측) ===== -->
                                <Border Grid.Column="1">
                                    <StackPanel>
                                        <!-- Row 0 (시나리오 라벨 + Cap) + Row 1 (컬럼 헤더) 통합 Grid -->
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                            </Grid.RowDefinitions>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="160"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="120"/>
                                            </Grid.ColumnDefinitions>
                                            <!-- Row 0: 시나리오 라벨 + Cap 적용 여부 -->
                                            <Border Grid.Row="0" Grid.Column="0" Background="{StaticResource SecondaryBrush}" BorderBrush="{StaticResource BlueGray300Brush}" BorderThickness="0,0,1,2" Padding="8,8">
                                                <TextBlock Text="시나리오 2" FontSize="12" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center"/>
                                            </Border>
                                            <Border Grid.Row="0" Grid.Column="1" BorderBrush="{StaticResource BlueGray300Brush}" BorderThickness="0,0,1,2" Padding="8,8">
                                                <TextBlock Text="" FontSize="12" HorizontalAlignment="Center"/>
                                            </Border>
                                            <Border Grid.Row="0" Grid.Column="2" Background="{StaticResource BlueGray100Brush}" BorderBrush="{StaticResource BlueGray300Brush}" BorderThickness="0,0,1,2" Padding="8,8">
                                                <TextBlock Text="Cap 적용 여부" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}" HorizontalAlignment="Center"/>
                                            </Border>
                                            <Border Grid.Row="0" Grid.Column="3" BorderBrush="{StaticResource BlueGray300Brush}" BorderThickness="0,0,0,2" Padding="4,4">
                                                <ComboBox ItemsSource="{Binding CapTypeOptions}"
                                                          SelectedItem="{Binding Scenario2CapType}"
                                                          FontSize="12" BorderThickness="0"
                                                          HorizontalContentAlignment="Center"/>
                                            </Border>
                                            <!-- Row 1: 컬럼 헤더 -->
                                            <Border Grid.Row="1" Grid.Column="0" Background="{StaticResource BlueGray100Brush}" BorderBrush="{StaticResource BlueGray200Brush}" BorderThickness="0,0,1,1" Padding="8,6">
                                                <TextBlock Text="구분" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}" HorizontalAlignment="Center"/>
                                            </Border>
                                            <Border Grid.Row="1" Grid.Column="1" Background="{StaticResource BlueGray100Brush}" BorderBrush="{StaticResource BlueGray200Brush}" BorderThickness="0,0,1,1" Padding="8,6">
                                                <TextBlock Text="CF in date" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}" HorizontalAlignment="Center"/>
                                            </Border>
                                            <Border Grid.Row="1" Grid.Column="2" Background="{StaticResource BlueGray100Brush}" BorderBrush="{StaticResource BlueGray200Brush}" BorderThickness="0,0,1,1" Padding="8,6">
                                                <TextBlock Text="Cash in/out" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}" HorizontalAlignment="Center"/>
                                            </Border>
                                            <Border Grid.Row="1" Grid.Column="3" Background="{StaticResource BlueGray100Brush}" BorderBrush="{StaticResource BlueGray200Brush}" BorderThickness="0,0,0,1" Padding="8,6">
                                                <TextBlock Text="Ratio" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}" HorizontalAlignment="Center"/>
                                            </Border>
                                        </Grid>

                                        <!-- 동적 데이터 행 -->
                                        <ItemsControl ItemsSource="{Binding RecoveryStrategyRows}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="160"/>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="120"/>
                                                        </Grid.ColumnDefinitions>
                                                        <Border Grid.Column="0" Background="{StaticResource BlueGray100Brush}" BorderBrush="{StaticResource BlueGray200Brush}" BorderThickness="0,0,1,1" Padding="8,6">
                                                            <TextBlock Text="{Binding Label}" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}" HorizontalAlignment="Center"/>
                                                        </Border>
                                                        <Border Grid.Column="1" BorderBrush="{StaticResource BlueGray200Brush}" BorderThickness="0,0,1,1" Padding="8,6">
                                                            <TextBlock Text="{Binding S2CfDate}" FontSize="12" HorizontalAlignment="Center"/>
                                                        </Border>
                                                        <Border Grid.Column="2" BorderBrush="{StaticResource BlueGray200Brush}" BorderThickness="0,0,1,1" Padding="8,6">
                                                            <TextBlock Text="{Binding S2CashInOut}" FontSize="12" HorizontalAlignment="Center"/>
                                                        </Border>
                                                        <Border Grid.Column="3" BorderBrush="{StaticResource BlueGray200Brush}" BorderThickness="0,0,0,1" Padding="8,6">
                                                            <TextBlock Text="{Binding S2Ratio}" FontSize="12" HorizontalAlignment="Center"/>
                                                        </Border>
                                                    </Grid>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </Border>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- 인터림 상계/회수 (모든 물건 공통 표시) -->
                    <Border Background="{StaticResource SurfaceColor}"
                            BorderBrush="{StaticResource BorderBrush}"
                            BorderThickness="1"
                            CornerRadius="8"
                            Margin="0,0,0,16">
                        <StackPanel>
                            <!-- 섹션 헤더 -->
                            <Border Background="{StaticResource PrimaryBrush}"
                                    CornerRadius="8,8,0,0"
                                    Padding="16,10">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <materialDesign:PackIcon Kind="SwapHorizontal" Width="18" Height="18"
                                                             Margin="0,0,6,0" VerticalAlignment="Center" Foreground="White"/>
                                    <TextBlock Text="인터림 상계/회수"
                                               Foreground="White"
                                               FontWeight="SemiBold"
                                               FontSize="{StaticResource FontSizeH4}"/>
                                </StackPanel>
                            </Border>

                            <!-- 16열 테이블 -->
                            <DataGrid ItemsSource="{Binding InterimRecoveryRows}"
                                      PreviewMouseWheel="DataGrid_PreviewMouseWheel"
                                      AutoGenerateColumns="False"
                                      CanUserAddRows="False"
                                      CanUserDeleteRows="False"
                                      CanUserSortColumns="False"
                                      HeadersVisibility="Column"
                                      GridLinesVisibility="All"
                                      BorderThickness="0"
                                      HorizontalGridLinesBrush="{StaticResource BorderBrush}"
                                      VerticalGridLinesBrush="{StaticResource BorderBrush}"
                                      RowHeight="32"
                                      IsReadOnly="True"
                                      ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                      ScrollViewer.VerticalScrollBarVisibility="Disabled"
                                      MinHeight="60">
                                <DataGrid.ColumnHeaderStyle>
                                    <StaticResource ResourceKey="SectionDataGridColumnHeaderStyle"/>
                                </DataGrid.ColumnHeaderStyle>
                                <DataGrid.CellStyle>
                                    <StaticResource ResourceKey="SectionDataGridCellStyle"/>
                                </DataGrid.CellStyle>
                                <DataGrid.RowStyle>
                                    <StaticResource ResourceKey="SectionDataGridRowStyle"/>
                                </DataGrid.RowStyle>
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="차주일련번호" Binding="{Binding BorrowerNumber}" Width="*" IsReadOnly="True"
                                                        ElementStyle="{StaticResource SectionDataGridTextBlockStyle}"/>
                                    <DataGridTextColumn Header="차주명" Binding="{Binding BorrowerName}" Width="*" IsReadOnly="True"
                                                        ElementStyle="{StaticResource SectionDataGridTextBlockStyle}"/>
                                    <DataGridTextColumn Header="채권일련번호" Binding="{Binding LoanNumber}" Width="*" IsReadOnly="True"
                                                        ElementStyle="{StaticResource SectionDataGridTextBlockStyle}"/>
                                    <DataGridTextColumn Header="계좌번호" Binding="{Binding AccountNumber}" Width="*" IsReadOnly="True"
                                                        ElementStyle="{StaticResource SectionDataGridTextBlockStyle}"/>
                                    <DataGridTextColumn Header="회수구분" Binding="{Binding RecoveryType}" Width="*" IsReadOnly="True"
                                                        ElementStyle="{StaticResource SectionDataGridTextBlockStyle}"/>
                                    <DataGridTextColumn Header="회수일자" Binding="{Binding RecoveryDate}" Width="*" IsReadOnly="True"
                                                        ElementStyle="{StaticResource SectionDataGridTextBlockStyle}"/>
                                    <DataGridTextColumn Header="회수원금" Binding="{Binding RecoveryPrincipal}" Width="*" IsReadOnly="True"
                                                        ElementStyle="{StaticResource SectionDataGridTextBlockStyle}"/>
                                    <DataGridTextColumn Header="회수이자" Binding="{Binding RecoveryInterest}" Width="*" IsReadOnly="True"
                                                        ElementStyle="{StaticResource SectionDataGridTextBlockStyle}"/>
                                    <DataGridTextColumn Header="회수가지급금" Binding="{Binding RecoveryProvisional}" Width="*" IsReadOnly="True"
                                                        ElementStyle="{StaticResource SectionDataGridTextBlockStyle}"/>
                                    <DataGridTextColumn Header="회수총액" Binding="{Binding RecoveryTotal}" Width="*" IsReadOnly="True"
                                                        ElementStyle="{StaticResource SectionDataGridTextBlockStyle}"/>
                                    <DataGridCheckBoxColumn Header="원금회수반영" Binding="{Binding PrincipalRecoveryApplied, UpdateSourceTrigger=PropertyChanged}" Width="*"/>
                                    <DataGridCheckBoxColumn Header="원금상계반영" Binding="{Binding PrincipalOffsetApplied, UpdateSourceTrigger=PropertyChanged}" Width="*"/>
                                    <DataGridCheckBoxColumn Header="이자회수반영" Binding="{Binding InterestRecoveryApplied, UpdateSourceTrigger=PropertyChanged}" Width="*"/>
                                    <DataGridCheckBoxColumn Header="이자상계반영" Binding="{Binding InterestOffsetApplied, UpdateSourceTrigger=PropertyChanged}" Width="*"/>
                                    <DataGridCheckBoxColumn Header="대위변제반영" Binding="{Binding SubrogationApplied, UpdateSourceTrigger=PropertyChanged}" Width="*"/>
                                    <DataGridCheckBoxColumn Header="기타회수반영" Binding="{Binding OtherRecoveryApplied, UpdateSourceTrigger=PropertyChanged}" Width="*"/>
                                </DataGrid.Columns>
                            </DataGrid>
                        </StackPanel>
                    </Border>

                    <!-- 인터림 지출 (모든 물건 공통 표시) -->
                    <Border Background="{StaticResource SurfaceColor}"
                            BorderBrush="{StaticResource BorderBrush}"
                            BorderThickness="1"
                            CornerRadius="8"
                            Margin="0,0,0,16">
                        <StackPanel>
                            <!-- 섹션 헤더 -->
                            <Border Background="{StaticResource PrimaryBrush}"
                                    CornerRadius="8,8,0,0"
                                    Padding="16,10">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <materialDesign:PackIcon Kind="CashMinus" Width="18" Height="18"
                                                             Margin="0,0,6,0" VerticalAlignment="Center" Foreground="White"/>
                                    <TextBlock Text="인터림 지출"
                                               Foreground="White"
                                               FontWeight="SemiBold"
                                               FontSize="{StaticResource FontSizeH4}"/>
                                </StackPanel>
                            </Border>

                            <!-- 10열 테이블 -->
                            <DataGrid ItemsSource="{Binding InterimExpenseRows}"
                                      PreviewMouseWheel="DataGrid_PreviewMouseWheel"
                                      AutoGenerateColumns="False"
                                      CanUserAddRows="False"
                                      CanUserDeleteRows="False"
                                      CanUserSortColumns="False"
                                      HeadersVisibility="Column"
                                      GridLinesVisibility="All"
                                      BorderThickness="0"
                                      HorizontalGridLinesBrush="{StaticResource BorderBrush}"
                                      VerticalGridLinesBrush="{StaticResource BorderBrush}"
                                      RowHeight="32"
                                      IsReadOnly="True"
                                      ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                      ScrollViewer.VerticalScrollBarVisibility="Disabled"
                                      MinHeight="60">
                                <DataGrid.ColumnHeaderStyle>
                                    <StaticResource ResourceKey="SectionDataGridColumnHeaderStyle"/>
                                </DataGrid.ColumnHeaderStyle>
                                <DataGrid.CellStyle>
                                    <StaticResource ResourceKey="SectionDataGridCellStyle"/>
                                </DataGrid.CellStyle>
                                <DataGrid.RowStyle>
                                    <StaticResource ResourceKey="SectionDataGridRowStyle"/>
                                </DataGrid.RowStyle>
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="차주일련번호" Binding="{Binding BorrowerNumber}" Width="*" IsReadOnly="True"
                                                        ElementStyle="{StaticResource SectionDataGridTextBlockStyle}"/>
                                    <DataGridTextColumn Header="차주명" Binding="{Binding BorrowerName}" Width="*" IsReadOnly="True"
                                                        ElementStyle="{StaticResource SectionDataGridTextBlockStyle}"/>
                                    <DataGridTextColumn Header="채권일련번호" Binding="{Binding LoanNumber}" Width="*" IsReadOnly="True"
                                                        ElementStyle="{StaticResource SectionDataGridTextBlockStyle}"/>
                                    <DataGridTextColumn Header="계좌번호" Binding="{Binding AccountNumber}" Width="*" IsReadOnly="True"
                                                        ElementStyle="{StaticResource SectionDataGridTextBlockStyle}"/>
                                    <DataGridTextColumn Header="발생일자" Binding="{Binding OccurrenceDate}" Width="*" IsReadOnly="True"
                                                        ElementStyle="{StaticResource SectionDataGridTextBlockStyle}"/>
                                    <DataGridTextColumn Header="최초발생액" Binding="{Binding InitialAmount}" Width="*" IsReadOnly="True"
                                                        ElementStyle="{StaticResource SectionDataGridTextBlockStyle}"/>
                                    <DataGridTextColumn Header="잔액" Binding="{Binding Balance}" Width="*" IsReadOnly="True"
                                                        ElementStyle="{StaticResource SectionDataGridTextBlockStyle}"/>
                                    <DataGridTextColumn Header="비고" Binding="{Binding Remarks}" Width="*" IsReadOnly="True"
                                                        ElementStyle="{StaticResource SectionDataGridTextBlockStyle}"/>
                                    <DataGridCheckBoxColumn Header="경매비용반영" Binding="{Binding AuctionCostApplied, UpdateSourceTrigger=PropertyChanged}" Width="*"/>
                                    <DataGridCheckBoxColumn Header="기타비용반영" Binding="{Binding OtherCostApplied, UpdateSourceTrigger=PropertyChanged}" Width="*"/>
                                </DataGrid.Columns>
                            </DataGrid>
                        </StackPanel>
                    </Border>

                    </StackPanel> <!-- 연립다세대 제외 섹션 끝 -->

            </StackPanel>

            <!-- 메시지 표시 -->
            <Border Grid.Row="1" 
                    Background="{StaticResource MaterialGreenBgBrush}" 
                    CornerRadius="4" 
                    Padding="12"
                    Margin="0,16,0,0"
                    VerticalAlignment="Bottom"
                    Visibility="{Binding SuccessMessage, Converter={StaticResource NullToVisibilityConverter}}">
                <TextBlock Text="{Binding SuccessMessage}" 
                           Foreground="{StaticResource MaterialGreenDarkBrush}"
                           FontSize="{StaticResource FontSizeBody}"/>
            </Border>

            <Border Grid.Row="1" 
                    Background="{StaticResource MaterialRedBgBrush}" 
                    CornerRadius="4" 
                    Padding="12"
                    Margin="0,16,0,0"
                    VerticalAlignment="Bottom"
                    Visibility="{Binding ErrorMessage, Converter={StaticResource NullToVisibilityConverter}}">
                <TextBlock Text="{Binding ErrorMessage}" 
                           Foreground="{StaticResource MaterialRedDarkBrush}"
                           FontSize="{StaticResource FontSizeBody}"/>
            </Border>
        </Grid>
    </ScrollViewer>
</UserControl>

