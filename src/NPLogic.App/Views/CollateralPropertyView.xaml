<UserControl x:Class="NPLogic.Views.CollateralPropertyView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:vm="clr-namespace:NPLogic.ViewModels"
             xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
             mc:Ignorable="d"
             d:DesignHeight="800" d:DesignWidth="1200"
             d:DataContext="{d:DesignInstance Type=vm:PropertyDetailViewModel}">
    
    <UserControl.Resources>
        <!-- 테이블 헤더 스타일 -->
        <Style x:Key="TableHeaderCell" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource BlueGray100Brush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="0,0,1,1"/>
            <Setter Property="Padding" Value="12,8"/>
        </Style>
        
        <!-- 테이블 데이터 셀 스타일 -->
        <Style x:Key="TableDataCell" TargetType="Border">
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="0,0,1,1"/>
            <Setter Property="Padding" Value="12,8"/>
        </Style>

        <Style x:Key="CompactTableHeaderCell" TargetType="Border" BasedOn="{StaticResource TableHeaderCell}">
            <Setter Property="Padding" Value="8,6"/>
        </Style>

        <Style x:Key="CompactTableDataCell" TargetType="Border" BasedOn="{StaticResource TableDataCell}">
            <Setter Property="Padding" Value="8,6"/>
        </Style>

        <!-- DataGrid 공통 스타일 (EvaluationTab/SeniorRightsView와 동일) -->
        <Style x:Key="SectionDataGridColumnHeaderStyle" TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="{StaticResource BlueGray100Brush}"/>
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="0,0,1,1"/>
        </Style>
        <Style x:Key="SectionDataGridCellStyle" TargetType="DataGridCell">
            <Setter Property="Foreground" Value="Black"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="0,0,1,0"/>
            <Setter Property="Padding" Value="10,4"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Foreground" Value="Black"/>
                </Trigger>
                <Trigger Property="IsEditing" Value="True">
                    <Setter Property="Foreground" Value="Black"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="SectionDataGridRowStyle" TargetType="DataGridRow">
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Foreground" Value="Black"/>
        </Style>
        <Style x:Key="SectionDataGridTextBlockStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="{StaticResource FontSizeBody}"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="TextAlignment" Value="Center"/>
        </Style>
        <Style x:Key="SectionDataGridTextBoxStyle" TargetType="TextBox">
            <Setter Property="FontSize" Value="{StaticResource FontSizeBody}"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="TextAlignment" Value="Center"/>
            <Setter Property="VerticalAlignment" Value="Stretch"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Margin" Value="0"/>
        </Style>
    </UserControl.Resources>
    
    <Grid Background="{StaticResource BackgroundBrush}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>

        <ScrollViewer Grid.Column="0" x:Name="MainScrollViewer" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                      ClipToBounds="True"
                      ScrollChanged="MainScrollViewer_ScrollChanged">
            <StackPanel Margin="12,8,12,12">
                
                <!-- 상단 버튼 바 제거됨: 토지이용계획은 물건 기본 정보 헤더, 등기부등본은 등기부등본 정보 헤더로 이동 -->

                <!-- ========== 지도 패널 (위성도, 지적도, 로드뷰 3분할) ========== -->
                <Border Background="{StaticResource SurfaceColor}"
                        BorderBrush="{StaticResource PrimaryBrush}"
                        BorderThickness="2"
                        CornerRadius="8"
                        Margin="0,0,0,16">
                    <StackPanel>
                        <!-- 헤더 -->
                        <Border Background="{StaticResource PrimaryBrush}"
                                CornerRadius="6,6,0,0"
                                Padding="16,10">
                            <Grid>
                                <TextBlock Text="🗺️ 지도 정보"
                                           Foreground="White"
                                           FontWeight="SemiBold"
                                           FontSize="{StaticResource FontSizeH4}"
                                           VerticalAlignment="Center"/>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                    <Button Content="저장"
                                            Command="{Binding SaveAllCollateralCommand}"
                                            Style="{StaticResource MaterialDesignRaisedButton}"
                                            Padding="12,6"
                                            Foreground="White"/>
                                    <Button Command="{Binding ToggleCollateralNotePanelCommand}"
                                            Style="{StaticResource MaterialDesignIconButton}"
                                            ToolTip="비고 패널 열기/닫기"
                                            Width="32" Height="32"
                                            Padding="0"
                                            Margin="8,0,0,0"
                                            Foreground="White">
                                        <materialDesign:PackIcon Kind="NoteEdit" Width="18" Height="18"/>
                                    </Button>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <!-- 3분할 지도 영역 -->
                        <Grid x:Name="MapPanelGrid" Height="420">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="4"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="4"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <!-- 위성도 -->
                            <Grid Grid.Column="0">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>

                                <!-- 위성도 타이틀 -->
                                <Border Grid.Row="0"
                                        Background="{StaticResource BlueGray100Brush}"
                                        BorderBrush="{StaticResource BorderBrush}"
                                        BorderThickness="0,0,0,1"
                                        Padding="12,6">
                                    <Grid>
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                            <materialDesign:PackIcon Kind="Satellite" Width="16" Height="16" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                            <TextBlock Text="위성도" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                        </StackPanel>
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                            <Button x:Name="SatelliteLockButton"
                                                    Content="고정"
                                                    Click="SatelliteLock_Click"
                                                    Style="{StaticResource MaterialDesignFlatButton}"
                                                    Padding="6,2"
                                                    Height="24"
                                                    FontSize="11"
                                                    Margin="0,0,4,0"
                                                    ToolTip="지도 드래그/줌 고정"/>
                                            <Button Click="SatelliteExpand_Click"
                                                    Style="{StaticResource MaterialDesignFlatButton}"
                                                    Padding="4,2"
                                                    Height="24"
                                                    ToolTip="확대 보기">
                                                <materialDesign:PackIcon Kind="Fullscreen" Width="16" Height="16"/>
                                            </Button>
                                        </StackPanel>
                                    </Grid>
                                </Border>

                                <!-- 위성도 WebView2 -->
                                <wv2:WebView2 x:Name="SatelliteMapWebView" Grid.Row="1"/>
                            </Grid>

                            <!-- 열 구분선 1 -->
                            <Border Grid.Column="1" Background="{StaticResource BorderBrush}"/>

                            <!-- 지적도 -->
                            <Grid Grid.Column="2">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>

                                <!-- 지적도 타이틀 -->
                                <Border Grid.Row="0"
                                        Background="{StaticResource BlueGray100Brush}"
                                        BorderBrush="{StaticResource BorderBrush}"
                                        BorderThickness="0,0,0,1"
                                        Padding="12,6">
                                    <Grid>
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                            <materialDesign:PackIcon Kind="Map" Width="16" Height="16" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                            <TextBlock Text="지적도" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                        </StackPanel>
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                            <Button x:Name="CadastralLockButton"
                                                    Content="고정"
                                                    Click="CadastralLock_Click"
                                                    Style="{StaticResource MaterialDesignFlatButton}"
                                                    Padding="6,2"
                                                    Height="24"
                                                    FontSize="11"
                                                    Margin="0,0,4,0"
                                                    ToolTip="지도 드래그/줌 고정"/>
                                            <Button Click="CadastralExpand_Click"
                                                    Style="{StaticResource MaterialDesignFlatButton}"
                                                    Padding="4,2"
                                                    Height="24"
                                                    ToolTip="확대 보기">
                                                <materialDesign:PackIcon Kind="Fullscreen" Width="16" Height="16"/>
                                            </Button>
                                        </StackPanel>
                                    </Grid>
                                </Border>

                                <!-- 지적도 WebView2 -->
                                <wv2:WebView2 x:Name="CadastralMapWebView" Grid.Row="1"/>
                            </Grid>

                            <!-- 열 구분선 2 -->
                            <Border Grid.Column="3" Background="{StaticResource BorderBrush}"/>

                            <!-- 로드뷰 -->
                            <Grid Grid.Column="4">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>

                                <!-- 로드뷰 타이틀 -->
                                <Border Grid.Row="0"
                                        Background="{StaticResource BlueGray100Brush}"
                                        BorderBrush="{StaticResource BorderBrush}"
                                        BorderThickness="0,0,0,1"
                                        Padding="12,6">
                                    <Grid>
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                            <materialDesign:PackIcon Kind="Walk" Width="16" Height="16" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                            <TextBlock Text="로드뷰" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                        </StackPanel>
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                            <Button x:Name="RoadViewLockButton"
                                                    Content="고정"
                                                    Click="RoadViewLock_Click"
                                                    Style="{StaticResource MaterialDesignFlatButton}"
                                                    Padding="6,2"
                                                    Height="24"
                                                    FontSize="11"
                                                    Margin="0,0,4,0"
                                                    ToolTip="지도 드래그/줌 고정"/>
                                            <Button Click="RoadViewExpand_Click"
                                                    Style="{StaticResource MaterialDesignFlatButton}"
                                                    Padding="4,2"
                                                    Height="24"
                                                    ToolTip="확대 보기">
                                                <materialDesign:PackIcon Kind="Fullscreen" Width="16" Height="16"/>
                                            </Button>
                                        </StackPanel>
                                    </Grid>
                                </Border>

                                <!-- 로드뷰 WebView2 -->
                                <wv2:WebView2 x:Name="RoadViewWebView" Grid.Row="1"/>
                            </Grid>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- WebView2 패널 (버튼 클릭 시 표시) -->
                <Border x:Name="WebViewPanel"
                        Background="{StaticResource SurfaceColor}"
                        BorderBrush="{StaticResource PrimaryBrush}"
                        BorderThickness="1"
                        CornerRadius="8"
                        Margin="0,0,0,16"
                        Visibility="Collapsed"
                        MinHeight="500">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <!-- 헤더 (제목 + 닫기 버튼) -->
                        <Border Grid.Row="0"
                                Background="{StaticResource PrimaryBrush}"
                                CornerRadius="8,8,0,0"
                                Padding="16,10">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <materialDesign:PackIcon x:Name="WebViewIcon" Kind="Map"
                                                         Width="20" Height="20"
                                                         Foreground="White"
                                                         VerticalAlignment="Center"
                                                         Margin="0,0,8,0"/>

                                <TextBlock x:Name="WebViewTitle"
                                           Grid.Column="1"
                                           Text="지도"
                                           Foreground="White"
                                           FontWeight="SemiBold"
                                           FontSize="{StaticResource FontSizeH4}"
                                           VerticalAlignment="Center"/>

                                <Button Grid.Column="2"
                                        Style="{StaticResource MaterialDesignFlatButton}"
                                        Foreground="White"
                                        Click="CloseWebView_Click"
                                        ToolTip="닫기"
                                        Padding="8,4">
                                    <StackPanel Orientation="Horizontal">
                                        <materialDesign:PackIcon Kind="Close" Width="18" Height="18" VerticalAlignment="Center"/>
                                        <TextBlock Text="닫기" Margin="4,0,0,0" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                            </Grid>
                        </Border>

                        <!-- WebView2 컨트롤 -->
                        <wv2:WebView2 x:Name="MapWebView"
                                      Grid.Row="1"
                                      MinHeight="450"/>
                    </Grid>
                </Border>
                
                <!-- ========== 물건 기본 정보 테이블 (1~2줄로 간소화) ========== -->
                <Border Background="{StaticResource SurfaceColor}"
                        BorderBrush="{StaticResource BorderBrush}"
                        BorderThickness="1"
                        CornerRadius="8"
                        Margin="0,0,0,16">
                    <StackPanel>
                        <!-- 헤더 -->
                        <Border Background="{StaticResource PrimaryBrush}"
                                CornerRadius="8,8,0,0"
                                Padding="16,10">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0"
                                           Text="📍 물건 기본 정보"
                                           Foreground="White"
                                           FontWeight="SemiBold"
                                           FontSize="{StaticResource FontSizeH4}"
                                           VerticalAlignment="Center"/>
                                <Button Grid.Column="1"
                                        Padding="12,6"
                                        Click="OpenLandUsePlan_Click"
                                        ToolTip="토지이용계획 열기"
                                        Background="Transparent"
                                        BorderBrush="White"
                                        BorderThickness="1"
                                        Cursor="Hand">
                                    <StackPanel Orientation="Horizontal">
                                        <materialDesign:PackIcon Kind="FileDocument" Width="14" Height="14" Margin="0,0,4,0" VerticalAlignment="Center" Foreground="White"/>
                                        <TextBlock Text="토지이용계획" VerticalAlignment="Center" Foreground="White" FontSize="{StaticResource FontSizeSmall}"/>
                                    </StackPanel>
                                </Button>
                            </Grid>
                        </Border>
                        
                        <!-- 테이블 (1줄: 주소, 담보종류, 토지면적, 건물면적, 공장저당) -->
                        <Grid Margin="0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="80"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="80"/>
                                <ColumnDefinition Width="120"/>
                                <ColumnDefinition Width="80"/>
                                <ColumnDefinition Width="120"/>
                                <ColumnDefinition Width="80"/>
                                <ColumnDefinition Width="120"/>
                                <ColumnDefinition Width="80"/>
                                <ColumnDefinition Width="80"/>
                            </Grid.ColumnDefinitions>
                            
                            <!-- 주소 -->
                            <Border Grid.Column="0" Style="{StaticResource TableHeaderCell}" BorderThickness="0,0,1,0">
                                <TextBlock Text="주소" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}"/>
                            </Border>
                            <Border Grid.Column="1" Style="{StaticResource TableDataCell}" BorderThickness="0,0,1,0">
                                <TextBlock Text="{Binding Property.AddressFull, FallbackValue='-'}" 
                                           TextWrapping="NoWrap"
                                           TextTrimming="CharacterEllipsis"
                                           FontWeight="SemiBold"
                                           ToolTip="{Binding Property.AddressFull}"/>
                            </Border>
                            
                            <!-- 담보종류 -->
                            <Border Grid.Column="2" Style="{StaticResource TableHeaderCell}" BorderThickness="0,0,1,0">
                                <TextBlock Text="담보종류" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}"/>
                            </Border>
                            <Border Grid.Column="3" Style="{StaticResource TableDataCell}" BorderThickness="0,0,1,0">
                                <TextBlock Text="{Binding Property.PropertyType, FallbackValue='-'}" HorizontalAlignment="Center"/>
                            </Border>
                            
                            <!-- 토지면적 -->
                            <Border Grid.Column="4" Style="{StaticResource TableHeaderCell}" BorderThickness="0,0,1,0">
                                <TextBlock Text="토지면적" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}"/>
                            </Border>
                            <Border Grid.Column="5" Style="{StaticResource TableDataCell}" BorderThickness="0,0,1,0">
                                <TextBlock HorizontalAlignment="Right">
                                    <Run Text="{Binding Property.LandArea, StringFormat=N2, FallbackValue='-'}"/>
                                    <Run Text=" ㎡" Foreground="{StaticResource TextSecondaryBrush}"/>
                                </TextBlock>
                            </Border>
                            
                            <!-- 건물면적 -->
                            <Border Grid.Column="6" Style="{StaticResource TableHeaderCell}" BorderThickness="0,0,1,0">
                                <TextBlock Text="건물면적" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}"/>
                            </Border>
                            <Border Grid.Column="7" Style="{StaticResource TableDataCell}" BorderThickness="0,0,1,0">
                                <TextBlock HorizontalAlignment="Right">
                                    <Run Text="{Binding Property.BuildingArea, StringFormat=N2, FallbackValue='-'}"/>
                                    <Run Text=" ㎡" Foreground="{StaticResource TextSecondaryBrush}"/>
                                </TextBlock>
                            </Border>
                            
                            <!-- 공장저당 -->
                            <Border Grid.Column="8" Style="{StaticResource TableHeaderCell}" BorderThickness="0,0,1,0">
                                <TextBlock Text="공장저당" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}"/>
                            </Border>
                            <Border Grid.Column="9" Style="{StaticResource TableDataCell}" BorderThickness="0">
                                <TextBlock Text="{Binding IsFactoryMortgageText, FallbackValue='-'}" HorizontalAlignment="Center"/>
                            </Border>
                        </Grid>
                    </StackPanel>
                </Border>
                
                <!-- ========== 등기부등본 정보 ========== -->
                <Border Background="{StaticResource SurfaceColor}"
                        BorderBrush="{StaticResource BorderBrush}"
                        BorderThickness="1"
                        CornerRadius="8"
                        Margin="0,0,0,16">
                    <StackPanel>
                        <!-- 헤더 -->
                        <Border Background="{StaticResource PrimaryBrush}"
                                CornerRadius="8,8,0,0"
                                Padding="16,10">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0"
                                           Text="📄 등기부등본 정보"
                                           Foreground="White"
                                           FontWeight="SemiBold"
                                           FontSize="{StaticResource FontSizeH4}"
                                           VerticalAlignment="Center"/>
                                <Button Grid.Column="1"
                                        Padding="12,6"
                                        Command="{Binding ToggleRegistryImagePanelCommand}"
                                        ToolTip="등기부등본 원본 이미지 보기/숨기기"
                                        Background="Transparent"
                                        BorderBrush="White"
                                        BorderThickness="1"
                                        Cursor="Hand">
                                    <StackPanel Orientation="Horizontal">
                                        <materialDesign:PackIcon Kind="FileImage" Width="14" Height="14" Margin="0,0,4,0" VerticalAlignment="Center" Foreground="White"/>
                                        <TextBlock Text="등기부등본" VerticalAlignment="Center" Foreground="White" FontSize="{StaticResource FontSizeSmall}"/>
                                    </StackPanel>
                                </Button>
                            </Grid>
                        </Border>

                        <!-- basic_info + 갑구 + 을구 -->
                        <StackPanel>
                            <!-- 1) 소유지분현황 (basic_info) - DataGrid -->
                            <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1">
                                <StackPanel>
                                    <Border Background="{StaticResource BlueGray100Brush}" Padding="12,8">
                                        <TextBlock Text="1. 소유지분현황 (기본정보)" FontWeight="SemiBold"/>
                                    </Border>
                                    <DataGrid ItemsSource="{Binding RegistryBasicInfoList}"
                                              AutoGenerateColumns="False"
                                              CanUserAddRows="False"
                                              CanUserDeleteRows="False"
                                              IsReadOnly="True"
                                              HeadersVisibility="Column"
                                              GridLinesVisibility="Horizontal"
                                              BorderThickness="0"
                                              RowHeight="32"
                                              Background="White"
                                              RowBackground="White"
                                              ColumnHeaderStyle="{StaticResource SectionDataGridColumnHeaderStyle}"
                                              CellStyle="{StaticResource SectionDataGridCellStyle}"
                                              RowStyle="{StaticResource SectionDataGridRowStyle}"
                                              Margin="12"
                                              MinHeight="80"
                                              PreviewMouseWheel="DataGrid_PreviewMouseWheel">
                                        <DataGrid.Columns>
                                            <DataGridTextColumn Header="지번일련번호" Binding="{Binding JibeonId}" Width="Auto"
                                                                ElementStyle="{StaticResource SectionDataGridTextBlockStyle}"/>
                                            <DataGridTextColumn Header="물건지 (등기부등본)" Binding="{Binding RegistryAddress}" Width="*"
                                                                ElementStyle="{StaticResource SectionDataGridTextBlockStyle}"/>
                                            <DataGridTextColumn Header="물건지 (DD)" Binding="{Binding DdAddress}" Width="*"
                                                                ElementStyle="{StaticResource SectionDataGridTextBlockStyle}"/>
                                            <DataGridTextColumn Header="일치여부" Binding="{Binding IsAddressMatched}" Width="Auto"
                                                                ElementStyle="{StaticResource SectionDataGridTextBlockStyle}"/>
                                            <DataGridTextColumn Header="담보물형태" Binding="{Binding CollateralType}" Width="Auto"
                                                                ElementStyle="{StaticResource SectionDataGridTextBlockStyle}"/>
                                            <DataGridTextColumn Header="대지면적 (평)" Binding="{Binding LandAreaPyeong, StringFormat={}{0:N2}}" Width="Auto"
                                                                ElementStyle="{StaticResource SectionDataGridTextBlockStyle}"/>
                                            <DataGridTextColumn Header="건물면적 (평)" Binding="{Binding BuildingAreaPyeong, StringFormat={}{0:N2}}" Width="Auto"
                                                                ElementStyle="{StaticResource SectionDataGridTextBlockStyle}"/>
                                            <DataGridTextColumn Header="소유자" Binding="{Binding OwnerName}" Width="Auto"
                                                                ElementStyle="{StaticResource SectionDataGridTextBlockStyle}"/>
                                            <DataGridTextColumn Header="등록번호" Binding="{Binding OwnerRegNo}" Width="Auto"
                                                                ElementStyle="{StaticResource SectionDataGridTextBlockStyle}"/>
                                            <DataGridTextColumn Header="최종지분" Binding="{Binding ShareRatio}" Width="Auto"
                                                                ElementStyle="{StaticResource SectionDataGridTextBlockStyle}"/>
                                            <DataGridTextColumn Header="소유자 주소" Binding="{Binding OwnerAddress}" Width="*"
                                                                ElementStyle="{StaticResource SectionDataGridTextBlockStyle}"/>
                                        </DataGrid.Columns>
                                    </DataGrid>
                                </StackPanel>
                            </Border>

                            <!-- 2) 갑구 -->
                            <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1">
                                <StackPanel>
                                    <Border Background="{StaticResource BlueGray100Brush}" Padding="12,8">
                                        <Grid>
                                            <TextBlock Text="2. 갑구" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                        </Grid>
                                    </Border>
                                    <DataGrid x:Name="GapguDataGrid"
                                              ItemsSource="{Binding RegistryGapguRows}"
                                              AutoGenerateColumns="False"
                                              CanUserAddRows="False"
                                              CanUserDeleteRows="False"
                                              IsReadOnly="False"
                                              HeadersVisibility="Column"
                                              GridLinesVisibility="Horizontal"
                                              BorderThickness="0"
                                              RowHeight="32"
                                              Background="White"
                                              RowBackground="White"
                                              ColumnHeaderStyle="{StaticResource SectionDataGridColumnHeaderStyle}"
                                              CellStyle="{StaticResource SectionDataGridCellStyle}"
                                              RowStyle="{StaticResource SectionDataGridRowStyle}"
                                              Margin="12"
                                              MinHeight="160"
                                              PreviewMouseWheel="DataGrid_PreviewMouseWheel">
                                        <DataGrid.Columns>
                                            <DataGridTextColumn Header="순위번호" Binding="{Binding RankNo, UpdateSourceTrigger=PropertyChanged}" Width="Auto"
                                                                ElementStyle="{StaticResource SectionDataGridTextBlockStyle}"
                                                                EditingElementStyle="{StaticResource SectionDataGridTextBoxStyle}"/>
                                            <DataGridTextColumn Header="등기목적" Binding="{Binding Purpose, UpdateSourceTrigger=PropertyChanged}" Width="2*"
                                                                ElementStyle="{StaticResource SectionDataGridTextBlockStyle}"
                                                                EditingElementStyle="{StaticResource SectionDataGridTextBoxStyle}"/>
                                            <DataGridTextColumn Header="접수정보" Binding="{Binding Receipt, UpdateSourceTrigger=PropertyChanged}" Width="2*"
                                                                ElementStyle="{StaticResource SectionDataGridTextBlockStyle}"
                                                                EditingElementStyle="{StaticResource SectionDataGridTextBoxStyle}"/>
                                            <DataGridTextColumn Header="접수날짜" Binding="{Binding ReceiptDate, StringFormat=yyyy-MM-dd, UpdateSourceTrigger=PropertyChanged}" Width="Auto"
                                                                ElementStyle="{StaticResource SectionDataGridTextBlockStyle}"
                                                                EditingElementStyle="{StaticResource SectionDataGridTextBoxStyle}"/>
                                            <DataGridTextColumn Header="권리자" Binding="{Binding RightHolder, UpdateSourceTrigger=PropertyChanged}" Width="2*"
                                                                ElementStyle="{StaticResource SectionDataGridTextBlockStyle}"
                                                                EditingElementStyle="{StaticResource SectionDataGridTextBoxStyle}"/>
                                            <DataGridTextColumn Header="청구금액" Binding="{Binding ClaimAmount, StringFormat=N0, UpdateSourceTrigger=PropertyChanged}" Width="Auto"
                                                                ElementStyle="{StaticResource SectionDataGridTextBlockStyle}"
                                                                EditingElementStyle="{StaticResource SectionDataGridTextBoxStyle}"/>
                                            <DataGridTextColumn Header="비고" Binding="{Binding NoteUserInput, UpdateSourceTrigger=PropertyChanged}" Width="2*"
                                                                ElementStyle="{StaticResource SectionDataGridTextBlockStyle}"
                                                                EditingElementStyle="{StaticResource SectionDataGridTextBoxStyle}"/>
                                            <DataGridTextColumn Header="임금채권추정" Binding="{Binding WageClaimEstimateUserInput, UpdateSourceTrigger=PropertyChanged}" Width="Auto"
                                                                ElementStyle="{StaticResource SectionDataGridTextBlockStyle}"
                                                                EditingElementStyle="{StaticResource SectionDataGridTextBoxStyle}"/>
                                            <DataGridTextColumn Header="대상소유자" Binding="{Binding TargetOwner, UpdateSourceTrigger=PropertyChanged}" Width="*"
                                                                ElementStyle="{StaticResource SectionDataGridTextBlockStyle}"
                                                                EditingElementStyle="{StaticResource SectionDataGridTextBoxStyle}"/>
                                            <DataGridTextColumn Header="지번번호" Binding="{Binding JibunNumber, UpdateSourceTrigger=PropertyChanged}" Width="Auto"
                                                                ElementStyle="{StaticResource SectionDataGridTextBlockStyle}"
                                                                EditingElementStyle="{StaticResource SectionDataGridTextBoxStyle}"/>
                                        </DataGrid.Columns>
                                    </DataGrid>

                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="12,0,12,8">
                                        <Button Command="{Binding AddGapguRowCommand}"
                                                Style="{StaticResource MaterialDesignFlatButton}"
                                                Padding="12,6" Height="28" ToolTip="행 추가">
                                            <StackPanel Orientation="Horizontal">
                                                <materialDesign:PackIcon Kind="Plus" Width="14" Height="14" VerticalAlignment="Center"/>
                                                <TextBlock Text="행 추가" Margin="4,0,0,0" FontSize="{StaticResource FontSizeSmall}" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </Button>
                                        <Button Command="{Binding DeleteGapguRowCommand}"
                                                CommandParameter="{Binding SelectedItem, ElementName=GapguDataGrid}"
                                                Style="{StaticResource MaterialDesignFlatButton}"
                                                Foreground="{StaticResource ErrorBrush}"
                                                Padding="12,6" Height="28" Margin="4,0,0,0" ToolTip="선택 행 삭제">
                                            <StackPanel Orientation="Horizontal">
                                                <materialDesign:PackIcon Kind="Delete" Width="14" Height="14" VerticalAlignment="Center"/>
                                                <TextBlock Text="행 삭제" Margin="4,0,0,0" FontSize="{StaticResource FontSizeSmall}" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </Button>
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                            <!-- 3) 을구 -->
                            <Border>
                                <StackPanel>
                                    <Border Background="{StaticResource BlueGray100Brush}" Padding="12,8">
                                        <Grid>
                                            <TextBlock Text="3. 을구" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                        </Grid>
                                    </Border>
                                    <DataGrid x:Name="EulguDataGrid"
                                              ItemsSource="{Binding RegistryEulguRows}"
                                              AutoGenerateColumns="False"
                                              CanUserAddRows="False"
                                              CanUserDeleteRows="False"
                                              IsReadOnly="False"
                                              HeadersVisibility="Column"
                                              GridLinesVisibility="Horizontal"
                                              BorderThickness="0"
                                              RowHeight="32"
                                              Background="White"
                                              RowBackground="White"
                                              ColumnHeaderStyle="{StaticResource SectionDataGridColumnHeaderStyle}"
                                              CellStyle="{StaticResource SectionDataGridCellStyle}"
                                              RowStyle="{StaticResource SectionDataGridRowStyle}"
                                              Margin="12"
                                              MinHeight="160"
                                              PreviewMouseWheel="DataGrid_PreviewMouseWheel">
                                        <DataGrid.Columns>
                                            <DataGridTextColumn Header="순위번호" Binding="{Binding RankNo, UpdateSourceTrigger=PropertyChanged}" Width="Auto"
                                                                ElementStyle="{StaticResource SectionDataGridTextBlockStyle}"
                                                                EditingElementStyle="{StaticResource SectionDataGridTextBoxStyle}"/>
                                            <DataGridTextColumn Header="등기목적" Binding="{Binding Purpose, UpdateSourceTrigger=PropertyChanged}" Width="2*"
                                                                ElementStyle="{StaticResource SectionDataGridTextBlockStyle}"
                                                                EditingElementStyle="{StaticResource SectionDataGridTextBoxStyle}"/>
                                            <DataGridTextColumn Header="접수정보" Binding="{Binding Receipt, UpdateSourceTrigger=PropertyChanged}" Width="2*"
                                                                ElementStyle="{StaticResource SectionDataGridTextBlockStyle}"
                                                                EditingElementStyle="{StaticResource SectionDataGridTextBoxStyle}"/>
                                            <DataGridTextColumn Header="접수날짜" Binding="{Binding ReceiptDate, StringFormat=yyyy-MM-dd, UpdateSourceTrigger=PropertyChanged}" Width="Auto"
                                                                ElementStyle="{StaticResource SectionDataGridTextBlockStyle}"
                                                                EditingElementStyle="{StaticResource SectionDataGridTextBoxStyle}"/>
                                            <DataGridTextColumn Header="근저당권자" Binding="{Binding MortgageHolder, UpdateSourceTrigger=PropertyChanged}" Width="2*"
                                                                ElementStyle="{StaticResource SectionDataGridTextBlockStyle}"
                                                                EditingElementStyle="{StaticResource SectionDataGridTextBoxStyle}"/>
                                            <DataGridTextColumn Header="채권최고액" Binding="{Binding MaxClaimAmount, StringFormat=N0, UpdateSourceTrigger=PropertyChanged}" Width="Auto"
                                                                ElementStyle="{StaticResource SectionDataGridTextBlockStyle}"
                                                                EditingElementStyle="{StaticResource SectionDataGridTextBoxStyle}"/>
                                            <DataGridTextColumn Header="채무자" Binding="{Binding DebtorUserInput, UpdateSourceTrigger=PropertyChanged}" Width="2*"
                                                                ElementStyle="{StaticResource SectionDataGridTextBlockStyle}"
                                                                EditingElementStyle="{StaticResource SectionDataGridTextBoxStyle}"/>
                                            <DataGridTextColumn Header="담보종류" Binding="{Binding CollateralTypeUserInput, UpdateSourceTrigger=PropertyChanged}" Width="*"
                                                                ElementStyle="{StaticResource SectionDataGridTextBlockStyle}"
                                                                EditingElementStyle="{StaticResource SectionDataGridTextBoxStyle}"/>
                                            <DataGridTextColumn Header="공장저당" Binding="{Binding IsFactoryMortgageUserInput, UpdateSourceTrigger=PropertyChanged}" Width="Auto"
                                                                ElementStyle="{StaticResource SectionDataGridTextBlockStyle}"
                                                                EditingElementStyle="{StaticResource SectionDataGridTextBoxStyle}"/>
                                            <DataGridTextColumn Header="대상소유자" Binding="{Binding TargetOwner, UpdateSourceTrigger=PropertyChanged}" Width="*"
                                                                ElementStyle="{StaticResource SectionDataGridTextBlockStyle}"
                                                                EditingElementStyle="{StaticResource SectionDataGridTextBoxStyle}"/>
                                            <DataGridTextColumn Header="지번번호" Binding="{Binding JibunNumber, UpdateSourceTrigger=PropertyChanged}" Width="Auto"
                                                                ElementStyle="{StaticResource SectionDataGridTextBlockStyle}"
                                                                EditingElementStyle="{StaticResource SectionDataGridTextBoxStyle}"/>
                                        </DataGrid.Columns>
                                    </DataGrid>

                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="12,0,12,12">
                                        <Button Command="{Binding AddEulguRowCommand}"
                                                Style="{StaticResource MaterialDesignFlatButton}"
                                                Padding="12,6" Height="28" ToolTip="행 추가">
                                            <StackPanel Orientation="Horizontal">
                                                <materialDesign:PackIcon Kind="Plus" Width="14" Height="14" VerticalAlignment="Center"/>
                                                <TextBlock Text="행 추가" Margin="4,0,0,0" FontSize="{StaticResource FontSizeSmall}" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </Button>
                                        <Button Command="{Binding DeleteEulguRowCommand}"
                                                CommandParameter="{Binding SelectedItem, ElementName=EulguDataGrid}"
                                                Style="{StaticResource MaterialDesignFlatButton}"
                                                Foreground="{StaticResource ErrorBrush}"
                                                Padding="12,6" Height="28" Margin="4,0,0,0" ToolTip="선택 행 삭제">
                                            <StackPanel Orientation="Horizontal">
                                                <materialDesign:PackIcon Kind="Delete" Width="14" Height="14" VerticalAlignment="Center"/>
                                                <TextBlock Text="행 삭제" Margin="4,0,0,0" FontSize="{StaticResource FontSizeSmall}" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </Button>
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <!-- 등기부등본 이미지 뷰어 (토글 패널) -->
                        <Border BorderBrush="{StaticResource BorderBrush}" 
                                BorderThickness="0,1,0,0"
                                Visibility="{Binding IsRegistryImageExpanded, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <StackPanel>
                                <Border Background="{StaticResource BlueGray100Brush}" Padding="12,8">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="물건지 선택:" VerticalAlignment="Center" FontWeight="SemiBold" Margin="0,0,8,0"/>
                                        <ComboBox Grid.Column="1"
                                                  ItemsSource="{Binding RegistryRuns}"
                                                  SelectedItem="{Binding SelectedImageRun}"
                                                  DisplayMemberPath="SourcePdfName"
                                                  MinWidth="300"
                                                  MaxWidth="600"
                                                  HorizontalAlignment="Left"/>
                                    </Grid>
                                </Border>
                                <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="800" Margin="12">
                                    <ItemsControl ItemsSource="{Binding RegistryDocumentImages}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" Margin="0,0,0,8" CornerRadius="4">
                                                    <Image Source="{Binding}" Stretch="Uniform"/>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>
                                <!-- 이미지 없을 때 안내 -->
                                <TextBlock Text="선택한 물건지에 대한 등기부등본 이미지가 없습니다. OCR 처리를 먼저 수행해 주세요."
                                           Foreground="{StaticResource TextSecondaryBrush}"
                                           HorizontalAlignment="Center"
                                           Margin="12,20"
                                           FontSize="{StaticResource FontSizeSmall}">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding RegistryDocumentImages.Count}" Value="0">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Border>

                <!-- ========== 감정평가 정보 ========== -->
                <Border Background="{StaticResource SurfaceColor}"
                        BorderBrush="{StaticResource BorderBrush}"
                        BorderThickness="1"
                        CornerRadius="8"
                        Margin="0,0,0,16">
                    <StackPanel>
                        <Border Background="{StaticResource PrimaryBrush}"
                                CornerRadius="8,8,0,0"
                                Padding="16,10">
                            <TextBlock Text="📊 감정평가 정보"
                                       Foreground="White"
                                       FontWeight="SemiBold"
                                       FontSize="{StaticResource FontSizeH4}"/>
                        </Border>
                        <DataGrid ItemsSource="{Binding AppraisalInfoList}"
                                  AutoGenerateColumns="False"
                                  CanUserAddRows="False"
                                  CanUserDeleteRows="False"
                                  IsReadOnly="True"
                                  HeadersVisibility="Column"
                                  GridLinesVisibility="Horizontal"
                                  BorderThickness="0"
                                  RowHeight="32"
                                  Background="White"
                                  RowBackground="White"
                                  ColumnHeaderStyle="{StaticResource SectionDataGridColumnHeaderStyle}"
                                  CellStyle="{StaticResource SectionDataGridCellStyle}"
                                  RowStyle="{StaticResource SectionDataGridRowStyle}"
                                  Margin="12"
                                  MinHeight="60"
                                  PreviewMouseWheel="DataGrid_PreviewMouseWheel">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="감정평가구분" Binding="{Binding AppraisalType}" Width="*"
                                                    ElementStyle="{StaticResource SectionDataGridTextBlockStyle}"/>
                                <DataGridTextColumn Header="감정평가일자" Binding="{Binding AppraisalDateFormatted}" Width="*"
                                                    ElementStyle="{StaticResource SectionDataGridTextBlockStyle}"/>
                                <DataGridTextColumn Header="감정평가기관" Binding="{Binding AppraisalAgency}" Width="*"
                                                    ElementStyle="{StaticResource SectionDataGridTextBlockStyle}"/>
                                <DataGridTextColumn Header="토지 감정평가액" Binding="{Binding LandAppraisalFormatted}" Width="*"
                                                    ElementStyle="{StaticResource SectionDataGridTextBlockStyle}"/>
                                <DataGridTextColumn Header="건물 감정평가액" Binding="{Binding BuildingAppraisalFormatted}" Width="*"
                                                    ElementStyle="{StaticResource SectionDataGridTextBlockStyle}"/>
                                <DataGridTextColumn Header="기계 감정평가액" Binding="{Binding MachineryAppraisalFormatted}" Width="*"
                                                    ElementStyle="{StaticResource SectionDataGridTextBlockStyle}"/>
                                <DataGridTextColumn Header="제시외" Binding="{Binding ExcludedAppraisalFormatted}" Width="*"
                                                    ElementStyle="{StaticResource SectionDataGridTextBlockStyle}"/>
                                <DataGridTextColumn Header="감정평가액합계" Binding="{Binding AppraisalValueFormatted}" Width="*">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock" BasedOn="{StaticResource SectionDataGridTextBlockStyle}">
                                            <Setter Property="FontWeight" Value="SemiBold"/>
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>
                            </DataGrid.Columns>
                        </DataGrid>

                        <!-- KB시세 (아파트인 경우만 표시) -->
                        <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0"
                                Visibility="{Binding IsApartment, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <StackPanel>
                                <Border Background="{StaticResource BlueGray100Brush}" Padding="12,8">
                                    <TextBlock Text="KB시세" FontWeight="SemiBold"/>
                                </Border>
                                <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="1,1,0,0" Margin="12">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>

                                        <!-- 헤더 -->
                                        <Border Grid.Row="0" Grid.Column="0" Style="{StaticResource TableHeaderCell}">
                                            <TextBlock Text="KB시세 데이터" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}" HorizontalAlignment="Center"/>
                                        </Border>
                                        <Border Grid.Row="0" Grid.Column="1" Style="{StaticResource TableHeaderCell}">
                                            <TextBlock Text="KB시세" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}" HorizontalAlignment="Center"/>
                                        </Border>
                                        <Border Grid.Row="0" Grid.Column="2" Style="{StaticResource TableHeaderCell}">
                                            <TextBlock Text="분양면적" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}" HorizontalAlignment="Center"/>
                                        </Border>

                                        <!-- 데이터 -->
                                        <Border Grid.Row="1" Grid.Column="0" Style="{StaticResource TableDataCell}">
                                            <TextBlock HorizontalAlignment="Center">
                                                <Hyperlink Command="{Binding OpenKBSiteCommand}" ToolTip="{Binding KbLandUrl}">
                                                    <Run Text="KB부동산 시세 확인"/>
                                                </Hyperlink>
                                            </TextBlock>
                                        </Border>
                                        <Border Grid.Row="1" Grid.Column="1" Style="{StaticResource TableDataCell}">
                                            <TextBlock Text="{Binding KbPrice, StringFormat=N0, TargetNullValue='-'}"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="SemiBold"/>
                                        </Border>
                                        <Border Grid.Row="1" Grid.Column="2" Style="{StaticResource TableDataCell}">
                                            <TextBox Text="{Binding KbSupplyArea, StringFormat=N2, UpdateSourceTrigger=PropertyChanged}"
                                                     BorderThickness="0" Background="Transparent"
                                                     HorizontalContentAlignment="Center" VerticalContentAlignment="Center"/>
                                        </Border>
                                    </Grid>
                                </Border>
                            </StackPanel>
                        </Border>

                        <!-- 분양가 (상가/아파트형공장인 경우만 표시) -->
                        <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0"
                                Visibility="{Binding IsCommercialOrFactory, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <StackPanel>
                                <Border Background="{StaticResource BlueGray100Brush}" Padding="12,8">
                                    <TextBlock Text="분양가" FontWeight="SemiBold"/>
                                </Border>
                                <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" Margin="12">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="34"/>
                                            <RowDefinition Height="34"/>
                                            <RowDefinition Height="34"/>
                                        </Grid.RowDefinitions>

                                        <!-- Row 0: 분양면적 (RowSpan=2) | 분양가 (ColSpan=4) -->
                                        <Border Grid.Row="0" Grid.Column="0" Grid.RowSpan="2" Style="{StaticResource CompactTableHeaderCell}">
                                            <TextBlock Text="분양면적" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <Border Grid.Row="0" Grid.Column="1" Grid.ColumnSpan="4" Style="{StaticResource CompactTableHeaderCell}">
                                            <TextBlock Text="분양가" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}" HorizontalAlignment="Center"/>
                                        </Border>

                                        <!-- Row 1: 분양가 하위 헤더 (토지, 건물, 합계, 부가세) -->
                                        <Border Grid.Row="1" Grid.Column="1" Style="{StaticResource CompactTableHeaderCell}">
                                            <TextBlock Text="토지" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}" HorizontalAlignment="Center"/>
                                        </Border>
                                        <Border Grid.Row="1" Grid.Column="2" Style="{StaticResource CompactTableHeaderCell}">
                                            <TextBlock Text="건물" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}" HorizontalAlignment="Center"/>
                                        </Border>
                                        <Border Grid.Row="1" Grid.Column="3" Style="{StaticResource CompactTableHeaderCell}">
                                            <TextBlock Text="합계" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}" HorizontalAlignment="Center"/>
                                        </Border>
                                        <Border Grid.Row="1" Grid.Column="4" Style="{StaticResource CompactTableHeaderCell}">
                                            <TextBlock Text="부가세" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}" HorizontalAlignment="Center"/>
                                        </Border>

                                        <!-- Row 2: 데이터 (모두 유저 입력) -->
                                        <Border Grid.Row="2" Grid.Column="0" Style="{StaticResource CompactTableDataCell}">
                                            <TextBox Text="{Binding SaleSupplyArea, StringFormat=N2, UpdateSourceTrigger=PropertyChanged}"
                                                     BorderThickness="0" Background="Transparent"
                                                     HorizontalContentAlignment="Center" VerticalContentAlignment="Center"/>
                                        </Border>
                                        <Border Grid.Row="2" Grid.Column="1" Style="{StaticResource CompactTableDataCell}">
                                            <TextBox Text="{Binding SalePriceLand, StringFormat=N0, UpdateSourceTrigger=PropertyChanged, TargetNullValue=''}"
                                                     BorderThickness="0" Background="Transparent"
                                                     HorizontalContentAlignment="Center" VerticalContentAlignment="Center"/>
                                        </Border>
                                        <Border Grid.Row="2" Grid.Column="2" Style="{StaticResource CompactTableDataCell}">
                                            <TextBox Text="{Binding SalePriceBuilding, StringFormat=N0, UpdateSourceTrigger=PropertyChanged, TargetNullValue=''}"
                                                     BorderThickness="0" Background="Transparent"
                                                     HorizontalContentAlignment="Center" VerticalContentAlignment="Center"/>
                                        </Border>
                                        <Border Grid.Row="2" Grid.Column="3" Style="{StaticResource CompactTableDataCell}">
                                            <TextBox Text="{Binding SalePriceTotal, StringFormat=N0, UpdateSourceTrigger=PropertyChanged, TargetNullValue=''}"
                                                     BorderThickness="0" Background="Transparent"
                                                     HorizontalContentAlignment="Center" VerticalContentAlignment="Center"/>
                                        </Border>
                                        <Border Grid.Row="2" Grid.Column="4" Style="{StaticResource CompactTableDataCell}">
                                            <TextBox Text="{Binding SalePriceVat, StringFormat=N0, UpdateSourceTrigger=PropertyChanged, TargetNullValue=''}"
                                                     BorderThickness="0" Background="Transparent"
                                                     HorizontalContentAlignment="Center" VerticalContentAlignment="Center"/>
                                        </Border>
                                    </Grid>
                                </Border>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Border>

                <!-- ===== 지번별 감정평가 패널 ===== -->
                <Border Background="{StaticResource SurfaceColor}" CornerRadius="8"
                        BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                        Margin="0,0,0,16">
                    <StackPanel>
                        <!-- 패널 헤더 -->
                        <Border Background="{StaticResource PrimaryBrush}" CornerRadius="8,8,0,0" Padding="16,10">
                            <Grid>
                                <TextBlock Text="📋 지번별 감정평가" FontWeight="SemiBold"
                                           FontSize="{StaticResource FontSizeH4}" Foreground="White"
                                           VerticalAlignment="Center"/>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                    <Button Content="+" FontSize="16" FontWeight="Bold"
                                            Command="{Binding CreateJibunAppraisalTableCommand}"
                                            Visibility="{Binding HasJibunAppraisalTable, Converter={StaticResource InverseBooleanToVisibilityConverter}}"
                                            Padding="8,0" MinHeight="0" Height="20" Cursor="Hand"
                                            Background="Transparent" BorderThickness="0"
                                            Foreground="White" ToolTip="지번별 감정평가 테이블 생성"/>
                                    <Button Content="&#x2212;" FontSize="16" FontWeight="Bold"
                                            Command="{Binding DestroyJibunAppraisalTableCommand}"
                                            Visibility="{Binding HasJibunAppraisalTable, Converter={StaticResource BooleanToVisibilityConverter}}"
                                            Padding="8,0" MinHeight="0" Height="20" Cursor="Hand"
                                            Background="Transparent" BorderThickness="0"
                                            Foreground="White" ToolTip="지번별 감정평가 테이블 제거"/>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <!-- 테이블 (HasJibunAppraisalTable이 true일 때만 표시) -->
                        <StackPanel Visibility="{Binding HasJibunAppraisalTable, Converter={StaticResource BooleanToVisibilityConverter}}"
                                    Margin="12">
                            <DataGrid x:Name="JibunAppraisalDataGrid"
                                      ItemsSource="{Binding JibunAppraisalRows}"
                                      AutoGenerateColumns="False"
                                      CanUserAddRows="False" CanUserDeleteRows="False"
                                      CanUserSortColumns="False"
                                      HeadersVisibility="Column"
                                      RowHeight="32"
                                      GridLinesVisibility="All"
                                      HorizontalGridLinesBrush="{StaticResource BorderBrush}"
                                      VerticalGridLinesBrush="{StaticResource BorderBrush}"
                                      BorderThickness="0"
                                      Background="White"
                                      RowBackground="White"
                                      ColumnHeaderStyle="{StaticResource SectionDataGridColumnHeaderStyle}"
                                      CellStyle="{StaticResource SectionDataGridCellStyle}"
                                      RowStyle="{StaticResource SectionDataGridRowStyle}"
                                      MinHeight="60"
                                      PreviewMouseWheel="DataGrid_PreviewMouseWheel">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="지번일련번호" Binding="{Binding JaSeq, UpdateSourceTrigger=PropertyChanged}" Width="100"
                                                        ElementStyle="{StaticResource SectionDataGridTextBlockStyle}"
                                                        EditingElementStyle="{StaticResource SectionDataGridTextBoxStyle}"/>
                                    <DataGridTextColumn Header="구분" Binding="{Binding JaCategory, UpdateSourceTrigger=PropertyChanged}" Width="80"
                                                        ElementStyle="{StaticResource SectionDataGridTextBlockStyle}"
                                                        EditingElementStyle="{StaticResource SectionDataGridTextBoxStyle}"/>
                                    <DataGridTextColumn Header="지번주소지" Binding="{Binding JaAddress, UpdateSourceTrigger=PropertyChanged}" Width="*"
                                                        ElementStyle="{StaticResource SectionDataGridTextBlockStyle}"
                                                        EditingElementStyle="{StaticResource SectionDataGridTextBoxStyle}"/>
                                    <DataGridTextColumn Header="면적(평)" Binding="{Binding JaAreaPyeong, StringFormat=N2, UpdateSourceTrigger=PropertyChanged}" Width="90"
                                                        ElementStyle="{StaticResource SectionDataGridTextBlockStyle}"
                                                        EditingElementStyle="{StaticResource SectionDataGridTextBoxStyle}"/>
                                    <DataGridTextColumn Header="평당감정가" Binding="{Binding JaPricePerPyeong, StringFormat=N0, UpdateSourceTrigger=PropertyChanged}" Width="110"
                                                        ElementStyle="{StaticResource SectionDataGridTextBlockStyle}"
                                                        EditingElementStyle="{StaticResource SectionDataGridTextBoxStyle}"/>
                                    <DataGridTextColumn Header="감정가" Binding="{Binding JaAppraisalValue, StringFormat=N0, UpdateSourceTrigger=PropertyChanged}" Width="120"
                                                        ElementStyle="{StaticResource SectionDataGridTextBlockStyle}"
                                                        EditingElementStyle="{StaticResource SectionDataGridTextBoxStyle}"/>
                                </DataGrid.Columns>
                            </DataGrid>

                            <!-- 합계 행 -->
                            <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="1,0,1,1" Background="{StaticResource BlueGray100Brush}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="100"/>
                                        <ColumnDefinition Width="80"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="90"/>
                                        <ColumnDefinition Width="110"/>
                                        <ColumnDefinition Width="120"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="합계" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" Padding="8,6"/>
                                    <TextBlock Grid.Column="5" Text="{Binding JibunAppraisalTotalValue, StringFormat=N0}" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" Padding="8,6"/>
                                </Grid>
                            </Border>

                            <!-- 행 추가/삭제 버튼 -->
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
                                <Button Command="{Binding AddJibunAppraisalRowCommand}"
                                        Style="{StaticResource MaterialDesignFlatButton}"
                                        Padding="12,6" Height="28" ToolTip="행 추가">
                                    <StackPanel Orientation="Horizontal">
                                        <materialDesign:PackIcon Kind="Plus" Width="14" Height="14" VerticalAlignment="Center"/>
                                        <TextBlock Text="행 추가" Margin="4,0,0,0" FontSize="{StaticResource FontSizeSmall}" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                                <Button Command="{Binding RemoveJibunAppraisalRowCommand}"
                                        CommandParameter="{Binding SelectedItem, ElementName=JibunAppraisalDataGrid}"
                                        Style="{StaticResource MaterialDesignFlatButton}"
                                        Foreground="{StaticResource ErrorBrush}"
                                        Padding="12,6" Height="28" Margin="4,0,0,0" ToolTip="선택 행 삭제">
                                    <StackPanel Orientation="Horizontal">
                                        <materialDesign:PackIcon Kind="Delete" Width="14" Height="14" VerticalAlignment="Center"/>
                                        <TextBlock Text="행 삭제" Margin="4,0,0,0" FontSize="{StaticResource FontSizeSmall}" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- ===== 기계기구 감정가 패널 (기계기구 감정가 있을 때만 표시) ===== -->
                <Border Background="{StaticResource SurfaceColor}" CornerRadius="8"
                        BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                        Margin="0,0,0,16"
                        Visibility="{Binding HasMachineryAppraisal, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <StackPanel>
                        <!-- 패널 헤더 -->
                        <Border Background="{StaticResource PrimaryBrush}" CornerRadius="8,8,0,0" Padding="16,10">
                            <Grid>
                                <TextBlock Text="🔧 기계기구 감정가" FontWeight="SemiBold"
                                           FontSize="{StaticResource FontSizeH4}" Foreground="White"
                                           VerticalAlignment="Center"/>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                    <Button Content="+" FontSize="16" FontWeight="Bold"
                                            Command="{Binding CreateMachineryAppraisalTableCommand}"
                                            Visibility="{Binding HasMachineryAppraisalTable, Converter={StaticResource InverseBooleanToVisibilityConverter}}"
                                            Padding="8,0" MinHeight="0" Height="20" Cursor="Hand"
                                            Background="Transparent" BorderThickness="0"
                                            Foreground="White" ToolTip="기계기구 감정가 테이블 생성"/>
                                    <Button Content="&#x2212;" FontSize="16" FontWeight="Bold"
                                            Command="{Binding DestroyMachineryAppraisalTableCommand}"
                                            Visibility="{Binding HasMachineryAppraisalTable, Converter={StaticResource BooleanToVisibilityConverter}}"
                                            Padding="8,0" MinHeight="0" Height="20" Cursor="Hand"
                                            Background="Transparent" BorderThickness="0"
                                            Foreground="White" ToolTip="기계기구 감정가 테이블 제거"/>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <!-- 테이블 영역 (HasMachineryAppraisalTable이 true일 때만 표시) -->
                        <StackPanel Visibility="{Binding HasMachineryAppraisalTable, Converter={StaticResource BooleanToVisibilityConverter}}"
                                    Margin="12">

                            <!-- 공장저당 열 관리 -->
                            <Border Background="{StaticResource BlueGray100Brush}" CornerRadius="4" Padding="8,6" Margin="0,0,0,8">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="공장저당 열:" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                    <ItemsControl x:Name="MortgageColumnEditor" ItemsSource="{Binding MortgageColumnNames}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <StackPanel Orientation="Horizontal"/>
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Background="White" CornerRadius="4" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                                                        Padding="4,2" Margin="0,0,6,0">
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBox Text="{Binding Mode=OneWay}" MinWidth="80" BorderThickness="0" Background="Transparent"
                                                                 VerticalContentAlignment="Center" FontSize="12"
                                                                 LostFocus="MortgageColumnName_LostFocus"
                                                                 Tag="{Binding}"/>
                                                        <Button Content="✕" FontSize="10" Padding="2,0" Margin="4,0,0,0"
                                                                Background="Transparent" Foreground="#E53935" BorderThickness="0"
                                                                Cursor="Hand" VerticalAlignment="Center"
                                                                Click="RemoveMortgageColumn_Click"
                                                                ToolTip="열 삭제"/>
                                                    </StackPanel>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                    <Button Content="+ 열 추가" FontSize="12"
                                            Command="{Binding AddMortgageColumnCommand}"
                                            Style="{StaticResource MaterialDesignFlatButton}"
                                            Padding="8,2" Height="28" Margin="4,0,0,0"/>
                                </StackPanel>
                            </Border>

                            <!-- DataGrid -->
                            <DataGrid x:Name="MachineryDataGrid"
                                      ItemsSource="{Binding MachineryAppraisalRows}"
                                      AutoGenerateColumns="False"
                                      CanUserAddRows="False" CanUserDeleteRows="False"
                                      CanUserSortColumns="False"
                                      HeadersVisibility="Column"
                                      RowHeight="32"
                                      GridLinesVisibility="All"
                                      HorizontalGridLinesBrush="{StaticResource BorderBrush}"
                                      VerticalGridLinesBrush="{StaticResource BorderBrush}"
                                      BorderThickness="0"
                                      Background="White"
                                      RowBackground="White"
                                      ColumnHeaderStyle="{StaticResource SectionDataGridColumnHeaderStyle}"
                                      CellStyle="{StaticResource SectionDataGridCellStyle}"
                                      RowStyle="{StaticResource SectionDataGridRowStyle}"
                                      MinHeight="60"
                                      HorizontalScrollBarVisibility="Auto"
                                      PreviewMouseWheel="DataGrid_PreviewMouseWheel">
                                <DataGrid.Columns>
                                    <!-- 고정 컬럼 (앞쪽) -->
                                    <DataGridTextColumn Header="번호" Binding="{Binding ItemNumber}" Width="50" IsReadOnly="True"
                                                        ElementStyle="{StaticResource SectionDataGridTextBlockStyle}"/>
                                    <DataGridTextColumn Header="기계기구명" Binding="{Binding MachineryName, UpdateSourceTrigger=PropertyChanged}" Width="150"
                                                        ElementStyle="{StaticResource SectionDataGridTextBlockStyle}"
                                                        EditingElementStyle="{StaticResource SectionDataGridTextBoxStyle}"/>
                                    <DataGridTextColumn Header="제조사" Binding="{Binding Manufacturer, UpdateSourceTrigger=PropertyChanged}" Width="100"
                                                        ElementStyle="{StaticResource SectionDataGridTextBlockStyle}"
                                                        EditingElementStyle="{StaticResource SectionDataGridTextBoxStyle}"/>
                                    <DataGridTextColumn Header="제작일자" Binding="{Binding ManufactureDate, UpdateSourceTrigger=PropertyChanged}" Width="90"
                                                        ElementStyle="{StaticResource SectionDataGridTextBlockStyle}"
                                                        EditingElementStyle="{StaticResource SectionDataGridTextBoxStyle}"/>
                                    <DataGridTextColumn Header="수량" Binding="{Binding Quantity, UpdateSourceTrigger=PropertyChanged}" Width="60"
                                                        ElementStyle="{StaticResource SectionDataGridTextBlockStyle}"
                                                        EditingElementStyle="{StaticResource SectionDataGridTextBoxStyle}"/>
                                    <DataGridTextColumn Header="단가" Binding="{Binding UnitPrice, StringFormat=N0, UpdateSourceTrigger=PropertyChanged}" Width="100"
                                                        ElementStyle="{StaticResource SectionDataGridTextBlockStyle}"
                                                        EditingElementStyle="{StaticResource SectionDataGridTextBoxStyle}"/>
                                    <DataGridTextColumn Header="감정가" Binding="{Binding AppraisalValue, StringFormat=N0, UpdateSourceTrigger=PropertyChanged}" Width="120" IsReadOnly="True">
                                        <DataGridTextColumn.ElementStyle>
                                            <Style TargetType="TextBlock" BasedOn="{StaticResource SectionDataGridTextBlockStyle}">
                                                <Setter Property="FontWeight" Value="SemiBold"/>
                                            </Style>
                                        </DataGridTextColumn.ElementStyle>
                                    </DataGridTextColumn>
                                    <!-- 동적 공장저당 컬럼은 code-behind에서 여기 뒤에 삽입됨 (index=7~) -->
                                    <!-- 고정 컬럼 (뒤쪽) - code-behind에서 동적 컬럼 뒤에 추가됨 -->
                                </DataGrid.Columns>
                            </DataGrid>

                            <!-- 합계 행 (감정가, 평가액) - code-behind에서 동적 컬럼에 맞춰 ColumnDefinitions 재구성 -->
                            <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="1,0,1,1" Background="{StaticResource BlueGray100Brush}">
                                <Grid x:Name="MachineryTotalsGrid" MinHeight="30">
                                    <!-- ColumnDefinitions는 code-behind에서 동적 생성 -->
                                </Grid>
                            </Border>

                            <!-- 행 추가/삭제 버튼 -->
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
                                <Button Command="{Binding AddMachineryAppraisalRowCommand}"
                                        Style="{StaticResource MaterialDesignFlatButton}"
                                        Padding="12,6" Height="28" ToolTip="행 추가">
                                    <StackPanel Orientation="Horizontal">
                                        <materialDesign:PackIcon Kind="Plus" Width="14" Height="14" VerticalAlignment="Center"/>
                                        <TextBlock Text="행 추가" Margin="4,0,0,0" FontSize="{StaticResource FontSizeSmall}" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                                <Button Command="{Binding RemoveMachineryAppraisalRowCommand}"
                                        CommandParameter="{Binding SelectedItem, ElementName=MachineryDataGrid}"
                                        Style="{StaticResource MaterialDesignFlatButton}"
                                        Foreground="{StaticResource ErrorBrush}"
                                        Padding="12,6" Height="28" Margin="4,0,0,0" ToolTip="선택 행 삭제">
                                    <StackPanel Orientation="Horizontal">
                                        <materialDesign:PackIcon Kind="Delete" Width="14" Height="14" VerticalAlignment="Center"/>
                                        <TextBlock Text="행 삭제" Margin="4,0,0,0" FontSize="{StaticResource FontSizeSmall}" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </StackPanel>
                    </StackPanel>
                </Border>

            </StackPanel>
        </ScrollViewer>

        <!-- 비고 사이드 패널 -->
        <Border Grid.Column="1"
                x:Name="NotePanelColumn"
                Width="250"
                Visibility="{Binding IsCollateralNotePanelVisible, Converter={StaticResource BooleanToVisibilityConverter}}"
                Background="{StaticResource SurfaceColor}"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="1,0,0,0"
                Padding="12">
            <DockPanel>
                <TextBlock DockPanel.Dock="Top"
                           Text="비고"
                           FontWeight="SemiBold"
                           FontSize="{StaticResource FontSizeBody}"
                           Foreground="{StaticResource PrimaryBrush}"
                           Margin="0,0,0,8"/>
                <TextBox Text="{Binding CollateralNoteText, UpdateSourceTrigger=PropertyChanged}"
                         TextWrapping="Wrap"
                         AcceptsReturn="True"
                         VerticalScrollBarVisibility="Auto"
                         VerticalAlignment="Stretch"
                         FontSize="{StaticResource FontSizeBody}"
                         Padding="8"
                         BorderBrush="{StaticResource BorderBrush}"
                         BorderThickness="1"
                         Background="White"/>
            </DockPanel>
        </Border>

    </Grid>
</UserControl>
