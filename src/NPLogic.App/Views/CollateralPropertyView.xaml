<UserControl x:Class="NPLogic.Views.CollateralPropertyView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:vm="clr-namespace:NPLogic.ViewModels"
             xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
             mc:Ignorable="d"
             d:DesignHeight="800" d:DesignWidth="1200"
             d:DataContext="{d:DesignInstance Type=vm:PropertyDetailViewModel}">
    
    <UserControl.Resources>
        <!-- 테이블 헤더 스타일 -->
        <Style x:Key="TableHeaderCell" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource BlueGray100Brush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="0,0,1,1"/>
            <Setter Property="Padding" Value="12,8"/>
        </Style>
        
        <!-- 테이블 데이터 셀 스타일 -->
        <Style x:Key="TableDataCell" TargetType="Border">
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="0,0,1,1"/>
            <Setter Property="Padding" Value="12,8"/>
        </Style>
    </UserControl.Resources>
    
    <Grid Background="{StaticResource BackgroundBrush}">
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Margin="12,8,12,12">
                
                <!-- ========== 상단: 버튼 바 (건축물대장) ========== -->
                <Border x:Name="ButtonBarPanel"
                        Background="{StaticResource SurfaceColor}"
                        BorderBrush="{StaticResource PrimaryBrush}"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="16"
                        Margin="0,0,0,16"
                        Visibility="Visible">
                    <StackPanel Orientation="Horizontal">
                        <Button Style="{StaticResource SecondaryButton}"
                                Padding="16,8"
                                Click="OpenBuildingRegister_Click"
                                ToolTip="건축물대장 열기">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="OfficeBuildingMarker" Width="16" Height="16" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                <TextBlock Text="건축물대장" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Border>

                <!-- ========== 지도 패널 (위성도, 지적도, 로드뷰 3분할) ========== -->
                <Border Background="{StaticResource SurfaceColor}"
                        BorderBrush="{StaticResource BorderBrush}"
                        BorderThickness="1"
                        CornerRadius="8"
                        Margin="0,0,0,16">
                    <StackPanel>
                        <!-- 헤더 -->
                        <Border Background="{StaticResource PrimaryBrush}"
                                CornerRadius="8,8,0,0"
                                Padding="16,10">
                            <TextBlock Text="🗺️ 지도 정보"
                                       Foreground="White"
                                       FontWeight="SemiBold"
                                       FontSize="{StaticResource FontSizeH4}"/>
                        </Border>

                        <!-- 3분할 지도 영역 -->
                        <Grid Height="300">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <!-- 위성도 -->
                            <Border Grid.Column="0"
                                    BorderBrush="{StaticResource BorderBrush}"
                                    BorderThickness="0,0,1,0">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="*"/>
                                    </Grid.RowDefinitions>

                                    <!-- 위성도 타이틀 -->
                                    <Border Grid.Row="0"
                                            Background="{StaticResource BlueGray100Brush}"
                                            Padding="12,8">
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                            <materialDesign:PackIcon Kind="Satellite" Width="16" Height="16" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                            <TextBlock Text="위성도" FontWeight="SemiBold"/>
                                        </StackPanel>
                                    </Border>

                                    <!-- 위성도 WebView2 -->
                                    <wv2:WebView2 x:Name="SatelliteMapWebView" Grid.Row="1"/>
                                </Grid>
                            </Border>

                            <!-- 지적도 -->
                            <Border Grid.Column="1"
                                    BorderBrush="{StaticResource BorderBrush}"
                                    BorderThickness="0,0,1,0">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="*"/>
                                    </Grid.RowDefinitions>

                                    <!-- 지적도 타이틀 -->
                                    <Border Grid.Row="0"
                                            Background="{StaticResource BlueGray100Brush}"
                                            Padding="12,8">
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                            <materialDesign:PackIcon Kind="Map" Width="16" Height="16" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                            <TextBlock Text="지적도" FontWeight="SemiBold"/>
                                        </StackPanel>
                                    </Border>

                                    <!-- 지적도 WebView2 -->
                                    <wv2:WebView2 x:Name="CadastralMapWebView" Grid.Row="1"/>
                                </Grid>
                            </Border>

                            <!-- 로드뷰 -->
                            <Border Grid.Column="2">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="*"/>
                                    </Grid.RowDefinitions>

                                    <!-- 로드뷰 타이틀 -->
                                    <Border Grid.Row="0"
                                            Background="{StaticResource BlueGray100Brush}"
                                            Padding="12,8">
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                            <materialDesign:PackIcon Kind="Walk" Width="16" Height="16" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                            <TextBlock Text="로드뷰" FontWeight="SemiBold"/>
                                        </StackPanel>
                                    </Border>

                                    <!-- 로드뷰 WebView2 -->
                                    <wv2:WebView2 x:Name="RoadViewWebView" Grid.Row="1"/>
                                </Grid>
                            </Border>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- WebView2 패널 (버튼 클릭 시 표시) -->
                <Border x:Name="WebViewPanel"
                        Background="{StaticResource SurfaceColor}"
                        BorderBrush="{StaticResource PrimaryBrush}"
                        BorderThickness="1"
                        CornerRadius="8"
                        Margin="0,0,0,16"
                        Visibility="Collapsed"
                        MinHeight="500">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <!-- 헤더 (제목 + 닫기 버튼) -->
                        <Border Grid.Row="0"
                                Background="{StaticResource PrimaryBrush}"
                                CornerRadius="8,8,0,0"
                                Padding="16,10">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <materialDesign:PackIcon x:Name="WebViewIcon" Kind="Map"
                                                         Width="20" Height="20"
                                                         Foreground="White"
                                                         VerticalAlignment="Center"
                                                         Margin="0,0,8,0"/>

                                <TextBlock x:Name="WebViewTitle"
                                           Grid.Column="1"
                                           Text="지도"
                                           Foreground="White"
                                           FontWeight="SemiBold"
                                           FontSize="{StaticResource FontSizeH4}"
                                           VerticalAlignment="Center"/>

                                <Button Grid.Column="2"
                                        Style="{StaticResource MaterialDesignFlatButton}"
                                        Foreground="White"
                                        Click="CloseWebView_Click"
                                        ToolTip="닫기"
                                        Padding="8,4">
                                    <StackPanel Orientation="Horizontal">
                                        <materialDesign:PackIcon Kind="Close" Width="18" Height="18" VerticalAlignment="Center"/>
                                        <TextBlock Text="닫기" Margin="4,0,0,0" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                            </Grid>
                        </Border>

                        <!-- WebView2 컨트롤 -->
                        <wv2:WebView2 x:Name="MapWebView"
                                      Grid.Row="1"
                                      MinHeight="450"/>
                    </Grid>
                </Border>
                
                <!-- ========== 물건 기본 정보 테이블 (1~2줄로 간소화) ========== -->
                <Border Background="{StaticResource SurfaceColor}"
                        BorderBrush="{StaticResource BorderBrush}"
                        BorderThickness="1"
                        CornerRadius="8"
                        Margin="0,0,0,16">
                    <StackPanel>
                        <!-- 헤더 -->
                        <Border Background="{StaticResource PrimaryBrush}"
                                CornerRadius="8,8,0,0"
                                Padding="16,8">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0"
                                           Text="📍 물건 기본 정보" 
                                           Foreground="White" 
                                           FontWeight="SemiBold"
                                           FontSize="{StaticResource FontSizeH4}"
                                           VerticalAlignment="Center"/>
                                <Button Grid.Column="1"
                                        Padding="10,4"
                                        Click="OpenLandUsePlan_Click"
                                        ToolTip="토지이용계획 열기"
                                        Background="Transparent"
                                        BorderBrush="White"
                                        BorderThickness="1"
                                        Cursor="Hand">
                                    <StackPanel Orientation="Horizontal">
                                        <materialDesign:PackIcon Kind="FileDocument" Width="14" Height="14" Margin="0,0,4,0" VerticalAlignment="Center" Foreground="White"/>
                                        <TextBlock Text="토지이용계획" VerticalAlignment="Center" Foreground="White" FontSize="{StaticResource FontSizeSmall}"/>
                                    </StackPanel>
                                </Button>
                            </Grid>
                        </Border>
                        
                        <!-- 테이블 (1줄: 주소, 담보종류, 토지면적, 건물면적, 공장저당) -->
                        <Grid Margin="0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="80"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="80"/>
                                <ColumnDefinition Width="120"/>
                                <ColumnDefinition Width="80"/>
                                <ColumnDefinition Width="120"/>
                                <ColumnDefinition Width="80"/>
                                <ColumnDefinition Width="120"/>
                                <ColumnDefinition Width="80"/>
                                <ColumnDefinition Width="80"/>
                            </Grid.ColumnDefinitions>
                            
                            <!-- 주소 -->
                            <Border Grid.Column="0" Style="{StaticResource TableHeaderCell}" BorderThickness="0,0,1,0">
                                <TextBlock Text="주소" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}"/>
                            </Border>
                            <Border Grid.Column="1" Style="{StaticResource TableDataCell}" BorderThickness="0,0,1,0">
                                <TextBlock Text="{Binding Property.AddressFull, FallbackValue='-'}" 
                                           TextWrapping="NoWrap"
                                           TextTrimming="CharacterEllipsis"
                                           FontWeight="SemiBold"
                                           ToolTip="{Binding Property.AddressFull}"/>
                            </Border>
                            
                            <!-- 담보종류 -->
                            <Border Grid.Column="2" Style="{StaticResource TableHeaderCell}" BorderThickness="0,0,1,0">
                                <TextBlock Text="담보종류" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}"/>
                            </Border>
                            <Border Grid.Column="3" Style="{StaticResource TableDataCell}" BorderThickness="0,0,1,0">
                                <TextBlock Text="{Binding Property.PropertyType, FallbackValue='-'}" HorizontalAlignment="Center"/>
                            </Border>
                            
                            <!-- 토지면적 -->
                            <Border Grid.Column="4" Style="{StaticResource TableHeaderCell}" BorderThickness="0,0,1,0">
                                <TextBlock Text="토지면적" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}"/>
                            </Border>
                            <Border Grid.Column="5" Style="{StaticResource TableDataCell}" BorderThickness="0,0,1,0">
                                <TextBlock HorizontalAlignment="Right">
                                    <Run Text="{Binding Property.LandArea, StringFormat=N2, FallbackValue='-'}"/>
                                    <Run Text=" ㎡" Foreground="{StaticResource TextSecondaryBrush}"/>
                                </TextBlock>
                            </Border>
                            
                            <!-- 건물면적 -->
                            <Border Grid.Column="6" Style="{StaticResource TableHeaderCell}" BorderThickness="0,0,1,0">
                                <TextBlock Text="건물면적" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}"/>
                            </Border>
                            <Border Grid.Column="7" Style="{StaticResource TableDataCell}" BorderThickness="0,0,1,0">
                                <TextBlock HorizontalAlignment="Right">
                                    <Run Text="{Binding Property.BuildingArea, StringFormat=N2, FallbackValue='-'}"/>
                                    <Run Text=" ㎡" Foreground="{StaticResource TextSecondaryBrush}"/>
                                </TextBlock>
                            </Border>
                            
                            <!-- 공장저당 -->
                            <Border Grid.Column="8" Style="{StaticResource TableHeaderCell}" BorderThickness="0,0,1,0">
                                <TextBlock Text="공장저당" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}"/>
                            </Border>
                            <Border Grid.Column="9" Style="{StaticResource TableDataCell}" BorderThickness="0">
                                <TextBlock Text="{Binding IsFactoryMortgageText, FallbackValue='-'}" HorizontalAlignment="Center"/>
                            </Border>
                        </Grid>
                    </StackPanel>
                </Border>
                
                <!-- ========== 등기부등본 정보 ========== -->
                <Border Background="{StaticResource SurfaceColor}"
                        BorderBrush="{StaticResource BorderBrush}"
                        BorderThickness="1"
                        CornerRadius="8"
                        Margin="0,0,0,16">
                    <StackPanel>
                        <!-- 헤더 -->
                        <Border Background="{StaticResource PrimaryBrush}"
                                CornerRadius="8,8,0,0"
                                Padding="16,10">
                            <TextBlock Text="📄 등기부등본 정보" 
                                       Foreground="White" 
                                       FontWeight="SemiBold"
                                       FontSize="{StaticResource FontSizeH4}"/>
                        </Border>

                        <!-- basic_info + 갑구 + 을구 -->
                        <StackPanel>
                            <!-- 1) 소유지분현황 (basic_info) - DataGrid -->
                            <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1">
                                <StackPanel>
                                    <Border Background="{StaticResource BlueGray100Brush}" Padding="12,8">
                                        <TextBlock Text="1. 소유지분현황 (기본정보)" FontWeight="SemiBold"/>
                                    </Border>
                                    <DataGrid ItemsSource="{Binding RegistryBasicInfoList}"
                                              AutoGenerateColumns="False"
                                              CanUserAddRows="False"
                                              CanUserDeleteRows="False"
                                              IsReadOnly="True"
                                              HeadersVisibility="Column"
                                              GridLinesVisibility="Horizontal"
                                              Margin="12"
                                              MinHeight="80">
                                        <DataGrid.Columns>
                                            <DataGridTextColumn Header="지번일련번호" Binding="{Binding JibeonId}" Width="Auto"/>
                                            <DataGridTextColumn Header="물건지 (등기부등본)" Binding="{Binding RegistryAddress}" Width="*"/>
                                            <DataGridTextColumn Header="물건지 (DD)" Binding="{Binding DdAddress}" Width="*"/>
                                            <DataGridTextColumn Header="일치여부" Binding="{Binding IsAddressMatched}" Width="Auto"/>
                                            <DataGridTextColumn Header="담보물형태" Binding="{Binding CollateralType}" Width="Auto"/>
                                            <DataGridTextColumn Header="대지면적 (평)" Binding="{Binding LandAreaPyeong, StringFormat={}{0:N2}}" Width="Auto"/>
                                            <DataGridTextColumn Header="건물면적 (평)" Binding="{Binding BuildingAreaPyeong, StringFormat={}{0:N2}}" Width="Auto"/>
                                            <DataGridTextColumn Header="소유자" Binding="{Binding OwnerName}" Width="Auto"/>
                                            <DataGridTextColumn Header="등록번호" Binding="{Binding OwnerRegNo}" Width="Auto"/>
                                            <DataGridTextColumn Header="최종지분" Binding="{Binding ShareRatio}" Width="Auto"/>
                                            <DataGridTextColumn Header="소유자 주소" Binding="{Binding OwnerAddress}" Width="*"/>
                                        </DataGrid.Columns>
                                    </DataGrid>
                                </StackPanel>
                            </Border>

                            <!-- 2) 갑구 -->
                            <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1">
                                <StackPanel>
                                    <Border Background="{StaticResource BlueGray100Brush}" Padding="12,8">
                                        <TextBlock Text="2. 갑구" FontWeight="SemiBold"/>
                                    </Border>
                                    <DataGrid ItemsSource="{Binding RegistryGapguRows}"
                                              AutoGenerateColumns="False"
                                              CanUserAddRows="False"
                                              CanUserDeleteRows="False"
                                              IsReadOnly="False"
                                              HeadersVisibility="Column"
                                              GridLinesVisibility="Horizontal"
                                              Margin="12"
                                              MinHeight="160">
                                        <DataGrid.Columns>
                                            <DataGridTextColumn Header="순위번호" Binding="{Binding RankNo}" Width="Auto" IsReadOnly="True"/>
                                            <DataGridTextColumn Header="등기목적" Binding="{Binding Purpose}" Width="2*" IsReadOnly="True"/>
                                            <DataGridTextColumn Header="접수정보" Binding="{Binding Receipt}" Width="2*" IsReadOnly="True"/>
                                            <DataGridTextColumn Header="접수날짜" Binding="{Binding ReceiptDate, StringFormat=yyyy-MM-dd}" Width="Auto" IsReadOnly="True"/>
                                            <DataGridTextColumn Header="권리자" Binding="{Binding RightHolder}" Width="2*" IsReadOnly="True"/>
                                            <DataGridTextColumn Header="청구금액" Binding="{Binding ClaimAmount, StringFormat=N0}" Width="Auto" IsReadOnly="True"/>
                                            <DataGridTextColumn Header="비고(입력)" Binding="{Binding NoteUserInput, UpdateSourceTrigger=PropertyChanged}" Width="2*"/>
                                            <DataGridCheckBoxColumn Header="임금채권추정(입력)" Binding="{Binding WageClaimEstimateUserInput}" Width="Auto"/>
                                            <DataGridTextColumn Header="대상소유자" Binding="{Binding TargetOwner}" Width="*" IsReadOnly="True"/>
                                            <DataGridTextColumn Header="지번번호" Binding="{Binding JibunNumber}" Width="Auto" IsReadOnly="True"/>
                                        </DataGrid.Columns>
                                    </DataGrid>
                                </StackPanel>
                            </Border>

                            <!-- 3) 을구 -->
                            <Border>
                                <StackPanel>
                                    <Border Background="{StaticResource BlueGray100Brush}" Padding="12,8">
                                        <TextBlock Text="3. 을구" FontWeight="SemiBold"/>
                                    </Border>
                                    <DataGrid ItemsSource="{Binding RegistryEulguRows}"
                                              AutoGenerateColumns="False"
                                              CanUserAddRows="False"
                                              CanUserDeleteRows="False"
                                              IsReadOnly="False"
                                              HeadersVisibility="Column"
                                              GridLinesVisibility="Horizontal"
                                              Margin="12"
                                              MinHeight="160">
                                        <DataGrid.Columns>
                                            <DataGridTextColumn Header="순위번호" Binding="{Binding RankNo}" Width="Auto" IsReadOnly="True"/>
                                            <DataGridTextColumn Header="등기목적" Binding="{Binding Purpose}" Width="2*" IsReadOnly="True"/>
                                            <DataGridTextColumn Header="접수정보" Binding="{Binding Receipt}" Width="2*" IsReadOnly="True"/>
                                            <DataGridTextColumn Header="접수날짜" Binding="{Binding ReceiptDate, StringFormat=yyyy-MM-dd}" Width="Auto" IsReadOnly="True"/>
                                            <DataGridTextColumn Header="근저당권자" Binding="{Binding MortgageHolder}" Width="2*" IsReadOnly="True"/>
                                            <DataGridTextColumn Header="채권최고액" Binding="{Binding MaxClaimAmount, StringFormat=N0}" Width="Auto" IsReadOnly="True"/>
                                            <DataGridTextColumn Header="채무자(입력)" Binding="{Binding DebtorUserInput, UpdateSourceTrigger=PropertyChanged}" Width="2*"/>
                                            <DataGridTextColumn Header="담보종류(입력)" Binding="{Binding CollateralTypeUserInput, UpdateSourceTrigger=PropertyChanged}" Width="*"/>
                                            <DataGridCheckBoxColumn Header="공장저당(입력)" Binding="{Binding IsFactoryMortgageUserInput}" Width="Auto"/>
                                            <DataGridTextColumn Header="대상소유자" Binding="{Binding TargetOwner}" Width="*" IsReadOnly="True"/>
                                            <DataGridTextColumn Header="지번번호" Binding="{Binding JibunNumber}" Width="Auto" IsReadOnly="True"/>
                                        </DataGrid.Columns>
                                    </DataGrid>

                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="12,0,12,12">
                                        <Button Content="사용자 입력 저장"
                                                Command="{Binding SaveRegistryUserInputsCommand}"
                                                Style="{StaticResource MaterialDesignRaisedButton}"
                                                Padding="12,6"/>
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </StackPanel>
                </Border>
                
                <!-- ========== 건축물대장 정보 (총괄표제부 + 표제부) ========== -->
                <Border Background="{StaticResource SurfaceColor}"
                        BorderBrush="{StaticResource BorderBrush}"
                        BorderThickness="1"
                        CornerRadius="8"
                        Margin="0,0,0,16">
                    <StackPanel>
                        <!-- 헤더 -->
                        <Border Background="{StaticResource PrimaryBrush}"
                                CornerRadius="8,8,0,0"
                                Padding="16,10">
                            <TextBlock Text="🏢 건축물대장 정보" 
                                       Foreground="White" 
                                       FontWeight="SemiBold"
                                       FontSize="{StaticResource FontSizeH4}"/>
                        </Border>
                        
                        <!-- 2열 테이블 (총괄표제부, 표제부) -->
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            
                            <!-- 총괄표제부 -->
                            <Border Grid.Column="0" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,1,0">
                                <StackPanel>
                                    <Border Background="{StaticResource BlueGray100Brush}" Padding="12,8">
                                        <TextBlock Text="총괄표제부" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                                    </Border>
                                    <Border Padding="12" MinHeight="80">
                                        <StackPanel>
                                            <TextBlock Text="{Binding BuildingRegisterGeneralSummary, FallbackValue='건축물대장 조회 필요'}"
                                                       TextWrapping="Wrap"
                                                       Foreground="{StaticResource TextSecondaryBrush}"
                                                       FontSize="{StaticResource FontSizeBody}"/>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </Border>
                            
                            <!-- 표제부 -->
                            <Border Grid.Column="1">
                                <StackPanel>
                                    <Border Background="{StaticResource BlueGray100Brush}" Padding="12,8">
                                        <TextBlock Text="표제부" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                                    </Border>
                                    <Border Padding="12" MinHeight="80">
                                        <StackPanel>
                                            <TextBlock Text="{Binding BuildingRegisterTitleSummary, FallbackValue='건축물대장 조회 필요'}"
                                                       TextWrapping="Wrap"
                                                       Foreground="{StaticResource TextSecondaryBrush}"
                                                       FontSize="{StaticResource FontSizeBody}"/>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </Border>
                        </Grid>
                    </StackPanel>
                </Border>
                
                <!-- ========== 감정평가 정보 (한 줄로 간소화) ========== -->
                <Border Background="{StaticResource SurfaceColor}"
                        BorderBrush="{StaticResource BorderBrush}"
                        BorderThickness="1"
                        CornerRadius="8"
                        Margin="0,0,0,16">
                    <StackPanel>
                        <!-- 헤더 -->
                        <Border Background="{StaticResource PrimaryBrush}"
                                CornerRadius="8,8,0,0"
                                Padding="16,10">
                            <TextBlock Text="💰 감정평가 정보" 
                                       Foreground="White" 
                                       FontWeight="SemiBold"
                                       FontSize="{StaticResource FontSizeH4}"/>
                        </Border>
                        
                        <!-- 감정평가 정보 한 줄 테이블 -->
                        <Grid Margin="0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="80"/>
                                <ColumnDefinition Width="100"/>
                                <ColumnDefinition Width="80"/>
                                <ColumnDefinition Width="100"/>
                                <ColumnDefinition Width="80"/>
                                <ColumnDefinition Width="130"/>
                                <ColumnDefinition Width="60"/>
                                <ColumnDefinition Width="100"/>
                                <ColumnDefinition Width="60"/>
                                <ColumnDefinition Width="100"/>
                                <ColumnDefinition Width="60"/>
                                <ColumnDefinition Width="100"/>
                                <ColumnDefinition Width="60"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            
                            <!-- 구분 -->
                            <Border Grid.Column="0" Style="{StaticResource TableHeaderCell}" BorderThickness="0,0,1,0">
                                <TextBlock Text="구분" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}"/>
                            </Border>
                            <Border Grid.Column="1" Style="{StaticResource TableDataCell}" BorderThickness="0,0,1,0">
                                <TextBlock Text="{Binding AppraisalType, FallbackValue='-'}" HorizontalAlignment="Center"/>
                            </Border>
                            
                            <!-- 일자 -->
                            <Border Grid.Column="2" Style="{StaticResource TableHeaderCell}" BorderThickness="0,0,1,0">
                                <TextBlock Text="일자" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}"/>
                            </Border>
                            <Border Grid.Column="3" Style="{StaticResource TableDataCell}" BorderThickness="0,0,1,0">
                                <TextBlock Text="{Binding Property.AppraisalDate, StringFormat=yyyy-MM-dd, FallbackValue='-'}" HorizontalAlignment="Center"/>
                            </Border>
                            
                            <!-- 기관 -->
                            <Border Grid.Column="4" Style="{StaticResource TableHeaderCell}" BorderThickness="0,0,1,0">
                                <TextBlock Text="기관" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}"/>
                            </Border>
                            <Border Grid.Column="5" Style="{StaticResource TableDataCell}" BorderThickness="0,0,1,0">
                                <TextBlock Text="{Binding AppraisalOrganization, FallbackValue='-'}" 
                                           TextTrimming="CharacterEllipsis"
                                           ToolTip="{Binding AppraisalOrganization}"/>
                            </Border>
                            
                            <!-- 토지 -->
                            <Border Grid.Column="6" Style="{StaticResource TableHeaderCell}" BorderThickness="0,0,1,0">
                                <TextBlock Text="토지" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}"/>
                            </Border>
                            <Border Grid.Column="7" Style="{StaticResource TableDataCell}" BorderThickness="0,0,1,0">
                                <TextBlock HorizontalAlignment="Right">
                                    <Run Text="{Binding LandAppraisalValue, StringFormat=N0, FallbackValue='0'}"/>
                                </TextBlock>
                            </Border>
                            
                            <!-- 건물 -->
                            <Border Grid.Column="8" Style="{StaticResource TableHeaderCell}" BorderThickness="0,0,1,0">
                                <TextBlock Text="건물" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}"/>
                            </Border>
                            <Border Grid.Column="9" Style="{StaticResource TableDataCell}" BorderThickness="0,0,1,0">
                                <TextBlock HorizontalAlignment="Right">
                                    <Run Text="{Binding BuildingAppraisalValue, StringFormat=N0, FallbackValue='0'}"/>
                                </TextBlock>
                            </Border>
                            
                            <!-- 기계 -->
                            <Border Grid.Column="10" Style="{StaticResource TableHeaderCell}" BorderThickness="0,0,1,0">
                                <TextBlock Text="기계" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}"/>
                            </Border>
                            <Border Grid.Column="11" Style="{StaticResource TableDataCell}" BorderThickness="0,0,1,0">
                                <TextBlock HorizontalAlignment="Right">
                                    <Run Text="{Binding MachineAppraisalValue, StringFormat=N0, FallbackValue='0'}"/>
                                </TextBlock>
                            </Border>
                            
                            <!-- 합계 (강조) -->
                            <Border Grid.Column="12" Style="{StaticResource TableHeaderCell}" Background="{StaticResource PrimaryBrush}" BorderThickness="0,0,1,0">
                                <TextBlock Text="합계" FontWeight="Bold" Foreground="White"/>
                            </Border>
                            <Border Grid.Column="13" Background="{StaticResource PrimaryBrush}" BorderThickness="0">
                                <TextBlock Margin="8,0" HorizontalAlignment="Right" VerticalAlignment="Center">
                                    <Run Text="{Binding Property.AppraisalValue, StringFormat=N0, FallbackValue='0'}" FontWeight="Bold" Foreground="White"/>
                                    <Run Text=" 원" FontSize="{StaticResource FontSizeSmall}" Foreground="#B0FFFFFF"/>
                                </TextBlock>
                            </Border>
                        </Grid>
                    </StackPanel>
                </Border>
                
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
