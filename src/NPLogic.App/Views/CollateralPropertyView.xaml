<UserControl x:Class="NPLogic.Views.CollateralPropertyView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:vm="clr-namespace:NPLogic.ViewModels"
             xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
             mc:Ignorable="d"
             d:DesignHeight="800" d:DesignWidth="1200"
             d:DataContext="{d:DesignInstance Type=vm:PropertyDetailViewModel}">
    
    <UserControl.Resources>
        <!-- 테이블 헤더 스타일 -->
        <Style x:Key="TableHeaderCell" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource BlueGray100Brush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="0,0,1,1"/>
            <Setter Property="Padding" Value="12,8"/>
        </Style>
        
        <!-- 테이블 데이터 셀 스타일 -->
        <Style x:Key="TableDataCell" TargetType="Border">
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="0,0,1,1"/>
            <Setter Property="Padding" Value="12,8"/>
        </Style>
    </UserControl.Resources>
    
    <Grid Background="{StaticResource BackgroundBrush}">
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Margin="12,8,12,12">
                
                <!-- 상단 버튼 바 제거됨: 토지이용계획은 물건 기본 정보 헤더, 등기부등본은 등기부등본 정보 헤더로 이동 -->

                <!-- ========== 지도 패널 (위성도, 지적도, 로드뷰 3분할) ========== -->
                <Border Background="{StaticResource SurfaceColor}"
                        BorderBrush="{StaticResource BorderBrush}"
                        BorderThickness="1"
                        CornerRadius="8"
                        Margin="0,0,0,16">
                    <StackPanel>
                        <!-- 헤더 -->
                        <Border Background="{StaticResource PrimaryBrush}"
                                CornerRadius="8,8,0,0"
                                Padding="16,10">
                            <TextBlock Text="🗺️ 지도 정보"
                                       Foreground="White"
                                       FontWeight="SemiBold"
                                       FontSize="{StaticResource FontSizeH4}"/>
                        </Border>

                        <!-- 3분할 지도 영역 -->
                        <Grid Height="300">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <!-- 위성도 -->
                            <Border Grid.Column="0"
                                    BorderBrush="{StaticResource BorderBrush}"
                                    BorderThickness="0,0,1,0">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="*"/>
                                    </Grid.RowDefinitions>

                                    <!-- 위성도 타이틀 -->
                                    <Border Grid.Row="0"
                                            Background="{StaticResource BlueGray100Brush}"
                                            Padding="12,8">
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                            <materialDesign:PackIcon Kind="Satellite" Width="16" Height="16" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                            <TextBlock Text="위성도" FontWeight="SemiBold"/>
                                        </StackPanel>
                                    </Border>

                                    <!-- 위성도 WebView2 -->
                                    <wv2:WebView2 x:Name="SatelliteMapWebView" Grid.Row="1"/>
                                </Grid>
                            </Border>

                            <!-- 지적도 -->
                            <Border Grid.Column="1"
                                    BorderBrush="{StaticResource BorderBrush}"
                                    BorderThickness="0,0,1,0">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="*"/>
                                    </Grid.RowDefinitions>

                                    <!-- 지적도 타이틀 -->
                                    <Border Grid.Row="0"
                                            Background="{StaticResource BlueGray100Brush}"
                                            Padding="12,8">
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                            <materialDesign:PackIcon Kind="Map" Width="16" Height="16" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                            <TextBlock Text="지적도" FontWeight="SemiBold"/>
                                        </StackPanel>
                                    </Border>

                                    <!-- 지적도 WebView2 -->
                                    <wv2:WebView2 x:Name="CadastralMapWebView" Grid.Row="1"/>
                                </Grid>
                            </Border>

                            <!-- 로드뷰 -->
                            <Border Grid.Column="2">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="*"/>
                                    </Grid.RowDefinitions>

                                    <!-- 로드뷰 타이틀 -->
                                    <Border Grid.Row="0"
                                            Background="{StaticResource BlueGray100Brush}"
                                            Padding="12,8">
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                            <materialDesign:PackIcon Kind="Walk" Width="16" Height="16" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                            <TextBlock Text="로드뷰" FontWeight="SemiBold"/>
                                        </StackPanel>
                                    </Border>

                                    <!-- 로드뷰 WebView2 -->
                                    <wv2:WebView2 x:Name="RoadViewWebView" Grid.Row="1"/>
                                </Grid>
                            </Border>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- WebView2 패널 (버튼 클릭 시 표시) -->
                <Border x:Name="WebViewPanel"
                        Background="{StaticResource SurfaceColor}"
                        BorderBrush="{StaticResource PrimaryBrush}"
                        BorderThickness="1"
                        CornerRadius="8"
                        Margin="0,0,0,16"
                        Visibility="Collapsed"
                        MinHeight="500">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <!-- 헤더 (제목 + 닫기 버튼) -->
                        <Border Grid.Row="0"
                                Background="{StaticResource PrimaryBrush}"
                                CornerRadius="8,8,0,0"
                                Padding="16,10">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <materialDesign:PackIcon x:Name="WebViewIcon" Kind="Map"
                                                         Width="20" Height="20"
                                                         Foreground="White"
                                                         VerticalAlignment="Center"
                                                         Margin="0,0,8,0"/>

                                <TextBlock x:Name="WebViewTitle"
                                           Grid.Column="1"
                                           Text="지도"
                                           Foreground="White"
                                           FontWeight="SemiBold"
                                           FontSize="{StaticResource FontSizeH4}"
                                           VerticalAlignment="Center"/>

                                <Button Grid.Column="2"
                                        Style="{StaticResource MaterialDesignFlatButton}"
                                        Foreground="White"
                                        Click="CloseWebView_Click"
                                        ToolTip="닫기"
                                        Padding="8,4">
                                    <StackPanel Orientation="Horizontal">
                                        <materialDesign:PackIcon Kind="Close" Width="18" Height="18" VerticalAlignment="Center"/>
                                        <TextBlock Text="닫기" Margin="4,0,0,0" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                            </Grid>
                        </Border>

                        <!-- WebView2 컨트롤 -->
                        <wv2:WebView2 x:Name="MapWebView"
                                      Grid.Row="1"
                                      MinHeight="450"/>
                    </Grid>
                </Border>
                
                <!-- ========== 물건 기본 정보 테이블 (1~2줄로 간소화) ========== -->
                <Border Background="{StaticResource SurfaceColor}"
                        BorderBrush="{StaticResource BorderBrush}"
                        BorderThickness="1"
                        CornerRadius="8"
                        Margin="0,0,0,16">
                    <StackPanel>
                        <!-- 헤더 -->
                        <Border Background="{StaticResource PrimaryBrush}"
                                CornerRadius="8,8,0,0"
                                Padding="16,8">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0"
                                           Text="📍 물건 기본 정보" 
                                           Foreground="White" 
                                           FontWeight="SemiBold"
                                           FontSize="{StaticResource FontSizeH4}"
                                           VerticalAlignment="Center"/>
                                <Button Grid.Column="1"
                                        Padding="10,4"
                                        Click="OpenLandUsePlan_Click"
                                        ToolTip="토지이용계획 열기"
                                        Background="Transparent"
                                        BorderBrush="White"
                                        BorderThickness="1"
                                        Cursor="Hand">
                                    <StackPanel Orientation="Horizontal">
                                        <materialDesign:PackIcon Kind="FileDocument" Width="14" Height="14" Margin="0,0,4,0" VerticalAlignment="Center" Foreground="White"/>
                                        <TextBlock Text="토지이용계획" VerticalAlignment="Center" Foreground="White" FontSize="{StaticResource FontSizeSmall}"/>
                                    </StackPanel>
                                </Button>
                            </Grid>
                        </Border>
                        
                        <!-- 테이블 (1줄: 주소, 담보종류, 토지면적, 건물면적, 공장저당) -->
                        <Grid Margin="0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="80"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="80"/>
                                <ColumnDefinition Width="120"/>
                                <ColumnDefinition Width="80"/>
                                <ColumnDefinition Width="120"/>
                                <ColumnDefinition Width="80"/>
                                <ColumnDefinition Width="120"/>
                                <ColumnDefinition Width="80"/>
                                <ColumnDefinition Width="80"/>
                            </Grid.ColumnDefinitions>
                            
                            <!-- 주소 -->
                            <Border Grid.Column="0" Style="{StaticResource TableHeaderCell}" BorderThickness="0,0,1,0">
                                <TextBlock Text="주소" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}"/>
                            </Border>
                            <Border Grid.Column="1" Style="{StaticResource TableDataCell}" BorderThickness="0,0,1,0">
                                <TextBlock Text="{Binding Property.AddressFull, FallbackValue='-'}" 
                                           TextWrapping="NoWrap"
                                           TextTrimming="CharacterEllipsis"
                                           FontWeight="SemiBold"
                                           ToolTip="{Binding Property.AddressFull}"/>
                            </Border>
                            
                            <!-- 담보종류 -->
                            <Border Grid.Column="2" Style="{StaticResource TableHeaderCell}" BorderThickness="0,0,1,0">
                                <TextBlock Text="담보종류" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}"/>
                            </Border>
                            <Border Grid.Column="3" Style="{StaticResource TableDataCell}" BorderThickness="0,0,1,0">
                                <TextBlock Text="{Binding Property.PropertyType, FallbackValue='-'}" HorizontalAlignment="Center"/>
                            </Border>
                            
                            <!-- 토지면적 -->
                            <Border Grid.Column="4" Style="{StaticResource TableHeaderCell}" BorderThickness="0,0,1,0">
                                <TextBlock Text="토지면적" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}"/>
                            </Border>
                            <Border Grid.Column="5" Style="{StaticResource TableDataCell}" BorderThickness="0,0,1,0">
                                <TextBlock HorizontalAlignment="Right">
                                    <Run Text="{Binding Property.LandArea, StringFormat=N2, FallbackValue='-'}"/>
                                    <Run Text=" ㎡" Foreground="{StaticResource TextSecondaryBrush}"/>
                                </TextBlock>
                            </Border>
                            
                            <!-- 건물면적 -->
                            <Border Grid.Column="6" Style="{StaticResource TableHeaderCell}" BorderThickness="0,0,1,0">
                                <TextBlock Text="건물면적" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}"/>
                            </Border>
                            <Border Grid.Column="7" Style="{StaticResource TableDataCell}" BorderThickness="0,0,1,0">
                                <TextBlock HorizontalAlignment="Right">
                                    <Run Text="{Binding Property.BuildingArea, StringFormat=N2, FallbackValue='-'}"/>
                                    <Run Text=" ㎡" Foreground="{StaticResource TextSecondaryBrush}"/>
                                </TextBlock>
                            </Border>
                            
                            <!-- 공장저당 -->
                            <Border Grid.Column="8" Style="{StaticResource TableHeaderCell}" BorderThickness="0,0,1,0">
                                <TextBlock Text="공장저당" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}"/>
                            </Border>
                            <Border Grid.Column="9" Style="{StaticResource TableDataCell}" BorderThickness="0">
                                <TextBlock Text="{Binding IsFactoryMortgageText, FallbackValue='-'}" HorizontalAlignment="Center"/>
                            </Border>
                        </Grid>
                    </StackPanel>
                </Border>
                
                <!-- ========== 등기부등본 정보 ========== -->
                <Border Background="{StaticResource SurfaceColor}"
                        BorderBrush="{StaticResource BorderBrush}"
                        BorderThickness="1"
                        CornerRadius="8"
                        Margin="0,0,0,16">
                    <StackPanel>
                        <!-- 헤더 -->
                        <Border Background="{StaticResource PrimaryBrush}"
                                CornerRadius="8,8,0,0"
                                Padding="16,8">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0"
                                           Text="📄 등기부등본 정보" 
                                           Foreground="White" 
                                           FontWeight="SemiBold"
                                           FontSize="{StaticResource FontSizeH4}"
                                           VerticalAlignment="Center"/>
                                <Button Grid.Column="1"
                                        Padding="10,4"
                                        Command="{Binding ToggleRegistryImagePanelCommand}"
                                        ToolTip="등기부등본 원본 이미지 보기/숨기기"
                                        Background="Transparent"
                                        BorderBrush="White"
                                        BorderThickness="1"
                                        Cursor="Hand">
                                    <StackPanel Orientation="Horizontal">
                                        <materialDesign:PackIcon Kind="FileImage" Width="14" Height="14" Margin="0,0,4,0" VerticalAlignment="Center" Foreground="White"/>
                                        <TextBlock Text="등기부등본" VerticalAlignment="Center" Foreground="White" FontSize="{StaticResource FontSizeSmall}"/>
                                    </StackPanel>
                                </Button>
                            </Grid>
                        </Border>

                        <!-- basic_info + 갑구 + 을구 -->
                        <StackPanel>
                            <!-- 1) 소유지분현황 (basic_info) - DataGrid -->
                            <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1">
                                <StackPanel>
                                    <Border Background="{StaticResource BlueGray100Brush}" Padding="12,8">
                                        <TextBlock Text="1. 소유지분현황 (기본정보)" FontWeight="SemiBold"/>
                                    </Border>
                                    <DataGrid ItemsSource="{Binding RegistryBasicInfoList}"
                                              AutoGenerateColumns="False"
                                              CanUserAddRows="False"
                                              CanUserDeleteRows="False"
                                              IsReadOnly="True"
                                              HeadersVisibility="Column"
                                              GridLinesVisibility="Horizontal"
                                              Margin="12"
                                              MinHeight="80">
                                        <DataGrid.Columns>
                                            <DataGridTextColumn Header="지번일련번호" Binding="{Binding JibeonId}" Width="Auto"/>
                                            <DataGridTextColumn Header="물건지 (등기부등본)" Binding="{Binding RegistryAddress}" Width="*"/>
                                            <DataGridTextColumn Header="물건지 (DD)" Binding="{Binding DdAddress}" Width="*"/>
                                            <DataGridTextColumn Header="일치여부" Binding="{Binding IsAddressMatched}" Width="Auto"/>
                                            <DataGridTextColumn Header="담보물형태" Binding="{Binding CollateralType}" Width="Auto"/>
                                            <DataGridTextColumn Header="대지면적 (평)" Binding="{Binding LandAreaPyeong, StringFormat={}{0:N2}}" Width="Auto"/>
                                            <DataGridTextColumn Header="건물면적 (평)" Binding="{Binding BuildingAreaPyeong, StringFormat={}{0:N2}}" Width="Auto"/>
                                            <DataGridTextColumn Header="소유자" Binding="{Binding OwnerName}" Width="Auto"/>
                                            <DataGridTextColumn Header="등록번호" Binding="{Binding OwnerRegNo}" Width="Auto"/>
                                            <DataGridTextColumn Header="최종지분" Binding="{Binding ShareRatio}" Width="Auto"/>
                                            <DataGridTextColumn Header="소유자 주소" Binding="{Binding OwnerAddress}" Width="*"/>
                                        </DataGrid.Columns>
                                    </DataGrid>
                                </StackPanel>
                            </Border>

                            <!-- 2) 갑구 -->
                            <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1">
                                <StackPanel>
                                    <Border Background="{StaticResource BlueGray100Brush}" Padding="12,8">
                                        <Grid>
                                            <TextBlock Text="2. 갑구" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                                <Button Command="{Binding AddGapguRowCommand}"
                                                        Style="{StaticResource MaterialDesignFlatButton}"
                                                        Padding="6,2" Height="28" ToolTip="행 추가">
                                                    <StackPanel Orientation="Horizontal">
                                                        <materialDesign:PackIcon Kind="Plus" Width="14" Height="14" VerticalAlignment="Center"/>
                                                        <TextBlock Text="행 추가" Margin="4,0,0,0" FontSize="{StaticResource FontSizeSmall}" VerticalAlignment="Center"/>
                                                    </StackPanel>
                                                </Button>
                                                <Button Command="{Binding DeleteGapguRowCommand}"
                                                        CommandParameter="{Binding SelectedItem, ElementName=GapguDataGrid}"
                                                        Style="{StaticResource MaterialDesignFlatButton}"
                                                        Foreground="{StaticResource ErrorBrush}"
                                                        Padding="6,2" Height="28" Margin="4,0,0,0" ToolTip="선택 행 삭제">
                                                    <StackPanel Orientation="Horizontal">
                                                        <materialDesign:PackIcon Kind="Delete" Width="14" Height="14" VerticalAlignment="Center"/>
                                                        <TextBlock Text="행 삭제" Margin="4,0,0,0" FontSize="{StaticResource FontSizeSmall}" VerticalAlignment="Center"/>
                                                    </StackPanel>
                                                </Button>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                    <DataGrid x:Name="GapguDataGrid"
                                              ItemsSource="{Binding RegistryGapguRows}"
                                              AutoGenerateColumns="False"
                                              CanUserAddRows="False"
                                              CanUserDeleteRows="False"
                                              IsReadOnly="False"
                                              HeadersVisibility="Column"
                                              GridLinesVisibility="Horizontal"
                                              Margin="12"
                                              MinHeight="160">
                                        <DataGrid.Columns>
                                            <DataGridTextColumn Header="순위번호" Binding="{Binding RankNo, UpdateSourceTrigger=PropertyChanged}" Width="Auto"/>
                                            <DataGridTextColumn Header="등기목적" Binding="{Binding Purpose, UpdateSourceTrigger=PropertyChanged}" Width="2*"/>
                                            <DataGridTextColumn Header="접수정보" Binding="{Binding Receipt, UpdateSourceTrigger=PropertyChanged}" Width="2*"/>
                                            <DataGridTextColumn Header="접수날짜" Binding="{Binding ReceiptDate, StringFormat=yyyy-MM-dd, UpdateSourceTrigger=PropertyChanged}" Width="Auto"/>
                                            <DataGridTextColumn Header="권리자" Binding="{Binding RightHolder, UpdateSourceTrigger=PropertyChanged}" Width="2*"/>
                                            <DataGridTextColumn Header="청구금액" Binding="{Binding ClaimAmount, StringFormat=N0, UpdateSourceTrigger=PropertyChanged}" Width="Auto"/>
                                            <DataGridTextColumn Header="비고" Binding="{Binding NoteUserInput, UpdateSourceTrigger=PropertyChanged}" Width="2*"/>
                                            <DataGridTextColumn Header="임금채권추정" Binding="{Binding WageClaimEstimateUserInput, UpdateSourceTrigger=PropertyChanged}" Width="Auto"/>
                                            <DataGridTextColumn Header="대상소유자" Binding="{Binding TargetOwner, UpdateSourceTrigger=PropertyChanged}" Width="*"/>
                                            <DataGridTextColumn Header="지번번호" Binding="{Binding JibunNumber, UpdateSourceTrigger=PropertyChanged}" Width="Auto"/>
                                        </DataGrid.Columns>
                                    </DataGrid>
                                </StackPanel>
                            </Border>

                            <!-- 3) 을구 -->
                            <Border>
                                <StackPanel>
                                    <Border Background="{StaticResource BlueGray100Brush}" Padding="12,8">
                                        <Grid>
                                            <TextBlock Text="3. 을구" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                                <Button Command="{Binding AddEulguRowCommand}"
                                                        Style="{StaticResource MaterialDesignFlatButton}"
                                                        Padding="6,2" Height="28" ToolTip="행 추가">
                                                    <StackPanel Orientation="Horizontal">
                                                        <materialDesign:PackIcon Kind="Plus" Width="14" Height="14" VerticalAlignment="Center"/>
                                                        <TextBlock Text="행 추가" Margin="4,0,0,0" FontSize="{StaticResource FontSizeSmall}" VerticalAlignment="Center"/>
                                                    </StackPanel>
                                                </Button>
                                                <Button Command="{Binding DeleteEulguRowCommand}"
                                                        CommandParameter="{Binding SelectedItem, ElementName=EulguDataGrid}"
                                                        Style="{StaticResource MaterialDesignFlatButton}"
                                                        Foreground="{StaticResource ErrorBrush}"
                                                        Padding="6,2" Height="28" Margin="4,0,0,0" ToolTip="선택 행 삭제">
                                                    <StackPanel Orientation="Horizontal">
                                                        <materialDesign:PackIcon Kind="Delete" Width="14" Height="14" VerticalAlignment="Center"/>
                                                        <TextBlock Text="행 삭제" Margin="4,0,0,0" FontSize="{StaticResource FontSizeSmall}" VerticalAlignment="Center"/>
                                                    </StackPanel>
                                                </Button>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                    <DataGrid x:Name="EulguDataGrid"
                                              ItemsSource="{Binding RegistryEulguRows}"
                                              AutoGenerateColumns="False"
                                              CanUserAddRows="False"
                                              CanUserDeleteRows="False"
                                              IsReadOnly="False"
                                              HeadersVisibility="Column"
                                              GridLinesVisibility="Horizontal"
                                              Margin="12"
                                              MinHeight="160">
                                        <DataGrid.Columns>
                                            <DataGridTextColumn Header="순위번호" Binding="{Binding RankNo, UpdateSourceTrigger=PropertyChanged}" Width="Auto"/>
                                            <DataGridTextColumn Header="등기목적" Binding="{Binding Purpose, UpdateSourceTrigger=PropertyChanged}" Width="2*"/>
                                            <DataGridTextColumn Header="접수정보" Binding="{Binding Receipt, UpdateSourceTrigger=PropertyChanged}" Width="2*"/>
                                            <DataGridTextColumn Header="접수날짜" Binding="{Binding ReceiptDate, StringFormat=yyyy-MM-dd, UpdateSourceTrigger=PropertyChanged}" Width="Auto"/>
                                            <DataGridTextColumn Header="근저당권자" Binding="{Binding MortgageHolder, UpdateSourceTrigger=PropertyChanged}" Width="2*"/>
                                            <DataGridTextColumn Header="채권최고액" Binding="{Binding MaxClaimAmount, StringFormat=N0, UpdateSourceTrigger=PropertyChanged}" Width="Auto"/>
                                            <DataGridTextColumn Header="채무자" Binding="{Binding DebtorUserInput, UpdateSourceTrigger=PropertyChanged}" Width="2*"/>
                                            <DataGridTextColumn Header="담보종류" Binding="{Binding CollateralTypeUserInput, UpdateSourceTrigger=PropertyChanged}" Width="*"/>
                                            <DataGridTextColumn Header="공장저당" Binding="{Binding IsFactoryMortgageUserInput, UpdateSourceTrigger=PropertyChanged}" Width="Auto"/>
                                            <DataGridTextColumn Header="대상소유자" Binding="{Binding TargetOwner, UpdateSourceTrigger=PropertyChanged}" Width="*"/>
                                            <DataGridTextColumn Header="지번번호" Binding="{Binding JibunNumber, UpdateSourceTrigger=PropertyChanged}" Width="Auto"/>
                                        </DataGrid.Columns>
                                    </DataGrid>

                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="12,0,12,12">
                                        <Button Content="저장"
                                                Command="{Binding SaveRegistryUserInputsCommand}"
                                                Style="{StaticResource MaterialDesignRaisedButton}"
                                                Padding="12,6"/>
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <!-- 등기부등본 이미지 뷰어 (토글 패널) -->
                        <Border BorderBrush="{StaticResource BorderBrush}" 
                                BorderThickness="0,1,0,0"
                                Visibility="{Binding IsRegistryImageExpanded, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <StackPanel>
                                <Border Background="{StaticResource BlueGray100Brush}" Padding="12,8">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="물건지 선택:" VerticalAlignment="Center" FontWeight="SemiBold" Margin="0,0,8,0"/>
                                        <ComboBox Grid.Column="1"
                                                  ItemsSource="{Binding RegistryRuns}"
                                                  SelectedItem="{Binding SelectedImageRun}"
                                                  DisplayMemberPath="SourcePdfName"
                                                  MinWidth="300"
                                                  MaxWidth="600"
                                                  HorizontalAlignment="Left"/>
                                    </Grid>
                                </Border>
                                <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="800" Margin="12">
                                    <ItemsControl ItemsSource="{Binding RegistryDocumentImages}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" Margin="0,0,0,8" CornerRadius="4">
                                                    <Image Source="{Binding}" Stretch="Uniform"/>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>
                                <!-- 이미지 없을 때 안내 -->
                                <TextBlock Text="선택한 물건지에 대한 등기부등본 이미지가 없습니다. OCR 처리를 먼저 수행해 주세요."
                                           Foreground="{StaticResource TextSecondaryBrush}"
                                           HorizontalAlignment="Center"
                                           Margin="12,20"
                                           FontSize="{StaticResource FontSizeSmall}">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding RegistryDocumentImages.Count}" Value="0">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Border>

                <!-- ========== 감정평가 정보 ========== -->
                <Border Background="{StaticResource SurfaceColor}"
                        BorderBrush="{StaticResource BorderBrush}"
                        BorderThickness="1"
                        CornerRadius="8"
                        Margin="0,0,0,16">
                    <StackPanel>
                        <Border Background="{StaticResource PrimaryBrush}"
                                CornerRadius="8,8,0,0"
                                Padding="16,8">
                            <TextBlock Text="감정평가 정보"
                                       Foreground="White"
                                       FontWeight="SemiBold"
                                       FontSize="{StaticResource FontSizeH4}"/>
                        </Border>
                        <DataGrid ItemsSource="{Binding AppraisalInfoList}"
                                  AutoGenerateColumns="False"
                                  CanUserAddRows="False"
                                  CanUserDeleteRows="False"
                                  IsReadOnly="True"
                                  HeadersVisibility="Column"
                                  GridLinesVisibility="Horizontal"
                                  Margin="12"
                                  MinHeight="60">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="감정평가구분" Binding="{Binding AppraisalType}" Width="Auto"/>
                                <DataGridTextColumn Header="감정평가일자" Binding="{Binding AppraisalDateFormatted}" Width="Auto"/>
                                <DataGridTextColumn Header="감정평가기관" Binding="{Binding AppraisalAgency}" Width="Auto"/>
                                <DataGridTextColumn Header="토지 감정평가액" Binding="{Binding LandAppraisalFormatted}" Width="Auto">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock"><Setter Property="TextAlignment" Value="Right"/></Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>
                                <DataGridTextColumn Header="건물 감정평가액" Binding="{Binding BuildingAppraisalFormatted}" Width="Auto">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock"><Setter Property="TextAlignment" Value="Right"/></Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>
                                <DataGridTextColumn Header="기계 감정평가액" Binding="{Binding MachineryAppraisalFormatted}" Width="Auto">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock"><Setter Property="TextAlignment" Value="Right"/></Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>
                                <DataGridTextColumn Header="제시외" Binding="{Binding ExcludedAppraisalFormatted}" Width="Auto">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock"><Setter Property="TextAlignment" Value="Right"/></Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>
                                <DataGridTextColumn Header="감정평가액합계" Binding="{Binding AppraisalValueFormatted}" Width="Auto">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock"><Setter Property="TextAlignment" Value="Right"/><Setter Property="FontWeight" Value="SemiBold"/></Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>
                            </DataGrid.Columns>
                        </DataGrid>

                        <!-- KB시세 (아파트인 경우만 표시) -->
                        <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0"
                                Visibility="{Binding IsApartment, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <StackPanel>
                                <Border Background="{StaticResource BlueGray100Brush}" Padding="12,8">
                                    <TextBlock Text="KB시세" FontWeight="SemiBold"/>
                                </Border>
                                <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="1,1,0,0" Margin="12">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>

                                        <!-- 헤더 -->
                                        <Border Grid.Row="0" Grid.Column="0" Style="{StaticResource TableHeaderCell}">
                                            <TextBlock Text="KB시세 데이터" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}" HorizontalAlignment="Center"/>
                                        </Border>
                                        <Border Grid.Row="0" Grid.Column="1" Style="{StaticResource TableHeaderCell}">
                                            <TextBlock Text="KB시세" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}" HorizontalAlignment="Center"/>
                                        </Border>
                                        <Border Grid.Row="0" Grid.Column="2" Style="{StaticResource TableHeaderCell}">
                                            <TextBlock Text="분양면적" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}" HorizontalAlignment="Center"/>
                                        </Border>

                                        <!-- 데이터 -->
                                        <Border Grid.Row="1" Grid.Column="0" Style="{StaticResource TableDataCell}">
                                            <TextBlock HorizontalAlignment="Center">
                                                <Hyperlink Command="{Binding OpenKBSiteCommand}" ToolTip="{Binding KbLandUrl}">
                                                    <Run Text="KB부동산 시세 확인"/>
                                                </Hyperlink>
                                            </TextBlock>
                                        </Border>
                                        <Border Grid.Row="1" Grid.Column="1" Style="{StaticResource TableDataCell}">
                                            <TextBlock Text="{Binding KbPrice, StringFormat=N0, TargetNullValue='-'}"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="SemiBold"/>
                                        </Border>
                                        <Border Grid.Row="1" Grid.Column="2" Style="{StaticResource TableDataCell}" Background="{StaticResource ManualInputBgBrush}">
                                            <TextBox Text="{Binding KbSupplyArea, StringFormat=N2, UpdateSourceTrigger=PropertyChanged}"
                                                     BorderThickness="0" Background="Transparent"
                                                     HorizontalContentAlignment="Center" VerticalContentAlignment="Center"/>
                                        </Border>
                                    </Grid>
                                </Border>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="12,8,12,12">
                                    <Button Content="저장"
                                            Command="{Binding SaveKbPanelCommand}"
                                            Style="{StaticResource MaterialDesignRaisedButton}"
                                            Padding="12,6"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <!-- 분양가 (상가/아파트형공장인 경우만 표시) -->
                        <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0"
                                Visibility="{Binding IsCommercialOrFactory, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <StackPanel>
                                <Border Background="{StaticResource BlueGray100Brush}" Padding="12,8">
                                    <TextBlock Text="분양가" FontWeight="SemiBold"/>
                                </Border>
                                <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="1,1,0,0" Margin="12">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>

                                        <!-- Row 0: 분양면적 (RowSpan=2) | 분양가 (ColSpan=4) -->
                                        <Border Grid.Row="0" Grid.Column="0" Grid.RowSpan="2" Style="{StaticResource TableHeaderCell}">
                                            <TextBlock Text="분양면적" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <Border Grid.Row="0" Grid.Column="1" Grid.ColumnSpan="4" Style="{StaticResource TableHeaderCell}">
                                            <TextBlock Text="분양가" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}" HorizontalAlignment="Center"/>
                                        </Border>

                                        <!-- Row 1: 분양가 하위 헤더 (토지, 건물, 합계, 부가세) -->
                                        <Border Grid.Row="1" Grid.Column="1" Style="{StaticResource TableHeaderCell}">
                                            <TextBlock Text="토지" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}" HorizontalAlignment="Center"/>
                                        </Border>
                                        <Border Grid.Row="1" Grid.Column="2" Style="{StaticResource TableHeaderCell}">
                                            <TextBlock Text="건물" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}" HorizontalAlignment="Center"/>
                                        </Border>
                                        <Border Grid.Row="1" Grid.Column="3" Style="{StaticResource TableHeaderCell}">
                                            <TextBlock Text="합계" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}" HorizontalAlignment="Center"/>
                                        </Border>
                                        <Border Grid.Row="1" Grid.Column="4" Style="{StaticResource TableHeaderCell}">
                                            <TextBlock Text="부가세" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}" HorizontalAlignment="Center"/>
                                        </Border>

                                        <!-- Row 2: 데이터 (모두 유저 입력) -->
                                        <Border Grid.Row="2" Grid.Column="0" Style="{StaticResource TableDataCell}" Background="{StaticResource ManualInputBgBrush}">
                                            <TextBox Text="{Binding SaleSupplyArea, StringFormat=N2, UpdateSourceTrigger=PropertyChanged}"
                                                     BorderThickness="0" Background="Transparent"
                                                     HorizontalContentAlignment="Center" VerticalContentAlignment="Center"/>
                                        </Border>
                                        <Border Grid.Row="2" Grid.Column="1" Style="{StaticResource TableDataCell}" Background="{StaticResource ManualInputBgBrush}">
                                            <TextBox Text="{Binding SalePriceLand, StringFormat=N0, UpdateSourceTrigger=PropertyChanged, TargetNullValue=''}"
                                                     BorderThickness="0" Background="Transparent"
                                                     HorizontalContentAlignment="Center" VerticalContentAlignment="Center"/>
                                        </Border>
                                        <Border Grid.Row="2" Grid.Column="2" Style="{StaticResource TableDataCell}" Background="{StaticResource ManualInputBgBrush}">
                                            <TextBox Text="{Binding SalePriceBuilding, StringFormat=N0, UpdateSourceTrigger=PropertyChanged, TargetNullValue=''}"
                                                     BorderThickness="0" Background="Transparent"
                                                     HorizontalContentAlignment="Center" VerticalContentAlignment="Center"/>
                                        </Border>
                                        <Border Grid.Row="2" Grid.Column="3" Style="{StaticResource TableDataCell}" Background="{StaticResource ManualInputBgBrush}">
                                            <TextBox Text="{Binding SalePriceTotal, StringFormat=N0, UpdateSourceTrigger=PropertyChanged, TargetNullValue=''}"
                                                     BorderThickness="0" Background="Transparent"
                                                     HorizontalContentAlignment="Center" VerticalContentAlignment="Center"/>
                                        </Border>
                                        <Border Grid.Row="2" Grid.Column="4" Style="{StaticResource TableDataCell}" Background="{StaticResource ManualInputBgBrush}">
                                            <TextBox Text="{Binding SalePriceVat, StringFormat=N0, UpdateSourceTrigger=PropertyChanged, TargetNullValue=''}"
                                                     BorderThickness="0" Background="Transparent"
                                                     HorizontalContentAlignment="Center" VerticalContentAlignment="Center"/>
                                        </Border>
                                    </Grid>
                                </Border>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="12,8,12,12">
                                    <Button Content="저장"
                                            Command="{Binding SaveSalePanelCommand}"
                                            Style="{StaticResource MaterialDesignRaisedButton}"
                                            Padding="12,6"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Border>

                <!-- ===== 지번별 감정평가 패널 ===== -->
                <Border Background="{StaticResource SurfaceColor}" CornerRadius="8"
                        BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                        Margin="0,0,0,16">
                    <StackPanel>
                        <!-- 패널 헤더 -->
                        <Border Background="{StaticResource PrimaryBrush}" CornerRadius="8,8,0,0" Padding="16,10">
                            <Grid>
                                <TextBlock Text="지번별 감정평가" FontWeight="Bold" FontSize="14" Foreground="White"
                                           VerticalAlignment="Center"/>
                                <Button Content="+" FontSize="16" FontWeight="Bold"
                                        HorizontalAlignment="Right"
                                        Command="{Binding CreateJibunAppraisalTableCommand}"
                                        Visibility="{Binding HasJibunAppraisalTable, Converter={StaticResource InverseBooleanToVisibilityConverter}}"
                                        Background="Transparent" Foreground="White" BorderThickness="0"
                                        Padding="8,2" Cursor="Hand"
                                        ToolTip="지번별 감정평가 테이블 생성"/>
                            </Grid>
                        </Border>

                        <!-- 테이블 (HasJibunAppraisalTable이 true일 때만 표시) -->
                        <StackPanel Visibility="{Binding HasJibunAppraisalTable, Converter={StaticResource BooleanToVisibilityConverter}}"
                                    Margin="12">
                            <DataGrid ItemsSource="{Binding JibunAppraisalRows}"
                                      AutoGenerateColumns="False"
                                      CanUserAddRows="False" CanUserDeleteRows="False"
                                      CanUserSortColumns="False"
                                      HeadersVisibility="Column"
                                      GridLinesVisibility="All"
                                      HorizontalGridLinesBrush="{StaticResource BorderBrush}"
                                      VerticalGridLinesBrush="{StaticResource BorderBrush}"
                                      BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                                      Background="White"
                                      RowBackground="White"
                                      AlternatingRowBackground="#FAFAFA"
                                      MinHeight="60">
                                <DataGrid.ColumnHeaderStyle>
                                    <Style TargetType="DataGridColumnHeader">
                                        <Setter Property="Background" Value="{StaticResource BlueGray100Brush}"/>
                                        <Setter Property="Padding" Value="8,6"/>
                                        <Setter Property="FontWeight" Value="SemiBold"/>
                                        <Setter Property="FontSize" Value="12"/>
                                        <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
                                        <Setter Property="HorizontalContentAlignment" Value="Center"/>
                                        <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
                                        <Setter Property="BorderThickness" Value="0,0,1,1"/>
                                    </Style>
                                </DataGrid.ColumnHeaderStyle>
                                <DataGrid.CellStyle>
                                    <Style TargetType="DataGridCell">
                                        <Setter Property="Background" Value="{StaticResource ManualInputBgBrush}"/>
                                        <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
                                        <Setter Property="BorderThickness" Value="0,0,1,0"/>
                                        <Setter Property="Padding" Value="4,2"/>
                                        <Setter Property="VerticalContentAlignment" Value="Center"/>
                                    </Style>
                                </DataGrid.CellStyle>
                                <DataGrid.RowStyle>
                                    <Style TargetType="DataGridRow">
                                        <Setter Property="VerticalContentAlignment" Value="Center"/>
                                    </Style>
                                </DataGrid.RowStyle>
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="지번일련번호" Binding="{Binding JaSeq, UpdateSourceTrigger=PropertyChanged}" Width="100">
                                        <DataGridTextColumn.ElementStyle>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="HorizontalAlignment" Value="Center"/>
                                                <Setter Property="VerticalAlignment" Value="Center"/>
                                            </Style>
                                        </DataGridTextColumn.ElementStyle>
                                        <DataGridTextColumn.EditingElementStyle>
                                            <Style TargetType="TextBox">
                                                <Setter Property="HorizontalContentAlignment" Value="Center"/>
                                                <Setter Property="VerticalContentAlignment" Value="Center"/>
                                            </Style>
                                        </DataGridTextColumn.EditingElementStyle>
                                    </DataGridTextColumn>
                                    <DataGridTextColumn Header="구분" Binding="{Binding JaCategory, UpdateSourceTrigger=PropertyChanged}" Width="80">
                                        <DataGridTextColumn.ElementStyle>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="HorizontalAlignment" Value="Center"/>
                                                <Setter Property="VerticalAlignment" Value="Center"/>
                                            </Style>
                                        </DataGridTextColumn.ElementStyle>
                                        <DataGridTextColumn.EditingElementStyle>
                                            <Style TargetType="TextBox">
                                                <Setter Property="HorizontalContentAlignment" Value="Center"/>
                                                <Setter Property="VerticalContentAlignment" Value="Center"/>
                                            </Style>
                                        </DataGridTextColumn.EditingElementStyle>
                                    </DataGridTextColumn>
                                    <DataGridTextColumn Header="지번주소지" Binding="{Binding JaAddress, UpdateSourceTrigger=PropertyChanged}" Width="*">
                                        <DataGridTextColumn.ElementStyle>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="HorizontalAlignment" Value="Center"/>
                                                <Setter Property="VerticalAlignment" Value="Center"/>
                                            </Style>
                                        </DataGridTextColumn.ElementStyle>
                                        <DataGridTextColumn.EditingElementStyle>
                                            <Style TargetType="TextBox">
                                                <Setter Property="HorizontalContentAlignment" Value="Center"/>
                                                <Setter Property="VerticalContentAlignment" Value="Center"/>
                                            </Style>
                                        </DataGridTextColumn.EditingElementStyle>
                                    </DataGridTextColumn>
                                    <DataGridTextColumn Header="면적(평)" Binding="{Binding JaAreaPyeong, StringFormat=N2, UpdateSourceTrigger=PropertyChanged}" Width="90">
                                        <DataGridTextColumn.ElementStyle>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="HorizontalAlignment" Value="Center"/>
                                                <Setter Property="VerticalAlignment" Value="Center"/>
                                            </Style>
                                        </DataGridTextColumn.ElementStyle>
                                        <DataGridTextColumn.EditingElementStyle>
                                            <Style TargetType="TextBox">
                                                <Setter Property="HorizontalContentAlignment" Value="Center"/>
                                                <Setter Property="VerticalContentAlignment" Value="Center"/>
                                            </Style>
                                        </DataGridTextColumn.EditingElementStyle>
                                    </DataGridTextColumn>
                                    <DataGridTextColumn Header="평당감정가" Binding="{Binding JaPricePerPyeong, StringFormat=N0, UpdateSourceTrigger=PropertyChanged}" Width="110">
                                        <DataGridTextColumn.ElementStyle>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="HorizontalAlignment" Value="Center"/>
                                                <Setter Property="VerticalAlignment" Value="Center"/>
                                            </Style>
                                        </DataGridTextColumn.ElementStyle>
                                        <DataGridTextColumn.EditingElementStyle>
                                            <Style TargetType="TextBox">
                                                <Setter Property="HorizontalContentAlignment" Value="Center"/>
                                                <Setter Property="VerticalContentAlignment" Value="Center"/>
                                            </Style>
                                        </DataGridTextColumn.EditingElementStyle>
                                    </DataGridTextColumn>
                                    <DataGridTextColumn Header="감정가" Binding="{Binding JaAppraisalValue, StringFormat=N0, UpdateSourceTrigger=PropertyChanged}" Width="120">
                                        <DataGridTextColumn.ElementStyle>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="HorizontalAlignment" Value="Center"/>
                                                <Setter Property="VerticalAlignment" Value="Center"/>
                                            </Style>
                                        </DataGridTextColumn.ElementStyle>
                                        <DataGridTextColumn.EditingElementStyle>
                                            <Style TargetType="TextBox">
                                                <Setter Property="HorizontalContentAlignment" Value="Center"/>
                                                <Setter Property="VerticalContentAlignment" Value="Center"/>
                                            </Style>
                                        </DataGridTextColumn.EditingElementStyle>
                                    </DataGridTextColumn>
                                    <DataGridTemplateColumn Header="" Width="40">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <Button Content="✕" FontSize="11"
                                                        Command="{Binding DataContext.RemoveJibunAppraisalRowCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                        CommandParameter="{Binding}"
                                                        Background="Transparent" Foreground="#E53935" BorderThickness="0"
                                                        Cursor="Hand" HorizontalAlignment="Center"
                                                        ToolTip="행 삭제"/>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                </DataGrid.Columns>
                            </DataGrid>

                            <!-- 행 추가 / 저장 버튼 -->
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
                                <Button Content="+ 행 추가"
                                        Command="{Binding AddJibunAppraisalRowCommand}"
                                        Style="{StaticResource MaterialDesignFlatButton}"
                                        Padding="12,6" Margin="0,0,8,0"/>
                                <Button Content="저장"
                                        Command="{Binding SaveJibunAppraisalsCommand}"
                                        Style="{StaticResource MaterialDesignRaisedButton}"
                                        Padding="12,6"/>
                            </StackPanel>
                        </StackPanel>
                    </StackPanel>
                </Border>

            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
