<UserControl x:Class="NPLogic.Views.Loan.Sections.GuaranteeSummarySection"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignHeight="300" d:DesignWidth="1600">

    <UserControl.Resources>
        <Style x:Key="HeaderCellStyle" TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="{StaticResource BlueGray100Brush}"/>
            <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
            <Setter Property="FontSize" Value="{StaticResource FontSizeTiny}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="4,6"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="0,0,1,1"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="ContentTemplate">
                <Setter.Value>
                    <DataTemplate>
                        <TextBlock Text="{Binding}" TextWrapping="Wrap" TextAlignment="Center"/>
                    </DataTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="CellStyle" TargetType="DataGridCell">
            <Setter Property="FontSize" Value="{StaticResource FontSizeTiny}"/>
            <Setter Property="Padding" Value="4,3"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="0,0,1,1"/>
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#E3F2FD"/>
                    <Setter Property="Foreground" Value="Black"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="AmountCellStyle" TargetType="TextBlock">
            <Setter Property="HorizontalAlignment" Value="Right"/>
            <Setter Property="Padding" Value="4,0"/>
        </Style>

        <Style x:Key="CenterCellStyle" TargetType="TextBlock">
            <Setter Property="HorizontalAlignment" Value="Center"/>
        </Style>
    </UserControl.Resources>

    <Border Background="{StaticResource SurfaceColor}"
            BorderBrush="{StaticResource BorderBrush}"
            BorderThickness="1"
            CornerRadius="8"
            Margin="0,0,0,16">
        <StackPanel>
            <!-- 섹션 헤더 -->
            <Border Background="{StaticResource PrimaryBrush}"
                    CornerRadius="8,8,0,0"
                    Padding="16,10">
                <TextBlock Text="보증서요약" FontWeight="SemiBold" FontSize="{StaticResource FontSizeH4}" Foreground="White"/>
            </Border>

            <!-- DataGrid -->
            <DataGrid ItemsSource="{Binding GuaranteeSummaryItems}"
                      AutoGenerateColumns="False"
                      CanUserAddRows="False"
                      CanUserDeleteRows="False"
                      IsReadOnly="True"
                      RowHeaderWidth="0"
                      GridLinesVisibility="All"
                      HorizontalGridLinesBrush="{StaticResource BorderBrush}"
                      VerticalGridLinesBrush="{StaticResource BorderBrush}"
                      Background="White"
                      BorderThickness="0"
                      MinHeight="60"
                      MaxHeight="250"
                      HorizontalScrollBarVisibility="Auto"
                      ColumnHeaderStyle="{StaticResource HeaderCellStyle}"
                      CellStyle="{StaticResource CellStyle}">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="계좌일련번호(A)" Binding="{Binding AccountSerial}" Width="*" MinWidth="90"/>
                    <DataGridTextColumn Header="보증기관(X)" Binding="{Binding GuaranteeOrganization}" Width="*" MinWidth="70"/>
                    <DataGridTextColumn Header="보증잔액(Y)" Binding="{Binding GuaranteeBalance, StringFormat=N0}" Width="*" MinWidth="90" ElementStyle="{StaticResource AmountCellStyle}"/>
                    <DataGridTextColumn Header="해지부 해지채권(Z)" Binding="{Binding TerminatedBondAmount, StringFormat=N0}" Width="*" MinWidth="90" ElementStyle="{StaticResource AmountCellStyle}"/>
                    <DataGridTextColumn Header="보증비율(AA)" Binding="{Binding GuaranteeRatio, StringFormat=P0}" Width="*" MinWidth="60" ElementStyle="{StaticResource CenterCellStyle}"/>
                    <DataGridCheckBoxColumn Header="대위변제여부(AB)" Binding="{Binding HasSubrogation, UpdateSourceTrigger=PropertyChanged}" Width="*" MinWidth="80">
                        <DataGridCheckBoxColumn.ElementStyle>
                            <Style TargetType="CheckBox">
                                <Setter Property="HorizontalAlignment" Value="Center"/>
                            </Style>
                        </DataGridCheckBoxColumn.ElementStyle>
                    </DataGridCheckBoxColumn>
                    <DataGridTextColumn Header="대위변제금 수령 예상일(AC)" Binding="{Binding SubrogationExpectedDate, StringFormat=yyyy-MM-dd}" Width="*" MinWidth="100" ElementStyle="{StaticResource CenterCellStyle}"/>
                    <DataGridTextColumn Header="연체이자율(M)" Binding="{Binding OverdueInterestRate, StringFormat=P1}" Width="*" MinWidth="65" ElementStyle="{StaticResource CenterCellStyle}"/>
                    <DataGridTextColumn Header="정상이자율(L)" Binding="{Binding NormalInterestRate, StringFormat=P2}" Width="*" MinWidth="65" ElementStyle="{StaticResource CenterCellStyle}"/>
                    <DataGridTextColumn Header="대위변제원금(AD)" Binding="{Binding SubrogationPrincipal, StringFormat=N0}" Width="*" MinWidth="90" ElementStyle="{StaticResource AmountCellStyle}"/>
                    <DataGridTextColumn Header="이자계산일수(AE)" Binding="{Binding InterestDays}" Width="*" MinWidth="65" ElementStyle="{StaticResource CenterCellStyle}"/>
                    <DataGridTextColumn Header="약정이자(AF)" Binding="{Binding AgreedInterest, StringFormat=N0}" Width="*" MinWidth="85" ElementStyle="{StaticResource AmountCellStyle}"/>
                    <DataGridTextColumn Header="대위변제금액(AG)" Binding="{Binding SubrogationAmount, StringFormat=N0}" Width="*" MinWidth="90" ElementStyle="{StaticResource AmountCellStyle}"/>
                    <DataGridTextColumn Header="연체이자,약정이자 차이(AH)" Binding="{Binding InterestDifference, StringFormat=N0}" Width="*" MinWidth="100" ElementStyle="{StaticResource AmountCellStyle}"/>
                    <DataGridTextColumn Header="1안 예상배당일(DD1)" Binding="{Binding ExpectedDividendDate1, StringFormat=yyyy-MM-dd}" Width="*" MinWidth="100" ElementStyle="{StaticResource CenterCellStyle}"/>
                    <DataGridTextColumn Header="1안 연체이자(AI)" Binding="{Binding OverdueInterest1, StringFormat=N0}" Width="*" MinWidth="90" ElementStyle="{StaticResource AmountCellStyle}"/>
                    <DataGridTextColumn Header="2안 예상배당일(DD2)" Binding="{Binding ExpectedDividendDate2, StringFormat=yyyy-MM-dd}" Width="*" MinWidth="100" ElementStyle="{StaticResource CenterCellStyle}"/>
                    <DataGridTextColumn Header="2안 연체이자(AJ)" Binding="{Binding OverdueInterest2, StringFormat=N0}" Width="*" MinWidth="90" ElementStyle="{StaticResource AmountCellStyle}"/>
                    <DataGridTextColumn Header="1안 보증기관 Loan Cap(XLC1)" Binding="{Binding GuaranteeLoanCap1, StringFormat=N0}" Width="*" MinWidth="110" ElementStyle="{StaticResource AmountCellStyle}"/>
                    <DataGridTextColumn Header="2안 보증기관 Loan Cap(XLC2)" Binding="{Binding GuaranteeLoanCap2, StringFormat=N0}" Width="*" MinWidth="110" ElementStyle="{StaticResource AmountCellStyle}"/>
                </DataGrid.Columns>
            </DataGrid>

            <!-- 이미지 영역: 보증서 등 + 기타항목 및 전송 (2열 그리드, 표 아래) -->
            <Grid Margin="0,8,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Row 0: 헤더 -->
                <Border Grid.Row="0" Grid.Column="0"
                        Background="{StaticResource BlueGray100Brush}"
                        BorderBrush="{StaticResource BorderBrush}" BorderThickness="1,1,1,1"
                        Padding="6,6">
                    <TextBlock Text="보증서 등" FontWeight="SemiBold" FontSize="{StaticResource FontSizeTiny}"
                               HorizontalAlignment="Center" Foreground="{StaticResource TextSecondaryBrush}"/>
                </Border>
                <Border Grid.Row="0" Grid.Column="1"
                        Background="{StaticResource BlueGray100Brush}"
                        BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,1,1"
                        Padding="6,6">
                    <TextBlock Text="기타항목 및 전송" FontWeight="SemiBold" FontSize="{StaticResource FontSizeTiny}"
                               HorizontalAlignment="Center" Foreground="{StaticResource TextSecondaryBrush}"/>
                </Border>

                <!-- Row 1: 이미지 콘텐츠 -->
                <Border Grid.Row="1" Grid.Column="0"
                        BorderBrush="{StaticResource BorderBrush}" BorderThickness="1,0,1,1" Background="White">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="140" MinHeight="40"/>
                            <RowDefinition Height="5"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Button Grid.Row="0" Content="이미지 붙여넣기"
                                Command="{Binding PasteGuaranteeImageCommand}"
                                Style="{StaticResource SecondaryButton}"
                                Padding="8,4" FontSize="{StaticResource FontSizeTiny}"
                                HorizontalAlignment="Left" Margin="4,4,0,4"/>
                        <Image Grid.Row="1" Source="{Binding GuaranteeImage}"
                               Stretch="Uniform" Margin="4,0"/>
                        <GridSplitter Grid.Row="2" HorizontalAlignment="Stretch"
                                      ResizeDirection="Rows" Background="#E0E0E0"
                                      Cursor="SizeNS" Height="5"/>
                        <TextBlock Grid.Row="3" Text="{Binding GuaranteeImageInfo}"
                                   FontSize="{StaticResource FontSizeTiny}" Opacity="0.7"
                                   TextWrapping="Wrap" Margin="4,2,4,4"/>
                    </Grid>
                </Border>
                <Border Grid.Row="1" Grid.Column="1"
                        BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,1,1" Background="White">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="140" MinHeight="40"/>
                            <RowDefinition Height="5"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Button Grid.Row="0" Content="이미지 붙여넣기"
                                Command="{Binding PasteOtherItemsImageCommand}"
                                Style="{StaticResource SecondaryButton}"
                                Padding="8,4" FontSize="{StaticResource FontSizeTiny}"
                                HorizontalAlignment="Left" Margin="4,4,0,4"/>
                        <Image Grid.Row="1" Source="{Binding OtherItemsImage}"
                               Stretch="Uniform" Margin="4,0"/>
                        <GridSplitter Grid.Row="2" HorizontalAlignment="Stretch"
                                      ResizeDirection="Rows" Background="#E0E0E0"
                                      Cursor="SizeNS" Height="5"/>
                        <TextBlock Grid.Row="3" Text="{Binding OtherItemsImageInfo}"
                                   FontSize="{StaticResource FontSizeTiny}" Opacity="0.7"
                                   TextWrapping="Wrap" Margin="4,2,4,4"/>
                    </Grid>
                </Border>
            </Grid>

        </StackPanel>
    </Border>
</UserControl>
