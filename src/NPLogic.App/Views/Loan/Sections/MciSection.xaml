<UserControl x:Class="NPLogic.Views.Loan.Sections.MciSection"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignHeight="400" d:DesignWidth="2200">

    <UserControl.Resources>
        <Style x:Key="CellBorder" TargetType="Border">
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="0,0,1,1"/>
            <Setter Property="Padding" Value="4,2"/>
        </Style>

        <Style x:Key="HeaderCell" TargetType="Border" BasedOn="{StaticResource CellBorder}">
            <Setter Property="Background" Value="{StaticResource BlueGray100Brush}"/>
        </Style>

        <Style x:Key="HeaderText" TargetType="TextBlock">
            <Setter Property="FontSize" Value="{StaticResource FontSizeTiny}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="TextAlignment" Value="Center"/>
        </Style>

        <Style x:Key="AmountText" TargetType="TextBlock">
            <Setter Property="FontSize" Value="{StaticResource FontSizeTiny}"/>
            <Setter Property="HorizontalAlignment" Value="Right"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <Style x:Key="CenterText" TargetType="TextBlock">
            <Setter Property="FontSize" Value="{StaticResource FontSizeTiny}"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
    </UserControl.Resources>

    <Border Background="{StaticResource SurfaceColor}"
            BorderBrush="{StaticResource BorderBrush}"
            BorderThickness="1"
            CornerRadius="8"
            Margin="0,0,0,16">
        <StackPanel>
            <!-- 섹션 헤더 (네이비 배너) -->
            <Border Background="{StaticResource PrimaryBrush}"
                    CornerRadius="8,8,0,0"
                    Padding="16,10">
                <StackPanel>
                    <TextBlock Text="MCI 보증" FontWeight="SemiBold" FontSize="{StaticResource FontSizeH4}" Foreground="White"/>
                    <TextBlock Text="MCI 보증 대상 대출의 청구액 산출" FontSize="{StaticResource FontSizeTiny}" Foreground="#B0C4DE"/>
                </StackPanel>
            </Border>

            <!-- ================================================================ -->
            <!-- 1안 서브헤더 -->
            <!-- ================================================================ -->
            <Border Background="#E8EAF6" Padding="12,7">
                <TextBlock Text="1안" FontWeight="Bold" FontSize="{StaticResource FontSizeSmall}" Foreground="{StaticResource PrimaryBrush}"/>
            </Border>

            <!-- 1안 표 -->
            <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="1,0,0,0">
                <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="90"/>
                            <ColumnDefinition Width="80"/>
                            <ColumnDefinition Width="90"/>
                            <ColumnDefinition Width="80"/>
                            <ColumnDefinition Width="80"/>
                            <ColumnDefinition Width="50"/>
                            <ColumnDefinition Width="65"/>
                            <ColumnDefinition Width="85"/>
                            <ColumnDefinition Width="85"/>
                            <ColumnDefinition Width="90"/>
                            <ColumnDefinition Width="90"/>
                            <ColumnDefinition Width="85"/>
                            <ColumnDefinition Width="85"/>
                            <ColumnDefinition Width="100"/>
                            <ColumnDefinition Width="105"/>
                            <ColumnDefinition Width="85"/>
                            <ColumnDefinition Width="120"/>
                            <ColumnDefinition Width="80"/>
                            <ColumnDefinition Width="85"/>
                            <ColumnDefinition Width="110"/>
                            <ColumnDefinition Width="85"/>
                            <ColumnDefinition Width="85"/>
                            <ColumnDefinition Width="80"/>
                        </Grid.ColumnDefinitions>

                        <!-- Row 0: 헤더 -->
                        <Border Grid.Row="0" Grid.Column="0" Style="{StaticResource HeaderCell}"><TextBlock Text="MCI최초&#x0a;가입금액" Style="{StaticResource HeaderText}"/></Border>
                        <Border Grid.Row="0" Grid.Column="1" Style="{StaticResource HeaderCell}"><TextBlock Text="채권번호" Style="{StaticResource HeaderText}"/></Border>
                        <Border Grid.Row="0" Grid.Column="2" Style="{StaticResource HeaderCell}"><TextBlock Text="MCI가입잔액" Style="{StaticResource HeaderText}"/></Border>
                        <Border Grid.Row="0" Grid.Column="3" Style="{StaticResource HeaderCell}"><TextBlock Text="최종이수일" Style="{StaticResource HeaderText}"/></Border>
                        <Border Grid.Row="0" Grid.Column="4" Style="{StaticResource HeaderCell}"><TextBlock Text="예상배당일" Style="{StaticResource HeaderText}"/></Border>
                        <Border Grid.Row="0" Grid.Column="5" Style="{StaticResource HeaderCell}"><TextBlock Text="일수" Style="{StaticResource HeaderText}"/></Border>
                        <Border Grid.Row="0" Grid.Column="6" Style="{StaticResource HeaderCell}"><TextBlock Text="정상이자율" Style="{StaticResource HeaderText}"/></Border>
                        <Border Grid.Row="0" Grid.Column="7" Style="{StaticResource HeaderCell}"><TextBlock Text="인수대상&#x0a;원금" Style="{StaticResource HeaderText}"/></Border>
                        <Border Grid.Row="0" Grid.Column="8" Style="{StaticResource HeaderCell}"><TextBlock Text="유효담보가" Style="{StaticResource HeaderText}"/></Border>
                        <Border Grid.Row="0" Grid.Column="9" Style="{StaticResource HeaderCell}"><TextBlock Text="유효담보가의&#x0a;이자" Style="{StaticResource HeaderText}"/></Border>
                        <Border Grid.Row="0" Grid.Column="10" Style="{StaticResource HeaderCell}"><TextBlock Text="유효담보가의&#x0a;이자한도" Style="{StaticResource HeaderText}"/></Border>
                        <Border Grid.Row="0" Grid.Column="11" Style="{StaticResource HeaderCell}"><TextBlock Text="유효담보가&#x0a;배당액" Style="{StaticResource HeaderText}"/></Border>
                        <Border Grid.Row="0" Grid.Column="12" Style="{StaticResource HeaderCell}"><TextBlock Text="채권잔액" Style="{StaticResource HeaderText}"/></Border>
                        <Border Grid.Row="0" Grid.Column="13" Style="{StaticResource HeaderCell}"><TextBlock Text="인수대상원금&#x0a;-MCI 가입잔액" Style="{StaticResource HeaderText}"/></Border>
                        <Border Grid.Row="0" Grid.Column="14" Style="{StaticResource HeaderCell}"><TextBlock Text="(미수이자+&#x0a;1안연체이자)" Style="{StaticResource HeaderText}"/></Border>
                        <Border Grid.Row="0" Grid.Column="15" Style="{StaticResource HeaderCell}"><TextBlock Text="유효담보가의&#x0a;20%" Style="{StaticResource HeaderText}"/></Border>
                        <Border Grid.Row="0" Grid.Column="16" Style="{StaticResource HeaderCell}"><TextBlock Text="유효담보가+유효담보가&#x0a;의 이자(Max 한도)" Style="{StaticResource HeaderText}"/></Border>
                        <Border Grid.Row="0" Grid.Column="17" Style="{StaticResource HeaderCell}"><TextBlock Text="예상배당금" Style="{StaticResource HeaderText}"/></Border>
                        <Border Grid.Row="0" Grid.Column="18" Style="{StaticResource HeaderCell}"><TextBlock Text="MCI 정상이자" Style="{StaticResource HeaderText}"/></Border>
                        <Border Grid.Row="0" Grid.Column="19" Style="{StaticResource HeaderCell}"><TextBlock Text="배당으로 충당되지&#x0a;않은 MCI 잔액" Style="{StaticResource HeaderText}"/></Border>
                        <Border Grid.Row="0" Grid.Column="20" Style="{StaticResource HeaderCell}"><TextBlock Text="청구가능금액" Style="{StaticResource HeaderText}"/></Border>
                        <Border Grid.Row="0" Grid.Column="21" Style="{StaticResource HeaderCell}"><TextBlock Text="배당후 손실액" Style="{StaticResource HeaderText}"/></Border>
                        <Border Grid.Row="0" Grid.Column="22" Style="{StaticResource HeaderCell}"><TextBlock Text="MCI 청구액" Style="{StaticResource HeaderText}" FontWeight="Bold"/></Border>

                        <!-- Row 1: 데이터 -->
                        <Border Grid.Row="1" Grid.Column="0" Style="{StaticResource CellBorder}" Background="White"><TextBlock Text="{Binding MciData1.MciInitialAmount, StringFormat=N0}" Style="{StaticResource AmountText}"/></Border>
                        <Border Grid.Row="1" Grid.Column="1" Style="{StaticResource CellBorder}" Background="White"><TextBlock Text="{Binding MciData1.BondNumber}" Style="{StaticResource CenterText}"/></Border>
                        <Border Grid.Row="1" Grid.Column="2" Style="{StaticResource CellBorder}" Background="White"><TextBlock Text="{Binding MciData1.MciBalance, StringFormat=N0}" Style="{StaticResource AmountText}"/></Border>
                        <Border Grid.Row="1" Grid.Column="3" Style="{StaticResource CellBorder}" Background="White"><TextBlock Text="{Binding MciData1.LastInterestDate, StringFormat=yyyy-MM-dd}" Style="{StaticResource CenterText}"/></Border>
                        <Border Grid.Row="1" Grid.Column="4" Style="{StaticResource CellBorder}" Background="White"><TextBlock Text="{Binding MciData1.ExpectedDividendDate, StringFormat=yyyy-MM-dd}" Style="{StaticResource CenterText}"/></Border>
                        <Border Grid.Row="1" Grid.Column="5" Style="{StaticResource CellBorder}" Background="White"><TextBlock Text="{Binding MciData1.Days}" Style="{StaticResource CenterText}"/></Border>
                        <Border Grid.Row="1" Grid.Column="6" Style="{StaticResource CellBorder}" Background="White"><TextBlock Text="{Binding MciData1.NormalInterestRate, StringFormat=P2}" Style="{StaticResource CenterText}"/></Border>
                        <Border Grid.Row="1" Grid.Column="7" Style="{StaticResource CellBorder}" Background="White"><TextBlock Text="{Binding MciData1.TargetPrincipal, StringFormat=N0}" Style="{StaticResource AmountText}"/></Border>
                        <Border Grid.Row="1" Grid.Column="8" Style="{StaticResource CellBorder}" Background="White"><TextBlock Text="{Binding MciData1.ValidCollateralValue, StringFormat=N0}" Style="{StaticResource AmountText}"/></Border>
                        <Border Grid.Row="1" Grid.Column="9" Style="{StaticResource CellBorder}" Background="White"><TextBlock Text="{Binding MciData1.ValidCollateralInterest, StringFormat=N0}" Style="{StaticResource AmountText}"/></Border>
                        <Border Grid.Row="1" Grid.Column="10" Style="{StaticResource CellBorder}" Background="White"><TextBlock Text="{Binding MciData1.ValidCollateralInterestLimit, StringFormat=N0}" Style="{StaticResource AmountText}"/></Border>
                        <Border Grid.Row="1" Grid.Column="11" Style="{StaticResource CellBorder}" Background="White"><TextBlock Text="{Binding MciData1.ValidCollateralDividend, StringFormat=N0}" Style="{StaticResource AmountText}"/></Border>
                        <Border Grid.Row="1" Grid.Column="12" Style="{StaticResource CellBorder}" Background="White"><TextBlock Text="{Binding MciData1.BondBalance, StringFormat=N0}" Style="{StaticResource AmountText}"/></Border>
                        <Border Grid.Row="1" Grid.Column="13" Style="{StaticResource CellBorder}" Background="White"><TextBlock Text="{Binding MciData1.TargetPrincipalMinusMci, StringFormat=N0}" Style="{StaticResource AmountText}"/></Border>
                        <Border Grid.Row="1" Grid.Column="14" Style="{StaticResource CellBorder}" Background="White"><TextBlock Text="{Binding MciData1.AccruedPlusOverdue, StringFormat=N0}" Style="{StaticResource AmountText}"/></Border>
                        <Border Grid.Row="1" Grid.Column="15" Style="{StaticResource CellBorder}" Background="White"><TextBlock Text="{Binding MciData1.ValidCollateral20Percent, StringFormat=N0}" Style="{StaticResource AmountText}"/></Border>
                        <Border Grid.Row="1" Grid.Column="16" Style="{StaticResource CellBorder}" Background="White"><TextBlock Text="{Binding MciData1.ValidCollateralPlusInterestMax, StringFormat=N0}" Style="{StaticResource AmountText}"/></Border>
                        <Border Grid.Row="1" Grid.Column="17" Style="{StaticResource CellBorder}" Background="White"><TextBlock Text="{Binding MciData1.ExpectedDividend, StringFormat=N0}" Style="{StaticResource AmountText}"/></Border>
                        <Border Grid.Row="1" Grid.Column="18" Style="{StaticResource CellBorder}" Background="White"><TextBlock Text="{Binding MciData1.MciNormalInterest, StringFormat=N0}" Style="{StaticResource AmountText}"/></Border>
                        <Border Grid.Row="1" Grid.Column="19" Style="{StaticResource CellBorder}" Background="White"><TextBlock Text="{Binding MciData1.RemainingMciBalance, StringFormat=N0}" Style="{StaticResource AmountText}"/></Border>
                        <Border Grid.Row="1" Grid.Column="20" Style="{StaticResource CellBorder}" Background="White"><TextBlock Text="{Binding MciData1.ClaimableAmount, StringFormat=N0}" Style="{StaticResource AmountText}"/></Border>
                        <Border Grid.Row="1" Grid.Column="21" Style="{StaticResource CellBorder}" Background="White"><TextBlock Text="{Binding MciData1.PostDividendLoss, StringFormat=N0}" Style="{StaticResource AmountText}"/></Border>
                        <Border Grid.Row="1" Grid.Column="22" Style="{StaticResource CellBorder}" Background="White"><TextBlock Text="{Binding MciData1.MciClaimAmount, StringFormat=N0}" Style="{StaticResource AmountText}" FontWeight="Bold"/></Border>
                    </Grid>
                </ScrollViewer>
            </Border>

            <!-- ================================================================ -->
            <!-- 2안 서브헤더 -->
            <!-- ================================================================ -->
            <Border Background="#E8EAF6" Padding="12,7" Margin="0,12,0,0">
                <TextBlock Text="2안" FontWeight="Bold" FontSize="{StaticResource FontSizeSmall}" Foreground="{StaticResource PrimaryBrush}"/>
            </Border>

            <!-- 2안 표 -->
            <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="1,0,0,0">
                <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="90"/>
                            <ColumnDefinition Width="80"/>
                            <ColumnDefinition Width="90"/>
                            <ColumnDefinition Width="80"/>
                            <ColumnDefinition Width="80"/>
                            <ColumnDefinition Width="50"/>
                            <ColumnDefinition Width="65"/>
                            <ColumnDefinition Width="85"/>
                            <ColumnDefinition Width="85"/>
                            <ColumnDefinition Width="90"/>
                            <ColumnDefinition Width="90"/>
                            <ColumnDefinition Width="85"/>
                            <ColumnDefinition Width="85"/>
                            <ColumnDefinition Width="100"/>
                            <ColumnDefinition Width="105"/>
                            <ColumnDefinition Width="85"/>
                            <ColumnDefinition Width="120"/>
                            <ColumnDefinition Width="80"/>
                            <ColumnDefinition Width="85"/>
                            <ColumnDefinition Width="110"/>
                            <ColumnDefinition Width="85"/>
                            <ColumnDefinition Width="85"/>
                            <ColumnDefinition Width="80"/>
                        </Grid.ColumnDefinitions>

                        <!-- Row 0: 헤더 -->
                        <Border Grid.Row="0" Grid.Column="0" Style="{StaticResource HeaderCell}"><TextBlock Text="MCI최초&#x0a;가입금액" Style="{StaticResource HeaderText}"/></Border>
                        <Border Grid.Row="0" Grid.Column="1" Style="{StaticResource HeaderCell}"><TextBlock Text="채권번호" Style="{StaticResource HeaderText}"/></Border>
                        <Border Grid.Row="0" Grid.Column="2" Style="{StaticResource HeaderCell}"><TextBlock Text="MCI가입잔액" Style="{StaticResource HeaderText}"/></Border>
                        <Border Grid.Row="0" Grid.Column="3" Style="{StaticResource HeaderCell}"><TextBlock Text="최종이수일" Style="{StaticResource HeaderText}"/></Border>
                        <Border Grid.Row="0" Grid.Column="4" Style="{StaticResource HeaderCell}"><TextBlock Text="예상배당일" Style="{StaticResource HeaderText}"/></Border>
                        <Border Grid.Row="0" Grid.Column="5" Style="{StaticResource HeaderCell}"><TextBlock Text="일수" Style="{StaticResource HeaderText}"/></Border>
                        <Border Grid.Row="0" Grid.Column="6" Style="{StaticResource HeaderCell}"><TextBlock Text="정상이자율" Style="{StaticResource HeaderText}"/></Border>
                        <Border Grid.Row="0" Grid.Column="7" Style="{StaticResource HeaderCell}"><TextBlock Text="인수대상&#x0a;원금" Style="{StaticResource HeaderText}"/></Border>
                        <Border Grid.Row="0" Grid.Column="8" Style="{StaticResource HeaderCell}"><TextBlock Text="유효담보가" Style="{StaticResource HeaderText}"/></Border>
                        <Border Grid.Row="0" Grid.Column="9" Style="{StaticResource HeaderCell}"><TextBlock Text="유효담보가의&#x0a;이자" Style="{StaticResource HeaderText}"/></Border>
                        <Border Grid.Row="0" Grid.Column="10" Style="{StaticResource HeaderCell}"><TextBlock Text="유효담보가의&#x0a;이자한도" Style="{StaticResource HeaderText}"/></Border>
                        <Border Grid.Row="0" Grid.Column="11" Style="{StaticResource HeaderCell}"><TextBlock Text="유효담보가&#x0a;배당액" Style="{StaticResource HeaderText}"/></Border>
                        <Border Grid.Row="0" Grid.Column="12" Style="{StaticResource HeaderCell}"><TextBlock Text="채권잔액" Style="{StaticResource HeaderText}"/></Border>
                        <Border Grid.Row="0" Grid.Column="13" Style="{StaticResource HeaderCell}"><TextBlock Text="인수대상원금&#x0a;-MCI 가입잔액" Style="{StaticResource HeaderText}"/></Border>
                        <Border Grid.Row="0" Grid.Column="14" Style="{StaticResource HeaderCell}"><TextBlock Text="(미수이자+&#x0a;2안연체이자)" Style="{StaticResource HeaderText}"/></Border>
                        <Border Grid.Row="0" Grid.Column="15" Style="{StaticResource HeaderCell}"><TextBlock Text="유효담보가의&#x0a;20%" Style="{StaticResource HeaderText}"/></Border>
                        <Border Grid.Row="0" Grid.Column="16" Style="{StaticResource HeaderCell}"><TextBlock Text="유효담보가+유효담보가&#x0a;의 이자(Max 한도)" Style="{StaticResource HeaderText}"/></Border>
                        <Border Grid.Row="0" Grid.Column="17" Style="{StaticResource HeaderCell}"><TextBlock Text="예상배당금" Style="{StaticResource HeaderText}"/></Border>
                        <Border Grid.Row="0" Grid.Column="18" Style="{StaticResource HeaderCell}"><TextBlock Text="MCI 정상이자" Style="{StaticResource HeaderText}"/></Border>
                        <Border Grid.Row="0" Grid.Column="19" Style="{StaticResource HeaderCell}"><TextBlock Text="배당으로 충당되지&#x0a;않은 MCI 잔액" Style="{StaticResource HeaderText}"/></Border>
                        <Border Grid.Row="0" Grid.Column="20" Style="{StaticResource HeaderCell}"><TextBlock Text="청구가능금액" Style="{StaticResource HeaderText}"/></Border>
                        <Border Grid.Row="0" Grid.Column="21" Style="{StaticResource HeaderCell}"><TextBlock Text="배당후 손실액" Style="{StaticResource HeaderText}"/></Border>
                        <Border Grid.Row="0" Grid.Column="22" Style="{StaticResource HeaderCell}"><TextBlock Text="MCI 청구액" Style="{StaticResource HeaderText}" FontWeight="Bold"/></Border>

                        <!-- Row 1: 데이터 -->
                        <Border Grid.Row="1" Grid.Column="0" Style="{StaticResource CellBorder}" Background="White"><TextBlock Text="{Binding MciData2.MciInitialAmount, StringFormat=N0}" Style="{StaticResource AmountText}"/></Border>
                        <Border Grid.Row="1" Grid.Column="1" Style="{StaticResource CellBorder}" Background="White"><TextBlock Text="{Binding MciData2.BondNumber}" Style="{StaticResource CenterText}"/></Border>
                        <Border Grid.Row="1" Grid.Column="2" Style="{StaticResource CellBorder}" Background="White"><TextBlock Text="{Binding MciData2.MciBalance, StringFormat=N0}" Style="{StaticResource AmountText}"/></Border>
                        <Border Grid.Row="1" Grid.Column="3" Style="{StaticResource CellBorder}" Background="White"><TextBlock Text="{Binding MciData2.LastInterestDate, StringFormat=yyyy-MM-dd}" Style="{StaticResource CenterText}"/></Border>
                        <Border Grid.Row="1" Grid.Column="4" Style="{StaticResource CellBorder}" Background="White"><TextBlock Text="{Binding MciData2.ExpectedDividendDate, StringFormat=yyyy-MM-dd}" Style="{StaticResource CenterText}"/></Border>
                        <Border Grid.Row="1" Grid.Column="5" Style="{StaticResource CellBorder}" Background="White"><TextBlock Text="{Binding MciData2.Days}" Style="{StaticResource CenterText}"/></Border>
                        <Border Grid.Row="1" Grid.Column="6" Style="{StaticResource CellBorder}" Background="White"><TextBlock Text="{Binding MciData2.NormalInterestRate, StringFormat=P2}" Style="{StaticResource CenterText}"/></Border>
                        <Border Grid.Row="1" Grid.Column="7" Style="{StaticResource CellBorder}" Background="White"><TextBlock Text="{Binding MciData2.TargetPrincipal, StringFormat=N0}" Style="{StaticResource AmountText}"/></Border>
                        <Border Grid.Row="1" Grid.Column="8" Style="{StaticResource CellBorder}" Background="White"><TextBlock Text="{Binding MciData2.ValidCollateralValue, StringFormat=N0}" Style="{StaticResource AmountText}"/></Border>
                        <Border Grid.Row="1" Grid.Column="9" Style="{StaticResource CellBorder}" Background="White"><TextBlock Text="{Binding MciData2.ValidCollateralInterest, StringFormat=N0}" Style="{StaticResource AmountText}"/></Border>
                        <Border Grid.Row="1" Grid.Column="10" Style="{StaticResource CellBorder}" Background="White"><TextBlock Text="{Binding MciData2.ValidCollateralInterestLimit, StringFormat=N0}" Style="{StaticResource AmountText}"/></Border>
                        <Border Grid.Row="1" Grid.Column="11" Style="{StaticResource CellBorder}" Background="White"><TextBlock Text="{Binding MciData2.ValidCollateralDividend, StringFormat=N0}" Style="{StaticResource AmountText}"/></Border>
                        <Border Grid.Row="1" Grid.Column="12" Style="{StaticResource CellBorder}" Background="White"><TextBlock Text="{Binding MciData2.BondBalance, StringFormat=N0}" Style="{StaticResource AmountText}"/></Border>
                        <Border Grid.Row="1" Grid.Column="13" Style="{StaticResource CellBorder}" Background="White"><TextBlock Text="{Binding MciData2.TargetPrincipalMinusMci, StringFormat=N0}" Style="{StaticResource AmountText}"/></Border>
                        <Border Grid.Row="1" Grid.Column="14" Style="{StaticResource CellBorder}" Background="White"><TextBlock Text="{Binding MciData2.AccruedPlusOverdue, StringFormat=N0}" Style="{StaticResource AmountText}"/></Border>
                        <Border Grid.Row="1" Grid.Column="15" Style="{StaticResource CellBorder}" Background="White"><TextBlock Text="{Binding MciData2.ValidCollateral20Percent, StringFormat=N0}" Style="{StaticResource AmountText}"/></Border>
                        <Border Grid.Row="1" Grid.Column="16" Style="{StaticResource CellBorder}" Background="White"><TextBlock Text="{Binding MciData2.ValidCollateralPlusInterestMax, StringFormat=N0}" Style="{StaticResource AmountText}"/></Border>
                        <Border Grid.Row="1" Grid.Column="17" Style="{StaticResource CellBorder}" Background="White"><TextBlock Text="{Binding MciData2.ExpectedDividend, StringFormat=N0}" Style="{StaticResource AmountText}"/></Border>
                        <Border Grid.Row="1" Grid.Column="18" Style="{StaticResource CellBorder}" Background="White"><TextBlock Text="{Binding MciData2.MciNormalInterest, StringFormat=N0}" Style="{StaticResource AmountText}"/></Border>
                        <Border Grid.Row="1" Grid.Column="19" Style="{StaticResource CellBorder}" Background="White"><TextBlock Text="{Binding MciData2.RemainingMciBalance, StringFormat=N0}" Style="{StaticResource AmountText}"/></Border>
                        <Border Grid.Row="1" Grid.Column="20" Style="{StaticResource CellBorder}" Background="White"><TextBlock Text="{Binding MciData2.ClaimableAmount, StringFormat=N0}" Style="{StaticResource AmountText}"/></Border>
                        <Border Grid.Row="1" Grid.Column="21" Style="{StaticResource CellBorder}" Background="White"><TextBlock Text="{Binding MciData2.PostDividendLoss, StringFormat=N0}" Style="{StaticResource AmountText}"/></Border>
                        <Border Grid.Row="1" Grid.Column="22" Style="{StaticResource CellBorder}" Background="White"><TextBlock Text="{Binding MciData2.MciClaimAmount, StringFormat=N0}" Style="{StaticResource AmountText}" FontWeight="Bold"/></Border>
                    </Grid>
                </ScrollViewer>
            </Border>

        </StackPanel>
    </Border>
</UserControl>
