<UserControl x:Class="NPLogic.Views.RightsAnalysisTab"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:vm="clr-namespace:NPLogic.ViewModels"
             xmlns:controls="clr-namespace:NPLogic.Controls;assembly=NPLogic.UI"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             mc:Ignorable="d"
             d:DesignHeight="1200" d:DesignWidth="1400"
             d:DataContext="{d:DesignInstance Type=vm:RightsAnalysisTabViewModel}"
             Loaded="RightsAnalysisTab_Loaded">
    
    <UserControl.Resources>
        <!-- 위험도 색상 -->
        <SolidColorBrush x:Key="RiskHighBrush" Color="#EF4444"/>
        <SolidColorBrush x:Key="RiskMediumBrush" Color="#F59E0B"/>
        <SolidColorBrush x:Key="RiskLowBrush" Color="#10B981"/>
        
        <!-- 섹션 카드 스타일 -->
        <Style x:Key="SectionCardStyle" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource BackgroundBrush}"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Margin" Value="0,0,0,16"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect Color="Black" Opacity="0.1" BlurRadius="10" ShadowDepth="2"/>
                </Setter.Value>
            </Setter>
        </Style>
        
        <!-- 섹션 헤더 스타일 -->
        <Style x:Key="SectionHeaderStyle" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource BlueGray100Brush}"/>
            <Setter Property="Padding" Value="16,12"/>
        </Style>
        
        <!-- 체크박스 스타일 -->
        <Style x:Key="AnalysisCheckBoxStyle" TargetType="CheckBox" BasedOn="{StaticResource {x:Type CheckBox}}">
            <Setter Property="Margin" Value="0,6"/>
            <Setter Property="FontSize" Value="{StaticResource FontSizeBody}"/>
        </Style>
        
        <!-- 필드 라벨 스타일 -->
        <Style x:Key="FieldLabelStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="{StaticResource FontSizeBody}"/>
            <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
            <Setter Property="Margin" Value="0,0,0,4"/>
        </Style>
        
        <!-- 필드 값 스타일 -->
        <Style x:Key="FieldValueStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="{StaticResource FontSizeH4}"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
            <Setter Property="FontWeight" Value="Medium"/>
        </Style>

        <!-- 날짜 입력 DatePicker 스타일 (보라색 계열 배경) -->
        <Style x:Key="DateInputPickerStyle" TargetType="DatePicker">
            <Setter Property="Background" Value="{StaticResource DateInputBgBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource DateInputBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontSize" Value="{StaticResource FontSizeSmall}"/>
            <Setter Property="Padding" Value="2,1"/>
            <Setter Property="Height" Value="24"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="DatePicker">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="2">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <DatePickerTextBox x:Name="PART_TextBox"
                                                   Grid.Column="0"
                                                   Background="Transparent"
                                                   BorderThickness="0"
                                                   Padding="{TemplateBinding Padding}"
                                                   VerticalAlignment="Center"
                                                   VerticalContentAlignment="Center"
                                                   Focusable="{TemplateBinding Focusable}"/>
                                <Button x:Name="PART_Button"
                                        Grid.Column="1"
                                        Width="20"
                                        Focusable="False"
                                        Background="Transparent"
                                        BorderThickness="0"
                                        VerticalAlignment="Center"
                                        HorizontalAlignment="Center"
                                        Padding="2">
                                    <Path Data="M0,0 L0,6 L6,6 L6,0 z M1,1 L1,2 L2,2 L2,1 z M3,1 L3,2 L4,2 L4,1 z M1,3 L1,4 L2,4 L2,3 z M3,3 L3,4 L4,4 L4,3 z"
                                          Fill="#666666"
                                          Width="10"
                                          Height="10"
                                          Stretch="Uniform"/>
                                </Button>
                                <Popup x:Name="PART_Popup"
                                       AllowsTransparency="True"
                                       Placement="Bottom"
                                       PlacementTarget="{Binding ElementName=PART_TextBox}"
                                       StaysOpen="False"/>
                            </Grid>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>

    <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <Grid Margin="24">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="24"/>
                <ColumnDefinition Width="380"/>
            </Grid.ColumnDefinitions>
            
            <!-- ========== 좌측: 메인 컨텐츠 ========== -->
            <StackPanel Grid.Column="0">
                
                <!-- 에러/성공 메시지 -->
                <Border Background="{StaticResource ErrorBrush}"
                        CornerRadius="4"
                        Padding="12"
                        Margin="0,0,0,16"
                        Visibility="{Binding ErrorMessage, Converter={StaticResource NullToVisibilityConverter}}">
                    <TextBlock Text="{Binding ErrorMessage}" 
                               Foreground="White"
                               TextWrapping="Wrap"/>
                </Border>

                <Border Background="{StaticResource SuccessBrush}"
                        CornerRadius="4"
                        Padding="12"
                        Margin="0,0,0,16"
                        Visibility="{Binding SuccessMessage, Converter={StaticResource NullToVisibilityConverter}}">
                    <TextBlock Text="{Binding SuccessMessage}" 
                               Foreground="White"
                               TextWrapping="Wrap"/>
                </Border>
                
                <!-- ===== 1. 경매사건 정보 ===== -->
                <Border Style="{StaticResource SectionCardStyle}">
                    <StackPanel>
                        <Border Style="{StaticResource SectionHeaderStyle}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="📊" FontSize="{StaticResource FontSizeH3}" Margin="0,0,8,0"/>
                                    <TextBlock Text="경매사건 정보" Style="{StaticResource H4TextStyle}"/>
                                </StackPanel>
                                <Button Grid.Column="1" 
                                        Content="경매사건검색" 
                                        Command="{Binding OpenAuctionSearchCommand}"
                                        Style="{StaticResource SecondaryButton}"
                                        Padding="12,4"
                                        FontSize="{StaticResource FontSizeBody}"/>
                            </Grid>
                        </Border>
                        
                        <Grid Margin="16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            
                            <!-- Row 1: 경매개시여부, 선행/후행 -->
                            <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,16,16">
                                <TextBlock Text="경매개시여부" Style="{StaticResource FieldLabelStyle}"/>
                                <ComboBox SelectedValue="{Binding Analysis.AuctionStatus, Mode=TwoWay}"
                                          SelectedValuePath="Tag"
                                          Width="140">
                                    <ComboBoxItem Content="경매개시" Tag="opened"/>
                                    <ComboBoxItem Content="경매미개시" Tag="not_opened"/>
                                </ComboBox>
                            </StackPanel>
                            
                            <StackPanel Grid.Row="0" Grid.Column="1" Margin="0,0,16,16">
                                <TextBlock Text="선행/후행" Style="{StaticResource FieldLabelStyle}"/>
                                <StackPanel Orientation="Horizontal">
                                    <CheckBox Content="선행" 
                                              IsChecked="{Binding Analysis.PrecedentAuction}"
                                              Style="{StaticResource AnalysisCheckBoxStyle}"
                                              Margin="0,0,16,0"/>
                                    <CheckBox Content="후행" 
                                              IsChecked="{Binding Analysis.SubsequentAuction}"
                                              Style="{StaticResource AnalysisCheckBoxStyle}"/>
                                </StackPanel>
                            </StackPanel>
                            
                            <StackPanel Grid.Row="0" Grid.Column="2" Margin="0,0,16,16">
                                <TextBlock Text="관할법원" Style="{StaticResource FieldLabelStyle}"/>
                                <TextBox Text="{Binding Analysis.CourtName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                         Style="{StaticResource {x:Type TextBox}}"/>
                            </StackPanel>
                            
                            <StackPanel Grid.Row="0" Grid.Column="3" Margin="0,0,0,16">
                                <TextBlock Text="경매사건번호" Style="{StaticResource FieldLabelStyle}"/>
                                <TextBox Text="{Binding Analysis.CaseNumber, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                         Style="{StaticResource {x:Type TextBox}}"/>
                            </StackPanel>
                            
                            <!-- Row 2: 경매신청기관, 경매개시일자, 배당요구종기일, 청구금액 -->
                            <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,0,16,16">
                                <TextBlock Text="경매신청기관" Style="{StaticResource FieldLabelStyle}"/>
                                <TextBox Text="{Binding Analysis.AuctionApplicant, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                         Style="{StaticResource {x:Type TextBox}}"/>
                            </StackPanel>
                            
                            <StackPanel Grid.Row="1" Grid.Column="1" Margin="0,0,16,16">
                                <TextBlock Text="경매개시일자" Style="{StaticResource FieldLabelStyle}"/>
                                <DatePicker SelectedDate="{Binding Analysis.AuctionStartDate, Mode=TwoWay}" Style="{StaticResource DateInputPickerStyle}"/>
                            </StackPanel>
                            
                            <StackPanel Grid.Row="1" Grid.Column="2" Margin="0,0,16,16">
                                <TextBlock Text="배당요구종기일" Style="{StaticResource FieldLabelStyle}"/>
                                <DatePicker SelectedDate="{Binding Analysis.ClaimDeadlineDate, Mode=TwoWay}" Style="{StaticResource DateInputPickerStyle}"/>
                            </StackPanel>
                            
                            <StackPanel Grid.Row="1" Grid.Column="3" Margin="0,0,0,16">
                                <TextBlock Text="청구금액" Style="{StaticResource FieldLabelStyle}"/>
                                <TextBox Text="{Binding Analysis.ClaimAmount, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, StringFormat=N0}"
                                         Style="{StaticResource {x:Type TextBox}}"/>
                            </StackPanel>
                            
                            <!-- Row 3: 최초법사가, 최초경매기일, 최종회차, 최종경매기일 -->
                            <StackPanel Grid.Row="2" Grid.Column="0" Margin="0,0,16,16">
                                <TextBlock Text="최초법사가 (감정가)" Style="{StaticResource FieldLabelStyle}"/>
                                <TextBox Text="{Binding Analysis.InitialAppraisalValue, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, StringFormat=N0}"
                                         Style="{StaticResource {x:Type TextBox}}"/>
                            </StackPanel>
                            
                            <StackPanel Grid.Row="2" Grid.Column="1" Margin="0,0,16,16">
                                <TextBlock Text="최초경매기일" Style="{StaticResource FieldLabelStyle}"/>
                                <DatePicker SelectedDate="{Binding Analysis.InitialAuctionDate, Mode=TwoWay}" Style="{StaticResource DateInputPickerStyle}"/>
                            </StackPanel>
                            
                            <StackPanel Grid.Row="2" Grid.Column="2" Margin="0,0,16,16">
                                <TextBlock Text="최종경매회차" Style="{StaticResource FieldLabelStyle}"/>
                                <TextBox Text="{Binding Analysis.FinalAuctionRound, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                         Style="{StaticResource {x:Type TextBox}}"/>
                            </StackPanel>
                            
                            <StackPanel Grid.Row="2" Grid.Column="3" Margin="0,0,0,16">
                                <TextBlock Text="최종경매결과" Style="{StaticResource FieldLabelStyle}"/>
                                <TextBox Text="{Binding Analysis.FinalAuctionResult, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                         Style="{StaticResource {x:Type TextBox}}"/>
                            </StackPanel>
                            
                            <!-- Row 4: 낙찰금액, 차후예정일, 차후최저입찰가, 배당요구종기경과 -->
                            <StackPanel Grid.Row="3" Grid.Column="0" Margin="0,0,16,0">
                                <TextBlock Text="낙찰금액" Style="{StaticResource FieldLabelStyle}"/>
                                <TextBox Text="{Binding Analysis.WinningBidAmount, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, StringFormat=N0}"
                                         Style="{StaticResource {x:Type TextBox}}"/>
                            </StackPanel>
                            
                            <StackPanel Grid.Row="3" Grid.Column="1" Margin="0,0,16,0">
                                <TextBlock Text="차후예정경매일" Style="{StaticResource FieldLabelStyle}"/>
                                <DatePicker SelectedDate="{Binding Analysis.NextAuctionDate, Mode=TwoWay}" Style="{StaticResource DateInputPickerStyle}"/>
                            </StackPanel>
                            
                            <StackPanel Grid.Row="3" Grid.Column="2" Margin="0,0,16,0">
                                <TextBlock Text="차후최저입찰가" Style="{StaticResource FieldLabelStyle}"/>
                                <TextBox Text="{Binding Analysis.NextMinimumBid, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, StringFormat=N0}"
                                         Style="{StaticResource {x:Type TextBox}}"/>
                            </StackPanel>
                            
                            <StackPanel Grid.Row="3" Grid.Column="3" Margin="0,0,0,0">
                                <TextBlock Text="배당요구종기일 경과" Style="{StaticResource FieldLabelStyle}"/>
                                <CheckBox IsChecked="{Binding Analysis.ClaimDeadlinePassed}"
                                          Content="경과"
                                          Style="{StaticResource AnalysisCheckBoxStyle}"/>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>
                
                <!-- ===== 2. 전입/임차 현황 체크리스트 ===== -->
                <Border Style="{StaticResource SectionCardStyle}">
                    <StackPanel>
                        <Border Style="{StaticResource SectionHeaderStyle}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="🏠" FontSize="{StaticResource FontSizeH3}" Margin="0,0,8,0"/>
                                    <TextBlock Text="전입/임차 현황" Style="{StaticResource H4TextStyle}"/>
                                </StackPanel>
                                <StackPanel Grid.Column="1" Orientation="Horizontal">
                                    <Button Content="주택공시가격 조회" 
                                            Command="{Binding OpenHousingPriceCommand}"
                                            Style="{StaticResource SecondaryButton}"
                                            Padding="12,4"
                                            FontSize="{StaticResource FontSizeBody}"
                                            Margin="0,0,8,0"/>
                                    <Button Content="공시지가 조회" 
                                            Command="{Binding OpenLandPriceCommand}"
                                            Style="{StaticResource SecondaryButton}"
                                            Padding="12,4"
                                            FontSize="{StaticResource FontSizeBody}"/>
                                </StackPanel>
                            </Grid>
                        </Border>
                        
                        <Grid Margin="16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            
                            <!-- Row 1 -->
                            <CheckBox Grid.Row="0" Grid.Column="0" 
                                      Content="물건지, 소유주 주소지 일치" 
                                      IsChecked="{Binding Analysis.AddressMatch}"
                                      Style="{StaticResource AnalysisCheckBoxStyle}"/>
                            <CheckBox Grid.Row="0" Grid.Column="1" 
                                      Content="소유주 전입" 
                                      IsChecked="{Binding Analysis.OwnerRegistered}"
                                      Style="{StaticResource AnalysisCheckBoxStyle}"/>
                            <CheckBox Grid.Row="0" Grid.Column="2" 
                                      Content="임차인 존재" 
                                      IsChecked="{Binding Analysis.HasTenant}"
                                      Style="{StaticResource AnalysisCheckBoxStyle}"/>
                            
                            <!-- Row 2 -->
                            <CheckBox Grid.Row="1" Grid.Column="0" 
                                      Content="현황조사서 제출" 
                                      IsChecked="{Binding Analysis.SurveyReportSubmitted}"
                                      Style="{StaticResource AnalysisCheckBoxStyle}"/>
                            <CheckBox Grid.Row="1" Grid.Column="1" 
                                      Content="전입세대열람 보유" 
                                      IsChecked="{Binding Analysis.HasTenantRegistry}"
                                      Style="{StaticResource AnalysisCheckBoxStyle}"/>
                            <CheckBox Grid.Row="1" Grid.Column="2" 
                                      Content="상가임대차열람 보유" 
                                      IsChecked="{Binding Analysis.HasCommercialLease}"
                                      Style="{StaticResource AnalysisCheckBoxStyle}"/>
                            
                            <!-- Row 3 -->
                            <CheckBox Grid.Row="2" Grid.Column="0" 
                                      Content="임차인 배당요구신청" 
                                      IsChecked="{Binding Analysis.TenantClaimSubmitted}"
                                      Style="{StaticResource AnalysisCheckBoxStyle}"/>
                            <CheckBox Grid.Row="2" Grid.Column="1" 
                                      Content="임차일 근저당설정일 이전" 
                                      IsChecked="{Binding Analysis.TenantDateBeforeMortgage}"
                                      Style="{StaticResource AnalysisCheckBoxStyle}"/>
                            <CheckBox Grid.Row="2" Grid.Column="2" 
                                      Content="경매열람자료 보유" 
                                      IsChecked="{Binding Analysis.HasAuctionDocs}"
                                      Style="{StaticResource AnalysisCheckBoxStyle}"/>
                            
                            <!-- Row 4: 임차인 정보 -->
                            <StackPanel Grid.Row="3" Grid.Column="0" Margin="0,12,16,0">
                                <TextBlock Text="전입인(임차인)" Style="{StaticResource FieldLabelStyle}"/>
                                <TextBox Text="{Binding Analysis.TenantName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                         Style="{StaticResource {x:Type TextBox}}"/>
                            </StackPanel>
                            
                            <StackPanel Grid.Row="3" Grid.Column="1" Margin="0,12,16,0">
                                <TextBlock Text="전입일(임차시작일)" Style="{StaticResource FieldLabelStyle}"/>
                                <DatePicker SelectedDate="{Binding Analysis.TenantMoveInDate, Mode=TwoWay}" Style="{StaticResource DateInputPickerStyle}"/>
                            </StackPanel>
                            
                            <StackPanel Grid.Row="3" Grid.Column="2" Margin="0,12,0,0">
                                <TextBlock Text="주택공시가격" Style="{StaticResource FieldLabelStyle}"/>
                                <TextBox Text="{Binding Analysis.HousingOfficialPrice, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, StringFormat=N0}"
                                         Style="{StaticResource {x:Type TextBox}}"/>
                            </StackPanel>
                        </Grid>
                        
                        <!-- 채무자 유형 & 임금채권/조세 -->
                        <Border BorderBrush="{StaticResource BlueGray200Brush}" BorderThickness="0,1,0,0">
                            <Grid Margin="16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                
                                <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,16,12">
                                    <TextBlock Text="채무자 유형" Style="{StaticResource FieldLabelStyle}"/>
                                    <ComboBox SelectedValue="{Binding Analysis.DebtorType, Mode=TwoWay}"
                                              SelectedValuePath="Tag">
                                        <ComboBoxItem Content="개인" Tag="individual"/>
                                        <ComboBoxItem Content="개인사업자" Tag="business"/>
                                        <ComboBoxItem Content="법인" Tag="corporation"/>
                                    </ComboBox>
                                </StackPanel>
                                
                                <CheckBox Grid.Row="0" Grid.Column="1" 
                                          Content="임금채권 존재" 
                                          IsChecked="{Binding Analysis.HasWageClaim}"
                                          Style="{StaticResource AnalysisCheckBoxStyle}"/>
                                <CheckBox Grid.Row="0" Grid.Column="2" 
                                          Content="임금채권 배당요구신청" 
                                          IsChecked="{Binding Analysis.WageClaimSubmitted}"
                                          Style="{StaticResource AnalysisCheckBoxStyle}"/>
                                
                                <CheckBox Grid.Row="1" Grid.Column="0" 
                                          Content="임금채권 추정가압류" 
                                          IsChecked="{Binding Analysis.WageClaimEstimatedSeizure}"
                                          Style="{StaticResource AnalysisCheckBoxStyle}"/>
                                <CheckBox Grid.Row="1" Grid.Column="1" 
                                          Content="당해세 교부청구" 
                                          IsChecked="{Binding Analysis.HasTaxClaim}"
                                          Style="{StaticResource AnalysisCheckBoxStyle}"/>
                                <CheckBox Grid.Row="1" Grid.Column="2" 
                                          Content="선순위조세 교부청구" 
                                          IsChecked="{Binding Analysis.HasSeniorTaxClaim}"
                                          Style="{StaticResource AnalysisCheckBoxStyle}"/>
                            </Grid>
                        </Border>
                    </StackPanel>
                </Border>
                
                <!-- ===== 3. 선순위 분석 (간소화) ===== -->
                <Border Style="{StaticResource SectionCardStyle}">
                    <StackPanel>
                        <Border Style="{StaticResource SectionHeaderStyle}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="📋" FontSize="{StaticResource FontSizeH3}" Margin="0,0,8,0"/>
                                    <TextBlock Text="선순위 분석" Style="{StaticResource H4TextStyle}"/>
                                </StackPanel>
                                <Button Grid.Column="1"
                                        Content="📊 선순위 분석 열기" 
                                        Command="{Binding OpenSeniorRightsCommand}"
                                        Style="{StaticResource PrimaryButton}"
                                        Padding="16,8"
                                        FontSize="{StaticResource FontSizeBody}"
                                        ToolTip="선순위 관리 화면을 열어 세부 분석을 진행합니다"/>
                            </Grid>
                        </Border>
                        
                        <!-- 선순위 합계 요약 -->
                        <Grid Margin="16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="선순위 합계" 
                                           Style="{StaticResource FieldLabelStyle}"
                                           Margin="0,0,0,4"/>
                                <TextBlock FontSize="{StaticResource FontSizeXLarge}" FontWeight="Bold" Foreground="{StaticResource PrimaryBrush}">
                                    <Run Text="{Binding TotalReflectedAmount, StringFormat=N0, Mode=OneWay}"/>
                                    <Run Text="원" FontSize="{StaticResource FontSizeH4}" FontWeight="Normal"/>
                                </TextBlock>
                                <TextBlock Text="선순위 관리에서 상세 내역을 확인하세요"
                                           FontSize="{StaticResource FontSizeBody}"
                                           Opacity="0.6"
                                           Margin="0,4,0,0"/>
                            </StackPanel>
                            
                            <Button Grid.Column="1"
                                    Content="새로고침"
                                    Command="{Binding RefreshSeniorRightsCommand}"
                                    Style="{StaticResource SecondaryButton}"
                                    Padding="12,6"
                                    VerticalAlignment="Center"
                                    ToolTip="선순위 데이터를 다시 불러옵니다"/>
                        </Grid>
                    </StackPanel>
                </Border>
                
                <!-- ===== 저장/액션 버튼 ===== -->
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
                    <Button Content="자동 계산" 
                            Command="{Binding AutoCalculateCommand}"
                            Style="{StaticResource SecondaryButton}"
                            Padding="24,10"
                            Margin="0,0,8,0"/>
                    <Button Content="저장"
                            Command="{Binding SaveCommand}"
                            Style="{StaticResource PrimaryButton}"
                            Padding="24,10"/>
                    <Button Command="{Binding ToggleNotePanelCommand}"
                            Style="{StaticResource MaterialDesignIconButton}"
                            ToolTip="비고 패널 열기/닫기"
                            Width="32" Height="32" Padding="0" Margin="8,0,0,0">
                        <materialDesign:PackIcon Kind="NoteEdit" Width="18" Height="18"/>
                    </Button>
                </StackPanel>
                
            </StackPanel>
            
            <!-- ========== 우측: 배당 시뮬레이션 & 위험도 ========== -->
            <StackPanel Grid.Column="2">
                
                <!-- ===== 배당 시뮬레이션 ===== -->
                <Border Style="{StaticResource SectionCardStyle}">
                    <StackPanel>
                        <Border Style="{StaticResource SectionHeaderStyle}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="💰" FontSize="{StaticResource FontSizeH3}" Margin="0,0,8,0"/>
                                <TextBlock Text="배당 시뮬레이션" Style="{StaticResource H4TextStyle}"/>
                            </StackPanel>
                        </Border>
                        
                        <StackPanel Margin="16">
                            <!-- 예상낙찰가 -->
                            <Border Background="{StaticResource BlueGray50Brush}" 
                                    CornerRadius="4" 
                                    Padding="12" 
                                    Margin="0,0,0,12">
                                <StackPanel>
                                    <TextBlock Text="예상낙찰가"
                                               FontSize="{StaticResource FontSizeBody}"
                                               Foreground="{StaticResource TextSecondaryBrush}"/>
                                    <TextBox Text="{Binding Analysis.ExpectedWinningBid, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, StringFormat=N0}"
                                             FontSize="{StaticResource FontSizeLarge}"
                                             FontWeight="Bold"
                                             BorderThickness="0"
                                             Background="Transparent"
                                             Margin="0,4,0,0"/>
                                </StackPanel>
                            </Border>
                            
                            <!-- 계산 단계 -->
                            <StackPanel Margin="0,0,0,8">
                                <Grid Margin="0,4">
                                    <TextBlock Text="(-) 경매수수료" Style="{StaticResource FieldLabelStyle}"/>
                                    <TextBlock Text="{Binding Analysis.AuctionFees, StringFormat=N0}" 
                                               HorizontalAlignment="Right"
                                               Style="{StaticResource FieldValueStyle}"/>
                                </Grid>
                                <Grid Margin="0,4">
                                    <TextBlock Text="= 배당가능재원" Style="{StaticResource FieldLabelStyle}"/>
                                    <TextBlock Text="{Binding Analysis.DistributableAmount, StringFormat=N0}" 
                                               HorizontalAlignment="Right"
                                               Style="{StaticResource FieldValueStyle}"/>
                                </Grid>
                                <Grid Margin="0,4">
                                    <TextBlock Text="(-) 선순위 합계" Style="{StaticResource FieldLabelStyle}"/>
                                    <TextBlock Text="{Binding TotalReflectedAmount, StringFormat=N0}" 
                                               HorizontalAlignment="Right"
                                               Style="{StaticResource FieldValueStyle}"
                                               Foreground="{StaticResource ErrorBrush}"/>
                                </Grid>
                            </StackPanel>
                            
                            <Border BorderBrush="{StaticResource BlueGray200Brush}" 
                                    BorderThickness="0,1,0,0" 
                                    Padding="0,12,0,0"
                                    Margin="0,8,0,0">
                                <StackPanel>
                                    <Grid Margin="0,4">
                                        <TextBlock Text="= 선순위 공제 후" FontWeight="SemiBold"/>
                                        <TextBlock Text="{Binding Analysis.AmountAfterSenior, StringFormat=N0}" 
                                                   HorizontalAlignment="Right"
                                                   FontWeight="Bold"
                                                   FontSize="{StaticResource FontSizeH3}"/>
                                    </Grid>
                                    
                                    <Grid Margin="0,8">
                                        <TextBlock Text="Loan Cap" Style="{StaticResource FieldLabelStyle}"/>
                                        <TextBox Text="{Binding Analysis.LoanCap, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, StringFormat=N0}"
                                                 HorizontalAlignment="Right"
                                                 Width="120"
                                                 TextAlignment="Right"/>
                                    </Grid>
                                    
                                    <Border Background="{StaticResource SuccessLightBrush}" 
                                            CornerRadius="4" 
                                            Padding="12" 
                                            Margin="0,8,0,0">
                                        <StackPanel>
                                            <TextBlock Text="Cap 반영 배당액"
                                                       FontSize="{StaticResource FontSizeBody}"
                                                       Foreground="{StaticResource TextSecondaryBrush}"/>
                                            <TextBlock Text="{Binding Analysis.CapAppliedDividend, StringFormat=N0}" 
                                                       FontSize="{StaticResource FontSizeH1}"
                                                       FontWeight="Bold"
                                                       Foreground="{StaticResource SuccessBrush}"
                                                       Margin="0,4,0,0"/>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </Border>
                            
                            <!-- 회수율 -->
                            <Border Background="{StaticResource PrimaryLightBrush}" 
                                    CornerRadius="4" 
                                    Padding="12" 
                                    Margin="0,12,0,0">
                                <Grid>
                                    <TextBlock Text="예상 회수율" 
                                               FontSize="{StaticResource FontSizeH4}" 
                                               FontWeight="SemiBold"/>
                                    <TextBlock HorizontalAlignment="Right">
                                        <Run Text="{Binding Analysis.RecoveryRate, StringFormat=N1, Mode=OneWay}"
                                             FontSize="{StaticResource FontSizeXXLarge}"
                                             FontWeight="Bold"
                                             Foreground="{StaticResource PrimaryBrush}"/>
                                        <Run Text="%"
                                             FontSize="{StaticResource FontSizeH3}"
                                             Foreground="{StaticResource PrimaryBrush}"/>
                                    </TextBlock>
                                </Grid>
                            </Border>
                        </StackPanel>
                    </StackPanel>
                </Border>
                
                <!-- ===== 위험도 평가 ===== -->
                <Border Style="{StaticResource SectionCardStyle}">
                    <StackPanel>
                        <Border Style="{StaticResource SectionHeaderStyle}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="⚠️" FontSize="{StaticResource FontSizeH3}" Margin="0,0,8,0"/>
                                <TextBlock Text="위험도 평가" Style="{StaticResource H4TextStyle}"/>
                            </StackPanel>
                        </Border>
                        
                        <StackPanel Margin="16">
                            <!-- 위험도 평가 설명 -->
                            <Border Background="{StaticResource BlueGray50Brush}" 
                                    CornerRadius="4" 
                                    Padding="10" 
                                    Margin="0,0,0,12">
                                <TextBlock TextWrapping="Wrap"
                                           FontSize="{StaticResource FontSizeSmall}"
                                           Foreground="{StaticResource TextSecondaryBrush}">
                                    <Run FontWeight="SemiBold">위험도 평가란?</Run>
                                    <LineBreak/>
                                    예상 회수율을 기반으로 투자 위험도를 자동 분석합니다.
                                    <LineBreak/>
                                    • 🟢 낮음: 회수율 80% 이상
                                    <LineBreak/>
                                    • 🟡 중간: 회수율 50~80%
                                    <LineBreak/>
                                    • 🔴 높음: 회수율 50% 미만
                                </TextBlock>
                            </Border>
                            
                            <!-- 위험도 레벨 -->
                            <Border x:Name="RiskLevelBorder"
                                    CornerRadius="8" 
                                    Padding="16" 
                                    Margin="0,0,0,16">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Background" Value="{StaticResource BlueGray100Brush}"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Analysis.RiskLevel}" Value="high">
                                                <Setter Property="Background" Value="#FEE2E2"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding Analysis.RiskLevel}" Value="medium">
                                                <Setter Property="Background" Value="#FEF3C7"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding Analysis.RiskLevel}" Value="low">
                                                <Setter Property="Background" Value="#D1FAE5"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <StackPanel HorizontalAlignment="Center">
                                    <TextBlock x:Name="RiskIcon" 
                                               FontSize="{StaticResource FontSizeXXLarge}" 
                                               HorizontalAlignment="Center">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Text" Value="❓"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Analysis.RiskLevel}" Value="high">
                                                        <Setter Property="Text" Value="🔴"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Analysis.RiskLevel}" Value="medium">
                                                        <Setter Property="Text" Value="🟡"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Analysis.RiskLevel}" Value="low">
                                                        <Setter Property="Text" Value="🟢"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                    <TextBlock FontSize="{StaticResource FontSizeH2}"
                                               FontWeight="Bold"
                                               HorizontalAlignment="Center"
                                               Margin="0,8,0,0">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Text" Value="미평가"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Analysis.RiskLevel}" Value="high">
                                                        <Setter Property="Text" Value="위험도 높음"/>
                                                        <Setter Property="Foreground" Value="{StaticResource ErrorBrush}"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Analysis.RiskLevel}" Value="medium">
                                                        <Setter Property="Text" Value="위험도 중간"/>
                                                        <Setter Property="Foreground" Value="{StaticResource WarningBrush}"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Analysis.RiskLevel}" Value="low">
                                                        <Setter Property="Text" Value="위험도 낮음"/>
                                                        <Setter Property="Foreground" Value="{StaticResource SuccessBrush}"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </StackPanel>
                            </Border>
                            
                            <!-- 위험도 선택 -->
                            <StackPanel Margin="0,0,0,12">
                                <TextBlock Text="위험도 수동 설정" Style="{StaticResource FieldLabelStyle}"/>
                                <ComboBox SelectedValue="{Binding Analysis.RiskLevel, Mode=TwoWay}"
                                          SelectedValuePath="Tag">
                                    <ComboBoxItem Content="🔴 높음 (High)" Tag="high"/>
                                    <ComboBoxItem Content="🟡 중간 (Medium)" Tag="medium"/>
                                    <ComboBoxItem Content="🟢 낮음 (Low)" Tag="low"/>
                                </ComboBox>
                            </StackPanel>
                            
                            <!-- 위험도 판단 근거 -->
                            <StackPanel Margin="0,0,0,12">
                                <TextBlock Text="위험도 판단 근거" Style="{StaticResource FieldLabelStyle}"/>
                                <TextBox Text="{Binding Analysis.RiskReason, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                         TextWrapping="Wrap"
                                         AcceptsReturn="True"
                                         Height="60"
                                         VerticalScrollBarVisibility="Auto"/>
                            </StackPanel>
                            
                            <!-- 권장 의견 -->
                            <StackPanel>
                                <TextBlock Text="권장 의견" Style="{StaticResource FieldLabelStyle}"/>
                                <TextBox Text="{Binding Analysis.Recommendations, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                         TextWrapping="Wrap"
                                         AcceptsReturn="True"
                                         Height="80"
                                         VerticalScrollBarVisibility="Auto"/>
                            </StackPanel>
                        </StackPanel>
                    </StackPanel>
                </Border>
                
                <!-- ===== 분석 완료 체크 ===== -->
                <Border Style="{StaticResource SectionCardStyle}">
                    <Grid Margin="16">
                        <CheckBox Content="권리분석 완료" 
                                  IsChecked="{Binding Analysis.IsCompleted}"
                                  FontSize="{StaticResource FontSizeH4}"
                                  FontWeight="SemiBold"/>
                        <TextBlock Text="{Binding Analysis.AnalyzedAt, StringFormat='yyyy-MM-dd HH:mm'}" 
                                   HorizontalAlignment="Right"
                                   VerticalAlignment="Center"
                                   FontSize="{StaticResource FontSizeBody}"
                                   Foreground="{StaticResource TextSecondaryBrush}"
                                   Visibility="{Binding Analysis.AnalyzedAt, Converter={StaticResource NullToVisibilityConverter}}"/>
                    </Grid>
                </Border>
                
            </StackPanel>
        </Grid>
    </ScrollViewer>

    <!-- 비고 사이드 패널 -->
    <Border x:Name="NotePanelColumn" Grid.Column="1"
            Width="250"
            Visibility="{Binding IsNotePanelVisible, Converter={StaticResource BoolToVisibilityConverter}}"
            Background="{StaticResource SurfaceColor}"
            BorderBrush="{StaticResource BorderBrush}"
            BorderThickness="1,0,0,0"
            Padding="12">
        <DockPanel>
            <TextBlock DockPanel.Dock="Top"
                       Text="&#x1F4DD; 비고"
                       FontWeight="SemiBold"
                       FontSize="{StaticResource FontSizeBody}"
                       Foreground="{StaticResource PrimaryBrush}"
                       Margin="0,0,0,8"/>
            <TextBox Text="{Binding NoteText, UpdateSourceTrigger=PropertyChanged}"
                     TextWrapping="Wrap"
                     AcceptsReturn="True"
                     VerticalScrollBarVisibility="Auto"
                     VerticalAlignment="Stretch"
                     FontSize="{StaticResource FontSizeBody}"
                     Padding="8"
                     BorderBrush="{StaticResource BorderBrush}"
                     BorderThickness="1"
                     Background="White"/>
        </DockPanel>
    </Border>

    </Grid>
</UserControl>

