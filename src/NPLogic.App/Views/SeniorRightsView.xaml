<UserControl x:Class="NPLogic.Views.SeniorRightsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:NPLogic.Views"
             xmlns:vm="clr-namespace:NPLogic.ViewModels"
             xmlns:converters="clr-namespace:NPLogic.Converters"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             mc:Ignorable="d" 
             d:DesignHeight="900" d:DesignWidth="1600"
             d:DataContext="{d:DesignInstance Type=vm:SeniorRightsViewModel}"
             >
    
    <UserControl.Resources>
        <!-- 테이블 스타일 (CollateralPropertyView와 동일) -->
        <SolidColorBrush x:Key="TableBorderBrush" Color="#E0E0E0"/>
        
        <!-- 테이블 헤더 스타일 (CollateralPropertyView와 동일) -->
        <Style x:Key="TableHeaderCell" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource BlueGray100Brush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="0,0,1,1"/>
            <Setter Property="Padding" Value="12,8"/>
        </Style>

        <!-- 테이블 데이터 셀 스타일 (CollateralPropertyView와 동일) -->
        <Style x:Key="TableDataCell" TargetType="Border">
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="0,0,1,1"/>
            <Setter Property="Padding" Value="12,8"/>
        </Style>

        <!-- 테이블 셀 내 TextBlock 세로 중앙 정렬 -->
        <Style x:Key="CellTextBlock" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style x:Key="CellHeaderTextBlock" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
        </Style>
        
        <!-- 섹션 헤더 스타일 -->
        <Style x:Key="SectionHeaderStyle" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="{StaticResource FontSizeBody}"/>
            <Setter Property="Foreground" Value="{StaticResource PrimaryBrush}"/>
            <Setter Property="Margin" Value="0,0,0,12"/>
        </Style>
        
        <!-- 라벨 스타일 -->
        <Style x:Key="LabelStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="{StaticResource FontSizeSmall}"/>
            <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
            <Setter Property="TextWrapping" Value="NoWrap"/>
        </Style>
        
        <!-- 값 스타일 -->
        <Style x:Key="ValueStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="{StaticResource FontSizeSmall}"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
            <Setter Property="TextWrapping" Value="NoWrap"/>
        </Style>
        
        <!-- 금액 스타일 -->
        <Style x:Key="AmountStyle" TargetType="TextBlock" BasedOn="{StaticResource ValueStyle}">
            <Setter Property="HorizontalAlignment" Value="Right"/>
        </Style>
        
        <!-- 테이블 셀 스타일 -->
        <Style x:Key="TableCellStyle" TargetType="Border">
            <Setter Property="BorderBrush" Value="{StaticResource TableBorderBrush}"/>
            <Setter Property="BorderThickness" Value="0,0,1,1"/>
            <Setter Property="Padding" Value="6,6"/>
            <Setter Property="Background" Value="Transparent"/>
        </Style>
        
        <!-- 테이블 헤더 셀 스타일 -->
        <Style x:Key="TableHeaderCellStyle" TargetType="Border" BasedOn="{StaticResource TableCellStyle}">
            <Setter Property="Background" Value="{StaticResource SurfaceColor}"/>
            <Setter Property="Padding" Value="4,6"/>
        </Style>
        
        <!-- 노란색 하이라이트 셀 -->
        <Style x:Key="YellowHighlightCellStyle" TargetType="Border" BasedOn="{StaticResource TableCellStyle}">
            <Setter Property="Background" Value="White"/>
        </Style>
        
        <!-- 입력 TextBox 스타일 -->
        <Style x:Key="InputTextBoxStyle" TargetType="TextBox">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
            <Setter Property="BorderBrush" Value="{StaticResource TableBorderBrush}"/>
            <Setter Property="Padding" Value="2,2"/>
            <Setter Property="FontSize" Value="{StaticResource FontSizeSmall}"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
        
        <!-- 읽기 전용 TextBox 스타일 -->
        <Style x:Key="ReadOnlyTextBoxStyle" TargetType="TextBox" BasedOn="{StaticResource InputTextBoxStyle}">
            <Setter Property="IsReadOnly" Value="True"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
        </Style>
        
        <!-- 컴팩트 CheckBox -->
        <Style x:Key="CompactCheckBoxStyle" TargetType="CheckBox">
            <Setter Property="FontSize" Value="{StaticResource FontSizeSmall}"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0"/>
        </Style>
        
        <!-- 컴팩트 DatePicker -->
        <Style x:Key="CompactDatePickerStyle" TargetType="DatePicker">
            <Setter Property="FontSize" Value="{StaticResource FontSizeTiny}"/>
            <Setter Property="Background" Value="{StaticResource DateInputBgBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource DateInputBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="1"/>
            <Setter Property="Height" Value="22"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="DatePicker">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <DatePickerTextBox x:Name="PART_TextBox"
                                                   Grid.Column="0"
                                                   Background="Transparent"
                                                   BorderThickness="0"
                                                   Padding="{TemplateBinding Padding}"
                                                   VerticalAlignment="Center"
                                                   VerticalContentAlignment="Center"
                                                   Focusable="{TemplateBinding Focusable}"/>
                                <Button x:Name="PART_Button"
                                        Grid.Column="1"
                                        Width="18"
                                        Focusable="False"
                                        Background="Transparent"
                                        BorderThickness="0"
                                        VerticalAlignment="Center"
                                        HorizontalAlignment="Center"
                                        Padding="1">
                                    <Path Data="M0,0 L0,6 L6,6 L6,0 z M1,1 L1,2 L2,2 L2,1 z M3,1 L3,2 L4,2 L4,1 z M1,3 L1,4 L2,4 L2,3 z M3,3 L3,4 L4,4 L4,3 z"
                                          Fill="#666666"
                                          Width="9"
                                          Height="9"
                                          Stretch="Uniform"/>
                                </Button>
                                <Popup x:Name="PART_Popup"
                                       AllowsTransparency="True"
                                       Placement="Bottom"
                                       PlacementTarget="{Binding ElementName=PART_TextBox}"
                                       StaysOpen="False"/>
                            </Grid>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 링크 버튼 스타일 -->
        <Style x:Key="LinkButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="{StaticResource PrimaryBrush}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="{StaticResource FontSizeSmall}"/>
            <Setter Property="Padding" Value="4,2"/>
        </Style>

        <!-- DataGrid 공통 스타일 (담보물건 > 지번별 감정평가와 동일 톤) -->
        <Style x:Key="SectionDataGridColumnHeaderStyle" TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="{StaticResource BlueGray100Brush}"/>
            <Setter Property="Padding" Value="8,6"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="0,0,1,1"/>
        </Style>

        <Style x:Key="SectionDataGridCellStyle" TargetType="DataGridCell">
            <Setter Property="Foreground" Value="Black"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="0,0,1,0"/>
            <Setter Property="Padding" Value="4,2"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Foreground" Value="Black"/>
                </Trigger>
                <Trigger Property="IsEditing" Value="True">
                    <Setter Property="Foreground" Value="Black"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="SectionDataGridRowStyle" TargetType="DataGridRow">
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Foreground" Value="Black"/>
        </Style>

        <Style x:Key="SectionDataGridTextBlockStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="{StaticResource FontSizeBody}"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="TextAlignment" Value="Center"/>
        </Style>

        <Style x:Key="SectionDataGridTextBoxStyle" TargetType="TextBox">
            <Setter Property="FontSize" Value="{StaticResource FontSizeBody}"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="TextAlignment" Value="Center"/>
            <Setter Property="VerticalAlignment" Value="Stretch"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Margin" Value="0"/>
        </Style>
    </UserControl.Resources>
    
    <Grid Margin="12,8,12,12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- 헤더 영역 -->
        <Grid Grid.Row="0" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0">
                <TextBlock Text="선순위(Ⅴ)" 
                           Style="{StaticResource H2TextStyle}"
                           Margin="0,0,0,4"/>
                <TextBlock Style="{StaticResource BodyTextStyle}" Opacity="0.7">
                    <Run Text="경매사건 및 선순위 분석 | 선순위 합계:"/>
                    <Run Text="{Binding SeniorRightsTotal, StringFormat=N0, FallbackValue=0, Mode=OneWay}" FontWeight="SemiBold"/>
                    <Run Text="원"/>
                </TextBlock>
            </StackPanel>

            <!-- 버튼 제거됨 (피드백 #26) -->
        </Grid>

        <!-- 메인 컨텐츠 -->
        <Border Grid.Row="1" Background="{StaticResource SurfaceColor}" CornerRadius="8" Padding="0">
            <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                <StackPanel>

                    <!-- 상단 영역: 넓은 테이블들 (수평 스크롤 필요) -->
                    <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled"
                                  PreviewMouseWheel="HorizontalScrollViewer_PreviewMouseWheel">
                        <StackPanel MinWidth="1400">

                    <!-- ========== 1. 경매사건 및 선순위 상단 정보 ========== -->
                    <Border Background="{StaticResource SurfaceColor}"
                            BorderBrush="{StaticResource BorderBrush}"
                            BorderThickness="1"
                            CornerRadius="8"
                            Margin="0,0,0,16">
                        <StackPanel>
                            <!-- 섹션 헤더 (CollateralPropertyView 스타일) -->
                            <Border Background="{StaticResource PrimaryBrush}"
                                    CornerRadius="8,8,0,0"
                                    Padding="16,10">
                                <TextBlock Text="📋 경매사건 및 선순위" 
                                           Foreground="White" 
                                           FontWeight="SemiBold"
                                           FontSize="{StaticResource FontSizeH4}"/>
                            </Border>
                            
                            <!-- 경매사건 통합 테이블: 왼쪽(선행/후행) + 오른쪽(공통) -->
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" MinWidth="80"/>   <!-- 0: 왼쪽 라벨 -->
                                    <ColumnDefinition Width="*" MinWidth="80"/>      <!-- 1: 선행 값 -->
                                    <ColumnDefinition Width="*" MinWidth="80"/>      <!-- 2: 후행 값 -->
                                    <ColumnDefinition Width="Auto" MinWidth="100"/>  <!-- 3: 오른쪽 라벨 -->
                                    <ColumnDefinition Width="*" MinWidth="80"/>      <!-- 4: 오른쪽 값 -->
                                    <ColumnDefinition Width="*" MinWidth="80"/>      <!-- 5: 당사자내역 1 -->
                                    <ColumnDefinition Width="*" MinWidth="80"/>      <!-- 6: 당사자내역 2 -->
                                    <ColumnDefinition Width="*" MinWidth="80"/>      <!-- 7: 당사자내역 3 -->
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <!-- ===== 기존 5열 (Col 0-4) ===== -->

                                <!-- Row 0: 헤더 / 최초법사가 -->
                                <Border Grid.Row="0" Grid.Column="0" Style="{StaticResource TableHeaderCell}"/>
                                <Border Grid.Row="0" Grid.Column="1" Style="{StaticResource TableHeaderCell}">
                                    <TextBlock Text="선행" Style="{StaticResource CellHeaderTextBlock}" HorizontalAlignment="Center"/>
                                </Border>
                                <Border Grid.Row="0" Grid.Column="2" Style="{StaticResource TableHeaderCell}">
                                    <TextBlock Text="후행" Style="{StaticResource CellHeaderTextBlock}" HorizontalAlignment="Center"/>
                                </Border>
                                <Border Grid.Row="0" Grid.Column="3" Style="{StaticResource TableHeaderCell}" BorderThickness="2,0,1,1">
                                    <TextBlock Text="최초법사가" Style="{StaticResource CellHeaderTextBlock}"/>
                                </Border>
                                <Border Grid.Row="0" Grid.Column="4" Style="{StaticResource TableDataCell}">
                                    <TextBlock Text="{Binding SelectedProperty.InitialCourtValue, StringFormat=N0, FallbackValue='-'}" Style="{StaticResource CellTextBlock}"/>
                                </Border>

                                <!-- Row 1: 경매개시여부 / 최초경매기일 -->
                                <Border Grid.Row="1" Grid.Column="0" Style="{StaticResource TableHeaderCell}">
                                    <TextBlock Text="경매개시여부" Style="{StaticResource CellHeaderTextBlock}"/>
                                </Border>
                                <Border Grid.Row="1" Grid.Column="1" Style="{StaticResource TableDataCell}">
                                    <TextBlock VerticalAlignment="Center">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Text" Value="경매미개시"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding SelectedProperty.AuctionStarted}" Value="True">
                                                        <Setter Property="Text" Value="경매개시"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </Border>
                                <Border Grid.Row="1" Grid.Column="2" Style="{StaticResource TableDataCell}">
                                    <TextBlock VerticalAlignment="Center">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Text" Value="경매미개시"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding SelectedProperty.AuctionStarted}" Value="True">
                                                        <Setter Property="Text" Value="경매개시"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </Border>
                                <Border Grid.Row="1" Grid.Column="3" Style="{StaticResource TableHeaderCell}" BorderThickness="2,0,1,1">
                                    <TextBlock Text="최초경매기일" Style="{StaticResource CellHeaderTextBlock}"/>
                                </Border>
                                <Border Grid.Row="1" Grid.Column="4" Style="{StaticResource TableDataCell}">
                                    <TextBlock Text="{Binding SelectedProperty.FirstAuctionDate, StringFormat=yyyy-MM-dd, FallbackValue='-'}" Style="{StaticResource CellTextBlock}"/>
                                </Border>

                                <!-- Row 2: 관할법원 / 최종경매회차 -->
                                <Border Grid.Row="2" Grid.Column="0" Style="{StaticResource TableHeaderCell}">
                                    <TextBlock Text="관할법원" Style="{StaticResource CellHeaderTextBlock}"/>
                                </Border>
                                <Border Grid.Row="2" Grid.Column="1" Style="{StaticResource TableDataCell}">
                                    <TextBlock Text="{Binding SelectedProperty.AuctionCourt, FallbackValue='-'}" Style="{StaticResource CellTextBlock}"/>
                                </Border>
                                <Border Grid.Row="2" Grid.Column="2" Style="{StaticResource TableDataCell}">
                                    <TextBlock Text="{Binding SelectedProperty.AuctionCourt, FallbackValue='-'}" Style="{StaticResource CellTextBlock}"/>
                                </Border>
                                <Border Grid.Row="2" Grid.Column="3" Style="{StaticResource TableHeaderCell}" BorderThickness="2,0,1,1">
                                    <TextBlock Text="최종경매회차" Style="{StaticResource CellHeaderTextBlock}"/>
                                </Border>
                                <Border Grid.Row="2" Grid.Column="4" Style="{StaticResource TableDataCell}">
                                    <TextBlock Text="{Binding SelectedProperty.FinalAuctionRound, FallbackValue='-'}" Style="{StaticResource CellTextBlock}"/>
                                </Border>

                                <!-- Row 3: 경매사건번호 / 최종경매기일 -->
                                <Border Grid.Row="3" Grid.Column="0" Style="{StaticResource TableHeaderCell}">
                                    <TextBlock Text="경매사건번호" Style="{StaticResource CellHeaderTextBlock}"/>
                                </Border>
                                <Border Grid.Row="3" Grid.Column="1" Style="{StaticResource TableDataCell}">
                                    <TextBlock Text="{Binding SelectedProperty.PrecedentCaseNumber, FallbackValue='-'}" Style="{StaticResource CellTextBlock}"/>
                                </Border>
                                <Border Grid.Row="3" Grid.Column="2" Style="{StaticResource TableDataCell}">
                                    <TextBlock Text="{Binding SelectedProperty.SubsequentCaseNumber, FallbackValue='-'}" Style="{StaticResource CellTextBlock}"/>
                                </Border>
                                <Border Grid.Row="3" Grid.Column="3" Style="{StaticResource TableHeaderCell}" BorderThickness="2,0,1,1">
                                    <TextBlock Text="최종경매기일" Style="{StaticResource CellHeaderTextBlock}"/>
                                </Border>
                                <Border Grid.Row="3" Grid.Column="4" Style="{StaticResource TableDataCell}">
                                    <TextBlock Text="{Binding SelectedProperty.FinalAuctionDate, StringFormat=yyyy-MM-dd, FallbackValue='-'}" Style="{StaticResource CellTextBlock}"/>
                                </Border>

                                <!-- Row 4: 경매신청기관 / 최종경매결과 -->
                                <Border Grid.Row="4" Grid.Column="0" Style="{StaticResource TableHeaderCell}">
                                    <TextBlock Text="경매신청기관" Style="{StaticResource CellHeaderTextBlock}"/>
                                </Border>
                                <Border Grid.Row="4" Grid.Column="1" Style="{StaticResource TableDataCell}">
                                    <TextBlock Text="{Binding SelectedProperty.PrecedentAuctionApplicant, FallbackValue='-'}" Style="{StaticResource CellTextBlock}"/>
                                </Border>
                                <Border Grid.Row="4" Grid.Column="2" Style="{StaticResource TableDataCell}">
                                    <TextBlock Text="{Binding SelectedProperty.SubsequentAuctionApplicant, FallbackValue='-'}" Style="{StaticResource CellTextBlock}"/>
                                </Border>
                                <Border Grid.Row="4" Grid.Column="3" Style="{StaticResource TableHeaderCell}" BorderThickness="2,0,1,1">
                                    <TextBlock Text="최종경매결과" Style="{StaticResource CellHeaderTextBlock}"/>
                                </Border>
                                <Border Grid.Row="4" Grid.Column="4" Style="{StaticResource TableDataCell}">
                                    <TextBlock Text="{Binding SelectedProperty.FinalAuctionResult, FallbackValue='-'}" Style="{StaticResource CellTextBlock}"/>
                                </Border>

                                <!-- Row 5: 경매개시일자 / 낙찰금액 -->
                                <Border Grid.Row="5" Grid.Column="0" Style="{StaticResource TableHeaderCell}">
                                    <TextBlock Text="경매개시일자" Style="{StaticResource CellHeaderTextBlock}"/>
                                </Border>
                                <Border Grid.Row="5" Grid.Column="1" Style="{StaticResource TableDataCell}">
                                    <TextBlock Text="{Binding SelectedProperty.PrecedentAuctionStartDate, StringFormat=yyyy-MM-dd, FallbackValue='-'}" Style="{StaticResource CellTextBlock}"/>
                                </Border>
                                <Border Grid.Row="5" Grid.Column="2" Style="{StaticResource TableDataCell}">
                                    <TextBlock Text="{Binding SelectedProperty.SubsequentAuctionStartDate, StringFormat=yyyy-MM-dd, FallbackValue='-'}" Style="{StaticResource CellTextBlock}"/>
                                </Border>
                                <Border Grid.Row="5" Grid.Column="3" Style="{StaticResource TableHeaderCell}" BorderThickness="2,0,1,1">
                                    <TextBlock Text="낙찰금액" Style="{StaticResource CellHeaderTextBlock}"/>
                                </Border>
                                <Border Grid.Row="5" Grid.Column="4" Style="{StaticResource TableDataCell}">
                                    <TextBlock Text="{Binding SelectedProperty.WinningBidAmount, StringFormat=N0, FallbackValue='-'}" Style="{StaticResource CellTextBlock}"/>
                                </Border>

                                <!-- Row 6: 배당요구종기일 / 최종경매일의 최저입찰금액 -->
                                <Border Grid.Row="6" Grid.Column="0" Style="{StaticResource TableHeaderCell}">
                                    <TextBlock Text="배당요구종기일" Style="{StaticResource CellHeaderTextBlock}"/>
                                </Border>
                                <Border Grid.Row="6" Grid.Column="1" Style="{StaticResource TableDataCell}">
                                    <TextBlock Text="{Binding SelectedProperty.PrecedentClaimDeadline, StringFormat=yyyy-MM-dd, FallbackValue='-'}" Style="{StaticResource CellTextBlock}"/>
                                </Border>
                                <Border Grid.Row="6" Grid.Column="2" Style="{StaticResource TableDataCell}">
                                    <TextBlock Text="{Binding SelectedProperty.SubsequentClaimDeadline, StringFormat=yyyy-MM-dd, FallbackValue='-'}" Style="{StaticResource CellTextBlock}"/>
                                </Border>
                                <Border Grid.Row="6" Grid.Column="3" Style="{StaticResource TableHeaderCell}" BorderThickness="2,0,1,1">
                                    <TextBlock Text="최종경매일의 최저입찰금액" Style="{StaticResource CellHeaderTextBlock}"/>
                                </Border>
                                <Border Grid.Row="6" Grid.Column="4" Style="{StaticResource TableDataCell}">
                                    <TextBlock Text="{Binding SelectedProperty.FinalMinimumBid, StringFormat=N0, FallbackValue='-'}" Style="{StaticResource CellTextBlock}"/>
                                </Border>

                                <!-- Row 7: 청구금액 / 차후예정경매일의 최저입찰금액 -->
                                <Border Grid.Row="7" Grid.Column="0" Style="{StaticResource TableHeaderCell}">
                                    <TextBlock Text="청구금액" Style="{StaticResource CellHeaderTextBlock}"/>
                                </Border>
                                <Border Grid.Row="7" Grid.Column="1" Style="{StaticResource TableDataCell}">
                                    <TextBlock Text="{Binding SelectedProperty.PrecedentClaimAmount, StringFormat=N0, FallbackValue='-'}" Style="{StaticResource CellTextBlock}"/>
                                </Border>
                                <Border Grid.Row="7" Grid.Column="2" Style="{StaticResource TableDataCell}">
                                    <TextBlock Text="{Binding SelectedProperty.SubsequentClaimAmount, StringFormat=N0, FallbackValue='-'}" Style="{StaticResource CellTextBlock}"/>
                                </Border>
                                <Border Grid.Row="7" Grid.Column="3" Style="{StaticResource TableHeaderCell}" BorderThickness="2,0,1,1">
                                    <TextBlock Text="차후예정경매일의 최저입찰금액" Style="{StaticResource CellHeaderTextBlock}"/>
                                </Border>
                                <Border Grid.Row="7" Grid.Column="4" Style="{StaticResource TableDataCell}">
                                    <TextBlock Text="{Binding SelectedProperty.NextMinimumBid, StringFormat=N0, FallbackValue='-'}" Style="{StaticResource CellTextBlock}"/>
                                </Border>

                                <!-- ===== 추가 3열 (Col 5-7): 당사자내역 ===== -->

                                <!-- Row 0: 당사자내역 헤더 (3열 병합) -->
                                <Border Grid.Row="0" Grid.Column="5" Grid.ColumnSpan="3"
                                        Style="{StaticResource TableHeaderCell}" BorderThickness="2,0,0,1">
                                    <TextBlock Text="당사자내역" Style="{StaticResource CellHeaderTextBlock}" HorizontalAlignment="Center"/>
                                </Border>

                                <!-- Row 1-5: 당사자내역 이미지 영역 (3열×5행 병합) -->
                                <Border Grid.Row="1" Grid.Column="5" Grid.ColumnSpan="3" Grid.RowSpan="5"
                                        Style="{StaticResource TableDataCell}" BorderThickness="2,0,0,1">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="140" MinHeight="40"/>
                                            <RowDefinition Height="5"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>
                                        <Button Grid.Row="0" Content="이미지 붙여넣기"
                                                Command="{Binding PastePartyDetailsImageCommand}"
                                                Style="{StaticResource SecondaryButton}"
                                                Padding="8,4" FontSize="{StaticResource FontSizeTiny}"
                                                HorizontalAlignment="Left" Margin="0,0,0,4"/>
                                        <Image Grid.Row="1" Source="{Binding PartyDetailsImage}"
                                               Stretch="Uniform"/>
                                        <GridSplitter Grid.Row="2" HorizontalAlignment="Stretch"
                                                      ResizeDirection="Rows" Background="#E0E0E0"
                                                      Cursor="SizeNS" Height="5"/>
                                        <TextBlock Grid.Row="3" Text="{Binding PartyDetailsImageInfo}"
                                                   FontSize="{StaticResource FontSizeTiny}" Opacity="0.7"
                                                   TextWrapping="Wrap" Margin="0,2,0,0"/>
                                    </Grid>
                                </Border>

                                <!-- Row 6: 현황조사서 / 감정평가서 / 배당요구종기일경과 (헤더) -->
                                <Border Grid.Row="6" Grid.Column="5" Style="{StaticResource TableHeaderCell}" BorderThickness="2,0,1,1">
                                    <TextBlock Text="현황조사서" Style="{StaticResource CellHeaderTextBlock}" HorizontalAlignment="Center"/>
                                </Border>
                                <Border Grid.Row="6" Grid.Column="6" Style="{StaticResource TableHeaderCell}">
                                    <TextBlock Text="감정평가서" Style="{StaticResource CellHeaderTextBlock}" HorizontalAlignment="Center"/>
                                </Border>
                                <Border Grid.Row="6" Grid.Column="7" Style="{StaticResource TableHeaderCell}" BorderThickness="0,0,0,1">
                                    <TextBlock Text="배당요구종기일경과" Style="{StaticResource CellHeaderTextBlock}" HorizontalAlignment="Center"/>
                                </Border>

                                <!-- Row 7: 현황조사서 / 감정평가서 / 배당요구종기일경과 (입력) -->
                                <Border Grid.Row="7" Grid.Column="5" Style="{StaticResource TableDataCell}" BorderThickness="2,0,1,1">
                                    <TextBox Text="{Binding SurveyReportNote, UpdateSourceTrigger=PropertyChanged}"
                                             Style="{StaticResource InputTextBoxStyle}"
                                             TextWrapping="Wrap" AcceptsReturn="True" MinHeight="24"/>
                                </Border>
                                <Border Grid.Row="7" Grid.Column="6" Style="{StaticResource TableDataCell}">
                                    <TextBox Text="{Binding AppraisalReportNote, UpdateSourceTrigger=PropertyChanged}"
                                             Style="{StaticResource InputTextBoxStyle}"
                                             TextWrapping="Wrap" AcceptsReturn="True" MinHeight="24"/>
                                </Border>
                                <Border Grid.Row="7" Grid.Column="7" Style="{StaticResource TableDataCell}" BorderThickness="0,0,0,1">
                                    <CheckBox IsChecked="{Binding ClaimDeadlinePassed}"
                                              Style="{StaticResource CompactCheckBoxStyle}"
                                              HorizontalAlignment="Center"/>
                                </Border>

                                <!-- 컬럼 너비 조정 핸들 (셀 위에 렌더링되도록 마지막에 배치) -->
                                <GridSplitter Grid.Column="0" Grid.RowSpan="8" Width="5" HorizontalAlignment="Right" Background="Transparent" Cursor="SizeWE"/>
                                <GridSplitter Grid.Column="1" Grid.RowSpan="8" Width="5" HorizontalAlignment="Right" Background="Transparent" Cursor="SizeWE"/>
                                <GridSplitter Grid.Column="2" Grid.RowSpan="8" Width="5" HorizontalAlignment="Right" Background="Transparent" Cursor="SizeWE"/>
                                <GridSplitter Grid.Column="3" Grid.RowSpan="8" Width="5" HorizontalAlignment="Right" Background="Transparent" Cursor="SizeWE"/>
                                <GridSplitter Grid.Column="4" Grid.RowSpan="8" Width="5" HorizontalAlignment="Right" Background="Transparent" Cursor="SizeWE"/>
                                <GridSplitter Grid.Column="5" Grid.RowSpan="8" Width="5" HorizontalAlignment="Right" Background="Transparent" Cursor="SizeWE"/>
                                <GridSplitter Grid.Column="6" Grid.RowSpan="8" Width="5" HorizontalAlignment="Right" Background="Transparent" Cursor="SizeWE"/>
                            </Grid>

                            <!-- 대법원 경매 이미지 테이블 (3열 x 2행) -->
                            <Grid Margin="0,8,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <!-- Row 0: 헤더 -->
                                <Border Grid.Row="0" Grid.Column="0" Style="{StaticResource TableHeaderCell}" BorderThickness="2,2,1,1">
                                    <TextBlock Text="경매사건검색" Style="{StaticResource CellHeaderTextBlock}" HorizontalAlignment="Center"/>
                                </Border>
                                <Border Grid.Row="0" Grid.Column="1" Style="{StaticResource TableHeaderCell}" BorderThickness="0,2,1,1">
                                    <TextBlock Text="기일내역검색" Style="{StaticResource CellHeaderTextBlock}" HorizontalAlignment="Center"/>
                                </Border>
                                <Border Grid.Row="0" Grid.Column="2" Style="{StaticResource TableHeaderCell}" BorderThickness="0,2,2,1">
                                    <TextBlock Text="문건송달내역" Style="{StaticResource CellHeaderTextBlock}" HorizontalAlignment="Center"/>
                                </Border>

                                <!-- Row 1: 이미지 붙여넣기 영역 -->
                                <Border Grid.Row="1" Grid.Column="0" Style="{StaticResource TableDataCell}" BorderThickness="2,0,1,2">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="140" MinHeight="40"/>
                                            <RowDefinition Height="5"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>
                                        <Button Grid.Row="0" Content="이미지 붙여넣기"
                                                Command="{Binding PasteCourtCaseSearchImageCommand}"
                                                Style="{StaticResource SecondaryButton}"
                                                Padding="8,4" FontSize="{StaticResource FontSizeTiny}"
                                                HorizontalAlignment="Left" Margin="0,0,0,4"/>
                                        <Image Grid.Row="1" Source="{Binding CourtCaseSearchImage}" Stretch="Uniform"/>
                                        <GridSplitter Grid.Row="2" HorizontalAlignment="Stretch"
                                                      ResizeDirection="Rows" Background="#E0E0E0"
                                                      Cursor="SizeNS" Height="5"/>
                                        <TextBlock Grid.Row="3" Text="{Binding CourtCaseSearchImageInfo}"
                                                   FontSize="{StaticResource FontSizeTiny}" Opacity="0.7"
                                                   TextWrapping="Wrap" Margin="0,2,0,0"/>
                                    </Grid>
                                </Border>
                                <Border Grid.Row="1" Grid.Column="1" Style="{StaticResource TableDataCell}" BorderThickness="0,0,1,2">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="140" MinHeight="40"/>
                                            <RowDefinition Height="5"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>
                                        <Button Grid.Row="0" Content="이미지 붙여넣기"
                                                Command="{Binding PasteCourtDateSearchImageCommand}"
                                                Style="{StaticResource SecondaryButton}"
                                                Padding="8,4" FontSize="{StaticResource FontSizeTiny}"
                                                HorizontalAlignment="Left" Margin="0,0,0,4"/>
                                        <Image Grid.Row="1" Source="{Binding CourtDateSearchImage}" Stretch="Uniform"/>
                                        <GridSplitter Grid.Row="2" HorizontalAlignment="Stretch"
                                                      ResizeDirection="Rows" Background="#E0E0E0"
                                                      Cursor="SizeNS" Height="5"/>
                                        <TextBlock Grid.Row="3" Text="{Binding CourtDateSearchImageInfo}"
                                                   FontSize="{StaticResource FontSizeTiny}" Opacity="0.7"
                                                   TextWrapping="Wrap" Margin="0,2,0,0"/>
                                    </Grid>
                                </Border>
                                <Border Grid.Row="1" Grid.Column="2" Style="{StaticResource TableDataCell}" BorderThickness="0,0,2,2">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="140" MinHeight="40"/>
                                            <RowDefinition Height="5"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>
                                        <Button Grid.Row="0" Content="이미지 붙여넣기"
                                                Command="{Binding PasteCourtDocumentDeliveryImageCommand}"
                                                Style="{StaticResource SecondaryButton}"
                                                Padding="8,4" FontSize="{StaticResource FontSizeTiny}"
                                                HorizontalAlignment="Left" Margin="0,0,0,4"/>
                                        <Image Grid.Row="1" Source="{Binding CourtDocumentDeliveryImage}" Stretch="Uniform"/>
                                        <GridSplitter Grid.Row="2" HorizontalAlignment="Stretch"
                                                      ResizeDirection="Rows" Background="#E0E0E0"
                                                      Cursor="SizeNS" Height="5"/>
                                        <TextBlock Grid.Row="3" Text="{Binding CourtDocumentDeliveryImageInfo}"
                                                   FontSize="{StaticResource FontSizeTiny}" Opacity="0.7"
                                                   TextWrapping="Wrap" Margin="0,2,0,0"/>
                                    </Grid>
                                </Border>
                            </Grid>

                            <!-- 하단: 대법원 링크 (왼쪽) + 저장 버튼 (오른쪽) -->
                            <Grid Margin="0,8,0,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Button Grid.Column="0" Content="대법원 경매사건 검색"
                                        Command="{Binding OpenCourtAuctionSearchCommand}"
                                        Style="{StaticResource MaterialDesignFlatButton}"
                                        Padding="12,6" HorizontalAlignment="Left"/>
                                <Button Grid.Column="1" Content="저장"
                                        Command="{Binding SaveAuctionCaseNotesCommand}"
                                        Style="{StaticResource MaterialDesignRaisedButton}"
                                        Padding="12,6"/>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- ========== 2. 전입/임차 현황 및 등기부 정보 ========== -->
                    <Border Background="{StaticResource SurfaceColor}"
                            BorderBrush="{StaticResource BorderBrush}"
                            BorderThickness="1"
                            CornerRadius="8"
                            Margin="0,0,0,16">
                        <StackPanel>
                            <!-- 섹션 헤더 -->
                            <Border Background="{StaticResource PrimaryBrush}"
                                    CornerRadius="8,8,0,0"
                                    Padding="16,10">
                                <TextBlock Text="📝 전입/임차 현황 및 등기부 정보"
                                           Foreground="White"
                                           FontWeight="SemiBold"
                                           FontSize="{StaticResource FontSizeH4}"/>
                            </Border>

                            <!-- 통합 테이블 (8열 x 8행) -->
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" MinWidth="80"/>  <!-- 0 -->
                                    <ColumnDefinition Width="*" MinWidth="80"/>  <!-- 1 -->
                                    <ColumnDefinition Width="*" MinWidth="80"/>  <!-- 2 -->
                                    <ColumnDefinition Width="*" MinWidth="80"/>  <!-- 3 -->
                                    <ColumnDefinition Width="*" MinWidth="80"/>  <!-- 4 -->
                                    <ColumnDefinition Width="*" MinWidth="80"/>  <!-- 5 -->
                                    <ColumnDefinition Width="*" MinWidth="80"/>  <!-- 6 -->
                                    <ColumnDefinition Width="*" MinWidth="80"/>  <!-- 7 -->
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" MinHeight="36"/>  <!-- 0: 헤더1 -->
                                    <RowDefinition Height="Auto" MinHeight="36"/>  <!-- 1: 데이터1 -->
                                    <RowDefinition Height="Auto" MinHeight="36"/>  <!-- 2: 헤더2 -->
                                    <RowDefinition Height="Auto" MinHeight="36"/>  <!-- 3: 데이터3 -->
                                    <RowDefinition Height="Auto" MinHeight="36"/>  <!-- 4: 헤더3 -->
                                    <RowDefinition Height="Auto" MinHeight="36"/>  <!-- 5: 데이터3 -->
                                    <RowDefinition Height="Auto" MinHeight="36"/>  <!-- 6: 헤더4 -->
                                    <RowDefinition Height="Auto" MinHeight="36"/>  <!-- 7: 데이터4 -->
                                </Grid.RowDefinitions>

                                <!-- ===== 왼쪽 5열 (Col 0-4) ===== -->

                                <!-- Row 0: 헤더 -->
                                <Border Grid.Row="0" Grid.Column="0" Style="{StaticResource TableHeaderCell}">
                                    <Viewbox Stretch="Uniform" StretchDirection="DownOnly" HorizontalAlignment="Left">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="물건지, 소유주 주소지 일치여부" Style="{StaticResource CellHeaderTextBlock}"/>
                                            <TextBlock Text=" (?)"
                                                       Style="{StaticResource CellHeaderTextBlock}"
                                                       Foreground="{StaticResource PrimaryBrush}"
                                                       Cursor="Help"
                                                       ToolTipService.InitialShowDelay="200"
                                                       ToolTip="등기부등본 OCR 업로드 필요"/>
                                        </StackPanel>
                                    </Viewbox>
                                </Border>
                                <Border Grid.Row="0" Grid.Column="1" Style="{StaticResource TableHeaderCell}">
                                    <TextBlock Text="차주구분" Style="{StaticResource CellHeaderTextBlock}"/>
                                </Border>
                                <Border Grid.Row="0" Grid.Column="2" Style="{StaticResource TableHeaderCell}">
                                    <TextBlock Text="임차인" Style="{StaticResource CellHeaderTextBlock}"/>
                                </Border>
                                <Border Grid.Row="0" Grid.Column="3" Style="{StaticResource TableHeaderCell}">
                                    <Viewbox Stretch="Uniform" StretchDirection="DownOnly" HorizontalAlignment="Left">
                                        <TextBlock Text="전입인(임차인)" Style="{StaticResource CellHeaderTextBlock}"/>
                                    </Viewbox>
                                </Border>
                                <Border Grid.Row="0" Grid.Column="4" Style="{StaticResource TableHeaderCell}">
                                    <Viewbox Stretch="Uniform" StretchDirection="DownOnly" HorizontalAlignment="Left">
                                        <TextBlock Text="전입일(임차시작일)" Style="{StaticResource CellHeaderTextBlock}"/>
                                    </Viewbox>
                                </Border>

                                <!-- Row 1: 데이터 -->
                                <Border Grid.Row="1" Grid.Column="0" Style="{StaticResource TableDataCell}">
                                    <CheckBox IsChecked="{Binding AddressMatch, Mode=OneWay}" IsHitTestVisible="False" Focusable="False" VerticalAlignment="Center"/>
                                </Border>
                                <Border Grid.Row="1" Grid.Column="1" Style="{StaticResource TableDataCell}">
                                    <TextBlock Text="{Binding BorrowerTypeDisplay}" Style="{StaticResource CellTextBlock}"/>
                                </Border>
                                <Border Grid.Row="1" Grid.Column="2" Style="{StaticResource TableDataCell}">
                                    <CheckBox IsChecked="{Binding HasTenant}" VerticalAlignment="Center"/>
                                </Border>
                                <Border Grid.Row="1" Grid.Column="3" Style="{StaticResource TableDataCell}">
                                    <TextBox Text="{Binding TenantName, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource InputTextBoxStyle}"/>
                                </Border>
                                <Border Grid.Row="1" Grid.Column="4" Style="{StaticResource TableDataCell}">
                                    <DatePicker SelectedDate="{Binding TenantMoveInDate}" Style="{StaticResource DateInputDatePicker}"/>
                                </Border>

                                <!-- Row 2: 헤더 -->
                                <Border Grid.Row="2" Grid.Column="0" Style="{StaticResource TableHeaderCell}">
                                    <TextBlock Text="소유주 전입" Style="{StaticResource CellHeaderTextBlock}"/>
                                </Border>
                                <Border Grid.Row="2" Grid.Column="1" Style="{StaticResource TableHeaderCell}">
                                    <TextBlock Text="경매열람자료" Style="{StaticResource CellHeaderTextBlock}"/>
                                </Border>
                                <Border Grid.Row="2" Grid.Column="2" Style="{StaticResource TableHeaderCell}">
                                    <Viewbox Stretch="Uniform" StretchDirection="DownOnly" HorizontalAlignment="Left">
                                        <TextBlock Text="전입세대열람, 상가임대차열람" Style="{StaticResource CellHeaderTextBlock}"/>
                                    </Viewbox>
                                </Border>
                                <Border Grid.Row="2" Grid.Column="3" Style="{StaticResource TableHeaderCell}">
                                    <Viewbox Stretch="Uniform" StretchDirection="DownOnly" HorizontalAlignment="Left">
                                        <TextBlock Text="임차인 배당요구신청" Style="{StaticResource CellHeaderTextBlock}"/>
                                    </Viewbox>
                                </Border>
                                <Border Grid.Row="2" Grid.Column="4" Style="{StaticResource TableHeaderCell}">
                                    <TextBlock Text="주택공시가격" Style="{StaticResource CellHeaderTextBlock}"/>
                                </Border>

                                <!-- Row 3: 데이터 -->
                                <Border Grid.Row="3" Grid.Column="0" Style="{StaticResource TableDataCell}">
                                    <CheckBox IsChecked="{Binding OwnerRegistered}" VerticalAlignment="Center"/>
                                </Border>
                                <Border Grid.Row="3" Grid.Column="1" Style="{StaticResource TableDataCell}">
                                    <CheckBox IsChecked="{Binding HasAuctionDocs}" VerticalAlignment="Center"/>
                                </Border>
                                <Border Grid.Row="3" Grid.Column="2" Style="{StaticResource TableDataCell}">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <RadioButton Content="전" GroupName="TenantRegistryGroup" IsChecked="{Binding HasTenantRegistry}" Margin="0,0,8,0" FontSize="12"/>
                                        <RadioButton Content="상" GroupName="TenantRegistryGroup" IsChecked="{Binding HasCommercialLease}" FontSize="12"/>
                                    </StackPanel>
                                </Border>
                                <Border Grid.Row="3" Grid.Column="3" Style="{StaticResource TableDataCell}">
                                    <CheckBox IsChecked="{Binding TenantClaimSubmitted}" VerticalAlignment="Center"/>
                                </Border>
                                <Border Grid.Row="3" Grid.Column="4" Style="{StaticResource TableDataCell}">
                                    <TextBlock Text="{Binding HousingOfficialPrice, StringFormat=N0}" Style="{StaticResource CellTextBlock}"/>
                                </Border>

                                <!-- Row 4: 헤더 -->
                                <Border Grid.Row="4" Grid.Column="0" Style="{StaticResource TableHeaderCell}">
                                    <TextBlock Text="임금채권" Style="{StaticResource CellHeaderTextBlock}"/>
                                </Border>
                                <Border Grid.Row="4" Grid.Column="1" Style="{StaticResource TableHeaderCell}">
                                    <Viewbox Stretch="Uniform" StretchDirection="DownOnly" HorizontalAlignment="Left">
                                        <TextBlock Text="임금채권 추정가압류" Style="{StaticResource CellHeaderTextBlock}"/>
                                    </Viewbox>
                                </Border>
                                <Border Grid.Row="4" Grid.Column="2" Style="{StaticResource TableHeaderCell}">
                                    <Viewbox Stretch="Uniform" StretchDirection="DownOnly" HorizontalAlignment="Left">
                                        <TextBlock Text="임금채권 배당요구신청" Style="{StaticResource CellHeaderTextBlock}"/>
                                    </Viewbox>
                                </Border>
                                <Border Grid.Row="4" Grid.Column="3" Style="{StaticResource TableHeaderCell}">
                                    <Viewbox Stretch="Uniform" StretchDirection="DownOnly" HorizontalAlignment="Left">
                                        <TextBlock Text="당해세 교부청구" Style="{StaticResource CellHeaderTextBlock}"/>
                                    </Viewbox>
                                </Border>
                                <Border Grid.Row="4" Grid.Column="4" Style="{StaticResource TableHeaderCell}">
                                    <Viewbox Stretch="Uniform" StretchDirection="DownOnly" HorizontalAlignment="Left">
                                        <TextBlock Text="선순위조세 교부청구" Style="{StaticResource CellHeaderTextBlock}"/>
                                    </Viewbox>
                                </Border>

                                <!-- Row 5: 데이터 -->
                                <Border Grid.Row="5" Grid.Column="0" Style="{StaticResource TableDataCell}">
                                    <CheckBox IsChecked="{Binding HasWageClaim}" VerticalAlignment="Center"/>
                                </Border>
                                <Border Grid.Row="5" Grid.Column="1" Style="{StaticResource TableDataCell}">
                                    <TextBox Text="{Binding WageClaimEstimatedSeizure, StringFormat=N0, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource InputTextBoxStyle}" FontSize="{StaticResource FontSizeBody}" HorizontalContentAlignment="Right"/>
                                </Border>
                                <Border Grid.Row="5" Grid.Column="2" Style="{StaticResource TableDataCell}">
                                    <CheckBox IsChecked="{Binding WageClaimSubmitted}" VerticalAlignment="Center"/>
                                </Border>
                                <Border Grid.Row="5" Grid.Column="3" Style="{StaticResource TableDataCell}">
                                    <CheckBox IsChecked="{Binding HasTaxClaim}" VerticalAlignment="Center"/>
                                </Border>
                                <Border Grid.Row="5" Grid.Column="4" Style="{StaticResource TableDataCell}">
                                    <CheckBox IsChecked="{Binding HasSeniorTaxClaim}" VerticalAlignment="Center"/>
                                </Border>

                                <!-- Row 6: 헤더 -->
                                <Border Grid.Row="6" Grid.Column="0" Style="{StaticResource TableHeaderCell}">
                                    <TextBlock Text="공시지가" Style="{StaticResource CellHeaderTextBlock}"/>
                                </Border>
                                <Border Grid.Row="6" Grid.Column="1" Style="{StaticResource TableHeaderCell}">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="건물기준시가" Style="{StaticResource CellHeaderTextBlock}"/>
                                        <TextBlock Text=" (?)"
                                                   Style="{StaticResource CellHeaderTextBlock}"
                                                   Foreground="{StaticResource PrimaryBrush}"
                                                   Cursor="Help"
                                                   ToolTipService.InitialShowDelay="200"
                                                   ToolTip="건물감정가액의 70%로 계산됩니다."/>
                                    </StackPanel>
                                </Border>
                                <Border Grid.Row="6" Grid.Column="2" Style="{StaticResource TableDataCell}"/>
                                <Border Grid.Row="6" Grid.Column="3" Style="{StaticResource TableDataCell}"/>
                                <Border Grid.Row="6" Grid.Column="4" Style="{StaticResource TableDataCell}"/>

                                <!-- Row 7: 데이터 -->
                                <Border Grid.Row="7" Grid.Column="0" Style="{StaticResource TableDataCell}">
                                    <TextBlock Text="{Binding OfficialLandPrice, StringFormat=N0}" Style="{StaticResource CellTextBlock}"/>
                                </Border>
                                <Border Grid.Row="7" Grid.Column="1" Style="{StaticResource TableDataCell}">
                                    <TextBox Text="{Binding BuildingStandardPrice, StringFormat=N0, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource InputTextBoxStyle}" FontSize="{StaticResource FontSizeBody}" HorizontalContentAlignment="Right"/>
                                </Border>
                                <Border Grid.Row="7" Grid.Column="2" Style="{StaticResource TableDataCell}"/>
                                <Border Grid.Row="7" Grid.Column="3" Style="{StaticResource TableDataCell}"/>
                                <Border Grid.Row="7" Grid.Column="4" Style="{StaticResource TableDataCell}"/>

                                <!-- ===== 오른쪽 3열 (Col 5-7) ===== -->

                                <!-- Row 0: 헤더 -->
                                <Border Grid.Row="0" Grid.Column="5" Style="{StaticResource TableHeaderCell}" BorderThickness="2,0,1,1">
                                    <TextBlock Text="접수정보" Style="{StaticResource CellHeaderTextBlock}"/>
                                </Border>
                                <Border Grid.Row="0" Grid.Column="6" Style="{StaticResource TableHeaderCell}">
                                    <TextBlock Text="근저당권자" Style="{StaticResource CellHeaderTextBlock}"/>
                                </Border>
                                <Border Grid.Row="0" Grid.Column="7" Style="{StaticResource TableHeaderCell}" BorderThickness="0,0,0,1">
                                    <TextBlock Text="채권최고액" Style="{StaticResource CellHeaderTextBlock}"/>
                                </Border>

                                <!-- Row 1-7: 데이터 (OCR 을구 자동표시, 읽기전용) -->
                                <Border Grid.Row="1" Grid.Column="5" Style="{StaticResource TableDataCell}" BorderThickness="2,0,1,1">
                                    <TextBlock Text="{Binding RegistryMortgageRows[0].Receipt}" Style="{StaticResource CellTextBlock}"/>
                                </Border>
                                <Border Grid.Row="1" Grid.Column="6" Style="{StaticResource TableDataCell}">
                                    <TextBlock Text="{Binding RegistryMortgageRows[0].MortgageHolder}" Style="{StaticResource CellTextBlock}"/>
                                </Border>
                                <Border Grid.Row="1" Grid.Column="7" Style="{StaticResource TableDataCell}" BorderThickness="0,0,0,1">
                                    <TextBlock Text="{Binding RegistryMortgageRows[0].MaxClaimAmount, StringFormat=N0}" Style="{StaticResource CellTextBlock}" TextAlignment="Right"/>
                                </Border>

                                <Border Grid.Row="2" Grid.Column="5" Style="{StaticResource TableDataCell}" BorderThickness="2,0,1,1">
                                    <TextBlock Text="{Binding RegistryMortgageRows[1].Receipt}" Style="{StaticResource CellTextBlock}"/>
                                </Border>
                                <Border Grid.Row="2" Grid.Column="6" Style="{StaticResource TableDataCell}">
                                    <TextBlock Text="{Binding RegistryMortgageRows[1].MortgageHolder}" Style="{StaticResource CellTextBlock}"/>
                                </Border>
                                <Border Grid.Row="2" Grid.Column="7" Style="{StaticResource TableDataCell}" BorderThickness="0,0,0,1">
                                    <TextBlock Text="{Binding RegistryMortgageRows[1].MaxClaimAmount, StringFormat=N0}" Style="{StaticResource CellTextBlock}" TextAlignment="Right"/>
                                </Border>

                                <Border Grid.Row="3" Grid.Column="5" Style="{StaticResource TableDataCell}" BorderThickness="2,0,1,1">
                                    <TextBlock Text="{Binding RegistryMortgageRows[2].Receipt}" Style="{StaticResource CellTextBlock}"/>
                                </Border>
                                <Border Grid.Row="3" Grid.Column="6" Style="{StaticResource TableDataCell}">
                                    <TextBlock Text="{Binding RegistryMortgageRows[2].MortgageHolder}" Style="{StaticResource CellTextBlock}"/>
                                </Border>
                                <Border Grid.Row="3" Grid.Column="7" Style="{StaticResource TableDataCell}" BorderThickness="0,0,0,1">
                                    <TextBlock Text="{Binding RegistryMortgageRows[2].MaxClaimAmount, StringFormat=N0}" Style="{StaticResource CellTextBlock}" TextAlignment="Right"/>
                                </Border>

                                <Border Grid.Row="4" Grid.Column="5" Style="{StaticResource TableDataCell}" BorderThickness="2,0,1,1">
                                    <TextBlock Text="{Binding RegistryMortgageRows[3].Receipt}" Style="{StaticResource CellTextBlock}"/>
                                </Border>
                                <Border Grid.Row="4" Grid.Column="6" Style="{StaticResource TableDataCell}">
                                    <TextBlock Text="{Binding RegistryMortgageRows[3].MortgageHolder}" Style="{StaticResource CellTextBlock}"/>
                                </Border>
                                <Border Grid.Row="4" Grid.Column="7" Style="{StaticResource TableDataCell}" BorderThickness="0,0,0,1">
                                    <TextBlock Text="{Binding RegistryMortgageRows[3].MaxClaimAmount, StringFormat=N0}" Style="{StaticResource CellTextBlock}" TextAlignment="Right"/>
                                </Border>

                                <Border Grid.Row="5" Grid.Column="5" Style="{StaticResource TableDataCell}" BorderThickness="2,0,1,1">
                                    <TextBlock Text="{Binding RegistryMortgageRows[4].Receipt}" Style="{StaticResource CellTextBlock}"/>
                                </Border>
                                <Border Grid.Row="5" Grid.Column="6" Style="{StaticResource TableDataCell}">
                                    <TextBlock Text="{Binding RegistryMortgageRows[4].MortgageHolder}" Style="{StaticResource CellTextBlock}"/>
                                </Border>
                                <Border Grid.Row="5" Grid.Column="7" Style="{StaticResource TableDataCell}" BorderThickness="0,0,0,1">
                                    <TextBlock Text="{Binding RegistryMortgageRows[4].MaxClaimAmount, StringFormat=N0}" Style="{StaticResource CellTextBlock}" TextAlignment="Right"/>
                                </Border>

                                <Border Grid.Row="6" Grid.Column="5" Style="{StaticResource TableDataCell}" BorderThickness="2,0,1,1">
                                    <TextBlock Text="{Binding RegistryMortgageRows[5].Receipt}" Style="{StaticResource CellTextBlock}"/>
                                </Border>
                                <Border Grid.Row="6" Grid.Column="6" Style="{StaticResource TableDataCell}">
                                    <TextBlock Text="{Binding RegistryMortgageRows[5].MortgageHolder}" Style="{StaticResource CellTextBlock}"/>
                                </Border>
                                <Border Grid.Row="6" Grid.Column="7" Style="{StaticResource TableDataCell}" BorderThickness="0,0,0,1">
                                    <TextBlock Text="{Binding RegistryMortgageRows[5].MaxClaimAmount, StringFormat=N0}" Style="{StaticResource CellTextBlock}" TextAlignment="Right"/>
                                </Border>

                                <Border Grid.Row="7" Grid.Column="5" Style="{StaticResource TableDataCell}" BorderThickness="2,0,1,1">
                                    <TextBlock Text="{Binding RegistryMortgageRows[6].Receipt}" Style="{StaticResource CellTextBlock}"/>
                                </Border>
                                <Border Grid.Row="7" Grid.Column="6" Style="{StaticResource TableDataCell}">
                                    <TextBlock Text="{Binding RegistryMortgageRows[6].MortgageHolder}" Style="{StaticResource CellTextBlock}"/>
                                </Border>
                                <Border Grid.Row="7" Grid.Column="7" Style="{StaticResource TableDataCell}" BorderThickness="0,0,0,1">
                                    <TextBlock Text="{Binding RegistryMortgageRows[6].MaxClaimAmount, StringFormat=N0}" Style="{StaticResource CellTextBlock}" TextAlignment="Right"/>
                                </Border>

                                <!-- 컬럼 너비 조정 핸들 -->
                                <GridSplitter Grid.Column="0" Grid.RowSpan="8" Width="5" HorizontalAlignment="Right" Background="Transparent" Cursor="SizeWE"/>
                                <GridSplitter Grid.Column="1" Grid.RowSpan="8" Width="5" HorizontalAlignment="Right" Background="Transparent" Cursor="SizeWE"/>
                                <GridSplitter Grid.Column="2" Grid.RowSpan="8" Width="5" HorizontalAlignment="Right" Background="Transparent" Cursor="SizeWE"/>
                                <GridSplitter Grid.Column="3" Grid.RowSpan="8" Width="5" HorizontalAlignment="Right" Background="Transparent" Cursor="SizeWE"/>
                                <GridSplitter Grid.Column="4" Grid.RowSpan="8" Width="5" HorizontalAlignment="Right" Background="Transparent" Cursor="SizeWE"/>
                                <GridSplitter Grid.Column="5" Grid.RowSpan="8" Width="5" HorizontalAlignment="Right" Background="Transparent" Cursor="SizeWE"/>
                                <GridSplitter Grid.Column="6" Grid.RowSpan="8" Width="5" HorizontalAlignment="Right" Background="Transparent" Cursor="SizeWE"/>
                            </Grid>

                            <!-- 하단: 저장 버튼 (오른쪽) -->
                            <Grid Margin="0,8,0,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Button Grid.Column="1" Content="저장"
                                        Command="{Binding SaveTenantInfoCommand}"
                                        Style="{StaticResource MaterialDesignRaisedButton}"
                                        Padding="12,6"/>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- ========== 3. 선순위 항목 산정표 ========== -->
                    <Border Background="{StaticResource SurfaceColor}"
                            BorderBrush="{StaticResource BorderBrush}"
                            BorderThickness="1"
                            CornerRadius="8"
                            Margin="0,0,0,16">
                        <StackPanel>
                            <!-- 섹션 헤더 -->
                            <Border Background="{StaticResource PrimaryBrush}"
                                    CornerRadius="8,8,0,0"
                                    Padding="16,10">
                                <TextBlock Text="📊 선순위 항목 산정표"
                                           Foreground="White"
                                           FontWeight="SemiBold"
                                           FontSize="{StaticResource FontSizeH4}"/>
                            </Border>

                            <!-- 9x4 테이블 -->
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="2*" MinWidth="180"/>
                                    <ColumnDefinition Width="*" MinWidth="120"/>
                                    <ColumnDefinition Width="*" MinWidth="140"/>
                                    <ColumnDefinition Width="2*" MinWidth="220"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" MinHeight="36"/>
                                    <RowDefinition Height="Auto" MinHeight="36"/>
                                    <RowDefinition Height="Auto" MinHeight="36"/>
                                    <RowDefinition Height="Auto" MinHeight="36"/>
                                    <RowDefinition Height="Auto" MinHeight="36"/>
                                    <RowDefinition Height="Auto" MinHeight="36"/>
                                    <RowDefinition Height="Auto" MinHeight="36"/>
                                    <RowDefinition Height="Auto" MinHeight="36"/>
                                    <RowDefinition Height="Auto" MinHeight="36"/>
                                </Grid.RowDefinitions>

                                <!-- Row 0: 헤더 -->
                                <Border Grid.Row="0" Grid.Column="0" Style="{StaticResource TableHeaderCell}">
                                    <TextBlock Text="선순위 구분" Style="{StaticResource CellHeaderTextBlock}"/>
                                </Border>
                                <Border Grid.Row="0" Grid.Column="1" Style="{StaticResource TableHeaderCell}">
                                    <TextBlock Text="DD" Style="{StaticResource CellHeaderTextBlock}"/>
                                </Border>
                                <Border Grid.Row="0" Grid.Column="2" Style="{StaticResource TableHeaderCell}">
                                    <TextBlock Text="평가자 반영 금액" Style="{StaticResource CellHeaderTextBlock}"/>
                                </Border>
                                <Border Grid.Row="0" Grid.Column="3" Style="{StaticResource TableHeaderCell}" BorderThickness="0,0,0,1">
                                    <TextBlock Text="상세추정 근거" Style="{StaticResource CellHeaderTextBlock}"/>
                                </Border>

                                <!-- Row 1 -->
                                <Border Grid.Row="1" Grid.Column="0" Style="{StaticResource TableHeaderCell}">
                                    <TextBlock Text="선순위근저당권" Style="{StaticResource CellHeaderTextBlock}"/>
                                </Border>
                                <Border Grid.Row="1" Grid.Column="1" Style="{StaticResource TableDataCell}">
                                    <TextBlock Text="{Binding SeniorMortgageDd, StringFormat=N0}" Style="{StaticResource CellTextBlock}" TextAlignment="Right"/>
                                </Border>
                                <Border Grid.Row="1" Grid.Column="2" Style="{StaticResource TableDataCell}">
                                    <TextBox Text="{Binding SeniorMortgageReflected, StringFormat=N0, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource InputTextBoxStyle}" HorizontalContentAlignment="Right"/>
                                </Border>
                                <Border Grid.Row="1" Grid.Column="3" Style="{StaticResource TableDataCell}" BorderThickness="0,0,0,1">
                                    <TextBox Text="{Binding SeniorMortgageReason, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource InputTextBoxStyle}" TextWrapping="Wrap" AcceptsReturn="True"/>
                                </Border>

                                <!-- Row 2 -->
                                <Border Grid.Row="2" Grid.Column="0" Style="{StaticResource TableHeaderCell}">
                                    <TextBlock Text="유치권 신고금액" Style="{StaticResource CellHeaderTextBlock}"/>
                                </Border>
                                <Border Grid.Row="2" Grid.Column="1" Style="{StaticResource TableDataCell}">
                                    <TextBlock Text="{Binding LienDd, StringFormat=N0}" Style="{StaticResource CellTextBlock}" TextAlignment="Right"/>
                                </Border>
                                <Border Grid.Row="2" Grid.Column="2" Style="{StaticResource TableDataCell}">
                                    <TextBox Text="{Binding LienReflected, StringFormat=N0, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource InputTextBoxStyle}" HorizontalContentAlignment="Right"/>
                                </Border>
                                <Border Grid.Row="2" Grid.Column="3" Style="{StaticResource TableDataCell}" BorderThickness="0,0,0,1">
                                    <TextBox Text="{Binding LienReason, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource InputTextBoxStyle}" TextWrapping="Wrap" AcceptsReturn="True"/>
                                </Border>

                                <!-- Row 3 -->
                                <Border Grid.Row="3" Grid.Column="0" Style="{StaticResource TableHeaderCell}">
                                    <TextBlock Text="선순위소액보증금" Style="{StaticResource CellHeaderTextBlock}"/>
                                </Border>
                                <Border Grid.Row="3" Grid.Column="1" Style="{StaticResource TableDataCell}">
                                    <TextBlock Text="{Binding SmallDepositDd, StringFormat=N0}" Style="{StaticResource CellTextBlock}" TextAlignment="Right"/>
                                </Border>
                                <Border Grid.Row="3" Grid.Column="2" Style="{StaticResource TableDataCell}">
                                    <TextBox Text="{Binding SmallDepositReflected, StringFormat=N0, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource InputTextBoxStyle}" HorizontalContentAlignment="Right"/>
                                </Border>
                                <Border Grid.Row="3" Grid.Column="3" Style="{StaticResource TableDataCell}" BorderThickness="0,0,0,1">
                                    <TextBox Text="{Binding SmallDepositReason, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource InputTextBoxStyle}" TextWrapping="Wrap" AcceptsReturn="True"/>
                                </Border>

                                <!-- Row 4 -->
                                <Border Grid.Row="4" Grid.Column="0" Style="{StaticResource TableHeaderCell}">
                                    <TextBlock Text="선순위임차보증금" Style="{StaticResource CellHeaderTextBlock}"/>
                                </Border>
                                <Border Grid.Row="4" Grid.Column="1" Style="{StaticResource TableDataCell}">
                                    <TextBlock Text="{Binding LeaseDepositDd, StringFormat=N0}" Style="{StaticResource CellTextBlock}" TextAlignment="Right"/>
                                </Border>
                                <Border Grid.Row="4" Grid.Column="2" Style="{StaticResource TableDataCell}">
                                    <TextBox Text="{Binding LeaseDepositReflected, StringFormat=N0, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource InputTextBoxStyle}" HorizontalContentAlignment="Right"/>
                                </Border>
                                <Border Grid.Row="4" Grid.Column="3" Style="{StaticResource TableDataCell}" BorderThickness="0,0,0,1">
                                    <TextBox Text="{Binding LeaseDepositReason, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource InputTextBoxStyle}" TextWrapping="Wrap" AcceptsReturn="True"/>
                                </Border>

                                <!-- Row 5 -->
                                <Border Grid.Row="5" Grid.Column="0" Style="{StaticResource TableHeaderCell}">
                                    <TextBlock Text="선순위 임금채권" Style="{StaticResource CellHeaderTextBlock}"/>
                                </Border>
                                <Border Grid.Row="5" Grid.Column="1" Style="{StaticResource TableDataCell}">
                                    <TextBlock Text="{Binding WageClaimDd, StringFormat=N0}" Style="{StaticResource CellTextBlock}" TextAlignment="Right"/>
                                </Border>
                                <Border Grid.Row="5" Grid.Column="2" Style="{StaticResource TableDataCell}">
                                    <TextBox Text="{Binding WageClaimReflected, StringFormat=N0, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource InputTextBoxStyle}" HorizontalContentAlignment="Right"/>
                                </Border>
                                <Border Grid.Row="5" Grid.Column="3" Style="{StaticResource TableDataCell}" BorderThickness="0,0,0,1">
                                    <TextBox Text="{Binding WageClaimReason, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource InputTextBoxStyle}" TextWrapping="Wrap" AcceptsReturn="True"/>
                                </Border>

                                <!-- Row 6 -->
                                <Border Grid.Row="6" Grid.Column="0" Style="{StaticResource TableHeaderCell}">
                                    <TextBlock Text="당해세" Style="{StaticResource CellHeaderTextBlock}"/>
                                </Border>
                                <Border Grid.Row="6" Grid.Column="1" Style="{StaticResource TableDataCell}">
                                    <TextBlock Text="{Binding CurrentTaxDd, StringFormat=N0}" Style="{StaticResource CellTextBlock}" TextAlignment="Right"/>
                                </Border>
                                <Border Grid.Row="6" Grid.Column="2" Style="{StaticResource TableDataCell}">
                                    <TextBox Text="{Binding CurrentTax, StringFormat=N0, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource InputTextBoxStyle}" HorizontalContentAlignment="Right"/>
                                </Border>
                                <Border Grid.Row="6" Grid.Column="3" Style="{StaticResource TableDataCell}" BorderThickness="0,0,0,1">
                                    <TextBox Text="{Binding CurrentTaxReason, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource InputTextBoxStyle}" TextWrapping="Wrap" AcceptsReturn="True"/>
                                </Border>

                                <!-- Row 7 -->
                                <Border Grid.Row="7" Grid.Column="0" Style="{StaticResource TableHeaderCell}">
                                    <TextBlock Text="선순위 조세채권" Style="{StaticResource CellHeaderTextBlock}"/>
                                </Border>
                                <Border Grid.Row="7" Grid.Column="1" Style="{StaticResource TableDataCell}">
                                    <TextBlock Text="{Binding SeniorTaxClaimDd, StringFormat=N0}" Style="{StaticResource CellTextBlock}" TextAlignment="Right"/>
                                </Border>
                                <Border Grid.Row="7" Grid.Column="2" Style="{StaticResource TableDataCell}">
                                    <TextBox Text="{Binding SeniorTaxClaimReflected, StringFormat=N0, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource InputTextBoxStyle}" HorizontalContentAlignment="Right"/>
                                </Border>
                                <Border Grid.Row="7" Grid.Column="3" Style="{StaticResource TableDataCell}" BorderThickness="0,0,0,1">
                                    <TextBox Text="{Binding SeniorTaxClaimReason, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource InputTextBoxStyle}" TextWrapping="Wrap" AcceptsReturn="True"/>
                                </Border>

                                <!-- Row 8 -->
                                <Border Grid.Row="8" Grid.Column="0" Style="{StaticResource TableHeaderCell}">
                                    <TextBlock Text="합계" Style="{StaticResource CellHeaderTextBlock}"/>
                                </Border>
                                <Border Grid.Row="8" Grid.Column="1" Style="{StaticResource TableDataCell}">
                                    <TextBlock Text="{Binding SeniorRightsDdTotal, StringFormat=N0}" Style="{StaticResource CellTextBlock}" FontWeight="SemiBold" TextAlignment="Right"/>
                                </Border>
                                <Border Grid.Row="8" Grid.Column="2" Style="{StaticResource TableDataCell}">
                                    <TextBlock Text="{Binding SeniorRightsReflectedTotal, StringFormat=N0}" Style="{StaticResource CellTextBlock}" FontWeight="SemiBold" TextAlignment="Right"/>
                                </Border>
                                <Border Grid.Row="8" Grid.Column="3" Style="{StaticResource TableDataCell}" BorderThickness="0,0,0,1"/>

                                <!-- 컬럼 너비 조정 핸들 -->
                                <GridSplitter Grid.Column="0" Grid.RowSpan="9" Width="5" HorizontalAlignment="Right" Background="Transparent" Cursor="SizeWE"/>
                                <GridSplitter Grid.Column="1" Grid.RowSpan="9" Width="5" HorizontalAlignment="Right" Background="Transparent" Cursor="SizeWE"/>
                                <GridSplitter Grid.Column="2" Grid.RowSpan="9" Width="5" HorizontalAlignment="Right" Background="Transparent" Cursor="SizeWE"/>
                            </Grid>

                            <!-- 자동 판단 버튼 -->
                            <Grid Margin="0,8,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Button Grid.Column="1"
                                        Content="자동 판단"
                                        Command="{Binding AutoJudgeCommand}"
                                        Style="{StaticResource MaterialDesignRaisedButton}"
                                        Padding="12,6"/>
                            </Grid>

                            <!-- 하단 2x4 표: 열람 자료 -->
                            <Grid Margin="0,12,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" MinHeight="36"/>
                                    <RowDefinition Height="Auto" MinHeight="180"/>
                                </Grid.RowDefinitions>

                                <!-- Row 1: 헤더 -->
                                <Border Grid.Row="0" Grid.Column="0" Style="{StaticResource TableHeaderCell}">
                                    <TextBlock Text="전입세대열람" Style="{StaticResource CellHeaderTextBlock}" HorizontalAlignment="Center" TextAlignment="Center"/>
                                </Border>
                                <Border Grid.Row="0" Grid.Column="1" Style="{StaticResource TableHeaderCell}">
                                    <TextBlock Text="상가임대차열람" Style="{StaticResource CellHeaderTextBlock}" HorizontalAlignment="Center" TextAlignment="Center"/>
                                </Border>
                                <Border Grid.Row="0" Grid.Column="2" Style="{StaticResource TableHeaderCell}">
                                    <TextBlock Text="권리분석" Style="{StaticResource CellHeaderTextBlock}" HorizontalAlignment="Center" TextAlignment="Center"/>
                                </Border>
                                <Border Grid.Row="0" Grid.Column="3" Style="{StaticResource TableHeaderCell}" BorderThickness="0,0,0,1">
                                    <TextBlock Text="임금자료" Style="{StaticResource CellHeaderTextBlock}" HorizontalAlignment="Center" TextAlignment="Center"/>
                                </Border>

                                <!-- Row 2: 전입세대열람 -->
                                <Border Grid.Row="1" Grid.Column="0" Style="{StaticResource TableDataCell}">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="140" MinHeight="40"/>
                                            <RowDefinition Height="5"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>
                                        <Button Grid.Row="0"
                                                Content="이미지 붙여넣기"
                                                Command="{Binding PasteTenantRegistryImageCommand}"
                                                Style="{StaticResource SecondaryButton}"
                                                Padding="8,4"
                                                FontSize="{StaticResource FontSizeTiny}"
                                                HorizontalAlignment="Left"
                                                Margin="0,0,0,6"/>
                                        <Image Grid.Row="1" Source="{Binding TenantRegistryImage}" Stretch="Uniform"/>
                                        <GridSplitter Grid.Row="2"
                                                      HorizontalAlignment="Stretch"
                                                      ResizeDirection="Rows"
                                                      Background="#E0E0E0"
                                                      Cursor="SizeNS"
                                                      Height="5"/>
                                        <TextBlock Grid.Row="3"
                                                   Text="{Binding TenantRegistryImageInfo}"
                                                   FontSize="{StaticResource FontSizeTiny}"
                                                   Opacity="0.7"
                                                   TextWrapping="Wrap"
                                                   Margin="0,6,0,0"/>
                                    </Grid>
                                </Border>

                                <!-- Row 2: 상가임대차열람 -->
                                <Border Grid.Row="1" Grid.Column="1" Style="{StaticResource TableDataCell}">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="140" MinHeight="40"/>
                                            <RowDefinition Height="5"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>
                                        <Button Grid.Row="0"
                                                Content="이미지 붙여넣기"
                                                Command="{Binding PasteCommercialLeaseImageCommand}"
                                                Style="{StaticResource SecondaryButton}"
                                                Padding="8,4"
                                                FontSize="{StaticResource FontSizeTiny}"
                                                HorizontalAlignment="Left"
                                                Margin="0,0,0,6"/>
                                        <Image Grid.Row="1" Source="{Binding CommercialLeaseImage}" Stretch="Uniform"/>
                                        <GridSplitter Grid.Row="2"
                                                      HorizontalAlignment="Stretch"
                                                      ResizeDirection="Rows"
                                                      Background="#E0E0E0"
                                                      Cursor="SizeNS"
                                                      Height="5"/>
                                        <TextBlock Grid.Row="3"
                                                   Text="{Binding CommercialLeaseImageInfo}"
                                                   FontSize="{StaticResource FontSizeTiny}"
                                                   Opacity="0.7"
                                                   TextWrapping="Wrap"
                                                   Margin="0,6,0,0"/>
                                    </Grid>
                                </Border>

                                <!-- Row 2: 권리분석(현재 미사용) -->
                                <Border Grid.Row="1" Grid.Column="2" Style="{StaticResource TableDataCell}">
                                    <Grid Background="#F8FAFC">
                                        <Viewbox Stretch="Fill">
                                            <Canvas Width="120" Height="120">
                                                <Line X1="0" Y1="0" X2="120" Y2="120" Stroke="#B0BEC5" StrokeThickness="3"/>
                                            </Canvas>
                                        </Viewbox>
                                    </Grid>
                                </Border>

                                <!-- Row 2: 임금자료 -->
                                <Border Grid.Row="1" Grid.Column="3" Style="{StaticResource TableDataCell}" BorderThickness="0,0,0,1">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="140" MinHeight="40"/>
                                            <RowDefinition Height="5"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>
                                        <Button Grid.Row="0"
                                                Content="이미지 붙여넣기"
                                                Command="{Binding PasteWageDataImageCommand}"
                                                Style="{StaticResource SecondaryButton}"
                                                Padding="8,4"
                                                FontSize="{StaticResource FontSizeTiny}"
                                                HorizontalAlignment="Left"
                                                Margin="0,0,0,6"/>
                                        <Image Grid.Row="1" Source="{Binding WageDataImage}" Stretch="Uniform"/>
                                        <GridSplitter Grid.Row="2"
                                                      HorizontalAlignment="Stretch"
                                                      ResizeDirection="Rows"
                                                      Background="#E0E0E0"
                                                      Cursor="SizeNS"
                                                      Height="5"/>
                                        <TextBlock Grid.Row="3"
                                                   Text="{Binding WageDataImageInfo}"
                                                   FontSize="{StaticResource FontSizeTiny}"
                                                   Opacity="0.7"
                                                   TextWrapping="Wrap"
                                                   Margin="0,6,0,0"/>
                                    </Grid>
                                </Border>
                            </Grid>

                            <!-- 하단: 저장 버튼 (오른쪽) -->
                            <Grid Margin="0,8,0,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Button Grid.Column="1"
                                        Content="저장"
                                        Command="{Binding SaveRightAnalysisCommand}"
                                        Style="{StaticResource MaterialDesignRaisedButton}"
                                        Padding="12,6"/>
                            </Grid>
                        </StackPanel>
                    </Border>

                        </StackPanel>
                    </ScrollViewer>

                    <!-- 하단 영역: DataGrid 테이블들 (수평 스크롤 불필요, star 컬럼 정상 작동) -->

                    <!-- ========== 4. 주택임대차 ========== -->
                    <Border Background="{StaticResource SurfaceColor}"
                            BorderBrush="{StaticResource BorderBrush}"
                            BorderThickness="1"
                            CornerRadius="8"
                            Margin="0,0,0,16">
                        <StackPanel>
                            <Border Background="{StaticResource PrimaryBrush}"
                                    CornerRadius="8,8,0,0"
                                    Padding="16,10">
                                <Grid>
                                    <TextBlock Text="주택임대차"
                                               Foreground="White"
                                               FontWeight="SemiBold"
                                               FontSize="{StaticResource FontSizeH4}"
                                               VerticalAlignment="Center"/>
                                    <Button Content="+"
                                            FontSize="16"
                                            FontWeight="Bold"
                                            HorizontalAlignment="Right"
                                            Command="{Binding CreateResidentialLeaseTableCommand}"
                                            Visibility="{Binding HasResidentialLeaseTable, Converter={StaticResource InverseBooleanToVisibilityConverter}}"
                                            Background="Transparent"
                                            Foreground="White"
                                            BorderThickness="0"
                                            Padding="8,2"
                                            Cursor="Hand"
                                            ToolTip="주택임대차 테이블 생성"/>
                                </Grid>
                            </Border>

                            <Grid Margin="12"
                                  Visibility="{Binding HasResidentialLeaseTable, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <DataGrid x:Name="ResidentialLeaseGrid"
                                          PreviewMouseWheel="DataGrid_PreviewMouseWheel"
                                          Grid.Row="0"
                                          ItemsSource="{Binding ResidentialLeases}"
                                          AutoGenerateColumns="False"
                                          CanUserAddRows="False"
                                          CanUserDeleteRows="False"
                                          CanUserSortColumns="False"
                                          HeadersVisibility="Column"
                                          ColumnWidth="*"
                                          Background="White"
                                          RowBackground="White"
                                          AlternatingRowBackground="#FAFAFA"
                                          BorderThickness="1"
                                          BorderBrush="{StaticResource BorderBrush}"
                                          GridLinesVisibility="All"
                                          HorizontalGridLinesBrush="{StaticResource BorderBrush}"
                                          VerticalGridLinesBrush="{StaticResource BorderBrush}"
                                          RowHeight="32"
                                          ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                          MinHeight="60">
                                    <DataGrid.ColumnHeaderStyle>
                                        <StaticResource ResourceKey="SectionDataGridColumnHeaderStyle"/>
                                    </DataGrid.ColumnHeaderStyle>
                                    <DataGrid.CellStyle>
                                        <StaticResource ResourceKey="SectionDataGridCellStyle"/>
                                    </DataGrid.CellStyle>
                                    <DataGrid.RowStyle>
                                        <StaticResource ResourceKey="SectionDataGridRowStyle"/>
                                    </DataGrid.RowStyle>
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="구분" Binding="{Binding Category, UpdateSourceTrigger=PropertyChanged}" Width="*" ElementStyle="{StaticResource SectionDataGridTextBlockStyle}" EditingElementStyle="{StaticResource SectionDataGridTextBoxStyle}"/>
                                        <DataGridTextColumn Header="면적" Binding="{Binding Area, UpdateSourceTrigger=PropertyChanged}" Width="*" ElementStyle="{StaticResource SectionDataGridTextBlockStyle}" EditingElementStyle="{StaticResource SectionDataGridTextBoxStyle}"/>
                                        <DataGridTextColumn Header="임차인" Binding="{Binding TenantName, UpdateSourceTrigger=PropertyChanged}" Width="*" ElementStyle="{StaticResource SectionDataGridTextBlockStyle}" EditingElementStyle="{StaticResource SectionDataGridTextBoxStyle}"/>
                                        <DataGridTextColumn Header="임차개시일" Binding="{Binding LeaseStartDate, StringFormat=yyyy-MM-dd, UpdateSourceTrigger=PropertyChanged}" Width="*" ElementStyle="{StaticResource SectionDataGridTextBlockStyle}" EditingElementStyle="{StaticResource SectionDataGridTextBoxStyle}"/>
                                        <DataGridTextColumn Header="임차종료일" Binding="{Binding LeaseEndDate, StringFormat=yyyy-MM-dd, UpdateSourceTrigger=PropertyChanged}" Width="*" ElementStyle="{StaticResource SectionDataGridTextBlockStyle}" EditingElementStyle="{StaticResource SectionDataGridTextBoxStyle}"/>
                                        <DataGridTextColumn Header="전입일" Binding="{Binding MoveInDate, StringFormat=yyyy-MM-dd, UpdateSourceTrigger=PropertyChanged}" Width="*" ElementStyle="{StaticResource SectionDataGridTextBlockStyle}" EditingElementStyle="{StaticResource SectionDataGridTextBoxStyle}"/>
                                        <DataGridTextColumn Header="보증금" Binding="{Binding Deposit, StringFormat=N0, UpdateSourceTrigger=PropertyChanged}" Width="*" ElementStyle="{StaticResource SectionDataGridTextBlockStyle}" EditingElementStyle="{StaticResource SectionDataGridTextBoxStyle}"/>
                                        <DataGridTextColumn Header="월세" Binding="{Binding MonthlyRent, StringFormat=N0, UpdateSourceTrigger=PropertyChanged}" Width="*" ElementStyle="{StaticResource SectionDataGridTextBlockStyle}" EditingElementStyle="{StaticResource SectionDataGridTextBoxStyle}"/>
                                        <DataGridTextColumn Header="소액보증금" Binding="{Binding SmallDeposit, StringFormat=N0, UpdateSourceTrigger=PropertyChanged}" Width="*" ElementStyle="{StaticResource SectionDataGridTextBlockStyle}" EditingElementStyle="{StaticResource SectionDataGridTextBoxStyle}"/>
                                        <DataGridTextColumn Header="선순위 보증금" Binding="{Binding SeniorDeposit, StringFormat=N0, UpdateSourceTrigger=PropertyChanged}" Width="*" ElementStyle="{StaticResource SectionDataGridTextBlockStyle}" EditingElementStyle="{StaticResource SectionDataGridTextBoxStyle}"/>
                                    </DataGrid.Columns>
                                </DataGrid>

                                <Grid Grid.Row="1" Margin="0,8,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Button Grid.Column="1"
                                            Command="{Binding AddResidentialLeaseRowCommand}"
                                            Style="{StaticResource MaterialDesignFlatButton}"
                                            Padding="6,2" Height="28" ToolTip="행 추가">
                                        <StackPanel Orientation="Horizontal">
                                            <materialDesign:PackIcon Kind="Plus" Width="14" Height="14" VerticalAlignment="Center"/>
                                            <TextBlock Text="행 추가" Margin="4,0,0,0" FontSize="{StaticResource FontSizeSmall}" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Button>
                                    <Button Grid.Column="2"
                                            Command="{Binding RemoveResidentialLeaseRowCommand}"
                                            CommandParameter="{Binding SelectedItem, ElementName=ResidentialLeaseGrid}"
                                            Style="{StaticResource MaterialDesignFlatButton}"
                                            Foreground="{StaticResource ErrorBrush}"
                                            Padding="6,2" Height="28" Margin="4,0,0,0" ToolTip="선택 행 삭제">
                                        <StackPanel Orientation="Horizontal">
                                            <materialDesign:PackIcon Kind="Delete" Width="14" Height="14" VerticalAlignment="Center"/>
                                            <TextBlock Text="행 삭제" Margin="4,0,0,0" FontSize="{StaticResource FontSizeSmall}" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Button>
                                </Grid>
                                <Grid Grid.Row="2" Margin="0,8,0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Button Grid.Column="1" Content="저장"
                                            Command="{Binding SaveResidentialLeasesCommand}"
                                            Style="{StaticResource MaterialDesignRaisedButton}"
                                            Padding="12,6"/>
                                </Grid>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- ========== 5. 상가임대차 ========== -->
                    <Border Background="{StaticResource SurfaceColor}"
                            BorderBrush="{StaticResource BorderBrush}"
                            BorderThickness="1"
                            CornerRadius="8"
                            Margin="0,0,0,16">
                        <StackPanel>
                            <Border Background="{StaticResource PrimaryBrush}"
                                    CornerRadius="8,8,0,0"
                                    Padding="16,10">
                                <Grid>
                                    <TextBlock Text="상가임대차"
                                               Foreground="White"
                                               FontWeight="SemiBold"
                                               FontSize="{StaticResource FontSizeH4}"
                                               VerticalAlignment="Center"/>
                                    <Button Content="+"
                                            FontSize="16"
                                            FontWeight="Bold"
                                            HorizontalAlignment="Right"
                                            Command="{Binding CreateCommercialLeaseTableCommand}"
                                            Visibility="{Binding HasCommercialLeaseTable, Converter={StaticResource InverseBooleanToVisibilityConverter}}"
                                            Background="Transparent"
                                            Foreground="White"
                                            BorderThickness="0"
                                            Padding="8,2"
                                            Cursor="Hand"
                                            ToolTip="상가임대차 테이블 생성"/>
                                </Grid>
                            </Border>

                            <Grid Margin="12"
                                  Visibility="{Binding HasCommercialLeaseTable, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <DataGrid x:Name="CommercialLeaseGrid"
                                          PreviewMouseWheel="DataGrid_PreviewMouseWheel"
                                          Grid.Row="0"
                                          ItemsSource="{Binding CommercialLeases}"
                                          AutoGenerateColumns="False"
                                          CanUserAddRows="False"
                                          CanUserDeleteRows="False"
                                          CanUserSortColumns="False"
                                          HeadersVisibility="Column"
                                          ColumnWidth="*"
                                          Background="White"
                                          RowBackground="White"
                                          AlternatingRowBackground="#FAFAFA"
                                          BorderThickness="1"
                                          BorderBrush="{StaticResource BorderBrush}"
                                          GridLinesVisibility="All"
                                          HorizontalGridLinesBrush="{StaticResource BorderBrush}"
                                          VerticalGridLinesBrush="{StaticResource BorderBrush}"
                                          RowHeight="32"
                                          ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                          MinHeight="60">
                                    <DataGrid.ColumnHeaderStyle>
                                        <StaticResource ResourceKey="SectionDataGridColumnHeaderStyle"/>
                                    </DataGrid.ColumnHeaderStyle>
                                    <DataGrid.CellStyle>
                                        <StaticResource ResourceKey="SectionDataGridCellStyle"/>
                                    </DataGrid.CellStyle>
                                    <DataGrid.RowStyle>
                                        <StaticResource ResourceKey="SectionDataGridRowStyle"/>
                                    </DataGrid.RowStyle>
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="구분" Binding="{Binding Category, UpdateSourceTrigger=PropertyChanged}" Width="*" ElementStyle="{StaticResource SectionDataGridTextBlockStyle}" EditingElementStyle="{StaticResource SectionDataGridTextBoxStyle}"/>
                                        <DataGridTextColumn Header="면적" Binding="{Binding Area, UpdateSourceTrigger=PropertyChanged}" Width="*" ElementStyle="{StaticResource SectionDataGridTextBlockStyle}" EditingElementStyle="{StaticResource SectionDataGridTextBoxStyle}"/>
                                        <DataGridTextColumn Header="임차인" Binding="{Binding TenantName, UpdateSourceTrigger=PropertyChanged}" Width="*" ElementStyle="{StaticResource SectionDataGridTextBlockStyle}" EditingElementStyle="{StaticResource SectionDataGridTextBoxStyle}"/>
                                        <DataGridTextColumn Header="임차개시일" Binding="{Binding LeaseStartDate, StringFormat=yyyy-MM-dd, UpdateSourceTrigger=PropertyChanged}" Width="*" ElementStyle="{StaticResource SectionDataGridTextBlockStyle}" EditingElementStyle="{StaticResource SectionDataGridTextBoxStyle}"/>
                                        <DataGridTextColumn Header="임차종료일" Binding="{Binding LeaseEndDate, StringFormat=yyyy-MM-dd, UpdateSourceTrigger=PropertyChanged}" Width="*" ElementStyle="{StaticResource SectionDataGridTextBlockStyle}" EditingElementStyle="{StaticResource SectionDataGridTextBoxStyle}"/>
                                        <DataGridTextColumn Header="확정신고일" Binding="{Binding ConfirmationDate, StringFormat=yyyy-MM-dd, UpdateSourceTrigger=PropertyChanged}" Width="*" ElementStyle="{StaticResource SectionDataGridTextBlockStyle}" EditingElementStyle="{StaticResource SectionDataGridTextBoxStyle}"/>
                                        <DataGridTextColumn Header="보증금" Binding="{Binding Deposit, StringFormat=N0, UpdateSourceTrigger=PropertyChanged}" Width="*" ElementStyle="{StaticResource SectionDataGridTextBlockStyle}" EditingElementStyle="{StaticResource SectionDataGridTextBoxStyle}"/>
                                        <DataGridTextColumn Header="월세" Binding="{Binding MonthlyRent, StringFormat=N0, UpdateSourceTrigger=PropertyChanged}" Width="*" ElementStyle="{StaticResource SectionDataGridTextBlockStyle}" EditingElementStyle="{StaticResource SectionDataGridTextBoxStyle}"/>
                                        <DataGridTextColumn Header="소액보증금" Binding="{Binding SmallDeposit, StringFormat=N0, UpdateSourceTrigger=PropertyChanged}" Width="*" ElementStyle="{StaticResource SectionDataGridTextBlockStyle}" EditingElementStyle="{StaticResource SectionDataGridTextBoxStyle}"/>
                                        <DataGridTextColumn Header="선순위 보증금" Binding="{Binding SeniorDeposit, StringFormat=N0, UpdateSourceTrigger=PropertyChanged}" Width="*" ElementStyle="{StaticResource SectionDataGridTextBlockStyle}" EditingElementStyle="{StaticResource SectionDataGridTextBoxStyle}"/>
                                    </DataGrid.Columns>
                                </DataGrid>

                                <Grid Grid.Row="1" Margin="0,8,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Button Grid.Column="1"
                                            Command="{Binding AddCommercialLeaseRowCommand}"
                                            Style="{StaticResource MaterialDesignFlatButton}"
                                            Padding="6,2" Height="28" ToolTip="행 추가">
                                        <StackPanel Orientation="Horizontal">
                                            <materialDesign:PackIcon Kind="Plus" Width="14" Height="14" VerticalAlignment="Center"/>
                                            <TextBlock Text="행 추가" Margin="4,0,0,0" FontSize="{StaticResource FontSizeSmall}" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Button>
                                    <Button Grid.Column="2"
                                            Command="{Binding RemoveCommercialLeaseRowCommand}"
                                            CommandParameter="{Binding SelectedItem, ElementName=CommercialLeaseGrid}"
                                            Style="{StaticResource MaterialDesignFlatButton}"
                                            Foreground="{StaticResource ErrorBrush}"
                                            Padding="6,2" Height="28" Margin="4,0,0,0" ToolTip="선택 행 삭제">
                                        <StackPanel Orientation="Horizontal">
                                            <materialDesign:PackIcon Kind="Delete" Width="14" Height="14" VerticalAlignment="Center"/>
                                            <TextBlock Text="행 삭제" Margin="4,0,0,0" FontSize="{StaticResource FontSizeSmall}" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Button>
                                </Grid>
                                <Grid Grid.Row="2" Margin="0,8,0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Button Grid.Column="1" Content="저장"
                                            Command="{Binding SaveCommercialLeasesCommand}"
                                            Style="{StaticResource MaterialDesignRaisedButton}"
                                            Padding="12,6"/>
                                </Grid>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- ========== 6. 임금채권 ========== -->
                    <Border Background="{StaticResource SurfaceColor}"
                            BorderBrush="{StaticResource BorderBrush}"
                            BorderThickness="1"
                            CornerRadius="8"
                            Margin="0,0,0,16">
                        <StackPanel>
                            <Border Background="{StaticResource PrimaryBrush}"
                                    CornerRadius="8,8,0,0"
                                    Padding="16,10">
                                <Grid>
                                    <TextBlock Text="임금채권"
                                               Foreground="White"
                                               FontWeight="SemiBold"
                                               FontSize="{StaticResource FontSizeH4}"
                                               VerticalAlignment="Center"/>
                                    <Button Content="+"
                                            FontSize="16"
                                            FontWeight="Bold"
                                            HorizontalAlignment="Right"
                                            Command="{Binding CreateWageClaimTableCommand}"
                                            Visibility="{Binding HasWageClaimTable, Converter={StaticResource InverseBooleanToVisibilityConverter}}"
                                            Background="Transparent"
                                            Foreground="White"
                                            BorderThickness="0"
                                            Padding="8,2"
                                            Cursor="Hand"
                                            ToolTip="임금채권 테이블 생성"/>
                                </Grid>
                            </Border>

                            <Grid Margin="12"
                                  Visibility="{Binding HasWageClaimTable, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <Grid Grid.Row="0" Margin="0,0,0,2">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <Border Grid.Column="0" Grid.ColumnSpan="15"
                                            Background="{StaticResource BlueGray100Brush}"
                                            BorderBrush="{StaticResource BorderBrush}"
                                            BorderThickness="1,1,1,1"
                                            Padding="0"/>

                                    <Border Grid.Column="6" Grid.ColumnSpan="4"
                                            BorderBrush="{StaticResource BorderBrush}"
                                            BorderThickness="1,0,1,0"
                                            Padding="8,6">
                                        <TextBlock Text="배당요구액(체불내역)"
                                                   FontSize="{StaticResource FontSizeSmall}"
                                                   FontWeight="SemiBold"
                                                   Foreground="{StaticResource TextSecondaryBrush}"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"/>
                                    </Border>

                                    <Border Grid.Column="10" Grid.ColumnSpan="4"
                                            BorderBrush="{StaticResource BorderBrush}"
                                            BorderThickness="1,0,1,0"
                                            Padding="8,6">
                                        <TextBlock Text="반영금액"
                                                   FontSize="{StaticResource FontSizeSmall}"
                                                   FontWeight="SemiBold"
                                                   Foreground="{StaticResource TextSecondaryBrush}"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"/>
                                    </Border>
                                </Grid>

                                <DataGrid x:Name="WageClaimGrid"
                                          PreviewMouseWheel="DataGrid_PreviewMouseWheel"
                                          Grid.Row="1"
                                          ColumnWidth="*"
                                          ItemsSource="{Binding WageClaims}"
                                          HeadersVisibility="Column"
                                          AutoGenerateColumns="False"
                                          CanUserAddRows="False"
                                          CanUserDeleteRows="False"
                                          CanUserSortColumns="False"
                                          Background="White"
                                          RowBackground="White"
                                          AlternatingRowBackground="#FAFAFA"
                                          BorderThickness="1"
                                          BorderBrush="{StaticResource BorderBrush}"
                                          GridLinesVisibility="All"
                                          HorizontalGridLinesBrush="{StaticResource BorderBrush}"
                                          VerticalGridLinesBrush="{StaticResource BorderBrush}"
                                          RowHeight="32"
                                          ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                          MinHeight="60">
                                    <DataGrid.ColumnHeaderStyle>
                                        <StaticResource ResourceKey="SectionDataGridColumnHeaderStyle"/>
                                    </DataGrid.ColumnHeaderStyle>
                                    <DataGrid.CellStyle>
                                        <StaticResource ResourceKey="SectionDataGridCellStyle"/>
                                    </DataGrid.CellStyle>
                                    <DataGrid.RowStyle>
                                        <StaticResource ResourceKey="SectionDataGridRowStyle"/>
                                    </DataGrid.RowStyle>
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="순번" Binding="{Binding SequenceNumber, UpdateSourceTrigger=PropertyChanged}" Width="*" ElementStyle="{StaticResource SectionDataGridTextBlockStyle}" EditingElementStyle="{StaticResource SectionDataGridTextBoxStyle}"/>
                                        <DataGridTextColumn Header="성명" Binding="{Binding EmployeeName, UpdateSourceTrigger=PropertyChanged}" Width="*" ElementStyle="{StaticResource SectionDataGridTextBlockStyle}" EditingElementStyle="{StaticResource SectionDataGridTextBoxStyle}"/>
                                        <DataGridTextColumn Header="생년월일" Binding="{Binding BirthDate, StringFormat=yyMMdd, UpdateSourceTrigger=PropertyChanged}" Width="*" ElementStyle="{StaticResource SectionDataGridTextBlockStyle}" EditingElementStyle="{StaticResource SectionDataGridTextBoxStyle}"/>
                                        <DataGridTextColumn Header="가압류일자" Binding="{Binding SeizureDate, StringFormat=yyyy-MM-dd, UpdateSourceTrigger=PropertyChanged}" Width="*" ElementStyle="{StaticResource SectionDataGridTextBlockStyle}" EditingElementStyle="{StaticResource SectionDataGridTextBoxStyle}"/>
                                        <DataGridTextColumn Header="가압류금액" Binding="{Binding SeizureAmount, StringFormat=N0, UpdateSourceTrigger=PropertyChanged}" Width="*" ElementStyle="{StaticResource SectionDataGridTextBlockStyle}" EditingElementStyle="{StaticResource SectionDataGridTextBoxStyle}"/>
                                        <DataGridTextColumn Header="배당요구일자" Binding="{Binding ClaimDate, StringFormat=yyyy-MM-dd, UpdateSourceTrigger=PropertyChanged}" Width="*" ElementStyle="{StaticResource SectionDataGridTextBlockStyle}" EditingElementStyle="{StaticResource SectionDataGridTextBoxStyle}"/>
                                        <DataGridTextColumn Header="임금" Binding="{Binding WageAmount, StringFormat=N0, UpdateSourceTrigger=PropertyChanged}" Width="*" ElementStyle="{StaticResource SectionDataGridTextBlockStyle}" EditingElementStyle="{StaticResource SectionDataGridTextBoxStyle}"/>
                                        <DataGridTextColumn Header="퇴직금" Binding="{Binding SeveranceAmount, StringFormat=N0, UpdateSourceTrigger=PropertyChanged}" Width="*" ElementStyle="{StaticResource SectionDataGridTextBlockStyle}" EditingElementStyle="{StaticResource SectionDataGridTextBoxStyle}"/>
                                        <DataGridTextColumn Header="기타" Binding="{Binding OtherAmount, StringFormat=N0, UpdateSourceTrigger=PropertyChanged}" Width="*" ElementStyle="{StaticResource SectionDataGridTextBlockStyle}" EditingElementStyle="{StaticResource SectionDataGridTextBoxStyle}"/>
                                        <DataGridTextColumn Header="합계" Binding="{Binding TotalAmount, StringFormat=N0}" Width="*" IsReadOnly="True" ElementStyle="{StaticResource SectionDataGridTextBlockStyle}"/>
                                        <DataGridTextColumn Header="3개월 임금" Binding="{Binding ThreeMonthWage, StringFormat=N0, UpdateSourceTrigger=PropertyChanged}" Width="*" ElementStyle="{StaticResource SectionDataGridTextBlockStyle}" EditingElementStyle="{StaticResource SectionDataGridTextBoxStyle}"/>
                                        <DataGridTextColumn Header="3년분 퇴직금" Binding="{Binding ThreeYearSeverance, StringFormat=N0, UpdateSourceTrigger=PropertyChanged}" Width="*" ElementStyle="{StaticResource SectionDataGridTextBlockStyle}" EditingElementStyle="{StaticResource SectionDataGridTextBoxStyle}"/>
                                        <DataGridTextColumn Header="체당금지급액" Binding="{Binding SubstitutePayment, StringFormat=N0, UpdateSourceTrigger=PropertyChanged}" Width="*" ElementStyle="{StaticResource SectionDataGridTextBlockStyle}" EditingElementStyle="{StaticResource SectionDataGridTextBoxStyle}"/>
                                        <DataGridTextColumn Header="합계" Binding="{Binding ReflectedAmount, StringFormat=N0}" Width="*" IsReadOnly="True" ElementStyle="{StaticResource SectionDataGridTextBlockStyle}"/>
                                        <DataGridTextColumn Header="비고" Binding="{Binding Notes, UpdateSourceTrigger=PropertyChanged}" Width="*" ElementStyle="{StaticResource SectionDataGridTextBlockStyle}" EditingElementStyle="{StaticResource SectionDataGridTextBoxStyle}"/>
                                    </DataGrid.Columns>
                                </DataGrid>

                                <Grid Grid.Row="2" Margin="0,8,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Button Grid.Column="1"
                                            Command="{Binding AddWageClaimRowCommand}"
                                            Style="{StaticResource MaterialDesignFlatButton}"
                                            Padding="6,2" Height="28" ToolTip="행 추가">
                                        <StackPanel Orientation="Horizontal">
                                            <materialDesign:PackIcon Kind="Plus" Width="14" Height="14" VerticalAlignment="Center"/>
                                            <TextBlock Text="행 추가" Margin="4,0,0,0" FontSize="{StaticResource FontSizeSmall}" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Button>
                                    <Button Grid.Column="2"
                                            Command="{Binding RemoveWageClaimRowCommand}"
                                            CommandParameter="{Binding SelectedItem, ElementName=WageClaimGrid}"
                                            Style="{StaticResource MaterialDesignFlatButton}"
                                            Foreground="{StaticResource ErrorBrush}"
                                            Padding="6,2" Height="28" Margin="4,0,0,0" ToolTip="선택 행 삭제">
                                        <StackPanel Orientation="Horizontal">
                                            <materialDesign:PackIcon Kind="Delete" Width="14" Height="14" VerticalAlignment="Center"/>
                                            <TextBlock Text="행 삭제" Margin="4,0,0,0" FontSize="{StaticResource FontSizeSmall}" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Button>
                                </Grid>
                                <Grid Grid.Row="3" Margin="0,8,0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Button Grid.Column="1" Content="저장"
                                            Command="{Binding SaveWageClaimsCommand}"
                                            Style="{StaticResource MaterialDesignRaisedButton}"
                                            Padding="12,6"/>
                                </Grid>
                            </Grid>
                        </StackPanel>
                    </Border>

                </StackPanel>
            </ScrollViewer>
        </Border>

        <!-- 로딩 오버레이 -->
        <Border Grid.RowSpan="2" Background="#80000000" CornerRadius="8"
                Visibility="{Binding IsLoading, Converter={StaticResource BooleanToVisibilityConverter}}">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                <ProgressBar IsIndeterminate="True" Width="200"/>
                <TextBlock Text="로딩 중..." Foreground="White" Margin="0,16,0,0"/>
            </StackPanel>
        </Border>

        <!-- 에러 메시지 -->
        <Border Grid.Row="1" Background="#E57373" CornerRadius="8" Padding="16" Margin="0,16,0,0"
                VerticalAlignment="Bottom"
                Visibility="{Binding ErrorMessage, Converter={StaticResource NullToVisibilityConverter}}">
            <TextBlock Text="{Binding ErrorMessage}" Foreground="White" TextWrapping="Wrap"/>
        </Border>
    </Grid>
</UserControl>
