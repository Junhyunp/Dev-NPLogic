<UserControl x:Class="NPLogic.Views.SeniorRightsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:NPLogic.Views"
             xmlns:vm="clr-namespace:NPLogic.ViewModels"
             mc:Ignorable="d" 
             d:DesignHeight="900" d:DesignWidth="1600"
             d:DataContext="{d:DesignInstance Type=vm:SeniorRightsViewModel}"
             Loaded="SeniorRightsView_Loaded">
    
    <UserControl.Resources>
        <!-- 테이블 스타일 (CollateralPropertyView와 동일) -->
        <SolidColorBrush x:Key="TableBorderBrush" Color="#E0E0E0"/>
        
        <!-- 테이블 헤더 스타일 (CollateralPropertyView와 동일) -->
        <Style x:Key="TableHeaderCell" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource BlueGray100Brush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="0,0,1,1"/>
            <Setter Property="Padding" Value="12,8"/>
        </Style>
        
        <!-- 테이블 데이터 셀 스타일 (CollateralPropertyView와 동일) -->
        <Style x:Key="TableDataCell" TargetType="Border">
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="0,0,1,1"/>
            <Setter Property="Padding" Value="12,8"/>
        </Style>
        
        <!-- 섹션 헤더 스타일 -->
        <Style x:Key="SectionHeaderStyle" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="{StaticResource FontSizeBody}"/>
            <Setter Property="Foreground" Value="{StaticResource PrimaryBrush}"/>
            <Setter Property="Margin" Value="0,0,0,12"/>
        </Style>
        
        <!-- 라벨 스타일 -->
        <Style x:Key="LabelStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="{StaticResource FontSizeSmall}"/>
            <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
            <Setter Property="TextWrapping" Value="NoWrap"/>
        </Style>
        
        <!-- 값 스타일 -->
        <Style x:Key="ValueStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="{StaticResource FontSizeSmall}"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
            <Setter Property="TextWrapping" Value="NoWrap"/>
        </Style>
        
        <!-- 금액 스타일 -->
        <Style x:Key="AmountStyle" TargetType="TextBlock" BasedOn="{StaticResource ValueStyle}">
            <Setter Property="HorizontalAlignment" Value="Right"/>
        </Style>
        
        <!-- 테이블 셀 스타일 -->
        <Style x:Key="TableCellStyle" TargetType="Border">
            <Setter Property="BorderBrush" Value="{StaticResource TableBorderBrush}"/>
            <Setter Property="BorderThickness" Value="0,0,1,1"/>
            <Setter Property="Padding" Value="6,6"/>
            <Setter Property="Background" Value="Transparent"/>
        </Style>
        
        <!-- 테이블 헤더 셀 스타일 -->
        <Style x:Key="TableHeaderCellStyle" TargetType="Border" BasedOn="{StaticResource TableCellStyle}">
            <Setter Property="Background" Value="{StaticResource SurfaceColor}"/>
            <Setter Property="Padding" Value="4,6"/>
        </Style>
        
        <!-- 노란색 하이라이트 셀 -->
        <Style x:Key="YellowHighlightCellStyle" TargetType="Border" BasedOn="{StaticResource TableCellStyle}">
            <Setter Property="Background" Value="#FFFDE7"/>
        </Style>
        
        <!-- 입력 TextBox 스타일 -->
        <Style x:Key="InputTextBoxStyle" TargetType="TextBox">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
            <Setter Property="BorderBrush" Value="{StaticResource TableBorderBrush}"/>
            <Setter Property="Padding" Value="2,2"/>
            <Setter Property="FontSize" Value="{StaticResource FontSizeSmall}"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
        
        <!-- 읽기 전용 TextBox 스타일 -->
        <Style x:Key="ReadOnlyTextBoxStyle" TargetType="TextBox" BasedOn="{StaticResource InputTextBoxStyle}">
            <Setter Property="IsReadOnly" Value="True"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
        </Style>
        
        <!-- 컴팩트 CheckBox -->
        <Style x:Key="CompactCheckBoxStyle" TargetType="CheckBox">
            <Setter Property="FontSize" Value="{StaticResource FontSizeSmall}"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0"/>
        </Style>
        
        <!-- 컴팩트 DatePicker -->
        <Style x:Key="CompactDatePickerStyle" TargetType="DatePicker">
            <Setter Property="FontSize" Value="{StaticResource FontSizeTiny}"/>
            <Setter Property="Background" Value="{StaticResource DateInputBgBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource DateInputBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="1"/>
            <Setter Property="Height" Value="22"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="DatePicker">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <DatePickerTextBox x:Name="PART_TextBox"
                                                   Grid.Column="0"
                                                   Background="Transparent"
                                                   BorderThickness="0"
                                                   Padding="{TemplateBinding Padding}"
                                                   VerticalAlignment="Center"
                                                   VerticalContentAlignment="Center"
                                                   Focusable="{TemplateBinding Focusable}"/>
                                <Button x:Name="PART_Button"
                                        Grid.Column="1"
                                        Width="18"
                                        Focusable="False"
                                        Background="Transparent"
                                        BorderThickness="0"
                                        VerticalAlignment="Center"
                                        HorizontalAlignment="Center"
                                        Padding="1">
                                    <Path Data="M0,0 L0,6 L6,6 L6,0 z M1,1 L1,2 L2,2 L2,1 z M3,1 L3,2 L4,2 L4,1 z M1,3 L1,4 L2,4 L2,3 z M3,3 L3,4 L4,4 L4,3 z"
                                          Fill="#666666"
                                          Width="9"
                                          Height="9"
                                          Stretch="Uniform"/>
                                </Button>
                                <Popup x:Name="PART_Popup"
                                       AllowsTransparency="True"
                                       Placement="Bottom"
                                       PlacementTarget="{Binding ElementName=PART_TextBox}"
                                       StaysOpen="False"/>
                            </Grid>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 링크 버튼 스타일 -->
        <Style x:Key="LinkButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="{StaticResource PrimaryBrush}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="{StaticResource FontSizeSmall}"/>
            <Setter Property="Padding" Value="4,2"/>
        </Style>
    </UserControl.Resources>
    
    <Grid Margin="12,8,12,12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- 헤더 영역 -->
        <Grid Grid.Row="0" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0">
                <TextBlock Text="선순위(Ⅴ)" 
                           Style="{StaticResource H2TextStyle}"
                           Margin="0,0,0,4"/>
                <TextBlock Style="{StaticResource BodyTextStyle}" Opacity="0.7">
                    <Run Text="경매사건 및 선순위 분석 | 선순위 합계:"/>
                    <Run Text="{Binding SeniorRightsTotal, StringFormat=N0, FallbackValue=0, Mode=OneWay}" FontWeight="SemiBold"/>
                    <Run Text="원"/>
                </TextBlock>
            </StackPanel>

            <!-- 버튼 제거됨 (피드백 #26) -->
        </Grid>

        <!-- 메인 컨텐츠 - 수평 스크롤 지원 -->
        <Border Grid.Row="1" Background="{StaticResource SurfaceColor}" CornerRadius="8" Padding="12">
            <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
                <StackPanel MinWidth="1400">
                    
                    <!-- ========== 1. 경매사건 및 선순위 상단 정보 ========== -->
                    <Border Background="{StaticResource SurfaceColor}"
                            BorderBrush="{StaticResource BorderBrush}"
                            BorderThickness="1"
                            CornerRadius="8"
                            Margin="0,0,0,16">
                        <StackPanel>
                            <!-- 섹션 헤더 (CollateralPropertyView 스타일) -->
                            <Border Background="{StaticResource PrimaryBrush}"
                                    CornerRadius="8,8,0,0"
                                    Padding="16,10">
                                <TextBlock Text="📋 경매사건 및 선순위" 
                                           Foreground="White" 
                                           FontWeight="SemiBold"
                                           FontSize="{StaticResource FontSizeH4}"/>
                            </Border>
                            
                            <!-- 경매사건 통합 테이블: 왼쪽(선행/후행) + 오른쪽(공통) -->
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" MinWidth="80"/>   <!-- 0: 왼쪽 라벨 -->
                                    <ColumnDefinition Width="*" MinWidth="80"/>      <!-- 1: 선행 값 -->
                                    <ColumnDefinition Width="*" MinWidth="80"/>      <!-- 2: 후행 값 -->
                                    <ColumnDefinition Width="Auto" MinWidth="100"/>  <!-- 3: 오른쪽 라벨 -->
                                    <ColumnDefinition Width="*" MinWidth="80"/>      <!-- 4: 오른쪽 값 -->
                                    <ColumnDefinition Width="*" MinWidth="80"/>      <!-- 5: 당사자내역 1 -->
                                    <ColumnDefinition Width="*" MinWidth="80"/>      <!-- 6: 당사자내역 2 -->
                                    <ColumnDefinition Width="*" MinWidth="80"/>      <!-- 7: 당사자내역 3 -->
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <!-- ===== 기존 5열 (Col 0-4) ===== -->

                                <!-- Row 0: 헤더 / 최초법사가 -->
                                <Border Grid.Row="0" Grid.Column="0" Style="{StaticResource TableHeaderCell}"/>
                                <Border Grid.Row="0" Grid.Column="1" Style="{StaticResource TableHeaderCell}">
                                    <TextBlock Text="선행" FontWeight="SemiBold" HorizontalAlignment="Center" Foreground="{StaticResource TextSecondaryBrush}"/>
                                </Border>
                                <Border Grid.Row="0" Grid.Column="2" Style="{StaticResource TableHeaderCell}">
                                    <TextBlock Text="후행" FontWeight="SemiBold" HorizontalAlignment="Center" Foreground="{StaticResource TextSecondaryBrush}"/>
                                </Border>
                                <Border Grid.Row="0" Grid.Column="3" Style="{StaticResource TableHeaderCell}" BorderThickness="2,0,1,1">
                                    <TextBlock Text="최초법사가" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}"/>
                                </Border>
                                <Border Grid.Row="0" Grid.Column="4" Style="{StaticResource TableDataCell}">
                                    <TextBlock Text="{Binding SelectedProperty.InitialCourtValue, StringFormat=N0, FallbackValue='-'}"/>
                                </Border>

                                <!-- Row 1: 경매개시여부 / 최초경매기일 -->
                                <Border Grid.Row="1" Grid.Column="0" Style="{StaticResource TableHeaderCell}">
                                    <TextBlock Text="경매개시여부" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}"/>
                                </Border>
                                <Border Grid.Row="1" Grid.Column="1" Style="{StaticResource TableDataCell}">
                                    <TextBlock>
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Text" Value="경매미개시"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding SelectedProperty.AuctionStarted}" Value="True">
                                                        <Setter Property="Text" Value="경매개시"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </Border>
                                <Border Grid.Row="1" Grid.Column="2" Style="{StaticResource TableDataCell}">
                                    <TextBlock>
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Text" Value="경매미개시"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding SelectedProperty.AuctionStarted}" Value="True">
                                                        <Setter Property="Text" Value="경매개시"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </Border>
                                <Border Grid.Row="1" Grid.Column="3" Style="{StaticResource TableHeaderCell}" BorderThickness="2,0,1,1">
                                    <TextBlock Text="최초경매기일" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}"/>
                                </Border>
                                <Border Grid.Row="1" Grid.Column="4" Style="{StaticResource TableDataCell}">
                                    <TextBlock Text="{Binding SelectedProperty.FirstAuctionDate, StringFormat=yyyy-MM-dd, FallbackValue='-'}"/>
                                </Border>

                                <!-- Row 2: 관할법원 / 최종경매회차 -->
                                <Border Grid.Row="2" Grid.Column="0" Style="{StaticResource TableHeaderCell}">
                                    <TextBlock Text="관할법원" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}"/>
                                </Border>
                                <Border Grid.Row="2" Grid.Column="1" Style="{StaticResource TableDataCell}">
                                    <TextBlock Text="{Binding SelectedProperty.AuctionCourt, FallbackValue='-'}"/>
                                </Border>
                                <Border Grid.Row="2" Grid.Column="2" Style="{StaticResource TableDataCell}">
                                    <TextBlock Text="{Binding SelectedProperty.AuctionCourt, FallbackValue='-'}"/>
                                </Border>
                                <Border Grid.Row="2" Grid.Column="3" Style="{StaticResource TableHeaderCell}" BorderThickness="2,0,1,1">
                                    <TextBlock Text="최종경매회차" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}"/>
                                </Border>
                                <Border Grid.Row="2" Grid.Column="4" Style="{StaticResource TableDataCell}">
                                    <TextBlock Text="{Binding SelectedProperty.FinalAuctionRound, FallbackValue='-'}"/>
                                </Border>

                                <!-- Row 3: 경매사건번호 / 최종경매기일 -->
                                <Border Grid.Row="3" Grid.Column="0" Style="{StaticResource TableHeaderCell}">
                                    <TextBlock Text="경매사건번호" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}"/>
                                </Border>
                                <Border Grid.Row="3" Grid.Column="1" Style="{StaticResource TableDataCell}">
                                    <TextBlock Text="{Binding SelectedProperty.PrecedentCaseNumber, FallbackValue='-'}"/>
                                </Border>
                                <Border Grid.Row="3" Grid.Column="2" Style="{StaticResource TableDataCell}">
                                    <TextBlock Text="{Binding SelectedProperty.SubsequentCaseNumber, FallbackValue='-'}"/>
                                </Border>
                                <Border Grid.Row="3" Grid.Column="3" Style="{StaticResource TableHeaderCell}" BorderThickness="2,0,1,1">
                                    <TextBlock Text="최종경매기일" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}"/>
                                </Border>
                                <Border Grid.Row="3" Grid.Column="4" Style="{StaticResource TableDataCell}">
                                    <TextBlock Text="{Binding SelectedProperty.FinalAuctionDate, StringFormat=yyyy-MM-dd, FallbackValue='-'}"/>
                                </Border>

                                <!-- Row 4: 경매신청기관 / 최종경매결과 -->
                                <Border Grid.Row="4" Grid.Column="0" Style="{StaticResource TableHeaderCell}">
                                    <TextBlock Text="경매신청기관" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}"/>
                                </Border>
                                <Border Grid.Row="4" Grid.Column="1" Style="{StaticResource TableDataCell}">
                                    <TextBlock Text="{Binding SelectedProperty.PrecedentAuctionApplicant, FallbackValue='-'}"/>
                                </Border>
                                <Border Grid.Row="4" Grid.Column="2" Style="{StaticResource TableDataCell}">
                                    <TextBlock Text="{Binding SelectedProperty.SubsequentAuctionApplicant, FallbackValue='-'}"/>
                                </Border>
                                <Border Grid.Row="4" Grid.Column="3" Style="{StaticResource TableHeaderCell}" BorderThickness="2,0,1,1">
                                    <TextBlock Text="최종경매결과" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}"/>
                                </Border>
                                <Border Grid.Row="4" Grid.Column="4" Style="{StaticResource TableDataCell}">
                                    <TextBlock Text="{Binding SelectedProperty.FinalAuctionResult, FallbackValue='-'}"/>
                                </Border>

                                <!-- Row 5: 경매개시일자 / 낙찰금액 -->
                                <Border Grid.Row="5" Grid.Column="0" Style="{StaticResource TableHeaderCell}">
                                    <TextBlock Text="경매개시일자" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}"/>
                                </Border>
                                <Border Grid.Row="5" Grid.Column="1" Style="{StaticResource TableDataCell}">
                                    <TextBlock Text="{Binding SelectedProperty.PrecedentAuctionStartDate, StringFormat=yyyy-MM-dd, FallbackValue='-'}"/>
                                </Border>
                                <Border Grid.Row="5" Grid.Column="2" Style="{StaticResource TableDataCell}">
                                    <TextBlock Text="{Binding SelectedProperty.SubsequentAuctionStartDate, StringFormat=yyyy-MM-dd, FallbackValue='-'}"/>
                                </Border>
                                <Border Grid.Row="5" Grid.Column="3" Style="{StaticResource TableHeaderCell}" BorderThickness="2,0,1,1">
                                    <TextBlock Text="낙찰금액" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}"/>
                                </Border>
                                <Border Grid.Row="5" Grid.Column="4" Style="{StaticResource TableDataCell}">
                                    <TextBlock Text="{Binding SelectedProperty.WinningBidAmount, StringFormat=N0, FallbackValue='-'}"/>
                                </Border>

                                <!-- Row 6: 배당요구종기일 / 최종경매일의 최저입찰금액 -->
                                <Border Grid.Row="6" Grid.Column="0" Style="{StaticResource TableHeaderCell}">
                                    <TextBlock Text="배당요구종기일" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}"/>
                                </Border>
                                <Border Grid.Row="6" Grid.Column="1" Style="{StaticResource TableDataCell}">
                                    <TextBlock Text="{Binding SelectedProperty.PrecedentClaimDeadline, StringFormat=yyyy-MM-dd, FallbackValue='-'}"/>
                                </Border>
                                <Border Grid.Row="6" Grid.Column="2" Style="{StaticResource TableDataCell}">
                                    <TextBlock Text="{Binding SelectedProperty.SubsequentClaimDeadline, StringFormat=yyyy-MM-dd, FallbackValue='-'}"/>
                                </Border>
                                <Border Grid.Row="6" Grid.Column="3" Style="{StaticResource TableHeaderCell}" BorderThickness="2,0,1,1">
                                    <TextBlock Text="최종경매일의 최저입찰금액" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}"/>
                                </Border>
                                <Border Grid.Row="6" Grid.Column="4" Style="{StaticResource TableDataCell}">
                                    <TextBlock Text="{Binding SelectedProperty.FinalMinimumBid, StringFormat=N0, FallbackValue='-'}"/>
                                </Border>

                                <!-- Row 7: 청구금액 / 차후예정경매일의 최저입찰금액 -->
                                <Border Grid.Row="7" Grid.Column="0" Style="{StaticResource TableHeaderCell}">
                                    <TextBlock Text="청구금액" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}"/>
                                </Border>
                                <Border Grid.Row="7" Grid.Column="1" Style="{StaticResource TableDataCell}">
                                    <TextBlock Text="{Binding SelectedProperty.PrecedentClaimAmount, StringFormat=N0, FallbackValue='-'}"/>
                                </Border>
                                <Border Grid.Row="7" Grid.Column="2" Style="{StaticResource TableDataCell}">
                                    <TextBlock Text="{Binding SelectedProperty.SubsequentClaimAmount, StringFormat=N0, FallbackValue='-'}"/>
                                </Border>
                                <Border Grid.Row="7" Grid.Column="3" Style="{StaticResource TableHeaderCell}" BorderThickness="2,0,1,1">
                                    <TextBlock Text="차후예정경매일의 최저입찰금액" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}"/>
                                </Border>
                                <Border Grid.Row="7" Grid.Column="4" Style="{StaticResource TableDataCell}">
                                    <TextBlock Text="{Binding SelectedProperty.NextMinimumBid, StringFormat=N0, FallbackValue='-'}"/>
                                </Border>

                                <!-- ===== 추가 3열 (Col 5-7): 당사자내역 ===== -->

                                <!-- Row 0: 당사자내역 헤더 (3열 병합) -->
                                <Border Grid.Row="0" Grid.Column="5" Grid.ColumnSpan="3"
                                        Style="{StaticResource TableHeaderCell}" BorderThickness="2,0,0,1">
                                    <TextBlock Text="당사자내역" FontWeight="SemiBold" HorizontalAlignment="Center" Foreground="{StaticResource TextSecondaryBrush}"/>
                                </Border>

                                <!-- Row 1-5: 당사자내역 이미지 영역 (3열×5행 병합) -->
                                <Border Grid.Row="1" Grid.Column="5" Grid.ColumnSpan="3" Grid.RowSpan="5"
                                        Style="{StaticResource TableDataCell}" BorderThickness="2,0,0,1">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="140" MinHeight="40"/>
                                            <RowDefinition Height="5"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>
                                        <Button Grid.Row="0" Content="이미지 붙여넣기"
                                                Command="{Binding PastePartyDetailsImageCommand}"
                                                Style="{StaticResource SecondaryButton}"
                                                Padding="8,4" FontSize="{StaticResource FontSizeTiny}"
                                                HorizontalAlignment="Left" Margin="0,0,0,4"/>
                                        <Image Grid.Row="1" Source="{Binding PartyDetailsImage}"
                                               Stretch="Uniform"/>
                                        <GridSplitter Grid.Row="2" HorizontalAlignment="Stretch"
                                                      ResizeDirection="Rows" Background="#E0E0E0"
                                                      Cursor="SizeNS" Height="5"/>
                                        <TextBlock Grid.Row="3" Text="{Binding PartyDetailsImageInfo}"
                                                   FontSize="{StaticResource FontSizeTiny}" Opacity="0.7"
                                                   TextWrapping="Wrap" Margin="0,2,0,0"/>
                                    </Grid>
                                </Border>

                                <!-- Row 6: 현황조사서 / 감정평가서 / 배당요구종기일경과 (헤더) -->
                                <Border Grid.Row="6" Grid.Column="5" Style="{StaticResource TableHeaderCell}" BorderThickness="2,0,1,1">
                                    <TextBlock Text="현황조사서" FontWeight="SemiBold" HorizontalAlignment="Center" Foreground="{StaticResource TextSecondaryBrush}"/>
                                </Border>
                                <Border Grid.Row="6" Grid.Column="6" Style="{StaticResource TableHeaderCell}">
                                    <TextBlock Text="감정평가서" FontWeight="SemiBold" HorizontalAlignment="Center" Foreground="{StaticResource TextSecondaryBrush}"/>
                                </Border>
                                <Border Grid.Row="6" Grid.Column="7" Style="{StaticResource TableHeaderCell}" BorderThickness="0,0,0,1">
                                    <TextBlock Text="배당요구종기일경과" FontWeight="SemiBold" HorizontalAlignment="Center" Foreground="{StaticResource TextSecondaryBrush}"/>
                                </Border>

                                <!-- Row 7: 현황조사서 / 감정평가서 / 배당요구종기일경과 (입력) -->
                                <Border Grid.Row="7" Grid.Column="5" Style="{StaticResource TableDataCell}" BorderThickness="2,0,1,1">
                                    <TextBox Text="{Binding SurveyReportNote, UpdateSourceTrigger=PropertyChanged}"
                                             Style="{StaticResource InputTextBoxStyle}"
                                             TextWrapping="Wrap" AcceptsReturn="True" MinHeight="24"/>
                                </Border>
                                <Border Grid.Row="7" Grid.Column="6" Style="{StaticResource TableDataCell}">
                                    <TextBox Text="{Binding AppraisalReportNote, UpdateSourceTrigger=PropertyChanged}"
                                             Style="{StaticResource InputTextBoxStyle}"
                                             TextWrapping="Wrap" AcceptsReturn="True" MinHeight="24"/>
                                </Border>
